+	} else {
+		return;
+	}
+
+	switch (entry->bfib1.pkt_type) {
+	case IPV4_HNAPT:
+	case IPV4_HNAT:
+		entry->ipv4_hnapt.tport_id = tport_id;
+		if (cdrt_id)
