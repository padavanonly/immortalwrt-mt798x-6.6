+static inline void hnat_qos_rate_limit_set(u32 id, const struct net_device *dev)
+{
+	const struct mtk_mac *mac;
+	u32 max_man = SPEED_10000 / SPEED_100;
+	u32 max_exp = 5;
+	u32 cfg;
+
+	if (id >= MTK_QDMA_TX_NUM || !hnat_priv || !hnat_priv->fe_base)
+		return;
+
+	if (!dev || IS_EXT(dev) || IS_BOND(dev) || IS_BR(dev))
+		goto setup_rate_limit;
+
+	mac = netdev_priv(dev);
+	switch (mac->speed) {
+	case SPEED_100:
+	case SPEED_1000:
+	case SPEED_2500:
+	case SPEED_5000:
+	case SPEED_10000:
+		max_man = mac->speed / SPEED_100;
+		break;
+	default:
+		return;
+	}
+
+setup_rate_limit:
+	cr_set_field(hnat_priv->fe_base + QDMA_PAGE, QTX_CFG_PAGE,
+		     (id / NUM_OF_Q_PER_PAGE));
+	cfg = QTX_SCH_MIN_RATE_EN | QTX_SCH_MAX_RATE_EN;
+	cfg |= (1 << QTX_SCH_MIN_RATE_MAN_OFFSET) |
+	       (4 << QTX_SCH_MIN_RATE_EXP_OFFSET) |
+	       ((max_man & 0x7f) << QTX_SCH_MAX_RATE_MAN_OFFSET) |
+	       ((max_exp & 0xf) << QTX_SCH_MAX_RATE_EXP_OFFSET) |
+	       (4 << QTX_SCH_MAX_RATE_WGHT_OFFSET);
+	writel(cfg, hnat_priv->fe_base + QTX_SCH(id % NUM_OF_Q_PER_PAGE));
+}
