+	case IPV4_DSLITE:
+		entry->ipv4_dslite.tport_id = tport_id;
+		if (cdrt_id)
+			entry->ipv4_dslite.cdrt_id = cdrt_id;
+		if (tops_entry)
+			entry->ipv4_dslite.tops_entry = tops_entry;
+		entry->ipv4_dslite.iblk2.qid = 14;
