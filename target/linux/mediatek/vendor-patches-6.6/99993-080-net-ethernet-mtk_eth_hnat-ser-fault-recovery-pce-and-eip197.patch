+			entry->ipv4_mape.cdrt_id = cdrt_id;
+		if (tops_entry)
+			entry->ipv4_mape.tops_entry = tops_entry;
+		entry->ipv4_mape.iblk2.qid = 14;
+		break;
+	case IPV6_3T_ROUTE:
+		entry->ipv6_3t_route.tport_id = tport_id;
+		if (cdrt_id)
+			entry->ipv6_3t_route.cdrt_id = cdrt_id;
+		if (tops_entry)
+			entry->ipv6_3t_route.tops_entry = tops_entry;
+		entry->ipv6_3t_route.iblk2.qid = 14;
+		break;
+	case IPV6_5T_ROUTE:
+		entry->ipv6_5t_route.tport_id = tport_id;
+		if (cdrt_id)
+			entry->ipv6_5t_route.cdrt_id = cdrt_id;
+		if (tops_entry)
+			entry->ipv6_5t_route.tops_entry = tops_entry;
+		entry->ipv6_5t_route.iblk2.qid = 14;
+		break;
+	case IPV6_6RD:
+		entry->ipv6_6rd.tport_id = tport_id;
+		if (cdrt_id)
+			entry->ipv6_6rd.cdrt_id = cdrt_id;
+		if (tops_entry)
+			entry->ipv6_6rd.tops_entry = tops_entry;
+		entry->ipv6_6rd.iblk2.qid = 14;
+		break;
+	case IPV6_HNAPT:
+	case IPV6_HNAT:
+		entry->ipv6_hnapt.tport_id = tport_id;
+		if (cdrt_id)
+			entry->ipv6_hnapt.cdrt_id = cdrt_id;
+		if (tops_entry)
+			entry->ipv6_hnapt.tops_entry = tops_entry;
+		entry->ipv6_hnapt.iblk2.qid = 14;
+		break;
+	default:
+		return;
+	}
+
+	hnat_qos_rate_limit_set(14, dev);
+}
+#else /* !defined(CONFIG_MEDIATEK_NETSYS_V3) */
+static inline void hnat_fill_offload_engine_entry(struct sk_buff *skb,
+						  struct foe_entry *entry,
+						  const struct net_device *dev)
+{
+}
+#endif /* defined(CONFIG_MEDIATEK_NETSYS_V3) */
+
+static inline void hnat_get_filled_unbind_entry(struct sk_buff *skb,
+						struct foe_entry *entry)
+{
+	u32 ppe_id;
+	u32 foe_idx;
+
+	if (unlikely(!hnat_priv || !skb || !entry))
+		return;
+
+	ppe_id = skb_hnat_ppe(skb);
+	foe_idx = skb_hnat_entry(skb);
+	if (ppe_id >= CFG_PPE_NUM || foe_idx >= hnat_priv->foe_etry_num ||
+	    !hnat_priv->foe_table_cpu[ppe_id])
+		return;
+
+	memcpy(entry,
+	       &hnat_priv->foe_table_cpu[ppe_id][foe_idx],
+	       sizeof(*entry));
+
+#if defined(CONFIG_MEDIATEK_NETSYS_V2) || defined(CONFIG_MEDIATEK_NETSYS_V3)
+	entry->bfib1.mc = 0;
+#endif
+	entry->bfib1.ka = 0;
+	entry->bfib1.vlan_layer = 0;
+	entry->bfib1.psn = 0;
+	entry->bfib1.vpm = 0;
+	entry->bfib1.ps = 0;
+}
+
+int hnat_bind_crypto_entry(struct sk_buff *skb, const struct net_device *dev,
+			   int fill_inner_info)
+{
+	struct foe_entry *foe;
+	struct foe_entry unbind_foe;
+	struct foe_entry entry = { 0 };
+	struct hnat_mib_bind_guard guard = { 0 };
+	struct ethhdr eth = { 0 };
+	struct ethhdr *eth_hdr_ptr;
+	struct net_device *master_dev = (struct net_device *)dev;
+	const struct net_device *rate_dev = NULL;
+	struct ipv6hdr *ip6h;
+	struct iphdr *iph;
+	struct tcpudphdr _ports;
+	const struct tcpudphdr *pptr;
+	u32 ppe_id;
+	u32 foe_idx;
+	u32 gmac = NR_DISCARD;
+	int udp = 0;
+	int port_id;
+	struct mtk_mac *mac;
+	struct flow_offload_hw_path hw_path = {
+		.dev = (struct net_device *)dev,
+		.virt_dev = (struct net_device *)dev,
+	};
+	u16 h_proto = 0;
+
+	if (!hnat_priv || !hnat_priv->data || !skb || !dev)
+		return -EINVAL;
+
+	if (!tnl_toggle) {
+		pr_notice("tnl_toggle is disable now!\n");
+		return -1;
+	}
+
+	if (!IS_SPACE_AVAILABLE_HEAD(skb) || !skb_hnat_is_hashed(skb))
+		return 0;
+
+	ppe_id = skb_hnat_ppe(skb);
+	foe_idx = skb_hnat_entry(skb);
+	if (ppe_id >= CFG_PPE_NUM || foe_idx >= hnat_priv->foe_etry_num)
+		return 0;
+
+	spin_lock_bh(&hnat_priv->entry_lock);
+	if (!hnat_priv->foe_table_cpu[ppe_id] || !hnat_priv->ppe_base[ppe_id]) {
+		spin_unlock_bh(&hnat_priv->entry_lock);
+		return -ENODEV;
+	}
+	foe = &hnat_priv->foe_table_cpu[ppe_id][foe_idx];
+	if (entry_hnat_is_bound(foe)) {
+		spin_unlock_bh(&hnat_priv->entry_lock);
+		return 0;
+	}
+	unbind_foe = *foe;
+	hnat_get_filled_unbind_entry(skb, &entry);
+	spin_unlock_bh(&hnat_priv->entry_lock);
+
+	if (ip_hdr(skb)->version == IPVERSION_V4)
+		h_proto = ETH_P_IP;
+	else if (ip_hdr(skb)->version == IPVERSION_V6)
+		h_proto = ETH_P_IPV6;
+	else
+		return 0;
+
+	if (dev->netdev_ops && dev->netdev_ops->ndo_flow_offload_check) {
+		dev->netdev_ops->ndo_flow_offload_check(&hw_path);
+		dev = (IS_GMAC1_MODE) ? hw_path.virt_dev : hw_path.dev;
+		if (!dev)
+			return -1;
+		master_dev = (struct net_device *)dev;
+	}
+
+	if (hw_path.flags & BIT(DEV_PATH_PPPOE)) {
+		memcpy(eth.h_dest, hw_path.eth_dest, ETH_ALEN);
+		memcpy(eth.h_source, hw_path.eth_src, ETH_ALEN);
+		eth.h_proto = htons(h_proto);
+		eth_hdr_ptr = &eth;
+	} else {
+		if (!skb_mac_header_was_set(skb))
+			return -1;
+		eth_hdr_ptr = eth_hdr(skb);
+		memcpy(hw_path.eth_dest, eth_hdr_ptr->h_dest, ETH_ALEN);
+		memcpy(hw_path.eth_src, eth_hdr_ptr->h_source, ETH_ALEN);
+	}
+
+	if (!fill_inner_info)
+		goto hnat_skip_fill_inner;
+
+	switch (h_proto) {
+	case ETH_P_IP:
+		iph = ip_hdr(skb);
+
+		switch (iph->protocol) {
+		case IPPROTO_UDP:
+			udp = 1;
+			fallthrough;
+		case IPPROTO_TCP:
+			entry.ipv4_hnapt.etype = htons(ETH_P_IP);
+			if (IS_IPV4_GRP(&entry)) {
+				entry.ipv4_hnapt.iblk2.dscp = iph->tos;
+				if (hnat_priv->data->per_flow_accounting)
+					entry.ipv4_hnapt.iblk2.mibf = 1;
+
+				entry.ipv4_hnapt.vlan1 = hw_path.vlan_id;
+				if (skb_vlan_tagged(skb)) {
+					entry.bfib1.vlan_layer += 1;
+					if (entry.ipv4_hnapt.vlan1)
+						entry.ipv4_hnapt.vlan2 = skb->vlan_tci;
+					else
+						entry.ipv4_hnapt.vlan1 = skb->vlan_tci;
+				}
+
+				entry.ipv4_hnapt.sip = unbind_foe.ipv4_hnapt.sip;
+				entry.ipv4_hnapt.dip = unbind_foe.ipv4_hnapt.dip;
+				entry.ipv4_hnapt.sport = unbind_foe.ipv4_hnapt.sport;
+				entry.ipv4_hnapt.dport = unbind_foe.ipv4_hnapt.dport;
+
+				entry.ipv4_hnapt.new_sip = ntohl(iph->saddr);
+				entry.ipv4_hnapt.new_dip = ntohl(iph->daddr);
+
+				if (IS_IPV4_HNAPT(&entry)) {
+					pptr = skb_header_pointer(skb,
+								  skb_network_offset(skb) +
+								  iph->ihl * 4,
+								  sizeof(_ports),
+								  &_ports);
+					if (unlikely(!pptr))
+						return -1;
+
+					entry.ipv4_hnapt.new_sport = ntohs(pptr->src);
+					entry.ipv4_hnapt.new_dport = ntohs(pptr->dst);
+				}
+			} else {
+				return 0;
+			}
+
+			entry.bfib1.udp = udp;
+#if defined(CONFIG_MEDIATEK_NETSYS_V3)
+			entry.ipv4_hnapt.eg_keep_ecn = 1;
+			entry.ipv4_hnapt.eg_keep_dscp = 1;
+#endif
+			break;
+
+		default:
+			return -1;
+		}
+		break;
+
+	case ETH_P_IPV6:
+		ip6h = ipv6_hdr(skb);
+		switch (ip6h->nexthdr) {
+		case NEXTHDR_UDP:
+			udp = 1;
+			fallthrough;
+		case NEXTHDR_TCP:
+			entry.ipv6_5t_route.etype = htons(ETH_P_IPV6);
+			entry.ipv6_5t_route.vlan1 = hw_path.vlan_id;
+
+			if (skb_vlan_tagged(skb)) {
+				entry.bfib1.vlan_layer += 1;
+				if (entry.ipv6_5t_route.vlan1)
+					entry.ipv6_5t_route.vlan2 = skb->vlan_tci;
+				else
+					entry.ipv6_5t_route.vlan1 = skb->vlan_tci;
+			}
+
+			if (hnat_priv->data->per_flow_accounting)
+				entry.ipv6_5t_route.iblk2.mibf = 1;
+			entry.bfib1.udp = udp;
+
+			entry.ipv6_3t_route.ipv6_sip0 = unbind_foe.ipv6_3t_route.ipv6_sip0;
+			entry.ipv6_3t_route.ipv6_sip1 = unbind_foe.ipv6_3t_route.ipv6_sip1;
+			entry.ipv6_3t_route.ipv6_sip2 = unbind_foe.ipv6_3t_route.ipv6_sip2;
+			entry.ipv6_3t_route.ipv6_sip3 = unbind_foe.ipv6_3t_route.ipv6_sip3;
+
+			entry.ipv6_3t_route.ipv6_dip0 = unbind_foe.ipv6_3t_route.ipv6_dip0;
+			entry.ipv6_3t_route.ipv6_dip1 = unbind_foe.ipv6_3t_route.ipv6_dip1;
+			entry.ipv6_3t_route.ipv6_dip2 = unbind_foe.ipv6_3t_route.ipv6_dip2;
+			entry.ipv6_3t_route.ipv6_dip3 = unbind_foe.ipv6_3t_route.ipv6_dip3;
+
+#if defined(CONFIG_MEDIATEK_NETSYS_V3)
+			entry.ipv6_3t_route.eg_keep_ecn = 1;
+			entry.ipv6_3t_route.eg_keep_cls = 1;
+#endif
+			if (IS_IPV6_3T_ROUTE(&entry)) {
+				entry.ipv6_3t_route.prot = unbind_foe.ipv6_3t_route.prot;
+				entry.ipv6_3t_route.hph = unbind_foe.ipv6_3t_route.hph;
+			} else if (IS_IPV6_5T_ROUTE(&entry)) {
+				entry.ipv6_5t_route.sport = unbind_foe.ipv6_5t_route.sport;
+				entry.ipv6_5t_route.dport = unbind_foe.ipv6_5t_route.dport;
+			} else {
+				return 0;
+			}
+
+			entry.ipv6_5t_route.iblk2.dscp =
+				(ip6h->priority << 4 | (ip6h->flow_lbl[0] >> 4));
+			break;
+
+		default:
+			return -1;
+		}
+		break;
+
+	default:
+		return -1;
+	}
+
+hnat_skip_fill_inner:
+	entry = ppe_fill_info_blk(eth_hdr_ptr, entry, &hw_path);
+
+	if (!IS_EXT(dev) && (IS_LAN_GRP(dev) || IS_WAN(dev))) {
+		port_id = hnat_dsa_get_port(&master_dev);
+#if defined(CONFIG_NET_DSA)
+		if (port_id < 0) {
+			struct net_device *dsa_dev = NULL;
+			const struct dsa_port *dp;
+
+			dp = hnat_dsa_resolve_dp(dev, &hw_path, &dsa_dev);
+			if (!IS_ERR(dp) && dsa_dev) {
+				master_dev = dsa_dev;
+				port_id = hnat_dsa_get_port(&master_dev);
+			}
+		}
+#endif
+		if (port_id >= 0) {
+			if (hnat_dsa_fill_stag(dev, &entry, &hw_path, h_proto, 0) < 0)
+				return -1;
+		}
+		if (!master_dev || IS_BOND(master_dev) || IS_BR(master_dev) ||
+		    IS_EXT(master_dev))
+			return -1;
+		rate_dev = master_dev;
+		mac = netdev_priv(master_dev);
+		gmac = HNAT_GMAC_FP(mac->id);
+	} else {
+		pr_notice("Unknown case of dp, iif=%x --> %s\n",
+			  skb_hnat_iface(skb), dev->name);
+		return -1;
+	}
+
+	if (IS_IPV4_GRP(&entry)) {
+		entry.ipv4_hnapt.iblk2.dp = gmac;
+		entry.ipv4_hnapt.iblk2.port_mg =
+			(hnat_priv->data->version == MTK_HNAT_V1_1) ? 0x3f : 0;
+		if (!skb_hnat_tops(skb)) {
+			entry.ipv4_hnapt.dmac_hi = swab32(*((u32 *)hw_path.eth_dest));
+			entry.ipv4_hnapt.dmac_lo = swab16(*((u16 *)&hw_path.eth_dest[4]));
+			entry.ipv4_hnapt.smac_hi = swab32(*((u32 *)hw_path.eth_src));
+			entry.ipv4_hnapt.smac_lo = swab16(*((u16 *)&hw_path.eth_src[4]));
+		}
+		entry.ipv4_hnapt.pppoe_id = hw_path.pppoe_sid;
+	} else {
+		entry.ipv6_5t_route.iblk2.dp = gmac;
+		entry.ipv6_5t_route.iblk2.port_mg =
+			(hnat_priv->data->version == MTK_HNAT_V1_1) ? 0x3f : 0;
+		if (!skb_hnat_tops(skb)) {
+			entry.ipv6_5t_route.dmac_hi = swab32(*((u32 *)hw_path.eth_dest));
+			entry.ipv6_5t_route.dmac_lo = swab16(*((u16 *)&hw_path.eth_dest[4]));
+			entry.ipv6_5t_route.smac_hi = swab32(*((u32 *)hw_path.eth_src));
+			entry.ipv6_5t_route.smac_lo = swab16(*((u16 *)&hw_path.eth_src[4]));
+		}
+		entry.ipv6_5t_route.pppoe_id = hw_path.pppoe_sid;
+	}
+
+	hnat_fill_offload_engine_entry(skb, &entry, rate_dev);
+
+	spin_lock_bh(&hnat_priv->entry_lock);
+	if (!hnat_priv->foe_table_cpu[ppe_id] || !hnat_priv->ppe_base[ppe_id]) {
+		spin_unlock_bh(&hnat_priv->entry_lock);
+		return -ENODEV;
+	}
+	foe = &hnat_priv->foe_table_cpu[ppe_id][foe_idx];
+	if (entry_hnat_is_bound(foe)) {
+		spin_unlock_bh(&hnat_priv->entry_lock);
+		return 0;
+	}
+
+	if (!hnat_mib_bind_begin(hnat_priv, ppe_id, foe_idx, &guard)) {
+		spin_unlock_bh(&hnat_priv->entry_lock);
+		return 0;
+	}
+
+	entry.bfib1.ttl = 1;
+	entry.bfib1.state = BIND;
+	hnat_record_foe_nh_meta_locked(skb, &hw_path, &entry);
+	wmb();
+	hnat_copy_foe_info(foe, &entry);
+	wmb();
+	memcpy(&foe->bfib1, &entry.bfib1, sizeof(entry.bfib1));
+	dma_wmb();
+	hnat_mib_bind_end(hnat_priv, ppe_id, &guard);
+	spin_unlock_bh(&hnat_priv->entry_lock);
+
+	return 0;
+}
+EXPORT_SYMBOL(hnat_bind_crypto_entry);
