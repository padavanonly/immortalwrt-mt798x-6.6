 struct mtk_ppe_registry {
@@ -5077,6 +5123,152 @@ struct mtk_ppe_registry {
 
 static LIST_HEAD(mtk_ppe_registries);
 static DEFINE_MUTEX(mtk_hnat_provider_lock);
+static atomic64_t mtk_hnat_ser_epoch = ATOMIC64_INIT(1);
+
+u64 mtk_hnat_get_ser_epoch(void)
+{
+	return (u64)atomic64_read(&mtk_hnat_ser_epoch);
+}
+EXPORT_SYMBOL_GPL(mtk_hnat_get_ser_epoch);
+
+static u32 mtk_eth_ppe_mmio_base(struct mtk_eth *eth, u32 id)
+{
+	if (!eth || !eth->soc || !eth->soc->reg_map ||
+	    !eth->soc->reg_map->ppe_base || id >= MTK_PPE_OWNER_MAX)
+		return 0;
+
+	return eth->soc->reg_map->ppe_base + (id == 2 ? 0xc00 : id * 0x400);
+}
+
+static bool mtk_eth_ppe_hw_idle_unpointed(struct mtk_eth *eth, u32 id)
+{
+	u32 ppe_mmio;
+	u32 glo_cfg, tb_base, mib_base = 0;
+
+	if (!eth || !eth->base)
+		return false;
+
+	ppe_mmio = mtk_eth_ppe_mmio_base(eth, id);
+	if (!ppe_mmio)
+		return false;
+
+	glo_cfg = mtk_r32(eth, ppe_mmio + MTK_PPE_GLO_CFG);
+	tb_base = mtk_r32(eth, ppe_mmio + MTK_PPE_TB_BASE);
+	if (eth->soc->has_accounting)
+		mib_base = mtk_r32(eth, ppe_mmio + MTK_PPE_MIB_TB_BASE);
+
+	return !(glo_cfg & MTK_PPE_GLO_CFG_BUSY) && tb_base == 0 &&
+	       mib_base == 0;
+}
+
+static u32 mtk_ppe_default_drop(struct mtk_eth *eth)
+{
+	if (eth->soc->caps == MT7988_CAPS)
+		return 0x00002300;
+	if (eth->soc->caps == MT7987_CAPS)
+		return 0x00000100;
+	return 0x00000300;
+}
+
+static void mtk_eth_release_ppe_slot_dma_locked(struct mtk_ppe_owner_slot *s)
+{
+	struct mtk_ppe_dma_hold d;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!s->registered)
+		return;
+
+	d = s->hold;
+	if (d.mib_cpu)
+		dma_free_coherent(d.dma_dev, d.mib_bytes,
+				  d.mib_cpu, d.mib_dma);
+	if (d.foe_cpu)
+		dma_free_coherent(d.dma_dev, d.foe_bytes,
+				  d.foe_cpu, d.foe_dma);
+
+	memset(&s->hold, 0, sizeof(s->hold));
+	s->registered = false;
+	if (d.dma_dev)
+		put_device(d.dma_dev);
+}
+
+static void
+mtk_eth_restore_ppe_policy_locked(struct mtk_eth *eth, u32 id)
+{
+	unsigned long flags;
+	struct mtk_ppe_port_policy *p;
+
+	if (!eth || mtk_is_netsys_v1(eth) || !mtk_eth_has_ppe_id(eth, id))
+		return;
+
+	spin_lock_irqsave(&eth->ppe_cfg_lock, flags);
+	p = &eth->ppe_policy[id];
+	if (p->isolated) {
+		u32 reg = MTK_FE_GLO_CFG(PSE_PPE_PORT(id));
+		u32 mask = MTK_FE_LINK_DOWN_P(PSE_PPE_PORT(id));
+		u32 val = mtk_r32(eth, reg);
+
+		val = (val & ~mask) | (p->link_down_was_set ? mask : 0);
+		mtk_w32(eth, val, reg);
+		p->isolated = false;
+		p->link_down_was_set = false;
+	}
+	if (!p->requested_valid || p->requested_drop == 0x3fff) {
+		p->requested_drop = mtk_ppe_default_drop(eth);
+		p->requested_valid = true;
+	}
+	mtk_w32(eth, p->requested_drop, PSE_PPE_DROP(id));
+	spin_unlock_irqrestore(&eth->ppe_cfg_lock, flags);
+}
+
+static void
+mtk_eth_recover_faulted_ppes_locked(struct mtk_eth *eth,
+				    struct mtk_ppe_registry *r,
+				    bool after_hw_reset)
+{
+	unsigned int id;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!eth || !r || !r->live || r->eth != eth ||
+	    test_bit(MTK_REMOVING, &eth->state))
+		return;
+
+	if (after_hw_reset)
+		atomic64_inc(&mtk_hnat_ser_epoch);
+
+	for (id = 0; id < MTK_PPE_OWNER_MAX; id++) {
+		struct mtk_ppe_owner_slot *s = &r->ppe[id];
+
+		if (!mtk_eth_has_ppe_id(eth, id) ||
+		    s->state != MTK_PPE_FAULTED)
+			continue;
+
+		if (!after_hw_reset && !s->consumer_detached)
+			continue;
+
+		if (!mtk_eth_ppe_hw_idle_unpointed(eth, id))
+			continue;
+
+		if (s->consumer_detached || !s->registered) {
+			mtk_eth_release_ppe_slot_dma_locked(s);
+			s->consumer_detached = false;
+			s->state = MTK_PPE_EMPTY;
+			mtk_eth_restore_ppe_policy_locked(eth, id);
+		} else {
+			s->state = MTK_PPE_ACTIVE;
+			mtk_eth_restore_ppe_policy_locked(eth, id);
+		}
+	}
+}
+
+static void
+mtk_eth_recover_faulted_ppes_after_hw_reset_locked(
+	struct mtk_eth *eth, struct mtk_ppe_registry *r)
+{
+	mtk_eth_recover_faulted_ppes_locked(eth, r, true);
+}
 
 static struct mtk_ppe_registry *
 mtk_eth_ppe_registry_get_locked(struct device_node *node)
@@ -5127,11 +5319,15 @@ mtk_eth_sync_faulted_policies_locked(struct mtk_eth *eth,
 		mask = MTK_FE_LINK_DOWN_P(PSE_PPE_PORT(id));
 		val = mtk_r32(eth, reg);
 		if (!p->isolated) {
-			p->link_down_was_set = !!(val & mask);
+			p->link_down_was_set =
+				test_bit(MTK_RESETTING, &eth->state) ?
+				false : !!(val & mask);
+			if (!p->requested_valid) {
+				p->requested_drop = mtk_r32(eth, PSE_PPE_DROP(id));
+				p->requested_valid = true;
+			}
 			p->isolated = true;
 		}
-		p->requested_drop = 0x3fff;
-		p->requested_valid = true;
 		mtk_w32(eth, val | mask, reg);
 		mtk_w32(eth, 0x3fff, PSE_PPE_DROP(id));
 	}
@@ -5166,12 +5362,14 @@ int mtk_eth_provider_online(struct mtk_eth *eth)
 
 	/*
 	 * Allow Ethernet CPU forwarding to come online.
-	 * Any pre-existing FAULTED slot remains latched in the resident
-	 * registry so HNAT claim refuses takeover before DMA allocation.
+	 * Detached faulted slots are reclaimed once hardware reset completes;
+	 * any remaining FAULTED slot stays isolated until reset recovery.
 	 */
 	r->eth = eth;
 	r->live = true;
 	eth->ppe_registry = r;
+	if (test_bit(MTK_HW_INIT, &eth->state))
+		mtk_eth_recover_faulted_ppes_locked(eth, r, false);
 	mtk_eth_sync_faulted_policies_locked(eth, r);
 	rcu_assign_pointer(g_eth, eth);
 
@@ -5312,6 +5510,90 @@ int mtk_eth_hnat_begin(struct mtk_eth_hnat_tx *tx)
 }
 EXPORT_SYMBOL(mtk_eth_hnat_begin);
 
+int mtk_eth_hnat_begin_teardown(struct mtk_eth_hnat_tx *tx)
+{
+	int retries;
+
+	if (!tx)
+		return -EINVAL;
+
+	for (retries = 0; retries < 25; retries++) {
+		struct mtk_eth *eth;
+		struct mtk_ppe_registry *r;
+		struct device *dev;
+		struct work_struct *pending_work;
+		bool should_flush;
+		int err;
+
+		/*
+		 * Never block on rtnl_lock() or call flush_work() while RTNL
+		 * is held: mtk_pending_work() takes rtnl_lock() and would ABBA
+		 * deadlock with flush_work(&eth->pending_work).
+		 */
+		if (!rtnl_trylock()) {
+			msleep(20);
+			continue;
+		}
+
+		err = mtk_eth_hnat_begin_rtnl(tx, false, true);
+		if (err != -EBUSY) {
+			if (err)
+				rtnl_unlock();
+			return err;
+		}
+		rtnl_unlock();
+
+		if (rtnl_is_locked()) {
+			msleep(20);
+			continue;
+		}
+
+		mutex_lock(&mtk_hnat_provider_lock);
+		eth = rcu_dereference_protected(
+			g_eth, lockdep_is_held(&mtk_hnat_provider_lock));
+		if (!eth || !eth->dev || !eth->ethsys) {
+			mutex_unlock(&mtk_hnat_provider_lock);
+			return -ENODEV;
+		}
+		r = eth->ppe_registry;
+		if (!r || !r->live || r->eth != eth ||
+		    test_bit(MTK_REMOVING, &eth->state)) {
+			mutex_unlock(&mtk_hnat_provider_lock);
+			return -ENODEV;
+		}
+		if (current_work() == &eth->pending_work) {
+			mutex_unlock(&mtk_hnat_provider_lock);
+			return -EBUSY;
+		}
+		dev = get_device(eth->dev);
+		if (!dev) {
+			mutex_unlock(&mtk_hnat_provider_lock);
+			return -ENODEV;
+		}
+		pending_work = &eth->pending_work;
+		should_flush = test_bit(MTK_RESETTING, &eth->state) ||
+			       work_pending(pending_work);
+		mutex_unlock(&mtk_hnat_provider_lock);
+
+		if (should_flush)
+			flush_work(pending_work);
+		else
+			msleep(20);
+		put_device(dev);
+	}
+
+	if (!rtnl_trylock())
+		return -EBUSY;
+	{
+		int err = mtk_eth_hnat_begin_rtnl(tx, false, true);
+
+		if (err)
+			rtnl_unlock();
+		return err;
+	}
+}
+EXPORT_SYMBOL(mtk_eth_hnat_begin_teardown);
+
 /* Only for synchronous reset notifier (MTK_FE_RESET_NAT_DONE) with RTNL held. */
 int mtk_eth_hnat_begin_reset(struct mtk_eth_hnat_tx *tx)
 {
@@ -5368,8 +5650,10 @@ int mtk_eth_claim_ppes_locked(struct mtk_eth_hnat_tx *tx, u32 mask)
 	}
 
 	for (id = 0; id < MTK_PPE_OWNER_MAX; id++)
-		if (mask & BIT(id))
+		if (mask & BIT(id)) {
 			r->ppe[id].state = MTK_PPE_ACTIVE;
+			r->ppe[id].consumer_detached = false;
+		}
 
 	return 0;
 }
@@ -5411,6 +5695,7 @@ int mtk_eth_register_ppes_locked(
 		r->ppe[id].hold = desc[id];
 		r->ppe[id].hold.dma_dev = get_device(desc[id].dma_dev);
 		r->ppe[id].registered = true;
+		r->ppe[id].consumer_detached = false;
 	}
 
 	return 0;
@@ -5431,8 +5716,10 @@ void mtk_eth_abort_claim_locked(struct mtk_eth_hnat_tx *tx, u32 mask)
 	for (id = 0; id < MTK_PPE_OWNER_MAX; id++)
 		if ((mask & BIT(id)) &&
 		    r->ppe[id].state == MTK_PPE_ACTIVE &&
-		    !r->ppe[id].registered)
+		    !r->ppe[id].registered) {
 			r->ppe[id].state = MTK_PPE_EMPTY;
+			r->ppe[id].consumer_detached = false;
+		}
 }
 EXPORT_SYMBOL(mtk_eth_abort_claim_locked);
 
@@ -5510,6 +5797,29 @@ void mtk_eth_fault_ppe(struct mtk_ppe_registry *r, u32 id)
 }
 EXPORT_SYMBOL(mtk_eth_fault_ppe);
 
+void mtk_eth_detach_ppe_consumer_locked(struct mtk_ppe_registry *r, u32 id)
+{
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (WARN_ON_ONCE(!r || id >= MTK_PPE_OWNER_MAX))
+		return;
+
+	mtk_eth_fault_ppe_locked(r, id);
+	r->ppe[id].consumer_detached = true;
+}
+EXPORT_SYMBOL(mtk_eth_detach_ppe_consumer_locked);
+
+void mtk_eth_detach_ppe_consumer(struct mtk_ppe_registry *r, u32 id)
+{
+	mutex_lock(&mtk_hnat_provider_lock);
+	if (!WARN_ON_ONCE(!r || id >= MTK_PPE_OWNER_MAX)) {
+		r->ppe[id].state = MTK_PPE_FAULTED;
+		r->ppe[id].consumer_detached = true;
+	}
+	mutex_unlock(&mtk_hnat_provider_lock);
+}
+EXPORT_SYMBOL(mtk_eth_detach_ppe_consumer);
+
 int mtk_eth_mark_ppe_quiesced_locked(struct mtk_eth_hnat_tx *tx, u32 id)
 {
 	struct mtk_ppe_owner_slot *s;
@@ -5531,7 +5841,6 @@ EXPORT_SYMBOL(mtk_eth_mark_ppe_quiesced_locked);
