 drivers/net/ethernet/mediatek/mtk_eth_reset.h |   4 +
 drivers/net/ethernet/mediatek/mtk_eth_soc.c   | 349 ++++++++++-
 drivers/net/ethernet/mediatek/mtk_eth_soc.h   |  58 ++
 drivers/net/ethernet/mediatek/mtk_hnat/hnat.c |  20 +-
 drivers/net/ethernet/mediatek/mtk_hnat/hnat.h |  13 +
 .../ethernet/mediatek/mtk_hnat/hnat_debugfs.c |  47 ++
