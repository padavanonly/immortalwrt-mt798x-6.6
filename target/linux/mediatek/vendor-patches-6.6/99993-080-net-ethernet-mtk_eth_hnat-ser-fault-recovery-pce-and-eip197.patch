+void foe_clear_crypto_entry(u32 cdrt_idx)
+{
+#if defined(CONFIG_MEDIATEK_NETSYS_V3)
+	struct foe_entry *entry;
+	int i, hash_index;
+	bool invalidated = false;
+
+	if (!hnat_priv || !hnat_priv->fe_base || !cdrt_idx)
+		return;
+
+	spin_lock_bh(&hnat_priv->entry_lock);
+	if (!hnat_priv->fe_base) {
+		spin_unlock_bh(&hnat_priv->entry_lock);
+		return;
+	}
+	for (i = 0; i < CFG_PPE_NUM; i++) {
+		if (!hnat_priv->foe_table_cpu[i] || !hnat_priv->ppe_base[i])
+			continue;
+		for (hash_index = 0; hash_index < hnat_priv->foe_etry_num; hash_index++) {
+			bool match = false;
+
+			entry = hnat_priv->foe_table_cpu[i] + hash_index;
+			if (entry->bfib1.state != BIND)
+				continue;
+
+			switch (entry->bfib1.pkt_type) {
+			case IPV4_HNAPT:
+			case IPV4_HNAT:
+				match = (entry->ipv4_hnapt.cdrt_id == cdrt_idx);
+				break;
+			case IPV4_DSLITE:
+				match = (entry->ipv4_dslite.cdrt_id == cdrt_idx);
+				break;
+			case IPV4_MAP_E:
+			case IPV4_MAP_T:
+				match = (entry->ipv4_mape.cdrt_id == cdrt_idx);
+				break;
+			case IPV6_3T_ROUTE:
+				match = (entry->ipv6_3t_route.cdrt_id == cdrt_idx);
+				break;
+			case IPV6_5T_ROUTE:
+				match = (entry->ipv6_5t_route.cdrt_id == cdrt_idx);
+				break;
+			case IPV6_6RD:
+				match = (entry->ipv6_6rd.cdrt_id == cdrt_idx);
+				break;
+			case IPV6_HNAPT:
+			case IPV6_HNAT:
+				match = (entry->ipv6_hnapt.cdrt_id == cdrt_idx);
+				break;
+			default:
+				break;
+			}
+
+			if (!match)
+				continue;
+
+			cr_set_field(hnat_priv->ppe_base[i] + PPE_TB_CFG,
+				     SMA, SMA_ONLY_FWD_CPU);
+			entry->udib1.state = INVALID;
+			entry->udib1.time_stamp =
+				readl((hnat_priv->fe_base + 0x0010)) & 0xFF;
+			foe_clear_pre_filled(entry);
+			if (hnat_priv->nh_meta[i])
+				hnat_priv->nh_meta[i][hash_index].valid = 0;
+			invalidated = true;
+
+			if (debug_level >= 2)
+				pr_info("[%s]: delete entry idx = %d_%d\n",
+					__func__, i, hash_index);
+		}
+	}
+	if (invalidated) {
+		hnat_cache_ebl(1);
+		mod_timer(&hnat_priv->hnat_sma_build_entry_timer,
+			  jiffies + 3 * HZ);
+	}
+	spin_unlock_bh(&hnat_priv->entry_lock);
+#endif /* defined(CONFIG_MEDIATEK_NETSYS_V3) */
+}
+EXPORT_SYMBOL(foe_clear_crypto_entry);
