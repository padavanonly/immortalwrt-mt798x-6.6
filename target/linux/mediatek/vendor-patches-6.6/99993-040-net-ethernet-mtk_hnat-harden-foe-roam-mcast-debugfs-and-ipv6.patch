 static void hnat_roaming_disable(void)
 {
-	if (_hnat_roam_sock)
-		sock_release(_hnat_roam_sock);
-	_hnat_roam_sock = NULL;
-	pr_info("hnat roaming work disable\n");
+	struct hnat_roam_ctx *ctx;
+
+	mutex_lock(&_hnat_roam_lock);
+	ctx = _hnat_roam;
+	if (!ctx) {
+		mutex_unlock(&_hnat_roam_lock);
+		pr_info("hnat roaming worker disable\n");
+		return;
+	}
+
+	atomic_set_release(&ctx->stop, 1);
+	wake_up_interruptible(sk_sleep(ctx->sock->sk));
+	wake_up_all(&ctx->stop_wait);
+	kthread_stop_put(ctx->task);
+	ctx->task = NULL;
+	if (atomic_read_acquire(&ctx->failed))
+		pr_warn("hnat roaming worker exited after error: %d\n", ctx->error);
+	_hnat_roam = NULL;
+	sock_release(ctx->sock);
+	kfree(ctx);
+	mutex_unlock(&_hnat_roam_lock);
+	pr_info("hnat roaming worker disable\n");
 }
 
