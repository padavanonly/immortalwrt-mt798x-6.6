+static int hnat_roam_wait_readable(struct hnat_roam_ctx *ctx)
+{
+	struct sock *sk = ctx->sock->sk;
+	int ret;
+
+	ret = wait_event_interruptible(*sk_sleep(sk),
+				       hnat_roam_stopping(ctx) ||
+				       !skb_queue_empty_lockless(&sk->sk_receive_queue));
+	return ret;
+}
+
+static int hnat_roam_wait_backoff(struct hnat_roam_ctx *ctx,
+				  unsigned int delay_ms)
+{
+	struct sock *sk = ctx->sock->sk;
+	long ret;
+
+	ret = wait_event_interruptible_timeout(*sk_sleep(sk),
+					       hnat_roam_stopping(ctx),
+					       msecs_to_jiffies(delay_ms));
+	return ret < 0 ? (int)ret : 0;
+}
+
+static int hnat_roam_thread(void *data)
+{
+	struct hnat_roam_ctx *ctx = data;
+	struct socket *sock = ctx->sock;
+	struct sock *sk = sock->sk;
+	u8 rcv_buf[512];
+	unsigned int batch;
+	int len, ret;
+
+	while (!hnat_roam_stopping(ctx)) {
+		for (batch = 0; batch < HNAT_ROAM_BATCH_MAX; batch++) {
+			struct kvec iov = {
+				.iov_base = rcv_buf,
+				.iov_len = sizeof(rcv_buf),
+			};
+			struct msghdr msg = {
+				.msg_namelen = sizeof(struct sockaddr_nl),
+			};
+
+			if (hnat_roam_stopping(ctx))
+				break;
+
+			len = kernel_recvmsg(sock, &msg, &iov, 1,
+					    iov.iov_len, MSG_DONTWAIT);
+			if (len > 0) {
+				if (hnat_roam_stopping(ctx))
+					break;
+				hnat_roam_process_msg(rcv_buf, len);
+				continue;
+			}
+
+			if (len == -EAGAIN) {
+				/* Back off if readability and queue state disagree. */
+				if (!skb_queue_empty_lockless(&sk->sk_receive_queue))
+					ret = hnat_roam_wait_backoff(ctx,
+							    HNAT_ROAM_QUEUE_RETRY_MS);
+				else
+					ret = hnat_roam_wait_readable(ctx);
+				if (ret && !hnat_roam_stopping(ctx))
+					return hnat_roam_fail(ctx, ret);
+				break;
+			}
+
+			if (len == -ENOBUFS) {
+				/* ENOBUFS may repeat with an empty queue; always back off. */
+				pr_warn_ratelimited("hnat roaming receive overflow\n");
+				ret = hnat_roam_wait_backoff(ctx,
+						    HNAT_ROAM_BACKOFF_MS);
+				if (ret && !hnat_roam_stopping(ctx))
+					return hnat_roam_fail(ctx, ret);
+				break;
+			}
+
+			if (len == 0) {
+				pr_warn_ratelimited("hnat roaming received empty message\n");
+				ret = hnat_roam_wait_backoff(ctx,
+						    HNAT_ROAM_BACKOFF_MS);
+				if (ret && !hnat_roam_stopping(ctx))
+					return hnat_roam_fail(ctx, ret);
+				break;
+			}
+
+			return hnat_roam_fail(ctx, len);
+		}
+
+		if (hnat_roam_stopping(ctx))
+			break;
+		if (batch == HNAT_ROAM_BATCH_MAX)
+			cond_resched();
+	}
+
+	return 0;
 }
 
