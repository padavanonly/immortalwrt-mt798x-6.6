index 0000000..dce7960
--- /dev/null
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_table_alloc.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __MTK_HNAT_TABLE_ALLOC_H
+#define __MTK_HNAT_TABLE_ALLOC_H
+
+#define MTK_HNAT_ALLOC_OK	0
+#define MTK_HNAT_ALLOC_RETRY	1
+#define MTK_HNAT_ALLOC_FAIL	(-1)
+
+struct mtk_hnat_table_alloc_ops {
+	int (*alloc)(void *context, unsigned int ppe_id,
+		     unsigned int entries, void **bundle);
+	void (*free)(void *context, unsigned int ppe_id, void *bundle,
+		     unsigned int entries);
+};
+
+/*
+ * alloc() publishes only a complete bundle on success. On failure, any
+ * partial allocations must be released by alloc() itself. The helper also
+ * releases a non-NULL published bundle from a failed callback defensively.
+ */
+/* Allocate every PPE at one common size; unwind a failed size before retry. */
+static inline int
+mtk_hnat_alloc_common_tables(void *context, unsigned int ppe_count,
+			     unsigned int table_slots,
+			     unsigned int initial_entries,
+			     int initial_cfg, int minimum_cfg,
+			     const struct mtk_hnat_table_alloc_ops *ops,
+			     void **bundles,
+			     unsigned int *actual_entries, int *actual_cfg)
+{
+	unsigned int entries = initial_entries;
+	unsigned int ppe_id;
+	int cfg;
+
+	if (!ppe_count || ppe_count > table_slots || !initial_entries ||
+	    !ops || !ops->alloc || !ops->free || !bundles ||
+	    !actual_entries || !actual_cfg || initial_cfg < minimum_cfg)
+		return -1;
+	*actual_entries = 0;
+	*actual_cfg = 0;
+
+	for (ppe_id = 0; ppe_id < ppe_count; ppe_id++)
+		bundles[ppe_id] = 0;
+
+	for (cfg = initial_cfg; cfg >= minimum_cfg; cfg--, entries /= 2) {
+		unsigned int allocated = 0;
+		int alloc_status = MTK_HNAT_ALLOC_RETRY;
+
+		while (allocated < ppe_count) {
+			bundles[allocated] = 0;
+			alloc_status = ops->alloc(context, allocated, entries,
+						  &bundles[allocated]);
+			if (alloc_status == MTK_HNAT_ALLOC_OK) {
+				if (bundles[allocated]) {
+					allocated++;
+					continue;
+				}
+				alloc_status = MTK_HNAT_ALLOC_FAIL;
+			}
+			if (bundles[allocated]) {
+				ops->free(context, allocated, bundles[allocated],
+					  entries);
+				bundles[allocated] = 0;
+			}
+			break;
+		}
+
+		if (allocated == ppe_count) {
+			*actual_entries = entries;
+			*actual_cfg = cfg;
+			return 0;
+		}
+
+		while (allocated) {
+			allocated--;
+			ops->free(context, allocated, bundles[allocated], entries);
+			bundles[allocated] = 0;
+		}
+		if (alloc_status != MTK_HNAT_ALLOC_RETRY &&
+		    alloc_status != MTK_HNAT_ALLOC_OK)
+			return -1;
+		if (cfg == minimum_cfg || entries < 2)
+			break;
+	}
+
+	return -1;
+}
+
+#endif /* __MTK_HNAT_TABLE_ALLOC_H */
