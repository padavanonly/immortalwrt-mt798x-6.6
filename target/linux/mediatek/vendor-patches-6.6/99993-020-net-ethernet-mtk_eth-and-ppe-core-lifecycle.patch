From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] net: ethernet: mtk: harden PPE deinit, WDMA RCU, SER
 boundary, and TX/RX init

Fix QDMA dump page indexing and partial RX ring unwind, complete PPE offload deinit, scope roaming teardown and WDMA RCU, and decouple SER/debugfs teardown from HNAT.
Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
 drivers/net/ethernet/mediatek/mtk_eth_dbg.c   | 51 ++++---------
 drivers/net/ethernet/mediatek/mtk_eth_dbg.h   |  1 +
 drivers/net/ethernet/mediatek/mtk_eth_reset.c | 23 +++---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c   | 75 ++++++++++++-------
 drivers/net/ethernet/mediatek/mtk_eth_soc.h   | 13 +++-
 drivers/net/ethernet/mediatek/mtk_ppe.c       | 15 ++--
 .../net/ethernet/mediatek/mtk_ppe_offload.c   | 26 ++++++-
 7 files changed, 123 insertions(+), 81 deletions(-)

diff --git a/drivers/net/ethernet/mediatek/mtk_eth_dbg.c b/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
index aadaae1..42f4ccb 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
@@ -23,6 +23,7 @@
 #include <linux/netdevice.h>
 #include <linux/ctype.h>
 #include <linux/debugfs.h>
+#include <linux/rcupdate.h>
 #include <linux/of_mdio.h>
 #include <linux/of_address.h>
 #include <net/dsa.h>
@@ -921,6 +922,7 @@ static const struct file_operations fops_tx_full_cnt = {
 void mtketh_debugfs_exit(struct mtk_eth *eth)
 {
 	debugfs_remove_recursive(eth_debug.root);
+	eth_debug.root = NULL;
 }
 
 int mtketh_debugfs_init(struct mtk_eth *eth)
@@ -2463,7 +2465,7 @@ static struct proc_dir_entry *proc_esw_cnt, *proc_mac_cnt, *proc_xfi_cnt,
 
 int debug_proc_init(struct mtk_eth *eth)
 {
-	g_eth = eth;
+	rcu_assign_pointer(g_eth, eth);
 
 	if (!proc_reg_dir)
 		proc_reg_dir = proc_mkdir(PROCREG_DIR, NULL);
@@ -2531,38 +2533,17 @@ int debug_proc_init(struct mtk_eth *eth)
 
 void debug_proc_exit(void)
 {
-	if (proc_tx_ring)
-		remove_proc_entry(PROCREG_TXRING, proc_reg_dir);
-
-	if (proc_hwtx_ring)
-		remove_proc_entry(PROCREG_HWTXRING, proc_reg_dir);
-
-	if (proc_rx_ring)
-		remove_proc_entry(PROCREG_RXRING, proc_reg_dir);
-
-	if (proc_esw_cnt)
-		remove_proc_entry(PROCREG_ESW_CNT, proc_reg_dir);
-
-	if (proc_mac_cnt)
-		remove_proc_entry(PROCREG_MAC_CNT, proc_reg_dir);
-
-	if (proc_xfi_cnt)
-		remove_proc_entry(PROCREG_XFI_CNT, proc_reg_dir);
-
-	if (proc_reg_dir)
-		remove_proc_entry(PROCREG_DIR, 0);
-
-	if (proc_dbg_regs)
-		remove_proc_entry(PROCREG_DBG_REGS, proc_reg_dir);
-
-	if (g_eth->hwlro) {
-		if (proc_hw_lro_stats)
-			remove_proc_entry(PROCREG_HW_LRO_STATS, proc_reg_dir);
-
-		if (proc_hw_lro_auto_tlb)
-			remove_proc_entry(PROCREG_HW_LRO_AUTO_TLB, proc_reg_dir);
-	}
-
-	if (proc_reset_event)
-		remove_proc_entry(PROCREG_RESET_EVENT, proc_reg_dir);
+	/* proc_remove() recursively unlinks and drains every child reader. */
+	proc_remove(proc_reg_dir);
+	proc_reg_dir = NULL;
+	proc_tx_ring = NULL;
+	proc_hwtx_ring = NULL;
+	proc_rx_ring = NULL;
+	proc_esw_cnt = NULL;
+	proc_mac_cnt = NULL;
+	proc_xfi_cnt = NULL;
+	proc_dbg_regs = NULL;
+	proc_hw_lro_stats = NULL;
+	proc_hw_lro_auto_tlb = NULL;
+	proc_reset_event = NULL;
 }
diff --git a/drivers/net/ethernet/mediatek/mtk_eth_dbg.h b/drivers/net/ethernet/mediatek/mtk_eth_dbg.h
index c662949..7608b52 100644
