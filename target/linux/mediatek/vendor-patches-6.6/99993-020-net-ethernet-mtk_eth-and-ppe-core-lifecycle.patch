+/* net_device::ieee80211_ptr is optional without cfg80211 headers. */
+static inline bool mtk_dev_is_wireless(const struct net_device *dev)
+{
+#if IS_ENABLED(CONFIG_CFG80211_HEADERS)
+	return dev && dev->ieee80211_ptr;
+#else
+	return false;
+#endif
+}
+
 static inline int
 mtk_ppe_check_pppq_path(struct mtk_mac *mac, struct net_device *idev, int dsa_port)
 {
-	bool wifi_rx = !!(idev->ieee80211_ptr);
+	bool wifi_rx = mtk_dev_is_wireless(idev);
 
 	if ((dsa_port >= 0 && dsa_port <= 4) ||
 	    (dsa_port == 5 && wifi_rx))
