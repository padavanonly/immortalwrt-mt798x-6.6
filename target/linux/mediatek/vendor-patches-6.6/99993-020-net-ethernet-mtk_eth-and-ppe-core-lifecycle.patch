+/* nf_conn::mark is optional when conntrack mark support is disabled. */
+static inline u32 mtk_flow_get_ct_mark(const struct nf_conn *ct)
+{
+#if IS_ENABLED(CONFIG_NF_CONNTRACK_MARK)
