 		if (!mtk_rx_get_desc(eth, &trxd, rxd))
 			break;
 
+		sent_ppd = 0;
+
 		/* find out which mac the packet come from. values start at 1 */
 		if (mtk_is_netsys_v3_or_greater(eth)) {
 			u32 val = RX_DMA_GET_SPORT_V2(trxd.rxd5);
@@ -2556,11 +2564,13 @@ static int mtk_poll_rx(struct napi_struct *napi, int budget,
 			mac = RX_DMA_GET_SPORT(trxd.rxd4) - 1;
 		}
 
-		if ( (mac == 4) || ((FIELD_GET(MTK_RXD5_PPE_CPU_REASON, trxd.rxd5)) == HIT_BIND_FORCE_TO_CPU)) 
-			{
+		if (mac == 4 ||
+		    (mtk_is_netsys_v3_or_greater(eth) &&
+		     FIELD_GET(MTK_RXD5_PPE_CPU_REASON, trxd.rxd5) ==
+		     MTK_PPE_CPU_REASON_HIT_BIND_FORCE_CPU)) {
 			sent_ppd = 1;
-			mac =0;
-			}
+			mac = 0;
+		}
 
 
 		if (unlikely(mac < 0 || mac >= MTK_MAX_DEVS ||
@@ -3186,6 +3196,7 @@ static int mtk_rx_alloc(struct mtk_eth *eth, int ring_no, int rx_flag)
 			     GFP_KERNEL);
 	if (!ring->data)
 		return -ENOMEM;
+	ring->dma_size = rx_dma_size;
 
 	if (mtk_page_pool_enabled(eth) && rcu_access_pointer(eth->prog))  {
 		struct page_pool *pp;
@@ -3270,7 +3281,6 @@ static int mtk_rx_alloc(struct mtk_eth *eth, int ring_no, int rx_flag)
 		}
 	}
 
-	ring->dma_size = rx_dma_size;
 	ring->calc_idx_update = false;
 	ring->calc_idx = rx_dma_size - 1;
 	if (rx_flag == MTK_RX_FLAGS_QDMA)
@@ -3307,26 +3317,29 @@ static int mtk_rx_alloc(struct mtk_eth *eth, int ring_no, int rx_flag)
 
 static void mtk_rx_clean(struct mtk_eth *eth, struct mtk_rx_ring *ring, bool in_sram)
 {
-	u64 addr64 = 0;
 	int i;
 
-	if (ring->data && ring->dma) {
-		for (i = 0; i < ring->dma_size; i++) {
-			struct mtk_rx_dma *rxd;
+	if (ring->data) {
+		if (ring->dma) {
+			for (i = 0; i < ring->dma_size; i++) {
+				struct mtk_rx_dma *rxd;
+				dma_addr_t dma_addr;
 
-			if (!ring->data[i])
-				continue;
+				if (!ring->data[i])
+					continue;
 
-			rxd = ring->dma + i * eth->soc->rx.desc_size;
-			if (!rxd->rxd1)
-				continue;
+				rxd = ring->dma + i * eth->soc->rx.desc_size;
 
-			if (MTK_HAS_CAPS(eth->soc->caps, MTK_36BIT_DMA))
-				addr64 = RX_DMA_GET_ADDR64(rxd->rxd2);
+				if (!ring->page_pool) {
+					dma_addr = (u64)rxd->rxd1;
+					if (MTK_HAS_CAPS(eth->soc->caps, MTK_36BIT_DMA))
+						dma_addr |= RX_DMA_GET_ADDR64(rxd->rxd2);
 
-			dma_unmap_single(eth->dma_dev, ((u64)rxd->rxd1 | addr64),
-					 ring->buf_size, DMA_FROM_DEVICE);
-			mtk_rx_put_buff(ring, ring->data[i], false);
+					dma_unmap_single(eth->dma_dev, dma_addr,
+							 ring->buf_size, DMA_FROM_DEVICE);
+				}
+				mtk_rx_put_buff(ring, ring->data[i], false);
+			}
 		}
 		kfree(ring->data);
 		ring->data = NULL;
@@ -4770,8 +4783,8 @@ static void mtk_hw_dump_all(struct mtk_eth *eth)
 	mtk_hw_dump_reg(eth, "FE", 0x1400, 0x300);
 	mtk_hw_dump_reg(eth, "ADMA", reg_map->pdma.rx_ptr, 0x300);
 	if (MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA)) {
-		for (id = 0; id < MTK_QDMA_NUM_QUEUES / 16; id++) {
-			mtk_w32(eth, (id / MTK_QTX_PER_PAGE), reg_map->qdma.page);
+		for (id = 0; id < MTK_QDMA_NUM_QUEUES / MTK_QTX_PER_PAGE; id++) {
+			mtk_w32(eth, id, reg_map->qdma.page);
 			pr_info("\nQDMA PAGE:%x ", mtk_r32(eth, reg_map->qdma.page));
 			mtk_hw_dump_reg(eth, "QDMA", reg_map->qdma.qtx_cfg, 0x100);
 			mtk_w32(eth, 0, reg_map->qdma.page);
@@ -5718,7 +5731,8 @@ static void mtk_pending_work(struct work_struct *work)
 			call_netdevice_notifiers(MTK_FE_RESET_DONE,
 						 eth->netdev[i]);
 
-			if (mtk_is_netsys_v3_or_greater(eth)) {
+			if (mtk_is_netsys_v3_or_greater(eth) &&
+			    mtk_wifi_num > 0) {
 				pr_info("waiting done ack from wifi\n");
 				rtnl_unlock();
 				wait_for_completion(&wait_ack_done);
@@ -5807,9 +5821,8 @@ static int mtk_cleanup(struct mtk_eth *eth)
 {
 	mtk_sgmii_destroy(eth);
 	mtk_unreg_dev(eth);
+	mtk_ppe_deinit(eth);
 	mtk_free_dev(eth);
