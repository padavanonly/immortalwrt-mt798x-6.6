 extern int _mtk_mdio_read_c45(struct mtk_eth *eth, u32 phy_addr,
 			      u32 devad, u32 phy_reg);
 
+extern struct mtk_eth *g_eth;
 int debug_proc_init(struct mtk_eth *eth);
