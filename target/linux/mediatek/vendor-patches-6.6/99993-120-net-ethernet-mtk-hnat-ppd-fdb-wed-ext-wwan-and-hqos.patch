+static bool hnat_ext_skb_needs_linearize(const struct sk_buff *skb)
+{
+	int i;
+
+	if (!skb_is_nonlinear(skb))
+		return false;
+
+	if (skb_has_frag_list(skb) || skb_headlen(skb) < 96)
+		return true;
+
+	for (i = 0; i < skb_shinfo(skb)->nr_frags; i++) {
+		if (skb_frag_size(&skb_shinfo(skb)->frags[i]) < 16)
+			return true;
+	}
+
+	return false;
+}
