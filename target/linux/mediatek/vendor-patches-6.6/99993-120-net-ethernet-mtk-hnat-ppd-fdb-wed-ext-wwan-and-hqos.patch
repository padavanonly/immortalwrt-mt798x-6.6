+static inline bool hnat_qos_is_wan_egress(const struct net_device *dev)
+{
+	return dev && (IS_WAN(dev) || IS_DSA_WAN(dev) ||
+		       (IS_EXT(dev) && !IS_WHNAT(dev)));
+}
+
+static inline bool hnat_qos_is_wan_ingress(const struct sk_buff *skb)
+{
+	return skb && (FROM_GE_WAN(skb) || FROM_GE_VIRTUAL(skb) || FROM_EXT(skb));
+}
+
+static inline bool hnat_qos_want_hqos(const struct net_device *dev,
+				      const struct sk_buff *skb, u32 qid)
+{
+	if (IS_PPPQ_MODE)
+		return IS_PPPQ_PATH(dev, skb) || qid >= MAX_PPPQ_PORT_NUM;
+	if (!IS_HQOS_MODE)
+		return false;
+	if (qid != 0)
+		return true;
+	return (IS_HQOS_UL_MODE && hnat_qos_is_wan_egress(dev)) ||
+	       (IS_HQOS_DL_MODE && IS_LAN_GRP(dev) && hnat_qos_is_wan_ingress(skb));
+}
+
+static bool hnat_qos_parse_l3(const struct sk_buff *skb,
+			      unsigned int *nh_off_out, __be16 *proto_out)
+{
+	unsigned int off;
+	__be16 proto;
+	int depth;
+
+	int nh_s;
+
+	if (!skb || skb->len < 1)
+		return false;
+
+	nh_s = skb_network_offset(skb);
+	if (nh_s >= 0 && (unsigned int)nh_s < skb->len &&
+	    (skb->protocol == htons(ETH_P_IP) ||
+	     skb->protocol == htons(ETH_P_IPV6))) {
+		*nh_off_out = (unsigned int)nh_s;
+		*proto_out = skb->protocol;
+		return true;
+	}
+
+	proto = hnat_skb_l3_proto(skb);
+	if (proto == htons(ETH_P_IP) || proto == htons(ETH_P_IPV6)) {
+		*nh_off_out = (nh_s >= 0 && (unsigned int)nh_s < skb->len) ?
+			      (unsigned int)nh_s : 0;
+		*proto_out = proto;
+		return true;
+	}
+
+	proto = skb->protocol;
+	off = 0;
+	for (depth = 0; depth < 3; depth++) {
+		if (eth_type_vlan(proto)) {
+			struct vlan_hdr _vh;
+			const struct vlan_hdr *vh =
+				skb_header_pointer(skb, off, sizeof(_vh), &_vh);
+			if (!vh)
+				return false;
+			proto = vh->h_vlan_encapsulated_proto;
+			off += sizeof(_vh);
+		} else if (proto == htons(ETH_P_PPP_SES)) {
+			__be16 _ppp_proto;
+			const __be16 *ppp_proto =
+				skb_header_pointer(skb, off + PPPOE_SES_HLEN - 2,
+						   sizeof(_ppp_proto), &_ppp_proto);
+			if (!ppp_proto)
+				return false;
+			off += PPPOE_SES_HLEN;
+			if (*ppp_proto == htons(PPP_IP))
+				proto = htons(ETH_P_IP);
+			else if (*ppp_proto == htons(PPP_IPV6))
+				proto = htons(ETH_P_IPV6);
+			else
+				return false;
+		} else {
+			break;
+		}
+	}
+
+	if (proto != htons(ETH_P_IP) && proto != htons(ETH_P_IPV6)) {
+		u8 ver = 0;
+
+		if (skb_copy_bits(skb, off, &ver, 1))
+			return false;
+		if ((ver >> 4) == 4)
+			proto = htons(ETH_P_IP);
+		else if ((ver >> 4) == 6)
+			proto = htons(ETH_P_IPV6);
+		else
+			return false;
+	}
+
+	*nh_off_out = off;
+	*proto_out = proto;
+	return true;
+}
+
+static bool hnat_sqm_is_prio_dscp(u8 tos)
+{
+	switch (tos >> 2) {
+	case 46: /* EF */
+	case 44: /* VA */
+	case 48: /* CS6 */
+	case 56: /* CS7 */
+	case 40: /* CS5 */
+	case 34: /* AF41 */
+	case 24: /* CS3 */
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool hnat_sqm_is_video_dscp(u8 tos)
+{
+	switch (tos >> 2) {
+	case 26: /* AF31 */
+	case 28: /* AF32 */
+	case 18: /* AF21 */
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool hnat_sqm_is_p2p_dscp(u8 tos)
+{
+	switch (tos >> 2) {
+	case 8: /* CS1 */
+	case 1: /* LE */
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool hnat_qos_match_video_sni(const u8 *buf, int len)
+{
+	static const char * const domains[] = {
+		"googlevideo", "youtube", "netflix", "nflxvideo",
+		"bilivideo", "bilibili", "akamaized", "ttvnw",
+		"tiktok", "douyin", "byteimg", "iqiyi"
+	};
+	int i, d, dlen;
+
+	for (d = 0; d < ARRAY_SIZE(domains); d++) {
+		dlen = strlen(domains[d]);
+		if (len < dlen)
+			continue;
+		for (i = 0; i <= len - dlen; i++) {
+			if (!memcmp(buf + i, domains[d], dlen))
+				return true;
+		}
+	}
+	return false;
+}
+
+static enum hnat_dpi_class hnat_dpi_inspect_l7_payload(
+	const struct sk_buff *skb, u8 l4_proto, unsigned int payload_off,
+	u16 payload_len, u16 sport_h, u16 dport_h, bool per_pkt,
+	bool tcp_ctrl_ack, u8 tos)
+{
+	u8 pbuf[192];
+	int probe_len;
+
+	if (hnat_sqm_is_prio_dscp(tos))
+		return HNAT_DPI_REALTIME;
+	if (hnat_sqm_is_p2p_dscp(tos))
+		return HNAT_DPI_P2P;
+
+	if (l4_proto == IPPROTO_TCP) {
+		if (per_pkt && tcp_ctrl_ack && READ_ONCE(qos_ack_prio))
+			return HNAT_DPI_REALTIME;
+		if (sport_h == 53 || dport_h == 53 ||
+		    sport_h == 22 || dport_h == 22)
+			return HNAT_DPI_REALTIME;
+		if (sport_h == 1935 || dport_h == 1935 ||
+		    sport_h == 554 || dport_h == 554)
+			return HNAT_DPI_VIDEO;
+		if ((sport_h >= 6881 && sport_h <= 6889) ||
+		    (dport_h >= 6881 && dport_h <= 6889) ||
+		    sport_h == 51413 || dport_h == 51413 ||
+		    sport_h == 4662 || dport_h == 4662)
+			return HNAT_DPI_P2P;
+
+		probe_len = min_t(int, payload_len, (int)sizeof(pbuf));
+		if (qos_dpi_toggle && probe_len >= 4) {
+			const u8 *p = skb_header_pointer(skb, payload_off,
+							 probe_len, pbuf);
+			if (p) {
+				if (!memcmp(p, "SSH-", 4))
+					return HNAT_DPI_REALTIME;
+				if (!memcmp(p, "\x13" "Bit", 4))
+					return HNAT_DPI_P2P;
+				if ((sport_h == 4662 || dport_h == 4662) &&
+				    (p[0] == 0xe3 || p[0] == 0xc5))
+					return HNAT_DPI_P2P;
+				if ((dport_h == 443 || sport_h == 443) &&
+				    probe_len > 43 && p[0] == 0x16 &&
+				    p[1] == 0x03 && p[5] == 0x01 &&
+				    hnat_qos_match_video_sni(p, probe_len))
+					return HNAT_DPI_VIDEO;
+			}
+		}
+	} else if (l4_proto == IPPROTO_UDP) {
+		if (sport_h == 53 || dport_h == 53 ||
+		    sport_h == 123 || dport_h == 123 ||
+		    sport_h == 67 || dport_h == 67 ||
+		    sport_h == 68 || dport_h == 68 ||
+		    sport_h == 3478 || dport_h == 3478 ||
+		    sport_h == 19302 || dport_h == 19302 ||
+		    sport_h == 51820 || dport_h == 51820 ||
+		    sport_h == 9993 || dport_h == 9993)
+			return HNAT_DPI_REALTIME;
+
+		if (payload_len <= 300 &&
+		    ((sport_h >= 27015 && sport_h <= 27050) ||
+		     (dport_h >= 27015 && dport_h <= 27050) ||
+		     sport_h == 3074 || dport_h == 3074 ||
+		     (sport_h >= 5000 && sport_h <= 5500) ||
+		     (dport_h >= 5000 && dport_h <= 5500) ||
+		     (sport_h >= 7000 && sport_h <= 8000) ||
+		     (dport_h >= 7000 && dport_h <= 8000)))
+			return HNAT_DPI_REALTIME;
+
+		if ((sport_h >= 6881 && sport_h <= 6889) ||
+		    (dport_h >= 6881 && dport_h <= 6889) ||
+		    sport_h == 51413 || dport_h == 51413 ||
+		    sport_h == 4672 || dport_h == 4672)
+			return HNAT_DPI_P2P;
+
+		probe_len = min_t(int, payload_len, 48);
+		if (qos_dpi_toggle && probe_len >= 4) {
+			const u8 *p = skb_header_pointer(skb, payload_off,
+							 probe_len, pbuf);
+			if (p) {
+				if (probe_len >= 8 && p[4] == 0x21 &&
+				    p[5] == 0x12 && p[6] == 0xa4 &&
+				    p[7] == 0x42)
+					return HNAT_DPI_REALTIME;
+				if (!memcmp(p, "d1:a", 4) ||
+				    !memcmp(p, "d1:r", 4) ||
+				    !memcmp(p, "d1:q", 4))
+					return HNAT_DPI_P2P;
+				if ((sport_h == 443 || dport_h == 443 ||
+				     sport_h == 8443 || dport_h == 8443) &&
+				    payload_len >= 40 && (p[0] & 0x40))
+					return HNAT_DPI_VIDEO;
+			}
+		}
+	}
+
+	if (hnat_sqm_is_video_dscp(tos))
+		return HNAT_DPI_VIDEO;
+
+	return HNAT_DPI_FAIR;
+}
+
+static void hnat_dpi_ct_key(const struct nf_conn *ct, u64 *sig_out, u32 *idx_out)
+{
+	const struct nf_conntrack_tuple *t =
+		&ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple;
+	u32 words[11];
+	u32 h1, h2;
+
+	memset(words, 0, sizeof(words));
+	words[0] = ((u32)t->src.l3num << 16) | t->dst.protonum;
+	memcpy(&words[1], &t->src.u3, sizeof(t->src.u3));
+	memcpy(&words[5], &t->dst.u3, sizeof(t->dst.u3));
+	words[9] = ((u32)(__force u16)t->src.u.all << 16) |
+		   (__force u16)t->dst.u.all;
+	words[10] = 0x51a0c0deU;
+
+	h1 = jhash2(words, ARRAY_SIZE(words), 0x1f2e3d4cU);
+	h2 = jhash2(words, ARRAY_SIZE(words), 0xa5b6c7d8U);
+	*idx_out = h1 & (HNAT_DPI_CACHE_SIZE - 1);
+	*sig_out = (((u64)h1 << 32) | h2) & HNAT_CACHE_SIG_MASK;
+}
+
+static void hnat_wire_tuple_key(__be16 l3_proto, const __be32 *saddr,
+				const __be32 *daddr, __be16 sport, __be16 dport,
+				u8 l4_proto, bool canonical, u32 table_size,
+				u64 *sig_out, u32 *idx_out)
+{
+	u32 words[10];
+	u32 h1, h2;
+	int n = (l3_proto == htons(ETH_P_IPV6)) ? 4 : 1;
+
+	memset(words, 0, sizeof(words));
+	if (canonical) {
+		int cmp = memcmp(saddr, daddr, n * sizeof(u32));
+
+		if (cmp > 0 || (cmp == 0 && ((__force u16)sport > (__force u16)dport))) {
+			memcpy(&words[0], daddr, n * sizeof(u32));
+			memcpy(&words[4], saddr, n * sizeof(u32));
+			words[8] = ((u32)(__force u16)dport << 16) |
+				   (__force u16)sport;
+		} else {
+			memcpy(&words[0], saddr, n * sizeof(u32));
+			memcpy(&words[4], daddr, n * sizeof(u32));
+			words[8] = ((u32)(__force u16)sport << 16) |
+				   (__force u16)dport;
+		}
+	} else {
+		memcpy(&words[0], saddr, n * sizeof(u32));
+		memcpy(&words[4], daddr, n * sizeof(u32));
+		words[8] = ((u32)(__force u16)sport << 16) |
+			   (__force u16)dport;
+	}
+	words[9] = ((u32)(__force u16)l3_proto << 8) | l4_proto;
+
+	h1 = jhash2(words, ARRAY_SIZE(words), 0x9e3779b9U);
+	h2 = jhash2(words, ARRAY_SIZE(words), 0x7f4a7c15U);
+	*idx_out = h1 & (table_size - 1);
+	*sig_out = (((u64)h1 << 32) | h2) & HNAT_CACHE_SIG_MASK;
+}
+
+static bool hnat_dpi_cache_lookup(const struct nf_conn *ct, __be16 l3_proto,
+				  const __be32 *saddr, const __be32 *daddr,
+				  __be16 sport, __be16 dport, u8 l4_proto,
+				  enum hnat_dpi_class *cls_out)
+{
+	u64 sig, val;
+	u32 idx;
+
+	if (ct)
+		hnat_dpi_ct_key(ct, &sig, &idx);
+	else
+		hnat_wire_tuple_key(l3_proto, saddr, daddr, sport, dport,
+				    l4_proto, true, HNAT_DPI_CACHE_SIZE,
+				    &sig, &idx);
+
+	val = (u64)atomic64_read(&hnat_dpi_flow_cache[idx]);
+	if ((val & HNAT_CACHE_SIG_MASK) == sig && (val & 0x4ULL)) {
+		*cls_out = (enum hnat_dpi_class)(val & 0x3ULL);
+		return true;
+	}
+	return false;
+}
+
+static void hnat_dpi_cache_store(const struct nf_conn *ct, __be16 l3_proto,
+				 const __be32 *saddr, const __be32 *daddr,
+				 __be16 sport, __be16 dport, u8 l4_proto,
+				 enum hnat_dpi_class cls)
+{
+	u64 sig;
+	u32 idx;
+
+	if (cls == HNAT_DPI_FAIR)
+		return;
+
+	if (ct)
+		hnat_dpi_ct_key(ct, &sig, &idx);
+	else
+		hnat_wire_tuple_key(l3_proto, saddr, daddr, sport, dport,
+				    l4_proto, true, HNAT_DPI_CACHE_SIZE,
+				    &sig, &idx);
+
+	atomic64_set(&hnat_dpi_flow_cache[idx], sig | 0x4ULL | ((u64)cls & 0x3ULL));
+}
+
+static bool hnat_qos_extract_5tuple(const struct sk_buff *skb,
+				    unsigned int nh_off, __be16 proto,
+				    u8 *l4_proto_out, __be32 *saddr_buf,
+				    __be32 *daddr_buf, __be16 *sport_out,
+				    __be16 *dport_out, unsigned int *pay_off_out,
+				    u16 *pay_len_out, bool *tcp_ctrl_out,
+				    u8 *tos_out)
+{
+	struct iphdr _iph;
+	const struct iphdr *iph;
+	struct ipv6hdr _ip6h;
+	const struct ipv6hdr *ip6h;
+	unsigned int th_off;
+	u8 l4_proto;
+	u16 tot_len;
+
+	memset(saddr_buf, 0, sizeof(u32) * 4);
+	memset(daddr_buf, 0, sizeof(u32) * 4);
+	*sport_out = 0;
+	*dport_out = 0;
+	*pay_off_out = 0;
+	*pay_len_out = 0;
+	*tcp_ctrl_out = false;
+	*tos_out = 0;
+
+	if (proto == htons(ETH_P_IP)) {
+		unsigned int ip_hlen;
+
+		iph = skb_header_pointer(skb, nh_off, sizeof(_iph), &_iph);
+		if (!iph || iph->ihl < 5)
+			return false;
+		ip_hlen = iph->ihl * 4U;
+		tot_len = ntohs(iph->tot_len);
+		if (tot_len < ip_hlen)
+			return false;
+		l4_proto = iph->protocol;
+		*tos_out = iph->tos;
+		th_off = nh_off + ip_hlen;
+		saddr_buf[0] = iph->saddr;
+		daddr_buf[0] = iph->daddr;
+		tot_len -= ip_hlen;
+	} else if (proto == htons(ETH_P_IPV6)) {
+		ip6h = skb_header_pointer(skb, nh_off, sizeof(_ip6h), &_ip6h);
+		if (!ip6h)
+			return false;
+		l4_proto = ip6h->nexthdr;
+		*tos_out = (u8)((ip6h->priority << 4) | (ip6h->flow_lbl[0] >> 4));
+		tot_len = ntohs(ip6h->payload_len);
+		th_off = nh_off + sizeof(*ip6h);
+		memcpy(saddr_buf, &ip6h->saddr, sizeof(ip6h->saddr));
+		memcpy(daddr_buf, &ip6h->daddr, sizeof(ip6h->daddr));
+	} else {
+		return false;
+	}
+
+	*l4_proto_out = l4_proto;
+	if (l4_proto == IPPROTO_TCP) {
+		struct tcphdr _th;
+		const struct tcphdr *th =
+			skb_header_pointer(skb, th_off, sizeof(_th), &_th);
+		if (th) {
+			unsigned int tcp_hlen =
+				th->doff >= 5 ? th->doff * 4U : sizeof(_th);
+			*sport_out = th->source;
+			*dport_out = th->dest;
+			*pay_off_out = th_off + tcp_hlen;
+			*pay_len_out = tot_len > tcp_hlen ? tot_len - tcp_hlen : 0;
+			*tcp_ctrl_out = (*pay_len_out == 0 || th->syn ||
+					 th->fin || th->rst);
+		}
+	} else if (l4_proto == IPPROTO_UDP) {
+		struct udphdr _uh;
+		const struct udphdr *uh =
+			skb_header_pointer(skb, th_off, sizeof(_uh), &_uh);
+		if (uh) {
+			*sport_out = uh->source;
+			*dport_out = uh->dest;
+			*pay_off_out = th_off + sizeof(_uh);
+			*pay_len_out = tot_len > sizeof(_uh) ? tot_len - sizeof(_uh) : 0;
+		}
+	}
+	return true;
+}
+
+static void hnat_dpi_observe_skb(const struct sk_buff *skb)
+{
+	unsigned int nh_off = 0, pay_off = 0;
+	__be16 proto = 0, sport = 0, dport = 0;
+	__be32 saddr[4], daddr[4];
+	enum hnat_dpi_class cls;
+	enum ip_conntrack_info ctinfo;
+	const struct nf_conn *ct;
+	u8 l4_proto = 0, tos = 0;
+	u16 pay_len = 0;
+	bool tcp_ctrl = false;
+
+	if (!skb || !sqm_toggle || !qos_dpi_toggle)
+		return;
+	if (!hnat_qos_parse_l3(skb, &nh_off, &proto))
+		return;
+	if (!hnat_qos_extract_5tuple(skb, nh_off, proto, &l4_proto, saddr, daddr,
+				     &sport, &dport, &pay_off, &pay_len,
+				     &tcp_ctrl, &tos))
+		return;
+
+	ct = nf_ct_get(skb, &ctinfo);
+	cls = hnat_dpi_inspect_l7_payload(skb, l4_proto, pay_off, pay_len,
+					  ntohs(sport), ntohs(dport), false,
+					  tcp_ctrl, tos);
+	if (cls != HNAT_DPI_FAIR)
+		hnat_dpi_cache_store(ct, proto, saddr, daddr, sport, dport,
+				     l4_proto, cls);
+}
+
+static u32 hnat_qos_classify_skb(const struct sk_buff *skb,
+				 bool is_dl, bool per_pkt, u32 fallback_hash)
+{
+	u32 base = is_dl ? 48 : 16;
+	unsigned int nh_off = 0, pay_off = 0;
+	__be16 proto = 0, sport = 0, dport = 0;
+	__be32 saddr[4], daddr[4];
+	enum hnat_dpi_class cls = HNAT_DPI_FAIR;
+	enum ip_conntrack_info ctinfo;
+	const struct nf_conn *ct;
+	u8 l4_proto = 0, tos = 0;
+	u16 pay_len = 0;
+	bool tcp_ctrl = false;
+	u32 hkey1, hkey2, hkey3, hash;
+
+	if (!skb || !hnat_qos_parse_l3(skb, &nh_off, &proto) ||
+	    !hnat_qos_extract_5tuple(skb, nh_off, proto, &l4_proto, saddr, daddr,
+				     &sport, &dport, &pay_off, &pay_len,
+				     &tcp_ctrl, &tos)) {
+		atomic64_inc(&hnat_qos_fair_pkts);
+		return base + 1 + (fallback_hash % 13);
+	}
+
+	ct = nf_ct_get(skb, &ctinfo);
+	cls = hnat_dpi_inspect_l7_payload(skb, l4_proto, pay_off, pay_len,
+					  ntohs(sport), ntohs(dport), per_pkt,
+					  tcp_ctrl, tos);
+	if (cls == HNAT_DPI_FAIR && qos_dpi_toggle) {
+		enum hnat_dpi_class cached = HNAT_DPI_FAIR;
+
+		if (hnat_dpi_cache_lookup(ct, proto, saddr, daddr, sport,
+					  dport, l4_proto, &cached))
+			cls = cached;
+	} else if (cls != HNAT_DPI_FAIR && !per_pkt && qos_dpi_toggle) {
+		hnat_dpi_cache_store(ct, proto, saddr, daddr, sport, dport,
+				     l4_proto, cls);
+	}
+
+	switch (cls) {
+	case HNAT_DPI_REALTIME:
+		atomic64_inc(&hnat_qos_rt_pkts);
+		return base;
+	case HNAT_DPI_VIDEO:
+		atomic64_inc(&hnat_qos_video_pkts);
+		return base + 14;
+	case HNAT_DPI_P2P:
+		atomic64_inc(&hnat_qos_p2p_pkts);
+		return base + 15;
+	default:
+		atomic64_inc(&hnat_qos_fair_pkts);
+		if (proto == htons(ETH_P_IPV6)) {
+			hkey1 = (__force u32)(saddr[0] ^ saddr[3]);
+			hkey2 = (__force u32)(daddr[0] ^ daddr[3]);
+		} else {
+			hkey1 = (__force u32)saddr[0];
+			hkey2 = (__force u32)daddr[0];
+		}
+		hkey3 = ((__force u32)sport << 16) | (__force u32)dport;
+		hash = jhash_3words(hkey1, hkey2, hkey3, l4_proto);
+		return base + 1 + (hash % 13);
+	}
+}
+
+static u32 hnat_ext_dl_qid_lookup_skb(const struct sk_buff *skb)
+{
+	unsigned int nh_off = 0, pay_off = 0;
+	__be16 proto = 0, sport = 0, dport = 0;
+	__be32 saddr[4], daddr[4];
+	u8 l4_proto = 0, tos = 0;
+	u16 pay_len = 0;
+	bool tcp_ctrl = false;
+	u64 sig, val;
+	u32 idx;
+
+	if (!skb || !hnat_qos_parse_l3(skb, &nh_off, &proto))
+		return 0;
+	if (!hnat_qos_extract_5tuple(skb, nh_off, proto, &l4_proto, saddr, daddr,
+				     &sport, &dport, &pay_off, &pay_len,
+				     &tcp_ctrl, &tos))
+		return 0;
+
+	hnat_wire_tuple_key(proto, saddr, daddr, sport, dport, l4_proto,
+			    false, HNAT_EXT_DL_CACHE_SIZE, &sig, &idx);
+	val = (u64)atomic64_read(&hnat_ext_dl_qid_cache[idx]);
+	if ((val & HNAT_CACHE_SIG_MASK) == sig && (val & 0x80ULL))
+		return (u32)(val & 0x7fULL);
+	return 0;
+}
+
+static void hnat_ext_dl_qid_record_entry(const struct foe_entry *entry, u32 qid)
+{
+	__be32 saddr[4], daddr[4];
+	__be16 l3_proto, sport, dport;
+	u8 l4_proto;
+	u64 sig;
+	u32 idx;
+
+	if (!entry || qid < 33 || qid > 63)
+		return;
+
+	memset(saddr, 0, sizeof(saddr));
+	memset(daddr, 0, sizeof(daddr));
+	l4_proto = entry->bfib1.udp ? IPPROTO_UDP : IPPROTO_TCP;
+
+	if (IS_IPV4_GRP(entry)) {
+		l3_proto = htons(ETH_P_IP);
+		saddr[0] = htonl(entry->ipv4_hnapt.sip);
+		daddr[0] = htonl(entry->ipv4_hnapt.dip);
+		sport = htons(entry->ipv4_hnapt.sport);
+		dport = htons(entry->ipv4_hnapt.dport);
+	} else if (IS_IPV6_5T_ROUTE(entry) || IS_IPV6_HNAPT(entry) ||
+		   IS_IPV6_HNAT(entry)) {
+		l3_proto = htons(ETH_P_IPV6);
+		saddr[0] = htonl(entry->ipv6_5t_route.ipv6_sip0);
+		saddr[1] = htonl(entry->ipv6_5t_route.ipv6_sip1);
+		saddr[2] = htonl(entry->ipv6_5t_route.ipv6_sip2);
+		saddr[3] = htonl(entry->ipv6_5t_route.ipv6_sip3);
+		daddr[0] = htonl(entry->ipv6_5t_route.ipv6_dip0);
+		daddr[1] = htonl(entry->ipv6_5t_route.ipv6_dip1);
+		daddr[2] = htonl(entry->ipv6_5t_route.ipv6_dip2);
+		daddr[3] = htonl(entry->ipv6_5t_route.ipv6_dip3);
+		sport = htons(entry->ipv6_5t_route.sport);
+		dport = htons(entry->ipv6_5t_route.dport);
+	} else {
+		return;
+	}
+
+	hnat_wire_tuple_key(l3_proto, saddr, daddr, sport, dport, l4_proto,
+			    false, HNAT_EXT_DL_CACHE_SIZE, &sig, &idx);
+	atomic64_set(&hnat_ext_dl_qid_cache[idx],
+		     sig | 0x80ULL | ((u64)qid & 0x7fULL));
+}
