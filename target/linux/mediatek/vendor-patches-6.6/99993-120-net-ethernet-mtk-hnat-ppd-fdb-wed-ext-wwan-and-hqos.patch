+static bool hnat_foe_is_hqos_ext_entry(const struct foe_entry *entry)
+{
+	union {
+		struct hnat_bind_info_blk bfib1;
+		u32 raw;
+	} blk1;
+	u8 tport_id;
+
+	blk1.raw = READ_ONCE(entry->ipv4_hnapt.info_blk1);
+	if (blk1.bfib1.state != BIND)
+		return false;
+
+	switch ((int)blk1.bfib1.pkt_type) {
+	case IPV4_HNAPT:
+	case IPV4_HNAT:
+		return entry->ipv4_hnapt.iblk2.dp == NR_PDMA_PORT &&
+		       entry->ipv4_hnapt.iblk2.fqos &&
+		       entry->ipv4_hnapt.tport_id == 1 &&
+		       (entry->ipv4_hnapt.act_dp & UDF_PINGPONG_IFIDX);
+	case IPV4_DSLITE:
+		tport_id = entry->ipv4_dslite.tport_id;
+		break;
+	case IPV4_MAP_E:
+	case IPV4_MAP_T:
+		tport_id = entry->ipv4_mape.tport_id;
+		break;
+	case IPV6_3T_ROUTE:
+		tport_id = entry->ipv6_3t_route.tport_id;
+		break;
+	case IPV6_5T_ROUTE:
+		tport_id = entry->ipv6_5t_route.tport_id;
+		break;
+	case IPV6_6RD:
+		tport_id = entry->ipv6_6rd.tport_id;
+		break;
+	case IPV6_HNAPT:
+	case IPV6_HNAT:
+		tport_id = entry->ipv6_hnapt.tport_id;
+		break;
+	default:
+		return false;
+	}
+
+	return entry->ipv6_5t_route.iblk2.dp == NR_PDMA_PORT &&
+	       entry->ipv6_5t_route.iblk2.fqos &&
+	       tport_id == 1 &&
+	       (entry->ipv6_5t_route.act_dp & UDF_PINGPONG_IFIDX);
+}
+
+static bool hnat_foe_extract_l2_macs(const struct foe_entry *entry,
+				     u8 dmac[ETH_ALEN], u8 smac[ETH_ALEN])
+{
+	switch ((int)entry->bfib1.pkt_type) {
+	case IPV4_HNAPT:
+	case IPV4_HNAT:
+		foe_dmac_to_bytes(dmac, entry->ipv4_hnapt.dmac_hi,
+				  entry->ipv4_hnapt.dmac_lo);
+		foe_dmac_to_bytes(smac, entry->ipv4_hnapt.smac_hi,
+				  entry->ipv4_hnapt.smac_lo);
+		return true;
+	case IPV4_DSLITE:
+	case IPV4_MAP_E:
+	case IPV4_MAP_T:
+	case IPV6_3T_ROUTE:
+	case IPV6_5T_ROUTE:
+	case IPV6_6RD:
+	case IPV6_HNAPT:
+	case IPV6_HNAT:
+		foe_dmac_to_bytes(dmac, entry->ipv6_5t_route.dmac_hi,
+				  entry->ipv6_5t_route.dmac_lo);
+		foe_dmac_to_bytes(smac, entry->ipv6_5t_route.smac_hi,
+				  entry->ipv6_5t_route.smac_lo);
+		return true;
+	default:
+		return false;
+	}
+}
