+static u32 hnat_sport_to_ppe(const struct mtk_hnat *h, u32 sport)
+{
+	if (sport == NR_GMAC3_PORT && h->ppe_num >= 3)
+		return 2;
+	if (sport == NR_GMAC2_PORT && h->ppe_num >= 2)
+		return 1;
