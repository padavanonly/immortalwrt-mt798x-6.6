+			foe_sip[1] = entry->ipv6_hnapt.new_ipv6_ip1;
+			foe_sip[2] = entry->ipv6_hnapt.new_ipv6_ip2;
+			foe_sip[3] = entry->ipv6_hnapt.new_ipv6_ip3;
+		} else {
+			foe_sip[0] = entry->ipv6_hnapt.ipv6_sip0;
+			foe_sip[1] = entry->ipv6_hnapt.ipv6_sip1;
+			foe_sip[2] = entry->ipv6_hnapt.ipv6_sip2;
+			foe_sip[3] = entry->ipv6_hnapt.ipv6_sip3;
+		}
+		break;
+	default:
+		return false;
+	}
+
+	return foe_sip[0] == be32_to_cpu(sip->s6_addr32[0]) &&
+	       foe_sip[1] == be32_to_cpu(sip->s6_addr32[1]) &&
+	       foe_sip[2] == be32_to_cpu(sip->s6_addr32[2]) &&
+	       foe_sip[3] == be32_to_cpu(sip->s6_addr32[3]);
+}
+
+static const struct foe_entry *hnat_lookup_hqos_ext_entry(u32 entry_idx,
+							  u32 sport)
+{
+	struct mtk_hnat *h = READ_ONCE(hnat_priv);
+	struct foe_entry *table;
+	u32 ppe_id;
+
+	if (!h || !READ_ONCE(h->fe_base) || !READ_ONCE(hook_toggle) ||
+	    !h->data || h->data->version != MTK_HNAT_V3)
+		return NULL;
+
+	if (entry_idx == 0x7fff || entry_idx >= READ_ONCE(h->foe_etry_num))
+		return NULL;
+
+	ppe_id = hnat_sport_to_ppe(h, sport);
+	if (ppe_id >= h->ppe_num || ppe_id >= MAX_PPE_NUM)
+		return NULL;
+
+	table = READ_ONCE(h->foe_table_cpu[ppe_id]);
+	if (!table)
+		return NULL;
+
+	return &table[entry_idx];
+}
+
+bool mtk_hnat_hqos_ext_rx_match_rxd(u32 rxd5)
+{
+	const struct foe_entry *entry;
+
+	entry = hnat_lookup_hqos_ext_entry(rxd5 & MTK_RXD5_FOE_ENTRY,
+					   FIELD_GET(MTK_RXD5_SRC_PORT, rxd5));
+	return entry && hnat_foe_is_hqos_ext_entry(entry);
+}
+
+bool mtk_hnat_hqos_ext_rx_match_skb(struct sk_buff *skb)
+{
+	const struct foe_entry *entry;
+	const struct ethhdr *eth;
+	const u8 *l3;
+	unsigned int l3_len;
+	__be16 proto;
+	u8 dmac[ETH_ALEN];
+	u8 smac[ETH_ALEN];
+	int pkt_type;
+
+	if (!skb || !skb_mac_header_was_set(skb))
+		return false;
+
+	entry = hnat_lookup_hqos_ext_entry(skb_hnat_entry(skb),
+					   skb_hnat_sport(skb));
+	if (!entry || !hnat_foe_is_hqos_ext_entry(entry))
+		return false;
+
+	dma_rmb();
+
+	eth = eth_hdr(skb);
+	if (!hnat_foe_extract_l2_macs(entry, dmac, smac) ||
+	    !ether_addr_equal(eth->h_dest, dmac) ||
+	    !ether_addr_equal(eth->h_source, smac))
+		return false;
+
+	l3 = skb->data;
+	l3_len = skb_headlen(skb);
+	proto = eth->h_proto;
+
+	if (entry->bfib1.vlan_layer == 1 && eth_type_vlan(proto)) {
+		const struct vlan_hdr *vh;
+
+		if (l3_len < VLAN_HLEN)
+			return false;
+		vh = (const struct vlan_hdr *)l3;
+		proto = vh->h_vlan_encapsulated_proto;
+		l3 += VLAN_HLEN;
+		l3_len -= VLAN_HLEN;
+	}
+
+	pkt_type = (int)entry->bfib1.pkt_type;
+	switch (pkt_type) {
+	case IPV4_HNAPT:
+	case IPV4_HNAT: {
+		const struct iphdr *iph = (const struct iphdr *)l3;
+
+		if (proto != htons(ETH_P_IP) || l3_len < sizeof(*iph) ||
+		    iph->version != 4)
+			return false;
+		if (iph->saddr != htonl(entry->ipv4_hnapt.new_sip) ||
+		    iph->daddr != htonl(entry->ipv4_hnapt.new_dip))
+			return false;
+		break;
+	}
+	case IPV6_3T_ROUTE:
+	case IPV6_5T_ROUTE:
+	case IPV6_HNAPT:
+	case IPV6_HNAT: {
+		const struct ipv6hdr *ip6h = (const struct ipv6hdr *)l3;
+
+		if (proto != htons(ETH_P_IPV6) || l3_len < sizeof(*ip6h) ||
+		    ip6h->version != 6)
+			return false;
+		if (!foe_ipv6_dip_eq(entry, &ip6h->daddr) ||
+		    !hnat_foe_ipv6_sip_eq(entry, &ip6h->saddr))
+			return false;
+		break;
+	}
+	case IPV4_DSLITE:
+	case IPV4_MAP_E:
+	case IPV4_MAP_T:
+	case IPV6_6RD:
+		if (proto != htons(ETH_P_IP) && proto != htons(ETH_P_IPV6))
+			return false;
+		break;
+	default:
+		return false;
+	}
+
+	dma_rmb();
+	return hnat_foe_is_hqos_ext_entry(entry);
+}
+#endif
