+/* The Ethernet driver and Vendor HNAT map the same FE QDMA window. */
+extern spinlock_t mtk_qdma_window_lock;
+
+struct mtk_qdma_page {
+	unsigned long flags;
+	u32 prev;
+};
+
+static inline void mtk_qdma_select_page(struct mtk_qdma_page *page,
+					void __iomem *reg, u32 index)
+{
+	spin_lock_irqsave(&mtk_qdma_window_lock, page->flags);
+	page->prev = readl(reg);
+	writel((page->prev & ~GENMASK(3, 0)) |
+	       FIELD_PREP(GENMASK(3, 0), index), reg);
+}
+
+static inline void mtk_qdma_restore_page(struct mtk_qdma_page *page,
+					 void __iomem *reg)
+{
+	writel(page->prev, reg);
+	/* Complete the register writes before a different CPU selects a page. */
+	readl(reg);
+	spin_unlock_irqrestore(&mtk_qdma_window_lock, page->flags);
+}
