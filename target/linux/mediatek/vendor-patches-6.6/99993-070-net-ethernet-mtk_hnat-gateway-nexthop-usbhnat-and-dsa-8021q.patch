+static inline void hnat_assign_held_dev(struct net_device **slot,
+					struct net_device *new_dev)
+{
+	struct net_device *old_dev;
+
+	if (!slot)
+		return;
+	if (READ_ONCE(*slot) == new_dev)
+		return;
+	if (new_dev)
+		dev_hold(new_dev);
+	old_dev = xchg(slot, new_dev);
+	if (old_dev)
+		dev_put(old_dev);
+}
 
