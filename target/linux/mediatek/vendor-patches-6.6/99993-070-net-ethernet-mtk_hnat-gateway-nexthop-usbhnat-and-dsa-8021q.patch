+{
+	switch ((int)entry->bfib1.pkt_type) {
+	case IPV4_HNAPT:
+	case IPV4_HNAT:
+		foe_dmac_to_bytes(mac, entry->ipv4_hnapt.dmac_hi,
+				  entry->ipv4_hnapt.dmac_lo);
+		return true;
+	case IPV6_3T_ROUTE:
+		foe_dmac_to_bytes(mac, entry->ipv6_3t_route.dmac_hi,
+				  entry->ipv6_3t_route.dmac_lo);
+		return true;
+	case IPV6_5T_ROUTE:
+		foe_dmac_to_bytes(mac, entry->ipv6_5t_route.dmac_hi,
+				  entry->ipv6_5t_route.dmac_lo);
+		return true;
+	case IPV6_HNAPT:
+	case IPV6_HNAT:
+		foe_dmac_to_bytes(mac, entry->ipv6_hnapt.dmac_hi,
+				  entry->ipv6_hnapt.dmac_lo);
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool foe_extract_dip_v6(const struct foe_entry *entry, u32 dip[4])
+{
+	switch ((int)entry->bfib1.pkt_type) {
+	case IPV6_3T_ROUTE:
+		dip[0] = entry->ipv6_3t_route.ipv6_dip0;
+		dip[1] = entry->ipv6_3t_route.ipv6_dip1;
+		dip[2] = entry->ipv6_3t_route.ipv6_dip2;
+		dip[3] = entry->ipv6_3t_route.ipv6_dip3;
+		return true;
+	case IPV6_5T_ROUTE:
+		dip[0] = entry->ipv6_5t_route.ipv6_dip0;
+		dip[1] = entry->ipv6_5t_route.ipv6_dip1;
+		dip[2] = entry->ipv6_5t_route.ipv6_dip2;
+		dip[3] = entry->ipv6_5t_route.ipv6_dip3;
+		return true;
+	case IPV6_HNAPT:
+	case IPV6_HNAT:
+		if (entry->ipv6_hnapt.eg_ipv6_dir == IPV6_DNAT) {
+			dip[0] = entry->ipv6_hnapt.new_ipv6_ip0;
+			dip[1] = entry->ipv6_hnapt.new_ipv6_ip1;
+			dip[2] = entry->ipv6_hnapt.new_ipv6_ip2;
+			dip[3] = entry->ipv6_hnapt.new_ipv6_ip3;
+		} else {
+			dip[0] = entry->ipv6_hnapt.ipv6_dip0;
+			dip[1] = entry->ipv6_hnapt.ipv6_dip1;
+			dip[2] = entry->ipv6_hnapt.ipv6_dip2;
+			dip[3] = entry->ipv6_hnapt.ipv6_dip3;
+		}
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool foe_ipv6_dip_eq(const struct foe_entry *entry,
+			    const struct in6_addr *dip)
+{
+	u32 foe_dip[4];
+
+	if (!foe_extract_dip_v6(entry, foe_dip))
+		return false;
+
+	return foe_dip[0] == be32_to_cpu(dip->s6_addr32[0]) &&
+	       foe_dip[1] == be32_to_cpu(dip->s6_addr32[1]) &&
+	       foe_dip[2] == be32_to_cpu(dip->s6_addr32[2]) &&
+	       foe_dip[3] == be32_to_cpu(dip->s6_addr32[3]);
+}
