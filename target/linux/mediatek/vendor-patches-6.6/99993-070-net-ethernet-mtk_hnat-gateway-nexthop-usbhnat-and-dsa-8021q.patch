-	       entry->ipv6_5t_route.ipv6_dip1 == be32_to_cpu(dip->s6_addr32[1]) &&
-	       entry->ipv6_5t_route.ipv6_dip2 == be32_to_cpu(dip->s6_addr32[2]) &&
-	       entry->ipv6_5t_route.ipv6_dip3 == be32_to_cpu(dip->s6_addr32[3]);
+	if (IS_IPV4_GRP(entry))
+		entry->ipv4_hnapt.act_dp &= ~UDF_HNAT_PRE_FILLED;
+	else
+		entry->ipv6_5t_route.act_dp &= ~UDF_HNAT_PRE_FILLED;
+}
+
+static bool hnat_foe_nh_meta_matches_entry(const struct foe_entry *entry,
+					   const struct hnat_foe_nh_meta *meta,
+					   const u8 h_dest[ETH_ALEN])
+{
+	u32 dip6[4];
+
+	if (!meta->valid || entry->bfib1.pkt_type != meta->pkt_type)
+		return false;
+
+	if (memcmp(h_dest, meta->bound_dmac, ETH_ALEN) != 0)
+		return false;
+
+	if (meta->nh_family == AF_INET) {
+		if (!IS_IPV4_HNAPT(entry) && !IS_IPV4_HNAT(entry))
+			return false;
+		return entry->ipv4_hnapt.new_dip == meta->flow_dip.v4_new_dip;
+	}
+
+	if (meta->nh_family == AF_INET6) {
+		if (!foe_extract_dip_v6(entry, dip6))
+			return false;
+		return memcmp(dip6, meta->flow_dip.v6_dip, sizeof(dip6)) == 0;
+	}
+
+	return false;
+}
+
+static void hnat_record_foe_nh_meta_locked(
+	struct sk_buff *skb,
+	const struct flow_offload_hw_path *hw_path,
+	const struct foe_entry *entry)
+{
+	u32 ppe_id = skb_hnat_ppe(skb);
+	u32 entry_idx = skb_hnat_entry(skb);
+	struct hnat_foe_nh_meta *meta;
+	const struct dst_entry *dst;
+	const struct ethhdr *eth;
+
+	if (!hnat_priv || ppe_id >= CFG_PPE_NUM ||
+	    entry_idx >= hnat_priv->foe_etry_num ||
+	    !hnat_priv->nh_meta[ppe_id])
+		return;
+
+	meta = &hnat_priv->nh_meta[ppe_id][entry_idx];
+	memset(meta, 0, sizeof(*meta));
+
+	if (!hw_path || (hw_path->flags & BIT(DEV_PATH_PPPOE)))
+		return;
+
+	dst = skb_dst(skb);
+	if (!dst || !dst->dev || (dst->flags & DST_FAKE_RTABLE) || !dst->ops)
+		return;
+
+	eth = eth_hdr(skb);
+	if ((IS_IPV4_HNAPT(entry) || IS_IPV4_HNAT(entry)) &&
+	    ntohs(eth->h_proto) == ETH_P_IP) {
+		const struct rtable *rt = (const struct rtable *)dst;
+
+		if (dst->ops->family != AF_INET ||
+		    (rt->rt_gw_family && rt->rt_gw_family != AF_INET))
+			return;
+
+		if (!foe_extract_dmac(entry, meta->bound_dmac))
+			return;
+
+		meta->nh_addr.v4 = rt_nexthop(rt, ip_hdr(skb)->daddr);
+		meta->nh_family = AF_INET;
+		meta->out_ifindex = dst->dev->ifindex;
+		meta->pkt_type = entry->bfib1.pkt_type;
+		meta->flow_dip.v4_new_dip = entry->ipv4_hnapt.new_dip;
+		meta->valid = 1;
+	} else if ((IS_IPV6_5T_ROUTE(entry) || IS_IPV6_3T_ROUTE(entry) ||
+		    IS_IPV6_HNAPT(entry) || IS_IPV6_HNAT(entry)) &&
+		   !IS_IPV6_6RD(entry) &&
+		   ntohs(eth->h_proto) == ETH_P_IPV6) {
+		const struct rt6_info *rt6 = (const struct rt6_info *)dst;
+		const struct in6_addr *nh6;
+
+		if (dst->ops->family != AF_INET6)
+			return;
+
+		if (!foe_extract_dip_v6(entry, meta->flow_dip.v6_dip) ||
+		    !foe_extract_dmac(entry, meta->bound_dmac))
+			return;
+
+		nh6 = rt6_nexthop(rt6, &ipv6_hdr(skb)->daddr);
+		meta->nh_addr.v6 = *nh6;
+		meta->nh_family = AF_INET6;
+		meta->out_ifindex = dst->dev->ifindex;
+		meta->pkt_type = entry->bfib1.pkt_type;
+		meta->valid = 1;
+	}
 }
 
