 .../net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c  |  24 ++-
 .../net/ethernet/mediatek/mtk_hnat/hnat_mcast.c    |  23 ++-
 .../net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c  | 161 ++++++++-------------
 6 files changed, 198 insertions(+), 124 deletions(-)

