        unsigned int h;
 
        rcu_read_lock();
        for (h = 0; h < nf_ct_expect_hsize; h++) {
                hlist_for_each_entry_rcu(i, &nf_ct_expect_hash[h], hnode) {
-                       if (nf_inet_addr_cmp(&i->saved_addr, &tp->src.u3) &&
+                       if (net_eq(nf_ct_exp_net(i), net) &&
+                           nf_ct_exp_zone_equal_any(i, zone) &&
+                           nf_inet_addr_cmp(&i->saved_addr, &tp->src.u3) &&
                            i->saved_proto.all == tp->src.u.all &&
                            i->tuple.dst.protonum == tp->dst.protonum &&
                            i->tuple.src.u3.ip == 0 &&
@@ -144,6 +148,8 @@ static inline struct nf_conntrack_expect *find_fullcone_exp(struct nf_conn *ct)
                                break;
                        }
                }
+               if (exp)
+                       break;
        }
        rcu_read_unlock();
 
@@ -210,20 +216,22 @@ extern unsigned int nf_conntrack_nat_mode;
                        pr_debug("bcm_nat: existing mapped port = %hu\n",
                                 ntohs(minport));
                } else { /* no previous expect */
-                       u_int16_t newport, tmpport, orgport;
+                       u32 newport, tmpport;
+                       u16 orgport;
 
-                       minport = range->min_proto.all == 0?
+                       minport = range->min_proto.all == 0 ?
                                ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.src.
                                u.udp.port : range->min_proto.all;
-                       maxport = range->max_proto.all == 0?
+                       maxport = range->max_proto.all == 0 ?
                                htons(65535) : range->max_proto.all;
-                        orgport = ntohs(minport);
-                       for (newport = ntohs(minport),tmpport = ntohs(maxport);
+                       orgport = ntohs(minport);
+                       for (newport = ntohs(minport), tmpport = ntohs(maxport);
                             newport <= tmpport; newport++) {
-                               if (CHECK_PORT_PARITY(orgport, newport) && !find_exp(newsrc, htons(newport), ct)) {
-                                        pr_debug("bcm_nat: new mapped port = "
-                                                "%hu\n", newport);
-                                       minport = maxport = htons(newport);
+                               if (CHECK_PORT_PARITY(orgport, newport) &&
+                                   !find_exp(newsrc, htons((u16)newport), ct)) {
+                                       pr_debug("bcm_nat: new mapped port = %u\n",
+                                                newport);
+                                       minport = maxport = htons((u16)newport);
                                        break;
                                }
                        }
@@ -246,7 +254,7 @@ extern unsigned int nf_conntrack_nat_mode;
                        if (help == NULL)
                                help = nf_ct_helper_ext_add(ct, GFP_ATOMIC);
                        if (help != NULL) {
-                               help->helper = &nf_conntrack_helper_bcm_nat;
+                               rcu_assign_pointer(help->helper, &nf_conntrack_helper_bcm_nat);
                                pr_debug("bcm_nat: helper set\n");
                        }
                }
@@ -497,8 +505,13 @@ static int nf_nat_masquerade_ipv6_register_notifier(void)
 {
 	return register_inet6addr_notifier(&masq_inet6_notifier);
 }
+static void nf_nat_masquerade_ipv6_unregister_notifier(void)
+{
+	unregister_inet6addr_notifier(&masq_inet6_notifier);
+}
 #else
 static inline int nf_nat_masquerade_ipv6_register_notifier(void) { return 0; }
+static inline void nf_nat_masquerade_ipv6_unregister_notifier(void) {}
 #endif
 
 int nf_nat_masquerade_inet_register_notifiers(void)
@@ -528,8 +541,14 @@ int nf_nat_masquerade_inet_register_notifiers(void)
 	if (ret)
 		goto err_unreg_inet;
 
+	ret = nf_conntrack_helper_register(&nf_conntrack_helper_bcm_nat);
+	if (ret)
+		goto err_unreg_inet6;
+
 	mutex_unlock(&masq_mutex);
 	return ret;
+err_unreg_inet6:
