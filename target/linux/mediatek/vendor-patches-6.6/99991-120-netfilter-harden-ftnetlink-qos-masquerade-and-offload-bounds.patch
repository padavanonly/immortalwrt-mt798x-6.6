diff --git a/net/netfilter/xt_FLOWOFFLOAD.c b/net/netfilter/xt_FLOWOFFLOAD.c
index 423e6d2..1b6e2e2 100644
--- a/net/netfilter/xt_FLOWOFFLOAD.c
+++ b/net/netfilter/xt_FLOWOFFLOAD.c
@@ -48,6 +48,7 @@ struct nf_forward_info {
 };
 
 static DEFINE_SPINLOCK(hooks_lock);
+static DEFINE_MUTEX(hooks_mutex);
 
 struct xt_flowoffload_table flowtable[2];
 
@@ -156,8 +157,10 @@ static void
 xt_flowoffload_register_hooks(struct xt_flowoffload_table *table)
 {
 	struct xt_flowoffload_hook *hook;
+	int err;
 
 restart:
+	spin_lock_bh(&hooks_lock);
 	hlist_for_each_entry(hook, &table->hooks, list) {
 		if (hook->registered)
 			continue;
@@ -165,14 +168,20 @@ xt_flowoffload_register_hooks(struct xt_flowoffload_table *table)
 		hook->registered = true;
 		hook->net = dev_net(hook->ops.dev);
 		spin_unlock_bh(&hooks_lock);
-		nf_register_net_hook(hook->net, &hook->ops);
+		err = nf_register_net_hook(hook->net, &hook->ops);
+		if (err) {
+			spin_lock_bh(&hooks_lock);
+			hlist_del(&hook->list);
+			spin_unlock_bh(&hooks_lock);
+			kfree(hook);
+			goto restart;
+		}
 		if (table->ft.flags & NF_FLOWTABLE_HW_OFFLOAD)
 			table->ft.type->setup(&table->ft, hook->ops.dev,
 					      FLOW_BLOCK_BIND);
-		spin_lock_bh(&hooks_lock);
 		goto restart;
 	}
-
+	spin_unlock_bh(&hooks_lock);
 }
 
 static bool
@@ -234,19 +243,27 @@ xt_flowoffload_hook_work(struct work_struct *work)
 
 	table = container_of(work, struct xt_flowoffload_table, work.work);
 
-	spin_lock_bh(&hooks_lock);
+	mutex_lock(&hooks_mutex);
 	xt_flowoffload_register_hooks(table);
+	spin_lock_bh(&hooks_lock);
 	hlist_for_each_entry(hook, &table->hooks, list)
 		hook->used = false;
 	spin_unlock_bh(&hooks_lock);
 
 	err = nf_flow_table_iterate(&table->ft, xt_flowoffload_check_hook,
 				    NULL);
-	if (err && err != -EAGAIN)
+	if (err && err != -EAGAIN) {
+		mutex_unlock(&hooks_mutex);
 		goto out;
+	}
 
-	if (!xt_flowoffload_cleanup_hooks(table))
-		return;
+	if (xt_flowoffload_cleanup_hooks(table)) {
+		mutex_unlock(&hooks_mutex);
+		goto out;
+	}
+
+	mutex_unlock(&hooks_mutex);
+	return;
 
 out:
 	queue_delayed_work(system_power_efficient_wq, &table->work, HZ);
@@ -807,6 +824,7 @@ static int flow_offload_netdev_event(struct notifier_block *this,
 	if (event != NETDEV_UNREGISTER)
 		return NOTIFY_DONE;
 
+	mutex_lock(&hooks_mutex);
 	spin_lock_bh(&hooks_lock);
 	hook0 = flow_offload_lookup_hook(&flowtable[0], dev);
 	if (hook0)
@@ -818,14 +836,22 @@ static int flow_offload_netdev_event(struct notifier_block *this,
 	spin_unlock_bh(&hooks_lock);
 
 	if (hook0) {
-		nf_unregister_net_hook(hook0->net, &hook0->ops);
+		if (hook0->registered)
+			nf_unregister_net_hook(hook0->net, &hook0->ops);
 		kfree(hook0);
 	}
 
 	if (hook1) {
-		nf_unregister_net_hook(hook1->net, &hook1->ops);
+		if (hook1->registered) {
+			if (flowtable[1].ft.flags & NF_FLOWTABLE_HW_OFFLOAD)
+				flowtable[1].ft.type->setup(&flowtable[1].ft,
+							    hook1->ops.dev,
+							    FLOW_BLOCK_UNBIND);
+			nf_unregister_net_hook(hook1->net, &hook1->ops);
+		}
 		kfree(hook1);
 	}
+	mutex_unlock(&hooks_mutex);
 
 	nf_flow_table_cleanup(dev);
 
@@ -882,11 +908,13 @@ static int __init xt_flowoffload_tg_init(void)
 {
 	int ret;
 
-	register_netdevice_notifier(&flow_offload_netdev_notifier);
+	ret = register_netdevice_notifier(&flow_offload_netdev_notifier);
+	if (ret)
+		return ret;
 
 	ret = init_flowtable(&flowtable[0]);
 	if (ret)
-		return ret;
+		goto err_unreg_notifier;
 
 	ret = init_flowtable(&flowtable[1]);
 	if (ret)
@@ -904,15 +932,34 @@ static int __init xt_flowoffload_tg_init(void)
 	nf_flow_table_free(&flowtable[1].ft);
 cleanup:
 	nf_flow_table_free(&flowtable[0].ft);
+err_unreg_notifier:
+	unregister_netdevice_notifier(&flow_offload_netdev_notifier);
 	return ret;
 }
 
 static void __exit xt_flowoffload_tg_exit(void)
 {
+	struct xt_flowoffload_hook *hook;
+	struct hlist_node *tmp;
+	int i;
+
 	xt_unregister_target(&offload_tg_reg);
 	unregister_netdevice_notifier(&flow_offload_netdev_notifier);
-	nf_flow_table_free(&flowtable[0].ft);
-	nf_flow_table_free(&flowtable[1].ft);
+	for (i = 0; i < ARRAY_SIZE(flowtable); i++) {
+		cancel_delayed_work_sync(&flowtable[i].work);
+		hlist_for_each_entry_safe(hook, tmp, &flowtable[i].hooks, list) {
+			hlist_del(&hook->list);
+			if (hook->registered) {
+				if (flowtable[i].ft.flags & NF_FLOWTABLE_HW_OFFLOAD)
+					flowtable[i].ft.type->setup(&flowtable[i].ft,
+								    hook->ops.dev,
+								    FLOW_BLOCK_UNBIND);
+				nf_unregister_net_hook(hook->net, &hook->ops);
+			}
+			kfree(hook);
+		}
+		nf_flow_table_free(&flowtable[i].ft);
+	}
 }
 
 MODULE_LICENSE("GPL");
