From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] netfilter: scope ftnetlink to netns and harden
 offload/masquerade bounds

Scope flowtable netlink lookups and flush operations to caller netns, and harden nf_conntrack_qos, masquerade, and xt_FLOWOFFLOAD bounds.
Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
 include/net/netfilter/nf_conntrack_qos.h |  4 +-
 include/net/netfilter/nf_flow_table.h    |  5 +-
 net/netfilter/nf_flow_table_core.c       | 99 ++++++++++++++++++++----
 net/netfilter/nf_flow_table_netlink.c    | 19 +++--
 net/netfilter/nf_nat_masquerade.c        | 55 ++++++++-----
 net/netfilter/xt_FLOWOFFLOAD.c           | 73 +++++++++++++----
 6 files changed, 200 insertions(+), 55 deletions(-)

diff --git a/include/net/netfilter/nf_conntrack_qos.h b/include/net/netfilter/nf_conntrack_qos.h
index 3d5ffe7..920ca5b 100644
--- a/include/net/netfilter/nf_conntrack_qos.h
+++ b/include/net/netfilter/nf_conntrack_qos.h
@@ -34,8 +34,10 @@ struct nf_conn_qos *nf_ct_qos_ext_add(struct nf_conn *ct, gfp_t gfp)
 		return NULL;
 
 	qos = nf_ct_ext_add(ct, NF_CT_EXT_QOS, gfp);
-	if (!qos)
+	if (!qos) {
 		pr_debug("failed to add qos extension area");
+		return NULL;
+	}
 
 	memset(qos, 0, sizeof(struct nf_conn_qos));
 
diff --git a/include/net/netfilter/nf_flow_table.h b/include/net/netfilter/nf_flow_table.h
index ad26b0c..4e3d11c 100644
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -314,12 +314,15 @@ void nf_flow_table_gc_run(struct nf_flowtable *flow_table);
 void nf_flow_table_gc_cleanup(struct nf_flowtable *flowtable,
 			      struct net_device *dev);
 void nf_flow_table_cleanup(struct net_device *dev);
+void nf_flow_table_cleanup_net(struct net *net);
 
 int nf_flow_table_init(struct nf_flowtable *flow_table);
 void nf_flow_table_free(struct nf_flowtable *flow_table);
 
 void flow_offload_teardown(struct flow_offload *flow);
-void flow_offload_teardown_by_tuple(struct flow_offload_tuple *tuple);
+void flow_offload_teardown_by_tuple(struct net *net,
+				    const struct flow_offload_tuple *tuple,
+				    u16 zone);
 
 int nf_flow_table_iterate(struct nf_flowtable *flow_table,
                       void (*iter)(struct nf_flowtable *flowtable,
diff --git a/net/netfilter/nf_flow_table_core.c b/net/netfilter/nf_flow_table_core.c
index 395f48a..08ed568 100644
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -357,26 +357,73 @@ void flow_offload_teardown(struct flow_offload *flow)
 }
 EXPORT_SYMBOL_GPL(flow_offload_teardown);
 
-void flow_offload_teardown_by_tuple(struct flow_offload_tuple *tuple)
+struct flow_offload_tuple_match {
+	const struct flow_offload_tuple *tuple;
+	struct net *net;
+	u16 zone;
+};
+
+static bool flow_offload_tuple_equal(const struct flow_offload_tuple *left,
+				     const struct flow_offload_tuple *right)
 {
-	struct net_device *netdev;
-	struct nf_flowtable *flowtable;
-	struct flow_offload_tuple_rhash *tuplehash;
-	struct flow_offload *flow;
+	if (left->l3proto != right->l3proto ||
+	    left->l4proto != right->l4proto ||
+	    left->src_port != right->src_port ||
+	    left->dst_port != right->dst_port)
+		return false;
+
+	switch (left->l3proto) {
+	case NFPROTO_IPV4:
+		return left->src_v4.s_addr == right->src_v4.s_addr &&
+		       left->dst_v4.s_addr == right->dst_v4.s_addr;
+	case NFPROTO_IPV6:
+		return ipv6_addr_equal(&left->src_v6, &right->src_v6) &&
+		       ipv6_addr_equal(&left->dst_v6, &right->dst_v6);
+	default:
+		return false;
+	}
+}
+
+static void nf_flow_table_do_cleanup_tuple(struct nf_flowtable *flowtable,
+					   struct flow_offload *flow,
+					   void *data)
+{
+	struct flow_offload_tuple_match *match = data;
+	const struct nf_conntrack_zone *ct_zone;
 	int dir;
 
-	list_for_each_entry(flowtable, &flowtables, list) {
-		for_each_netdev(&init_net, netdev) {
-			tuple->iifidx = netdev->ifindex;
-			tuplehash = flow_offload_lookup(flowtable, tuple);
-			if (!tuplehash)
-				continue;
-
-			dir = tuplehash->tuple.dir;
-			flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
+	if (!net_eq(nf_ct_net(flow->ct), match->net))
+		return;
+
+	ct_zone = nf_ct_zone(flow->ct);
+	if (ct_zone->id != match->zone)
+		return;
+
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		if (flow_offload_tuple_equal(&flow->tuplehash[dir].tuple,
+					     match->tuple)) {
 			flow_offload_teardown(flow);
+			return;
 		}
+	}
+}
+
+void flow_offload_teardown_by_tuple(struct net *net,
+				    const struct flow_offload_tuple *tuple,
+				    u16 zone)
+{
+	struct flow_offload_tuple_match match = {
+		.tuple = tuple,
+		.net = net,
+		.zone = zone,
 	};
+	struct nf_flowtable *flowtable;
+
+	mutex_lock(&flowtable_lock);
+	list_for_each_entry(flowtable, &flowtables, list)
+		nf_flow_table_iterate(flowtable,
+				      nf_flow_table_do_cleanup_tuple, &match);
+	mutex_unlock(&flowtable_lock);
 }
 EXPORT_SYMBOL_GPL(flow_offload_teardown_by_tuple);
 
@@ -629,6 +676,30 @@ void nf_flow_table_cleanup(struct net_device *dev)
 }
 EXPORT_SYMBOL_GPL(nf_flow_table_cleanup);
 
+static void nf_flow_table_do_cleanup_net(struct nf_flowtable *flowtable,
+					 struct flow_offload *flow, void *data)
+{
+	struct net *net = data;
+
+	if (net_eq(nf_ct_net(flow->ct), net))
+		flow_offload_teardown(flow);
+}
+
+void nf_flow_table_cleanup_net(struct net *net)
+{
+	struct nf_flowtable *flowtable;
+
+	mutex_lock(&flowtable_lock);
+	list_for_each_entry(flowtable, &flowtables, list) {
+		nf_flow_table_iterate(flowtable,
+				      nf_flow_table_do_cleanup_net, net);
+		flush_delayed_work(&flowtable->gc_work);
+		nf_flow_table_offload_flush(flowtable);
+	}
+	mutex_unlock(&flowtable_lock);
+}
+EXPORT_SYMBOL_GPL(nf_flow_table_cleanup_net);
+
 void nf_flow_table_free(struct nf_flowtable *flow_table)
 {
 	mutex_lock(&flowtable_lock);
diff --git a/net/netfilter/nf_flow_table_netlink.c b/net/netfilter/nf_flow_table_netlink.c
index 7e0f16f..a1ce0e1 100644
--- a/net/netfilter/nf_flow_table_netlink.c
+++ b/net/netfilter/nf_flow_table_netlink.c
@@ -84,6 +84,9 @@ static inline int ftnetlink_parse_tuple_ip(struct nlattr *attr,
 
 		tuple->src_v4.s_addr = nla_get_in_addr(tb[FTA_IP_V4_SRC]);
 		tuple->dst_v4.s_addr = nla_get_in_addr(tb[FTA_IP_V4_DST]);
+		break;
+	default:
+		return -EAFNOSUPPORT;
 	}
 
 	return err;
@@ -97,7 +100,7 @@ static inline int ftnetlink_parse_tuple_proto(struct nlattr *attr,
 
 	err = nla_parse_nested_deprecated(tb, FTA_PROTO_MAX, attr, l4proto_nla_policy, NULL);
 
-	if(err < 0)
+	if (err < 0)
 		return err;
 
 	if (!tb[FTA_PROTO_NUM] || !tb[FTA_PROTO_SPORT] || !tb[FTA_PROTO_DPORT])
@@ -112,7 +115,7 @@ static inline int ftnetlink_parse_tuple_proto(struct nlattr *attr,
 
 static int ftnetlink_parse_tuple(const struct nlattr * const cda[],
 				 struct flow_offload_tuple *tuple,
-				 int attrtype, int l3proto)
+				 u16 *zone, int attrtype, int l3proto)
 {
 	struct nlattr *tb[FTA_TUPLE_MAX+1];
 	int err;
@@ -126,6 +129,8 @@ static int ftnetlink_parse_tuple(const struct nlattr * const cda[],
 	if (!tb[FTA_TUPLE_IP])
 		return -EINVAL;
 
+	*zone = tb[FTA_TUPLE_ZONE] ? nla_get_u16(tb[FTA_TUPLE_ZONE]) : 0;
+
 	/* parse IP */
 	tuple->l3proto = l3proto;
 	err = ftnetlink_parse_tuple_ip(tb[FTA_TUPLE_IP], tuple);
@@ -150,20 +155,21 @@ static int ftnetlink_del_nf_flow(struct sk_buff *skb, const struct nfnl_info *in
 				 const struct nlattr * const cda[])
 {
 	struct flow_offload_tuple tuple;
+	u16 zone;
 	int err = -1;
 	struct nfgenmsg *nfmsg = nlmsg_data(info->nlh);
 	u_int8_t u3 = nfmsg->nfgen_family;
 
 	/* parse tuple */
-	if(!cda[FTA_TUPLE])
+	if (!cda[FTA_TUPLE])
 		return -EINVAL;
 
-	err = ftnetlink_parse_tuple(cda, &tuple, FTA_TUPLE, u3);
+	err = ftnetlink_parse_tuple(cda, &tuple, &zone, FTA_TUPLE, u3);
 	if (err < 0)
 		return err;
 
 	/* teardown the flow */
-	flow_offload_teardown_by_tuple(&tuple);
+	flow_offload_teardown_by_tuple(info->net, &tuple, zone);
 
 	return 0;
 }
@@ -177,8 +183,7 @@ static int ftnetlink_add_nf_flow(struct sk_buff *skb, const struct nfnl_info *in
 static int ftnetlink_flush_table(struct sk_buff *skb, const struct nfnl_info *info,
 				 const struct nlattr * const cda[])
 {
-	/* NULL device tears down every flow in all flow tables. */
-	nf_flow_table_cleanup(NULL);
+	nf_flow_table_cleanup_net(info->net);
 
 	return 0;
 }
diff --git a/net/netfilter/nf_nat_masquerade.c b/net/netfilter/nf_nat_masquerade.c
index 79fd897..0dcf421 100644
--- a/net/netfilter/nf_nat_masquerade.c
+++ b/net/netfilter/nf_nat_masquerade.c
@@ -88,7 +88,7 @@ static int bcm_nat_help(struct sk_buff *skb, unsigned int protoff,
 
 /****************************************************************************/
 static struct nf_conntrack_expect_policy bcm_nat_exp_policy __read_mostly = {
-       .max_expected   = 1000,
+       .max_expected   = NF_CT_EXPECT_MAX_CNT,
        .timeout        = 240,
 };
 
@@ -126,16 +126,20 @@ static inline int find_exp(__be32 ip, __be16 port, struct nf_conn *ct)
 /****************************************************************************/
 static inline struct nf_conntrack_expect *find_fullcone_exp(struct nf_conn *ct)
 {
-       struct nf_conntrack_tuple * tp =
+       struct nf_conntrack_tuple *tp =
                &ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple;
