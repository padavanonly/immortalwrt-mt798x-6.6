+static bool bcm_nat_setup_fullcone(struct nf_conn *ct, u8 l3num,
+				   const union nf_inet_addr *ext_addr,
+				   const struct nf_nat_range2 *range,
+				   struct nf_conntrack_helper *bcm_helper,
+				   unsigned int *ret_out)
+{
+	struct nf_nat_range2 newrange = {};
+	struct nf_conntrack_expect *exp;
+	bool found = false;
+	__be16 minport = 0;
+	unsigned int ret;
+
+	if (nf_conntrack_nat_mode == 0 ||
+	    (nfct_help(ct) && nfct_help(ct)->helper) ||
+	    nf_ct_protonum(ct) != IPPROTO_UDP)
+		return false;
+
+	pr_debug("bcm_nat: need full cone NAT (af=%u)\n", l3num);
+
+	spin_lock_bh(&nf_conntrack_expect_lock);
+	exp = find_fullcone_exp(ct, l3num, ext_addr);
+	if (exp) {
+		minport = exp->tuple.dst.u.udp.port;
+		found = true;
+		pr_debug("bcm_nat: existing mapped port = %u\n",
+			 ntohs(minport));
+	} else {
+		bool is_random = range->flags &
+			(NF_NAT_RANGE_PROTO_RANDOM | NF_NAT_RANGE_PROTO_RANDOM_FULLY);
+		u32 orgport, min_avail, max_avail, range_size, start, off;
+
+		orgport = ntohs(ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.src.u.udp.port);
+		min_avail = range->min_proto.all ?
+			ntohs(range->min_proto.all) : (orgport < 1024 ? orgport : 1024);
+		max_avail = range->max_proto.all ?
+			ntohs(range->max_proto.all) : 65535;
+		if (max_avail < min_avail)
+			swap(min_avail, max_avail);
+		range_size = max_avail - min_avail + 1;
+		start = is_random ? get_random_u32_below(range_size) :
+			clamp(orgport, min_avail, max_avail) - min_avail;
+
+		/* Preserve RFC 4787 port parity first unless randomized. */
+		if (!is_random) {
+			for (off = 0; off < range_size; off++) {
+				u32 newport = min_avail + ((start + off) % range_size);
+
+				if (((newport ^ orgport) & 1) == 0 &&
+				    !find_exp(l3num, ext_addr, htons((u16)newport), ct)) {
+					minport = htons((u16)newport);
+					found = true;
+					break;
+				}
+			}
+		}
+
+		if (!found) {
+			for (off = 0; off < range_size; off++) {
+				u32 newport = min_avail + ((start + off) % range_size);
+
+				if (!is_random && ((newport ^ orgport) & 1) == 0)
+					continue;
+				if (!find_exp(l3num, ext_addr, htons((u16)newport), ct)) {
+					minport = htons((u16)newport);
+					found = true;
+					break;
+				}
+			}
+		}
+
+		if (found)
+			pr_debug("bcm_nat: new mapped port = %u\n",
+				 ntohs(minport));
+	}
+	spin_unlock_bh(&nf_conntrack_expect_lock);
+
+	if (!found)
+		return false;
+
+	newrange.flags = range->flags | NF_NAT_RANGE_MAP_IPS |
+		NF_NAT_RANGE_PROTO_SPECIFIED;
+	newrange.min_addr = *ext_addr;
+	newrange.max_addr = *ext_addr;
+	newrange.min_proto.udp.port = minport;
+	newrange.max_proto.udp.port = minport;
+
+	/* Set ct helper only on the first flow owning the expectation. */
+	ret = nf_nat_setup_info(ct, &newrange, NF_NAT_MANIP_SRC);
+	if (ret == NF_ACCEPT && !exp) {
+		struct nf_conn_help *help = nfct_help(ct);
+
+		if (!help)
+			help = nf_ct_helper_ext_add(ct, GFP_ATOMIC);
+		if (help) {
+			rcu_assign_pointer(help->helper, bcm_helper);
+			pr_debug("bcm_nat: helper set\n");
+		}
+	}
+
+	*ret_out = ret;
+	return true;
 }
 
