+static int bond_dev_flow_offload_check(struct flow_offload_hw_path *path)
+{
+	struct net_device *master_dev = path->dev;
+	struct bonding *bond = netdev_priv(master_dev);
+	struct net_device *slave_dev[10];
+	struct list_head *iter;
+	struct slave *slave;
+	int i = 0;
+
+	rcu_read_lock();
+	bond_for_each_slave_rcu(bond, slave, iter) {
+		if (!bond_slave_can_tx(slave))
+			continue;
+		slave_dev[i++] = slave->dev;
+		if (i >= ARRAY_SIZE(slave_dev))
+			break;
+	}
+	rcu_read_unlock();
+
+	if (i <= 0)
+		return -ENODEV;
+
+	i = ((path->skb_hash) >> 1) % i;
+	if (i >= 0 && i < ARRAY_SIZE(slave_dev)) {
+		if (path->virt_dev == master_dev)
+			path->virt_dev = slave_dev[i];
+		path->dev = slave_dev[i];
+	}
+
+	if (path->dev->netdev_ops->ndo_flow_offload_check)
+		return path->dev->netdev_ops->ndo_flow_offload_check(path);
+	return 0;
+}
+
+static int bond_fill_forward_path(struct net_device_path_ctx *ctx,
+				  struct net_device_path *path)
+{
+	struct net_device *master_dev = (struct net_device *)ctx->dev;
+	struct bonding *bond = netdev_priv(master_dev);
+	struct net_device *slave_dev[10];
+	struct list_head *iter;
+	struct slave *slave;
+	int i = 0;
+
+	rcu_read_lock();
+	bond_for_each_slave_rcu(bond, slave, iter) {
+		if (!bond_slave_can_tx(slave))
+			continue;
+		slave_dev[i++] = slave->dev;
+		if (i >= ARRAY_SIZE(slave_dev))
+			break;
+	}
+	rcu_read_unlock();
+
+	if (i <= 0)
+		return -ENODEV;
+
+	path->type = DEV_PATH_ETHERNET;
+	path->dev = ctx->dev;
+	ctx->dev = slave_dev[(ctx->daddr[5] ^ ctx->daddr[4]) % i];
+	return 0;
+}
+#endif /* CONFIG_NF_FLOW_TABLE */
 
