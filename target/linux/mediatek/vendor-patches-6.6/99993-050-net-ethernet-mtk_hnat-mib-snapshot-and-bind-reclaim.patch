 		foe_mib_tb_sz = hnat_priv->foe_etry_num * sizeof(struct mib_entry);
 		if (hnat_priv->foe_mib_cpu[ppe_id])
 			dma_free_coherent(hnat_priv->dev, foe_mib_tb_sz,
@@ -882,6 +908,8 @@ static void hnat_stop(u32 ppe_id)
