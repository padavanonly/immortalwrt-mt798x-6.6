 static inline u16 foe_timestamp(struct mtk_hnat *h)
 {
diff --git a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
index 9c39c71..5e04aff 100644
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
@@ -968,70 +968,266 @@ static const debugfs_write_func cr_set_func[] = {
 	[12] = set_macvlan_support,
 };
 
-int read_mib(struct mtk_hnat *h, u32 ppe_id,
-	     u32 index, u64 *bytes, u64 *packets)
+static void __hnat_mib_finish_pending_locked(struct mtk_hnat *h, u32 ppe_id,
+				     u64 *last_bytes, u64 *last_packets)
 {
+	struct hnat_mib_ppe *mib = &h->mib[ppe_id];
+	u32 cmd_index = mib->pending.index;
+	u32 cmd_gen = mib->pending.generation;
+	u32 cnt_r0, cnt_r1, cnt_r2, cnt_r3;
+	u64 hw_bytes, hw_packets;
+
+	if (!mib->pending.valid)
+		return;
+
+	cnt_r0 = readl(h->ppe_base[ppe_id] + PPE_MIB_SER_R0);
+	cnt_r1 = readl(h->ppe_base[ppe_id] + PPE_MIB_SER_R1);
+	cnt_r2 = readl(h->ppe_base[ppe_id] + PPE_MIB_SER_R2);
+
+	if (h->data->version == MTK_HNAT_V3) {
+		cnt_r3 = readl(h->ppe_base[ppe_id] + PPE_MIB_SER_R3);
+		hw_bytes = cnt_r0 + ((u64)cnt_r1 << 32);
+		hw_packets = cnt_r2 + ((u64)cnt_r3 << 32);
+	} else {
+		hw_bytes = cnt_r0 + ((u64)(cnt_r1 & 0xffff) << 32);
+		hw_packets = ((cnt_r1 & 0xffff0000) >> 16) +
+			     ((u64)(cnt_r2 & 0xffffff) << 16);
+	}
+
+	if (cmd_index < h->foe_etry_num &&
+	    h->ct_cursor[ppe_id][cmd_index].generation == cmd_gen) {
+		h->acct[ppe_id][cmd_index].bytes += hw_bytes;
+		h->acct[ppe_id][cmd_index].packets += hw_packets;
+	}
+
+	mib->pending.valid = false;
+	mib->pending.polling = false;
+
+	if (last_bytes)
+		*last_bytes = hw_bytes;
+	if (last_packets)
+		*last_packets = hw_packets;
+}
+
+int hnat_mib_sample_entry(struct mtk_hnat *h, u32 ppe_id, u32 index,
+			  enum hnat_mib_op op, struct hnat_accounting *out)
+{
+	struct hnat_mib_ppe *mib;
+	struct hnat_ct_cursor *cursor;
+	struct hnat_accounting *total;
+	unsigned long flags;
+	u32 cmd_index, cmd_gen;
+	u32 val;
+	u64 hw_bytes = 0, hw_packets = 0;
 	int ret;
-	u32 val, cnt_r0, cnt_r1, cnt_r2, cnt_r3;
 
-	if (ppe_id >= CFG_PPE_NUM)
+	if (!h || ppe_id >= CFG_PPE_NUM || index >= h->foe_etry_num)
 		return -EINVAL;
 
-	writel(index | (1 << 16), h->ppe_base[ppe_id] + PPE_MIB_SER_CR);
-	ret = readx_poll_timeout_atomic(readl, h->ppe_base[ppe_id] + PPE_MIB_SER_CR, val,
-					!(val & BIT_MIB_BUSY), 20, 10000);
+	if (!h->data || !h->data->per_flow_accounting)
+		return -EOPNOTSUPP;
+
+	mib = &h->mib[ppe_id];
+
+	spin_lock_irqsave(&mib->lock, flags);
+	if (mib->stopping) {
+		spin_unlock_irqrestore(&mib->lock, flags);
+		return -ENODEV;
+	}
+
+	if (mib->pending.polling) {
+		spin_unlock_irqrestore(&mib->lock, flags);
+		return -EBUSY;
+	}
+
+	if (!mib->pending.valid) {
+		mib->pending.index = index;
+		mib->pending.generation = h->ct_cursor[ppe_id][index].generation;
+		mib->pending.valid = true;
+		mib->pending.polling = true;
+		writel(index | (1 << 16), h->ppe_base[ppe_id] + PPE_MIB_SER_CR);
+		cmd_index = index;
+		cmd_gen = mib->pending.generation;
+	} else {
+		mib->pending.polling = true;
+		cmd_index = mib->pending.index;
+		cmd_gen = mib->pending.generation;
+	}
+	spin_unlock_irqrestore(&mib->lock, flags);
 
+	ret = readx_poll_timeout_atomic(readl, h->ppe_base[ppe_id] + PPE_MIB_SER_CR,
+					val, !(val & BIT_MIB_BUSY), 20, 10000);
 	if (ret < 0) {
-		pr_notice("mib busy, please check later\n");
+		spin_lock_irqsave(&mib->lock, flags);
+		mib->pending.polling = false;
+		spin_unlock_irqrestore(&mib->lock, flags);
+		wake_up(&mib->idle);
 		return ret;
 	}
-	cnt_r0 = readl(h->ppe_base[ppe_id] + PPE_MIB_SER_R0);
-	cnt_r1 = readl(h->ppe_base[ppe_id] + PPE_MIB_SER_R1);
-	cnt_r2 = readl(h->ppe_base[ppe_id] + PPE_MIB_SER_R2);
 
-	if (hnat_priv->data->version == MTK_HNAT_V3) {
-		cnt_r3 = readl(h->ppe_base[ppe_id] + PPE_MIB_SER_R3);
-		*bytes = cnt_r0 + ((u64)cnt_r1 << 32);
-		*packets = cnt_r2 + ((u64)cnt_r3 << 32);
-	} else {
-		*bytes = cnt_r0 + ((u64)(cnt_r1 & 0xffff) << 32);
-		*packets = ((cnt_r1 & 0xffff0000) >> 16) +
-			   ((u64)(cnt_r2 & 0xffffff) << 16);
+	spin_lock_irqsave(&mib->lock, flags);
+	if (mib->stopping || !mib->pending.valid) {
+		mib->pending.polling = false;
+		spin_unlock_irqrestore(&mib->lock, flags);
+		wake_up(&mib->idle);
+		return -ENODEV;
 	}
 
-	return 0;
+	cmd_index = mib->pending.index;
+	cmd_gen = mib->pending.generation;
+	__hnat_mib_finish_pending_locked(h, ppe_id, &hw_bytes, &hw_packets);
+
+	if (cmd_index != index || h->ct_cursor[ppe_id][index].generation != cmd_gen) {
+		spin_unlock_irqrestore(&mib->lock, flags);
+		wake_up(&mib->idle);
+		return -EAGAIN;
+	}
 
+	switch (op) {
+	case HNAT_MIB_OP_SNAPSHOT:
+		if (out)
+			*out = h->acct[ppe_id][index];
+		break;
+	case HNAT_MIB_OP_CT_DELTA:
+		cursor = &h->ct_cursor[ppe_id][index];
+		total = &h->acct[ppe_id][index];
+		if (out) {
+			out->bytes = total->bytes - cursor->reported_bytes;
+			out->packets = total->packets - cursor->reported_packets;
+		}
+		cursor->reported_bytes = total->bytes;
+		cursor->reported_packets = total->packets;
+		break;
+	case HNAT_MIB_OP_COUNT:
+		if (out) {
+			out->bytes = hw_bytes;
+			out->packets = hw_packets;
+		}
+		break;
+	}
+
+	spin_unlock_irqrestore(&mib->lock, flags);
+	wake_up(&mib->idle);
+	return 0;
 }
 
+int read_mib(struct mtk_hnat *h, u32 ppe_id,
+	     u32 index, u64 *bytes, u64 *packets)
+{
+	struct hnat_accounting diff;
+	int ret;
+
+	ret = hnat_mib_sample_entry(h, ppe_id, index, HNAT_MIB_OP_COUNT, &diff);
+	if (ret)
+		return ret;
+	if (bytes)
+		*bytes = diff.bytes;
+	if (packets)
+		*packets = diff.packets;
+	return 0;
+}
 
 struct hnat_accounting *hnat_get_count(struct mtk_hnat *h, u32 ppe_id,
 				       u32 index, struct hnat_accounting *diff)
-
 {
-	u64 bytes, packets;
+	int ret;
 
-	if (ppe_id >= CFG_PPE_NUM)
+	if (!h || ppe_id >= CFG_PPE_NUM || index >= h->foe_etry_num)
 		return NULL;
 
-	if (index >= hnat_priv->foe_etry_num)
+	if (!h->data || !h->data->per_flow_accounting)
 		return NULL;
 
-	if (!hnat_priv->data->per_flow_accounting)
+	ret = hnat_mib_sample_entry(h, ppe_id, index, HNAT_MIB_OP_COUNT, diff);
+	if (ret)
 		return NULL;
 
-	if (read_mib(h, ppe_id, index, &bytes, &packets))
-		return NULL;
+	return &h->acct[ppe_id][index];
+}
+EXPORT_SYMBOL(hnat_get_count);
 
-	h->acct[ppe_id][index].bytes += bytes;
-	h->acct[ppe_id][index].packets += packets;
+int hnat_get_ct_delta(struct mtk_hnat *h, u32 ppe_id, u32 index,
+		      struct hnat_accounting *delta)
+{
+	if (!delta)
+		return -EINVAL;
+
+	return hnat_mib_sample_entry(h, ppe_id, index, HNAT_MIB_OP_CT_DELTA, delta);
+}
+EXPORT_SYMBOL(hnat_get_ct_delta);
+
+int hnat_get_count_snapshot(struct mtk_hnat *h, u32 ppe_id, u32 index,
+			    struct hnat_accounting *snapshot)
+{
+	if (!snapshot)
+		return -EINVAL;
+
+	return hnat_mib_sample_entry(h, ppe_id, index, HNAT_MIB_OP_SNAPSHOT, snapshot);
+}
+EXPORT_SYMBOL(hnat_get_count_snapshot);
+
+bool hnat_mib_bind_begin(struct mtk_hnat *h, u32 ppe_id, u32 index,
+			 struct hnat_mib_bind_guard *guard)
+{
+	struct hnat_mib_ppe *mib;
+	struct hnat_ct_cursor *cursor;
+	unsigned long flags = 0;
 
-	if (diff) {
-		diff->bytes = bytes;
-		diff->packets = packets;
+	if (!guard)
+		return false;
+
+	guard->locked = false;
+	guard->flags = 0;
+
+	if (!h || ppe_id >= CFG_PPE_NUM || index >= h->foe_etry_num)
+		return false;
+
+	if (!h->data || !h->data->per_flow_accounting)
+		return true;
+
+	mib = &h->mib[ppe_id];
+
+	spin_lock_irqsave(&mib->lock, flags);
+	if (mib->stopping)
+		goto reject;
+
+	if (mib->pending.valid && mib->pending.index == index) {
+		if (mib->pending.polling)
+			goto reject;
+		if (readl(h->ppe_base[ppe_id] + PPE_MIB_SER_CR) & BIT_MIB_BUSY)
+			goto reject;
+		__hnat_mib_finish_pending_locked(h, ppe_id, NULL, NULL);
 	}
-	return &h->acct[ppe_id][index];
+
+	cursor = &h->ct_cursor[ppe_id][index];
+	cursor->generation++;
+	cursor->reported_bytes = 0;
+	cursor->reported_packets = 0;
+	memset(&h->acct[ppe_id][index], 0, sizeof(h->acct[ppe_id][index]));
+
+	guard->flags = flags;
+	guard->locked = true;
+	return true;
+
+reject:
+	spin_unlock_irqrestore(&mib->lock, flags);
+	return false;
 }
-EXPORT_SYMBOL(hnat_get_count);
+EXPORT_SYMBOL(hnat_mib_bind_begin);
+
+void hnat_mib_bind_end(struct mtk_hnat *h, u32 ppe_id,
+		       struct hnat_mib_bind_guard *guard)
+{
+	if (!guard || !guard->locked)
+		return;
+
+	if (!h || ppe_id >= CFG_PPE_NUM)
+		return;
+
+	guard->locked = false;
+	spin_unlock_irqrestore(&h->mib[ppe_id].lock, guard->flags);
+}
+EXPORT_SYMBOL(hnat_mib_bind_end);
 
