+			if (hnat_priv->ct_cursor[ppe_id])
+				memset(hnat_priv->ct_cursor[ppe_id], 0,
+				       hnat_priv->foe_etry_num * sizeof(struct hnat_ct_cursor));
 			foe_mib_tb_sz =
