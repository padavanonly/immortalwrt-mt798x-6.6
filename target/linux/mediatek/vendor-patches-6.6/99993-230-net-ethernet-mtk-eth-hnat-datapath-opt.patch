From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] net: ethernet: mediatek: optimize TX/RX ring, prefetch, and HNAT struct pass

Eliminate per-descriptor UDIV and per-packet LL/SC atomic_inc inside
mtk_poll_tx_qdma/mtk_poll_tx_pdma via shift fast-path and loop-batched
atomic_add, add single-page fast-path + single_skb cached desc count in
mtk_start_xmit, add next-descriptor/data prefetch in mtk_poll_rx, pass
struct foe_entry by pointer in mtk_hnat helpers, and build hnat_debugfs.o
with -Os.

Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -7,6 +7,7 @@
  */
 
 #include <linux/of.h>
+#include <linux/prefetch.h>
 #include <linux/of_mdio.h>
 #include <linux/of_net.h>
 #include <linux/of_address.h>
@@ -1742,10 +1743,23 @@
 	return ring->dma + (desc - ring->phys);
 }
 
+static inline int mtk_tx_desc_idx(const struct mtk_tx_ring *ring,
+				  const void *txd, u32 txd_size)
+{
+	ptrdiff_t diff = txd - ring->dma;
+
+	if (likely(txd_size == 32))
+		return diff >> 5;
+	if (likely(txd_size == 16))
+		return diff >> 4;
+
+	return diff / txd_size;
+}
+
 static struct mtk_tx_buf *mtk_desc_to_tx_buf(struct mtk_tx_ring *ring,
 					     void *txd, u32 txd_size)
 {
-	int idx = (txd - ring->dma) / txd_size;
+	int idx = mtk_tx_desc_idx(ring, txd, txd_size);
 
 	return &ring->buf[idx];
 }
@@ -1758,7 +1772,7 @@
 
 static int txd_to_idx(struct mtk_tx_ring *ring, void *dma, u32 txd_size)
 {
-	return (dma - ring->dma) / txd_size;
+	return mtk_tx_desc_idx(ring, dma, txd_size);
 }
 
 static void mtk_tx_unmap(struct mtk_eth *eth, struct mtk_tx_buf *tx_buf,
@@ -2148,13 +2162,18 @@
 static unsigned int
 mtk_qdma_desc_need(struct mtk_eth *eth, struct sk_buff *skb)
 {
+	unsigned int max_len = eth->soc->tx.dma_max_len;
 	unsigned int need = 1;
 	int i;
 
-	for (i = 0; i < skb_shinfo(skb)->nr_frags; i++)
-		need += DIV_ROUND_UP(
-			skb_frag_size(&skb_shinfo(skb)->frags[i]),
-			eth->soc->tx.dma_max_len);
+	for (i = 0; i < skb_shinfo(skb)->nr_frags; i++) {
+		unsigned int frag_len = skb_frag_size(&skb_shinfo(skb)->frags[i]);
+
+		if (likely(frag_len <= max_len))
+			need++;
+		else
+			need += DIV_ROUND_UP(frag_len, max_len);
+	}
 
 	return need;
 }
@@ -2296,42 +2315,49 @@
 		netif_tx_wake_all_queues(dev);
 	}
 
-	if (tx_list != orig_skb) {
-		consume_skb(orig_skb);
-		orig_skb = NULL;
-	}
+	{
+		bool single_skb = (tx_list == orig_skb && !orig_skb->next);
 
-	skb_list_walk_safe(tx_list, seg, next) {
-		int seg_tx_num;
+		if (tx_list != orig_skb) {
+			consume_skb(orig_skb);
+			orig_skb = NULL;
+		}
 
-		skb_mark_not_on_list(seg);
-		gso = false;
+		skb_list_walk_safe(tx_list, seg, next) {
+			int seg_tx_num;
 
-		/* TSO: fill MSS info in tcp checksum field */
-		if (skb_is_gso(seg)) {
-			if (skb_cow_head(seg, 0)) {
-				netif_warn(eth, tx_err, dev,
-					   "GSO expand head fail.\n");
-				stats->tx_dropped++;
-				dev_kfree_skb_any(seg);
-				continue;
-			}
+			skb_mark_not_on_list(seg);
+			gso = false;
+
+			/* TSO: fill MSS info in tcp checksum field */
+			if (skb_is_gso(seg)) {
+				if (skb_cow_head(seg, 0)) {
+					netif_warn(eth, tx_err, dev,
+						   "GSO expand head fail.\n");
+					stats->tx_dropped++;
+					dev_kfree_skb_any(seg);
+					continue;
+				}
 
-			if (skb_shinfo(seg)->gso_type &
-			    (SKB_GSO_TCPV4 | SKB_GSO_TCPV6)) {
-				gso = true;
-				tcp_hdr(seg)->check =
-					htons(skb_shinfo(seg)->gso_size);
+				if (skb_shinfo(seg)->gso_type &
+				    (SKB_GSO_TCPV4 | SKB_GSO_TCPV6)) {
+					gso = true;
+					tcp_hdr(seg)->check =
+						htons(skb_shinfo(seg)->gso_size);
+				}
 			}
-		}
 
-		seg_tx_num = MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA) ?
-			     mtk_qdma_desc_need(eth, seg) :
-			     mtk_cal_txd_req(eth, seg);
+			if (likely(single_skb))
+				seg_tx_num = need;
+			else
+				seg_tx_num = MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA) ?
+					     mtk_qdma_desc_need(eth, seg) :
+					     mtk_cal_txd_req(eth, seg);
 
-		if (mtk_tx_map(seg, dev, seg_tx_num, ring, gso) < 0) {
-			stats->tx_dropped++;
-			dev_kfree_skb_any(seg);
+			if (mtk_tx_map(seg, dev, seg_tx_num, ring, gso) < 0) {
+				stats->tx_dropped++;
+				dev_kfree_skb_any(seg);
+			}
 		}
 	}
 
@@ -2707,6 +2733,8 @@
 		int orig_mac;
 #endif
 
+		u32 next_idx;
+
 		idx = NEXT_DESP_IDX(ring->calc_idx, ring->dma_size);
 		rxd = ring->dma + idx * eth->soc->rx.desc_size;
 		data = ring->data[idx];
@@ -2714,6 +2742,11 @@
 		if (!mtk_rx_get_desc(eth, &trxd, rxd))
 			break;
 
+		next_idx = NEXT_DESP_IDX(idx, ring->dma_size);
+		prefetch(ring->dma + next_idx * eth->soc->rx.desc_size);
+		if (likely(ring->data[next_idx]))
+			prefetch(ring->data[next_idx]);
+
 		sent_ppd = 0;
 
 		/* find out which mac the packet come from. values start at 1 */
@@ -3085,6 +3118,7 @@
 	struct xdp_frame_bulk bq;
 	struct mtk_tx_dma *desc;
 	u32 cpu, dma;
+	int freed = 0;
 
 	cpu = ring->last_free_ptr;
 	dma = mtk_r32(eth, reg_map->qdma.drx_ptr);
@@ -3114,10 +3148,12 @@
 		mtk_tx_unmap(eth, tx_buf, &bq, true);
 
 		ring->last_free = desc;
-		atomic_inc(&ring->free_count);
+		freed++;
 
 		cpu = next_cpu;
 	}
+	if (likely(freed))
+		atomic_add(freed, &ring->free_count);
 	xdp_flush_frame_bulk(&bq);
 
 	ring->last_free_ptr = cpu;
@@ -3134,6 +3170,7 @@
 	struct xdp_frame_bulk bq;
 	struct mtk_tx_dma *desc;
 	u32 cpu, dma;
+	int freed = 0;
 
 	cpu = ring->cpu_idx;
 	dma = mtk_r32(eth, MT7628_TX_DTX_IDX0);
@@ -3153,10 +3190,12 @@
 
 		desc = ring->dma + cpu * eth->soc->tx.desc_size;
 		ring->last_free = desc;
-		atomic_inc(&ring->free_count);
+		freed++;
 
 		cpu = NEXT_DESP_IDX(cpu, ring->dma_size);
 	}
+	if (likely(freed))
+		atomic_add(freed, &ring->free_count);
 	xdp_flush_frame_bulk(&bq);
 
 	ring->cpu_idx = cpu;
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
@@ -3064,17 +3064,17 @@
 	return chksum_base;
 }
 
