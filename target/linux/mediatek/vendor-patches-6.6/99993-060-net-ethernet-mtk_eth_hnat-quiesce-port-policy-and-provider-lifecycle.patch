From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] net: ethernet: mtk_eth_hnat: coordinate PPE quiesce, DMA
 retention, and provider lifecycle

Introduce synchronous PPE quiesce and persistent DMA ownership, unify PPE port-policy resume, and bind ETH/HNAT lifetimes through a resident provider registry and supplier teardown.
Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
 drivers/net/ethernet/mediatek/mtk_eth_dbg.c   |   6 +-
 drivers/net/ethernet/mediatek/mtk_eth_reset.c |  18 +-
 drivers/net/ethernet/mediatek/mtk_eth_reset.h |  59 ++
 drivers/net/ethernet/mediatek/mtk_eth_soc.c   | 766 +++++++++++++++++-
 drivers/net/ethernet/mediatek/mtk_eth_soc.h   |  68 +-
 drivers/net/ethernet/mediatek/mtk_hnat/hnat.c | 440 +++++++---
 drivers/net/ethernet/mediatek/mtk_hnat/hnat.h |   9 +
 .../ethernet/mediatek/mtk_hnat/hnat_mcast.c   |   3 +-
 8 files changed, 1244 insertions(+), 125 deletions(-)

diff --git a/drivers/net/ethernet/mediatek/mtk_eth_dbg.c b/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
index 53285f7..99da8e7 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
@@ -2469,8 +2469,6 @@ static struct proc_dir_entry *proc_esw_cnt, *proc_mac_cnt, *proc_xfi_cnt,
 
 int debug_proc_init(struct mtk_eth *eth)
 {
-	rcu_assign_pointer(g_eth, eth);
-
 	if (!proc_reg_dir)
 		proc_reg_dir = proc_mkdir(PROCREG_DIR, NULL);
 
@@ -2494,7 +2492,7 @@ int debug_proc_init(struct mtk_eth *eth)
 	if (!proc_esw_cnt)
 		pr_notice("!! FAIL to create %s PROC !!\n", PROCREG_ESW_CNT);
 
-	if (mtk_is_netsys_v3_or_greater(g_eth)) {
+	if (mtk_is_netsys_v3_or_greater(eth)) {
 		proc_mac_cnt =
 		    proc_create(PROCREG_MAC_CNT, 0,
 				proc_reg_dir, &mac_count_fops);
@@ -2515,7 +2513,7 @@ int debug_proc_init(struct mtk_eth *eth)
 	if (!proc_dbg_regs)
 		pr_notice("!! FAIL to create %s PROC !!\n", PROCREG_DBG_REGS);
 
-	if (g_eth->hwlro) {
+	if (eth->hwlro) {
 		proc_hw_lro_stats =
 			proc_create(PROCREG_HW_LRO_STATS, 0, proc_reg_dir,
 				    &hw_lro_stats_fops);
diff --git a/drivers/net/ethernet/mediatek/mtk_eth_reset.c b/drivers/net/ethernet/mediatek/mtk_eth_reset.c
index 09ab3c4..f1e96be 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_reset.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_reset.c
@@ -26,15 +26,16 @@ EXPORT_SYMBOL(mtk_check_wifi_busy);
 void mtk_set_pse_drop(u32 config)
 {
 	struct mtk_eth *eth;
+	unsigned long flags;
 
 	rcu_read_lock();
 	eth = rcu_dereference(g_eth);
 	if (eth && !mtk_is_netsys_v1(eth)) {
-		mtk_w32(eth, config, PSE_PPE_DROP(0));
-		if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSTCTRL_PPE1))
-			mtk_w32(eth, config, PSE_PPE_DROP(1));
-		if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSTCTRL_PPE2))
-			mtk_w32(eth, config, PSE_PPE_DROP(2));
+		spin_lock_irqsave(&eth->ppe_cfg_lock, flags);
+		mtk_ppe_set_drop_locked(eth, 0, config);
+		mtk_ppe_set_drop_locked(eth, 1, config);
+		mtk_ppe_set_drop_locked(eth, 2, config);
+		spin_unlock_irqrestore(&eth->ppe_cfg_lock, flags);
 	}
 	rcu_read_unlock();
 }
@@ -102,6 +103,11 @@ int mtk_eth_netdevice_event_init(struct mtk_eth *eth)
 	if (err)
 		return err;
 
-	rcu_assign_pointer(g_eth, eth);
+	err = mtk_eth_provider_online(eth);
+	if (err) {
+		unregister_netdevice_notifier(&eth->reset.netdevice_notifier);
+		return err;
+	}
+
 	return 0;
 }
diff --git a/drivers/net/ethernet/mediatek/mtk_eth_reset.h b/drivers/net/ethernet/mediatek/mtk_eth_reset.h
index f541a3b..5d8c185 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_reset.h
+++ b/drivers/net/ethernet/mediatek/mtk_eth_reset.h
@@ -7,6 +7,11 @@
 #ifndef MTK_ETH_RESET_H
 #define MTK_ETH_RESET_H
 
+#include <linux/bits.h>
+#include <linux/types.h>
+
+struct device;
+
 /* Frame Engine Reset FSM */
 #define MTK_FE_START_RESET		(0x2000)
 #define MTK_FE_RESET_DONE		(0x2001)
@@ -32,4 +37,58 @@ extern bool mtk_stop_fail;
 void mtk_set_pse_drop(u32 config);
 int mtk_eth_netdevice_event_init(struct mtk_eth *eth);
 bool mtk_eth_queue_reset(struct mtk_eth *eth, u32 event);
+
+#define MTK_PPE_OWNER_MAX 3
+
+enum mtk_ppe_owner_state {
+	MTK_PPE_EMPTY = 0,
+	MTK_PPE_ACTIVE,
+	MTK_PPE_QUIESCED,
+	MTK_PPE_FAULTED,
+};
+
+struct mtk_ppe_dma_hold {
+	struct device *dma_dev;
+	void *foe_cpu;
+	dma_addr_t foe_dma;
+	size_t foe_bytes;
+	void *mib_cpu;
+	dma_addr_t mib_dma;
+	size_t mib_bytes;
+};
+
+struct mtk_eth;
+struct mtk_ppe_registry;
+
+struct mtk_eth_hnat_tx {
+	struct mtk_eth *eth;
+	struct mtk_ppe_registry *provider;
+	bool locked;
+	bool owns_rtnl;
+};
+
+int mtk_eth_provider_online(struct mtk_eth *eth);
+void mtk_eth_provider_offline(struct mtk_eth *eth);
+int mtk_eth_hnat_get_supplier(struct device **out);
+
+int mtk_eth_hnat_begin(struct mtk_eth_hnat_tx *tx);
+int mtk_eth_hnat_begin_reset(struct mtk_eth_hnat_tx *tx);
+void mtk_eth_hnat_end(struct mtk_eth_hnat_tx *tx);
+
+int mtk_eth_claim_ppes_locked(struct mtk_eth_hnat_tx *tx, u32 mask);
+int mtk_eth_register_ppes_locked(struct mtk_eth_hnat_tx *tx, u32 mask,
+				 const struct mtk_ppe_dma_hold desc[MTK_PPE_OWNER_MAX]);
+void mtk_eth_abort_claim_locked(struct mtk_eth_hnat_tx *tx, u32 mask);
+int mtk_eth_can_warm_init_ppes_locked(struct mtk_eth_hnat_tx *tx, u32 mask);
+
+int mtk_eth_mark_ppe_quiesced_locked(struct mtk_eth_hnat_tx *tx, u32 id);
+int mtk_eth_free_ppe_dma_locked(struct mtk_eth_hnat_tx *tx, u32 id);
+void mtk_eth_fault_ppe_locked(struct mtk_ppe_registry *r, u32 id);
+void mtk_eth_fault_ppe(struct mtk_ppe_registry *r, u32 id);
+
+int mtk_eth_quiesce_ppe_locked(struct mtk_eth_hnat_tx *tx, u32 ppe_id);
+int mtk_eth_resume_ppe_locked(struct mtk_eth_hnat_tx *tx, u32 ppe_mask);
+int mtk_eth_quiesce_ppe_sync(u32 ppe_id);
+int mtk_eth_resume_ppe_sync(u32 ppe_id);
+void mtk_eth_set_pse_port_link_down(u32 port, bool link_down);
 #endif		/* MTK_ETH_RESET_H */
diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.c b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
index 16542af..61fe52e 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -26,7 +26,10 @@
 #include <linux/phy/phy.h>
 #include <linux/gpio/consumer.h>
 #include <linux/jhash.h>
+#include <linux/lockdep.h>
+#include <linux/mutex.h>
 #include <linux/rcupdate.h>
+#include <linux/rtnetlink.h>
 #include <linux/bitfield.h>
 #include <net/dsa.h>
 #include <net/dst_metadata.h>
@@ -5036,6 +5039,685 @@ static void mtk_hw_warm_reset(struct mtk_eth *eth)
 			val, rst_mask);
 }
 
+void mtk_eth_set_pse_port_link_down(u32 port, bool link_down)
+{
+	struct mtk_eth *eth;
+	unsigned long flags;
+	u32 val;
+
+	rcu_read_lock();
+	eth = rcu_dereference(g_eth);
+	if (eth) {
+		spin_lock_irqsave(&eth->ppe_cfg_lock, flags);
+		val = mtk_r32(eth, MTK_FE_GLO_CFG(port));
+		if (link_down)
+			val |= MTK_FE_LINK_DOWN_P(port);
+		else
+			val &= ~MTK_FE_LINK_DOWN_P(port);
+		mtk_w32(eth, val, MTK_FE_GLO_CFG(port));
+		spin_unlock_irqrestore(&eth->ppe_cfg_lock, flags);
+	}
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL(mtk_eth_set_pse_port_link_down);
+
+struct mtk_ppe_owner_slot {
+	enum mtk_ppe_owner_state state;
+	struct mtk_ppe_dma_hold hold;
+	bool registered;
+};
+
+struct mtk_ppe_registry {
+	struct list_head list;
+	struct device_node *node;
+	struct mtk_eth *eth;
+	bool live;
+	struct mtk_ppe_owner_slot ppe[MTK_PPE_OWNER_MAX];
+};
+
+static LIST_HEAD(mtk_ppe_registries);
+static DEFINE_MUTEX(mtk_hnat_provider_lock);
+
+static struct mtk_ppe_registry *
+mtk_eth_ppe_registry_get_locked(struct device_node *node)
+{
+	struct mtk_ppe_registry *r;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!node)
+		return NULL;
+
+	list_for_each_entry(r, &mtk_ppe_registries, list)
+		if (r->node == node)
+			return r;
+
+	r = kzalloc(sizeof(*r), GFP_KERNEL);
+	if (!r)
+		return NULL;
+
+	r->node = of_node_get(node);
+	list_add_tail(&r->list, &mtk_ppe_registries);
+	return r;
+}
+
+static void
+mtk_eth_sync_faulted_policies_locked(struct mtk_eth *eth,
+				     struct mtk_ppe_registry *r)
+{
+	unsigned long flags;
+	unsigned int id;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!eth || !r || mtk_is_netsys_v1(eth))
+		return;
+
+	spin_lock_irqsave(&eth->ppe_cfg_lock, flags);
+	for (id = 0; id < MTK_PPE_OWNER_MAX; id++) {
+		struct mtk_ppe_port_policy *p;
+		u32 reg, mask, val;
+
+		if (!mtk_eth_has_ppe_id(eth, id) ||
+		    r->ppe[id].state != MTK_PPE_FAULTED)
+			continue;
+
+		p = &eth->ppe_policy[id];
+		reg = MTK_FE_GLO_CFG(PSE_PPE_PORT(id));
+		mask = MTK_FE_LINK_DOWN_P(PSE_PPE_PORT(id));
+		val = mtk_r32(eth, reg);
+		if (!p->isolated) {
+			p->link_down_was_set = !!(val & mask);
+			p->isolated = true;
+		}
+		p->requested_drop = 0x3fff;
+		p->requested_valid = true;
+		mtk_w32(eth, val | mask, reg);
+		mtk_w32(eth, 0x3fff, PSE_PPE_DROP(id));
+	}
+	spin_unlock_irqrestore(&eth->ppe_cfg_lock, flags);
+}
+
+int mtk_eth_provider_online(struct mtk_eth *eth)
+{
+	struct mtk_ppe_registry *r;
+	int err = 0;
+
+	if (!eth || !eth->dev || !eth->dev->of_node)
+		return -EINVAL;
+
+	mutex_lock(&mtk_hnat_provider_lock);
+
+	if (rcu_access_pointer(g_eth)) {
+		err = -EBUSY;
+		goto out;
+	}
+
+	r = mtk_eth_ppe_registry_get_locked(eth->dev->of_node);
+	if (!r) {
+		err = -ENOMEM;
+		goto out;
+	}
+
+	if (r->live) {
+		err = -EBUSY;
+		goto out;
+	}
+
+	/*
+	 * Allow Ethernet CPU forwarding to come online.
+	 * Any pre-existing FAULTED slot remains latched in the resident
+	 * registry so HNAT claim refuses takeover before DMA allocation.
+	 */
+	r->eth = eth;
+	r->live = true;
+	eth->ppe_registry = r;
+	mtk_eth_sync_faulted_policies_locked(eth, r);
+	rcu_assign_pointer(g_eth, eth);
+
+out:
+	mutex_unlock(&mtk_hnat_provider_lock);
+	return err;
+}
+EXPORT_SYMBOL(mtk_eth_provider_online);
+
+void mtk_eth_provider_offline(struct mtk_eth *eth)
+{
+	struct mtk_ppe_registry *r;
+	unsigned int id;
+
+	if (!eth)
+		return;
+
+	mutex_lock(&mtk_hnat_provider_lock);
+
+	r = eth->ppe_registry;
+
+	if (rcu_access_pointer(g_eth) == eth)
+		RCU_INIT_POINTER(g_eth, NULL);
+
+	if (r && r->eth == eth) {
+		r->live = false;
+		r->eth = NULL;
+
+		for (id = 0; id < MTK_PPE_OWNER_MAX; id++)
+			if (r->ppe[id].state != MTK_PPE_EMPTY ||
+			    r->ppe[id].registered)
+				r->ppe[id].state = MTK_PPE_FAULTED;
+	}
+
+	eth->ppe_registry = NULL;
+	mutex_unlock(&mtk_hnat_provider_lock);
+
+	synchronize_rcu();
+}
+EXPORT_SYMBOL(mtk_eth_provider_offline);
+
+int mtk_eth_hnat_get_supplier(struct device **out)
+{
+	struct mtk_eth *eth;
+	struct mtk_ppe_registry *r;
+	int err = -ENODEV;
+
+	if (!out)
+		return -EINVAL;
+
+	*out = NULL;
+
+	mutex_lock(&mtk_hnat_provider_lock);
+	eth = rcu_dereference_protected(
+		g_eth, lockdep_is_held(&mtk_hnat_provider_lock));
+	if (!eth || !eth->dev || !eth->ethsys)
+		goto out;
+
+	r = eth->ppe_registry;
+	if (!r || !r->live || r->eth != eth)
+		goto out;
+
+	if (test_bit(MTK_REMOVING, &eth->state))
+		goto out;
+
+	*out = get_device(eth->dev);
+	err = *out ? 0 : -ENODEV;
+
+out:
+	mutex_unlock(&mtk_hnat_provider_lock);
+	return err;
+}
+EXPORT_SYMBOL(mtk_eth_hnat_get_supplier);
+
+static int
+mtk_eth_hnat_begin_rtnl(struct mtk_eth_hnat_tx *tx,
+			bool allow_reset, bool owns_rtnl)
+{
+	struct mtk_eth *eth;
+	struct mtk_ppe_registry *r;
+	int err = -ENODEV;
+
+	ASSERT_RTNL();
+
+	if (!tx)
+		return -EINVAL;
+
+	memset(tx, 0, sizeof(*tx));
+	mutex_lock(&mtk_hnat_provider_lock);
+
+	eth = rcu_dereference_protected(
+		g_eth, lockdep_is_held(&mtk_hnat_provider_lock));
+
+	if (!eth || !eth->ethsys)
+		goto fail;
+
+	r = eth->ppe_registry;
+	if (!r || !r->live || r->eth != eth)
+		goto fail;
+
+	if (test_bit(MTK_REMOVING, &eth->state))
+		goto fail;
+
+	if (!allow_reset && test_bit(MTK_RESETTING, &eth->state)) {
+		err = -EBUSY;
+		goto fail;
+	}
+
+	if (allow_reset && !test_bit(MTK_RESETTING, &eth->state)) {
+		err = -EBUSY;
+		goto fail;
+	}
+
+	tx->eth = eth;
+	tx->provider = r;
+	tx->locked = true;
+	tx->owns_rtnl = owns_rtnl;
+	return 0;
+
+fail:
+	mutex_unlock(&mtk_hnat_provider_lock);
+	return err;
+}
+
+int mtk_eth_hnat_begin(struct mtk_eth_hnat_tx *tx)
+{
+	int err;
+
+	if (!tx)
+		return -EINVAL;
+
+	rtnl_lock();
+	err = mtk_eth_hnat_begin_rtnl(tx, false, true);
+	if (err)
+		rtnl_unlock();
+
+	return err;
+}
+EXPORT_SYMBOL(mtk_eth_hnat_begin);
+
+/* Only for synchronous reset notifier (MTK_FE_RESET_NAT_DONE) with RTNL held. */
+int mtk_eth_hnat_begin_reset(struct mtk_eth_hnat_tx *tx)
+{
+	if (!rtnl_is_locked())
+		return -EPERM;
+
+	return mtk_eth_hnat_begin_rtnl(tx, true, false);
+}
+EXPORT_SYMBOL(mtk_eth_hnat_begin_reset);
+
+void mtk_eth_hnat_end(struct mtk_eth_hnat_tx *tx)
+{
+	bool owns_rtnl;
+
+	if (!tx || !tx->locked)
+		return;
+
+	owns_rtnl = tx->owns_rtnl;
+	tx->eth = NULL;
+	tx->provider = NULL;
+	tx->locked = false;
+	tx->owns_rtnl = false;
+
+	mutex_unlock(&mtk_hnat_provider_lock);
+
+	if (owns_rtnl)
+		rtnl_unlock();
+}
+EXPORT_SYMBOL(mtk_eth_hnat_end);
+
+int mtk_eth_claim_ppes_locked(struct mtk_eth_hnat_tx *tx, u32 mask)
+{
+	struct mtk_ppe_registry *r;
+	unsigned int id;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!tx || !tx->locked || !tx->eth || !tx->provider || !mask ||
+	    (mask & ~GENMASK(MTK_PPE_OWNER_MAX - 1, 0)))
+		return -EINVAL;
+
+	r = tx->provider;
+
+	for (id = 0; id < MTK_PPE_OWNER_MAX; id++) {
+		if (!(mask & BIT(id)))
+			continue;
+
+		if (!mtk_eth_has_ppe_id(tx->eth, id))
+			return -EINVAL;
+
+		if (r->ppe[id].state != MTK_PPE_EMPTY ||
+		    r->ppe[id].registered)
+			return -EBUSY;
+	}
+
+	for (id = 0; id < MTK_PPE_OWNER_MAX; id++)
+		if (mask & BIT(id))
+			r->ppe[id].state = MTK_PPE_ACTIVE;
+
+	return 0;
+}
+EXPORT_SYMBOL(mtk_eth_claim_ppes_locked);
+
+int mtk_eth_register_ppes_locked(
+	struct mtk_eth_hnat_tx *tx, u32 mask,
+	const struct mtk_ppe_dma_hold desc[MTK_PPE_OWNER_MAX])
+{
+	struct mtk_ppe_registry *r;
+	unsigned int id;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!tx || !tx->locked || !tx->provider || !desc || !mask ||
+	    (mask & ~GENMASK(MTK_PPE_OWNER_MAX - 1, 0)))
+		return -EINVAL;
+
+	r = tx->provider;
+
+	/* Pre-validate the entire batch before mutating any slot or refcount. */
+	for (id = 0; id < MTK_PPE_OWNER_MAX; id++) {
+		if (!(mask & BIT(id)))
+			continue;
+
+		if (r->ppe[id].state != MTK_PPE_ACTIVE ||
+		    r->ppe[id].registered ||
+		    !desc[id].dma_dev ||
+		    !desc[id].foe_cpu ||
+		    !desc[id].foe_bytes ||
+		    (!!desc[id].mib_cpu != !!desc[id].mib_bytes))
+			return -EINVAL;
+	}
+
+	for (id = 0; id < MTK_PPE_OWNER_MAX; id++) {
+		if (!(mask & BIT(id)))
+			continue;
+
+		r->ppe[id].hold = desc[id];
+		r->ppe[id].hold.dma_dev = get_device(desc[id].dma_dev);
+		r->ppe[id].registered = true;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL(mtk_eth_register_ppes_locked);
+
+void mtk_eth_abort_claim_locked(struct mtk_eth_hnat_tx *tx, u32 mask)
+{
+	struct mtk_ppe_registry *r;
+	unsigned int id;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!tx || !tx->locked || !tx->provider)
+		return;
+
+	r = tx->provider;
+	for (id = 0; id < MTK_PPE_OWNER_MAX; id++)
+		if ((mask & BIT(id)) &&
+		    r->ppe[id].state == MTK_PPE_ACTIVE &&
+		    !r->ppe[id].registered)
+			r->ppe[id].state = MTK_PPE_EMPTY;
+}
+EXPORT_SYMBOL(mtk_eth_abort_claim_locked);
+
+int mtk_eth_can_warm_init_ppes_locked(struct mtk_eth_hnat_tx *tx, u32 mask)
+{
+	struct mtk_ppe_registry *r;
+	unsigned int id;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!tx || !tx->locked || !tx->eth || !tx->provider || !mask ||
+	    (mask & ~GENMASK(MTK_PPE_OWNER_MAX - 1, 0)))
+		return -EINVAL;
+
+	r = tx->provider;
+	for (id = 0; id < MTK_PPE_OWNER_MAX; id++) {
+		if (!(mask & BIT(id)))
+			continue;
+
+		if (!mtk_eth_has_ppe_id(tx->eth, id))
+			return -EINVAL;
+
+		if (r->ppe[id].state != MTK_PPE_ACTIVE ||
+		    !r->ppe[id].registered)
+			return -EBUSY;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL(mtk_eth_can_warm_init_ppes_locked);
+
+void mtk_eth_fault_ppe_locked(struct mtk_ppe_registry *r, u32 id)
+{
+	unsigned long flags;
+	struct mtk_eth *eth;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (WARN_ON_ONCE(!r || id >= MTK_PPE_OWNER_MAX))
+		return;
+
+	r->ppe[id].state = MTK_PPE_FAULTED;
+
+	eth = r->live ? r->eth : NULL;
+	if (eth && !mtk_is_netsys_v1(eth) && mtk_eth_has_ppe_id(eth, id)) {
+		struct mtk_ppe_port_policy *p;
+		u32 reg, mask, val;
+
+		spin_lock_irqsave(&eth->ppe_cfg_lock, flags);
+		p = &eth->ppe_policy[id];
+		reg = MTK_FE_GLO_CFG(PSE_PPE_PORT(id));
+		mask = MTK_FE_LINK_DOWN_P(PSE_PPE_PORT(id));
+		val = mtk_r32(eth, reg);
+		if (!p->isolated) {
+			p->link_down_was_set = !!(val & mask);
+			if (!p->requested_valid) {
+				p->requested_drop = mtk_r32(eth, PSE_PPE_DROP(id));
+				p->requested_valid = true;
+			}
+			p->isolated = true;
+		}
+		mtk_w32(eth, val | mask, reg);
+		mtk_w32(eth, 0x3fff, PSE_PPE_DROP(id));
+		spin_unlock_irqrestore(&eth->ppe_cfg_lock, flags);
+	}
+}
