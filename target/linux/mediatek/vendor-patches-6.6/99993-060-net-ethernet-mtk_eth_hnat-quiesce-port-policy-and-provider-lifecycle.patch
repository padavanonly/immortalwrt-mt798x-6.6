+void mtk_eth_fault_ppe(struct mtk_ppe_registry *r, u32 id)
+{
+	mutex_lock(&mtk_hnat_provider_lock);
+	if (!WARN_ON_ONCE(!r || id >= MTK_PPE_OWNER_MAX))
+		r->ppe[id].state = MTK_PPE_FAULTED;
+	mutex_unlock(&mtk_hnat_provider_lock);
+}
+EXPORT_SYMBOL(mtk_eth_fault_ppe);
