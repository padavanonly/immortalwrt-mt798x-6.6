+int mtk_eth_mark_ppe_quiesced_locked(struct mtk_eth_hnat_tx *tx, u32 id)
+{
+	struct mtk_ppe_owner_slot *s;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!tx || !tx->locked || !tx->provider || id >= MTK_PPE_OWNER_MAX)
+		return -EINVAL;
+
+	s = &tx->provider->ppe[id];
+	if (s->state != MTK_PPE_ACTIVE || !s->registered)
+		return -EBUSY;
+
+	s->state = MTK_PPE_QUIESCED;
+	return 0;
+}
+EXPORT_SYMBOL(mtk_eth_mark_ppe_quiesced_locked);
