+int mtk_eth_quiesce_ppe_locked(struct mtk_eth_hnat_tx *tx, u32 ppe_id)
+{
+	struct mtk_eth *eth;
+	unsigned long flags;
+	struct mtk_ppe_port_policy *p;
+	u32 rst_mask = 0;
+	u32 reg, mask, val;
+	int ret = 0;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!tx || !tx->locked || !tx->eth)
+		return -EINVAL;
+
+	eth = tx->eth;
+	if (!mtk_eth_has_ppe_id(eth, ppe_id))
+		return -EINVAL;
+
+	if (ppe_id == 0) {
+		if (mtk_is_netsys_v3_or_greater(eth))
+			rst_mask = RSTCTRL_PPE0_V3;
+		else if (mtk_is_netsys_v2_or_greater(eth))
+			rst_mask = RSTCTRL_PPE0_V2;
+		else
+			rst_mask = RSTCTRL_PPE0;
+	} else if (ppe_id == 1) {
+		rst_mask = mtk_is_netsys_v3_or_greater(eth) ?
+			   RSTCTRL_PPE1_V3 : RSTCTRL_PPE1;
+	} else if (ppe_id == 2) {
+		rst_mask = RSTCTRL_PPE2;
+	} else {
+		return -EINVAL;
+	}
+
+	if (!mtk_is_netsys_v1(eth)) {
+		spin_lock_irqsave(&eth->ppe_cfg_lock, flags);
+		p = &eth->ppe_policy[ppe_id];
+		reg = MTK_FE_GLO_CFG(PSE_PPE_PORT(ppe_id));
+		mask = MTK_FE_LINK_DOWN_P(PSE_PPE_PORT(ppe_id));
+		val = mtk_r32(eth, reg);
+		if (!p->isolated) {
+			p->link_down_was_set = !!(val & mask);
+			if (!p->requested_valid) {
+				p->requested_drop = mtk_r32(eth, PSE_PPE_DROP(ppe_id));
+				p->requested_valid = true;
+			}
+			p->isolated = true;
+		}
+		val |= mask;
+		mtk_w32(eth, val, reg);
+		mtk_w32(eth, 0x3fff, PSE_PPE_DROP(ppe_id));
+		spin_unlock_irqrestore(&eth->ppe_cfg_lock, flags);
+	}
+
+	regmap_update_bits(eth->ethsys, ETHSYS_RSTCTRL, rst_mask, rst_mask);
+	if (readx_poll_timeout_atomic(mtk_hw_reset_read, eth, val,
+				      val & rst_mask, 1, 1000)) {
+		dev_err(eth->dev, "ppe%u reset assert timeout\n", ppe_id);
+		return -ETIMEDOUT;
+	}
+
+	regmap_update_bits(eth->ethsys, ETHSYS_RSTCTRL, rst_mask, ~rst_mask);
+	if (readx_poll_timeout_atomic(mtk_hw_reset_read, eth, val,
+				      !(val & rst_mask), 1, 1000)) {
+		dev_err(eth->dev, "ppe%u reset deassert timeout\n", ppe_id);
+		ret = -ETIMEDOUT;
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL(mtk_eth_quiesce_ppe_locked);
+
+int mtk_eth_resume_ppe_locked(struct mtk_eth_hnat_tx *tx, u32 ppe_mask)
+{
+	struct mtk_eth *eth;
+	unsigned long flags;
+	struct mtk_ppe_port_policy *p;
+	u32 reg, mask, val;
+	u32 id;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!tx || !tx->locked || !tx->eth || !tx->provider)
+		return -EINVAL;
+
+	eth = tx->eth;
+	if (ppe_mask & ~GENMASK(MTK_PPE_OWNER_MAX - 1, 0))
+		return -EINVAL;
+
+	for (id = 0; id < MTK_PPE_OWNER_MAX; id++) {
+		if (!(ppe_mask & BIT(id)))
+			continue;
+		if (!mtk_eth_has_ppe_id(eth, id))
+			return -EINVAL;
+		if (tx->provider->ppe[id].state == MTK_PPE_FAULTED)
+			return -EBUSY;
+	}
+
+	if (!mtk_is_netsys_v1(eth)) {
+		spin_lock_irqsave(&eth->ppe_cfg_lock, flags);
+		for (id = 0; id < ARRAY_SIZE(eth->ppe_policy); id++) {
+			if (!(ppe_mask & BIT(id)))
+				continue;
+
+			p = &eth->ppe_policy[id];
+			if (p->isolated) {
+				reg = MTK_FE_GLO_CFG(PSE_PPE_PORT(id));
+				mask = MTK_FE_LINK_DOWN_P(PSE_PPE_PORT(id));
+				val = mtk_r32(eth, reg);
+				val = (val & ~mask) | (p->link_down_was_set ? mask : 0);
+				mtk_w32(eth, val, reg);
+				p->isolated = false;
+			}
+			if (p->requested_valid)
+				mtk_w32(eth, p->requested_drop, PSE_PPE_DROP(id));
+		}
+		spin_unlock_irqrestore(&eth->ppe_cfg_lock, flags);
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL(mtk_eth_resume_ppe_locked);
+
+int mtk_eth_quiesce_ppe_sync(u32 ppe_id)
+{
+	struct mtk_eth_hnat_tx tx;
+	int ret;
+
+	if (ppe_id >= MTK_PPE_OWNER_MAX)
+		return -EINVAL;
+
+	ret = mtk_eth_hnat_begin(&tx);
+	if (ret)
+		return ret;
+
+	ret = mtk_eth_quiesce_ppe_locked(&tx, ppe_id);
+	mtk_eth_hnat_end(&tx);
+	return ret;
+}
+EXPORT_SYMBOL(mtk_eth_quiesce_ppe_sync);
+
+int mtk_eth_resume_ppe_sync(u32 ppe_id)
+{
+	struct mtk_eth_hnat_tx tx;
+	int ret;
+
+	if (ppe_id >= MTK_PPE_OWNER_MAX)
+		return -EINVAL;
+
+	ret = mtk_eth_hnat_begin(&tx);
+	if (ret)
+		return ret;
+
+	ret = mtk_eth_resume_ppe_locked(&tx, BIT(ppe_id));
+	mtk_eth_hnat_end(&tx);
+	return ret;
+}
+EXPORT_SYMBOL(mtk_eth_resume_ppe_sync);
