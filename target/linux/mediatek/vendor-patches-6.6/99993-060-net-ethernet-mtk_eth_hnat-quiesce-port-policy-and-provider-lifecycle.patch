+int mtk_eth_free_ppe_dma_locked(struct mtk_eth_hnat_tx *tx, u32 id)
+{
+	struct mtk_ppe_owner_slot *s;
+	struct mtk_ppe_dma_hold d;
+
+	lockdep_assert_held(&mtk_hnat_provider_lock);
+
+	if (!tx || !tx->locked || !tx->provider || id >= MTK_PPE_OWNER_MAX)
+		return -EINVAL;
+
+	s = &tx->provider->ppe[id];
+	if (s->state != MTK_PPE_QUIESCED || !s->registered)
+		return -EBUSY;
+
+	d = s->hold;
+
+	if (d.mib_cpu)
+		dma_free_coherent(d.dma_dev, d.mib_bytes,
+				  d.mib_cpu, d.mib_dma);
+
+	dma_free_coherent(d.dma_dev, d.foe_bytes,
+			  d.foe_cpu, d.foe_dma);
+
+	memset(&s->hold, 0, sizeof(s->hold));
+	s->registered = false;
+	s->state = MTK_PPE_EMPTY;
+	put_device(d.dma_dev);
+	return 0;
+}
+EXPORT_SYMBOL(mtk_eth_free_ppe_dma_locked);
