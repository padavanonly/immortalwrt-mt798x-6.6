+
+	if (!ct)
+		return NULL;
+
+	hash_for_each_possible_rcu(nf_flow_ct_ht, flow, hnat_ct_node,
+				   (unsigned long)ct) {
+		if (flow->ct == ct && !test_bit(NF_FLOW_TEARDOWN, &flow->flags))
+			return flow;
+	}
+
+	return NULL;
+}
+EXPORT_SYMBOL_GPL(nf_flow_table_lookup_by_ct_rcu);
+
+int nf_flow_table_flush_by_ct(struct nf_conn *ct)
+{
+	struct flow_offload *flow;
+	int flushed = 0;
+
+	if (!ct)
+		return 0;
+
+	rcu_read_lock();
+	hash_for_each_possible_rcu(nf_flow_ct_ht, flow, hnat_ct_node,
+				   (unsigned long)ct) {
+		if (flow->ct == ct && !test_bit(NF_FLOW_TEARDOWN, &flow->flags)) {
+			flow_offload_teardown(flow);
+			flushed++;
+		}
+	}
+	rcu_read_unlock();
