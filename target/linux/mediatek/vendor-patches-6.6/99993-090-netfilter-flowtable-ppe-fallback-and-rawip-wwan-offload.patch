+static int mtk_flow_multitier_proc_show(struct seq_file *seq, void *v)
+{
+	u32 bind = 0, total = 0, permille = 0;
+	u64 tier2_flows, tier2_pkts = 0, tier2_bytes = 0;
+	u64 defers, backoffs, roams, ser_epoch = 0;
+	s64 raw_flows;
+	int cpu;
+
+	nf_flow_multitier_get_ppe_occupancy(&bind, &total);
+	if (total) {
+		u64 raw = div_u64((u64)bind * 1000ULL, total);
+
+		permille = (raw > 1000ULL) ? 1000U : (u32)raw;
+	}
+
+	for_each_possible_cpu(cpu) {
+		const struct mtk_flow_tier2_pcpu_stats *st =
+			per_cpu_ptr(&mtk_flow_tier2_stats, cpu);
+		unsigned int start;
+		u64 p, b;
+
+		do {
+			start = u64_stats_fetch_begin(&st->syncp);
+			p = u64_stats_read(&st->packets);
+			b = u64_stats_read(&st->bytes);
+		} while (u64_stats_fetch_retry(&st->syncp, start));
+
+		tier2_pkts += p;
+		tier2_bytes += b;
+	}
+
+	raw_flows = atomic64_read(&mtk_flow_tier2_sw_flows);
+	tier2_flows = raw_flows > 0 ? (u64)raw_flows : 0ULL;
+	defers = (u64)atomic64_read(&mtk_flow_watermark_defers);
+	backoffs = (u64)atomic64_read(&mtk_flow_hw_fail_backoffs);
+	roams = (u64)atomic64_read(&mtk_flow_roam_flushes);
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_SOC) && IS_REACHABLE(CONFIG_NET_MEDIATEK_SOC)
+	ser_epoch = mtk_hnat_get_ser_epoch();
+#endif
+
+	seq_printf(seq, "tier1_ppe_bind %u\n", bind);
+	seq_printf(seq, "tier1_ppe_total %u\n", total);
+	seq_printf(seq, "tier1_occupancy_permille %u\n", permille);
+	seq_printf(seq, "tier2_sw_flows %llu\n", tier2_flows);
+	seq_printf(seq, "tier2_sw_packets %llu\n", tier2_pkts);
+	seq_printf(seq, "tier2_sw_bytes %llu\n", tier2_bytes);
+	seq_printf(seq, "watermark_defers %llu\n", defers);
+	seq_printf(seq, "hw_fail_backoffs %llu\n", backoffs);
+	seq_printf(seq, "roam_flushes %llu\n", roams);
+	seq_printf(seq, "ser_epoch %llu\n", ser_epoch);
+	return 0;
+}
+
+static int mtk_flow_multitier_proc_init(void)
+{
+	mtk_flow_multitier_proc_entry = proc_create_single("mtk_flow_multitier",
+							   0444,
+							   init_net.proc_net_stat,
+							   mtk_flow_multitier_proc_show);
+	if (!mtk_flow_multitier_proc_entry)
+		return -ENOMEM;
+
+	return 0;
+}
+
+static void mtk_flow_multitier_proc_exit(void)
+{
+	if (mtk_flow_multitier_proc_entry) {
+		remove_proc_entry("mtk_flow_multitier",
+				  init_net.proc_net_stat);
+		mtk_flow_multitier_proc_entry = NULL;
+	}
+}
+#else
+static inline int mtk_flow_multitier_proc_init(void)
+{
+	return 0;
+}
+
+static inline void mtk_flow_multitier_proc_exit(void)
+{
+}
+#endif
