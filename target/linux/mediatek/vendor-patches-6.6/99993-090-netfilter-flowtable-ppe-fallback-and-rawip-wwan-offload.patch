+bool nf_flow_multitier_ppe_over_watermark(void)
+{
+	u32 bound = 0, total = 0, permille;
+
+	nf_flow_multitier_get_ppe_occupancy(&bound, &total);
+	if (!total)
+		return false;
+
+	permille = min_t(u32, 1000U, (u32)div_u64((u64)bound * 1000ULL, total));
+	return permille >= MTK_PPE_OCCUPANCY_WATERMARK_PERMILLE;
