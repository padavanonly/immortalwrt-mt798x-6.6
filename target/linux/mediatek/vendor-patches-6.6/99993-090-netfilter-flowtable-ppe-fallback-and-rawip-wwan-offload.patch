+	out = dst ? dst->dev : NULL;
+	if (out && IS_BOND(out))
+		return false;
+	if (out && !IS_WHNAT(out) && IS_EXT(out) &&
+	    IS_SPACE_AVAILABLE_HEAD(skb) && is_magic_tag_valid(skb) &&
+	    FROM_WED(skb))
+		return false;
+	if (skb->mark == HNAT_EXCEPTION_TAG)
+		return false;
+
+	if (IS_SPACE_AVAILABLE_HEAD(skb) && is_magic_tag_valid(skb)) {
+		u32 ppe_id = skb_hnat_ppe(skb);
+		u32 foe_idx = skb_hnat_entry(skb);
+
+		if (skb_hnat_alg(skb) || !skb_hnat_is_hashed(skb))
+			return false;
+
+		if (ppe_id < CFG_PPE_NUM && ppe_id < MAX_PPE_NUM &&
+		    foe_idx < hnat_priv->foe_etry_num &&
+		    hnat_priv->foe_table_cpu[ppe_id]) {
+			const struct foe_entry *entry =
+				&hnat_priv->foe_table_cpu[ppe_id][foe_idx];
+
+			if (skb_hnat_reason(skb) == UN_HIT &&
+			    entry_hnat_is_bound(entry))
