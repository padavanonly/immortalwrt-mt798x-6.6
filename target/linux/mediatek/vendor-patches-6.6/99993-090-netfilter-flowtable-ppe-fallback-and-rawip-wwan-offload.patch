+static bool hnat_multitier_defer_sw_admit(const struct sk_buff *skb,
+					  const struct nf_conn *ct)
+{
+	const struct dst_entry *dst;
+	const struct net_device *out;
+
+	(void)ct;
+	if (!hook_toggle || !hnat_priv || !READ_ONCE(hnat_priv->fe_base) || !skb)
+		return false;
+
+	if (nf_flow_multitier_ppe_over_watermark()) {
+		if (!(IS_SPACE_AVAILABLE_HEAD(skb) && is_magic_tag_valid(skb) &&
+		      skb_hnat_reason(skb) == HIT_UNBIND_RATE_REACH))
+			nf_flow_multitier_inc_watermark_defer();
+		return false;
+	}
+
+	dst = skb_dst(skb);
+	if (dst && dst_xfrm(dst))
+		return false;
