+static inline bool hnat_dev_is_rawip_ext(const struct net_device *dev)
+{
+	return dev && (dev->type == ARPHRD_NONE || dev->type == ARPHRD_RAWIP);
+}
+
+static inline bool hnat_dev_is_noarp_ext(const struct net_device *dev)
+{
+	return dev && (hnat_dev_is_rawip_ext(dev) ||
+		       (dev->flags & (IFF_NOARP | IFF_POINTOPOINT)));
+}
+
+static inline bool hnat_skb_has_eth_hdr(const struct sk_buff *skb)
+{
+	const unsigned char *net_hdr;
+
+	if (!skb || !skb_mac_header_was_set(skb))
+		return false;
+
+	net_hdr = (const unsigned char *)ip_hdr(skb);
+	if (!net_hdr || net_hdr > skb->data)
+		return false;
+
+	return skb_mac_header(skb) < net_hdr &&
+	       (size_t)(net_hdr - skb_mac_header(skb)) >= ETH_HLEN;
+}
+
+static inline __be16 hnat_skb_l3_proto(const struct sk_buff *skb)
+{
+	const struct iphdr *iph;
+
+	if (!skb)
+		return 0;
+
+	if (skb->protocol == htons(ETH_P_IP) ||
+	    skb->protocol == htons(ETH_P_IPV6))
+		return skb->protocol;
+
+	if (skb->len < 1)
+		return 0;
+
+	iph = ip_hdr(skb);
+	if ((const unsigned char *)iph >= skb->head &&
+	    (const unsigned char *)iph <= skb->data) {
+		if (iph->version == 6)
+			return htons(ETH_P_IPV6);
+		if (iph->version == 4)
+			return htons(ETH_P_IP);
+		return 0;
+	}
+
+	if (skb_headlen(skb) >= 1) {
+		u8 ver = skb->data[0] >> 4;
+
+		if (ver == 6)
+			return htons(ETH_P_IPV6);
+		if (ver == 4)
+			return htons(ETH_P_IP);
+	}
+
+	return 0;
+}
+
+static inline void hnat_fill_ext_wwan_mac(int ext_slot, u8 *mac)
+{
+	mac[0] = 0x02;
+	mac[1] = 'm';
+	mac[2] = 't';
+	mac[3] = 'k';
+	mac[4] = 'w';
+	mac[5] = (u8)(ext_slot & 0xff);
+}
+
+static inline void hnat_fill_ext_ppd_mac(const struct net_device *ppd, u8 *mac)
+{
+	static const u8 fallback_ppd_mac[ETH_ALEN] = {
+		0x02, 'm', 't', 'k', 'p', 0x01
+	};
+
+	if (ppd && is_valid_ether_addr(ppd->dev_addr))
+		ether_addr_copy(mac, ppd->dev_addr);
+	else
+		ether_addr_copy(mac, fallback_ppd_mac);
+}
+
+static inline void hnat_fill_rawip_pseudo_eth(struct ethhdr *eth,
+					      const struct net_device *wwan_dev,
+					      __be16 proto, int ext_slot,
+					      const struct net_device *ppd)
+{
+	(void)wwan_dev;
+	if (!eth)
+		return;
+
+	hnat_fill_ext_ppd_mac(ppd, eth->h_dest);
+	hnat_fill_ext_wwan_mac(ext_slot, eth->h_source);
+	eth->h_proto = proto;
+}
+
