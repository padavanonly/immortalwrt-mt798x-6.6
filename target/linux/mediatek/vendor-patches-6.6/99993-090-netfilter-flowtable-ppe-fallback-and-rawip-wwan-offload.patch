+int mtk_flow_multitier_register_ops(const struct mtk_flow_multitier_ops *ops)
+{
+	const struct mtk_flow_multitier_ops *cur;
+
+	if (!ops)
+		return -EINVAL;
+
+	mutex_lock(&mtk_flow_multitier_ops_lock);
+	cur = rcu_dereference_protected(mtk_flow_multitier_ops_ptr,
+					lockdep_is_held(&mtk_flow_multitier_ops_lock));
+	if (cur && cur != ops) {
+		mutex_unlock(&mtk_flow_multitier_ops_lock);
+		return -EBUSY;
+	}
+	rcu_assign_pointer(mtk_flow_multitier_ops_ptr, ops);
+	mutex_unlock(&mtk_flow_multitier_ops_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_flow_multitier_register_ops);
+
+void mtk_flow_multitier_unregister_ops(const struct mtk_flow_multitier_ops *ops)
+{
+	const struct mtk_flow_multitier_ops *cur;
+
+	mutex_lock(&mtk_flow_multitier_ops_lock);
+	cur = rcu_dereference_protected(mtk_flow_multitier_ops_ptr,
+					lockdep_is_held(&mtk_flow_multitier_ops_lock));
+	if (!ops || cur == ops) {
+		RCU_INIT_POINTER(mtk_flow_multitier_ops_ptr, NULL);
+		mutex_unlock(&mtk_flow_multitier_ops_lock);
+		synchronize_rcu();
