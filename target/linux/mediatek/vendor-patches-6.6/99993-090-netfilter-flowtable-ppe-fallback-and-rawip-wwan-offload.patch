+static void hnat_fill_ext_nexthop_macs(const struct net_device *out,
+				       int ext_slot, bool rawip,
+				       u8 *dmac, u8 *smac)
+{
+	struct net_device *ppd =
+		hnat_priv ? READ_ONCE(hnat_priv->g_ppdev) : NULL;
+
+	hnat_fill_ext_wwan_mac(ext_slot, dmac);
+	if (!rawip && out && is_valid_ether_addr(out->dev_addr))
+		ether_addr_copy(smac, out->dev_addr);
+	else
+		hnat_fill_ext_ppd_mac(ppd, smac);
+}
+
+static void hnat_write_skb_eth_macs(struct sk_buff *skb, bool is_v6_ipip,
+				    u16 ipip_offset, const u8 *dmac,
+				    const u8 *smac)
+{
+	struct ethhdr *eth;
+
+	if (!hnat_skb_has_eth_hdr(skb))
+		return;
+
+	if (is_v6_ipip) {
+		if (skb_headroom(skb) <
+		    (unsigned int)(FOE_INFO_LEN + ipip_offset))
+			return;
+		eth = (struct ethhdr *)(skb->data - ipip_offset);
+		eth->h_proto = skb->protocol;
+	} else {
+		eth = eth_hdr(skb);
+	}
+
+	ether_addr_copy(eth->h_dest, dmac);
+	ether_addr_copy(eth->h_source, smac);
+}
