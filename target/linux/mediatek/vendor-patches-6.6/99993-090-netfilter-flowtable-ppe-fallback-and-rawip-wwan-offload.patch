+static bool hnat_foe_entry_matches_mac(const struct foe_entry *entry,
+				       const u8 *mac)
+{
+	u8 dmac[ETH_ALEN], smac[ETH_ALEN];
+
+	if (IS_IPV4_GRP(entry)) {
+		foe_dmac_to_bytes(dmac, entry->ipv4_hnapt.dmac_hi,
+				  entry->ipv4_hnapt.dmac_lo);
+		foe_dmac_to_bytes(smac, entry->ipv4_hnapt.smac_hi,
+				  entry->ipv4_hnapt.smac_lo);
+	} else {
+		foe_dmac_to_bytes(dmac, entry->ipv6_5t_route.dmac_hi,
+				  entry->ipv6_5t_route.dmac_lo);
+		foe_dmac_to_bytes(smac, entry->ipv6_5t_route.smac_hi,
+				  entry->ipv6_5t_route.smac_lo);
+	}
+
+	return ether_addr_equal(dmac, mac) || ether_addr_equal(smac, mac);
+}
+
+static void hnat_multitier_get_ppe_occupancy(u32 *bound, u32 *total)
+{
+	u32 b = 0, t = 0;
+	u32 i, idx;
+
+	if (!bound || !total)
+		return;
+
+	*bound = 0;
+	*total = 0;
+
+	if (!hnat_priv || !READ_ONCE(hnat_priv->fe_base))
+		return;
+
+	spin_lock_bh(&hnat_priv->entry_lock);
+	if (!hnat_priv->fe_base) {
+		spin_unlock_bh(&hnat_priv->entry_lock);
+		return;
+	}
+
+	for (i = 0; i < CFG_PPE_NUM && i < MAX_PPE_NUM; i++) {
+		const struct foe_entry *table = hnat_priv->foe_table_cpu[i];
+
+		if (!table || !hnat_priv->ppe_base[i])
+			continue;
+
+		t += hnat_priv->foe_etry_num;
+		for (idx = 0; idx < hnat_priv->foe_etry_num; idx++) {
+			if (table[idx].bfib1.state == BIND)
+				b++;
+		}
+	}
+	spin_unlock_bh(&hnat_priv->entry_lock);
+
+	*bound = b;
+	*total = t;
+}
+
+static bool hnat_multitier_roam_flush(const u8 *mac,
+				      const struct net_device *dev, u16 vid)
+{
+	struct foe_entry *entry;
+	struct hnat_foe_nh_meta *meta;
+	bool invalidated = false;
+	u32 i, hash_index;
+
+	(void)dev;
+	(void)vid;
+
+	if (!mac || !hnat_priv || !READ_ONCE(hnat_priv->fe_base))
+		return false;
+
+	spin_lock_bh(&hnat_priv->entry_lock);
+	if (!hnat_priv->fe_base) {
+		spin_unlock_bh(&hnat_priv->entry_lock);
+		return false;
+	}
+
+	for (i = 0; i < CFG_PPE_NUM && i < MAX_PPE_NUM; i++) {
+		if (!hnat_priv->foe_table_cpu[i] || !hnat_priv->ppe_base[i])
+			continue;
+
+		for (hash_index = 0; hash_index < hnat_priv->foe_etry_num;
+		     hash_index++) {
+			bool pre_filled;
+
+			entry = hnat_priv->foe_table_cpu[i] + hash_index;
+			meta = hnat_priv->nh_meta[i] ?
+			       &hnat_priv->nh_meta[i][hash_index] : NULL;
+			pre_filled = (entry->bfib1.state == UNBIND &&
+				      is_hnat_pre_filled(entry));
+
+			if (entry->bfib1.state != BIND && !pre_filled)
+				continue;
+
+			if (!hnat_foe_entry_matches_mac(entry, mac))
+				continue;
+
+			cr_set_field(hnat_priv->ppe_base[i] + PPE_TB_CFG,
+				     SMA, SMA_ONLY_FWD_CPU);
+			entry->udib1.state = INVALID;
+			entry->udib1.time_stamp =
+				readl(hnat_priv->fe_base + 0x0010) & 0xFF;
+			foe_clear_pre_filled(entry);
+			if (meta)
+				meta->valid = 0;
+			invalidated = true;
+		}
+	}
+
+	if (invalidated) {
+		for (i = 0; i < CFG_PPE_NUM && i < MAX_PPE_NUM; i++) {
+			if (!hnat_priv->ppe_base[i])
+				continue;
+			cr_set_field(hnat_priv->ppe_base[i] + PPE_CAH_CTRL,
+				     CAH_X_MODE, 1);
+			cr_set_field(hnat_priv->ppe_base[i] + PPE_CAH_CTRL,
+				     CAH_X_MODE, 0);
+			cr_set_field(hnat_priv->ppe_base[i] + PPE_CAH_CTRL,
+				     CAH_EN, 1);
+		}
+		mod_timer(&hnat_priv->hnat_sma_build_entry_timer,
+			  jiffies + 3 * HZ);
+	}
+	spin_unlock_bh(&hnat_priv->entry_lock);
+
+	return invalidated;
+}
+
+static bool hnat_multitier_ingress_pass_to_hnat(const struct sk_buff *skb,
+						const struct net_device *in_dev,
+						bool *is_promote_candidate)
+{
+	if (!is_promote_candidate)
+		return false;
+
+	*is_promote_candidate = false;
+	if (!skb)
+		return false;
+
+	if (IS_SPACE_AVAILABLE_HEAD(skb) && is_magic_tag_valid(skb)) {
+		switch (skb_hnat_reason(skb)) {
+		case HIT_BIND_KEEPALIVE_DUP_OLD_HDR:
+		case HIT_BIND_MULTICAST_TO_CPU:
+		case HIT_BIND_MULTICAST_TO_GMAC_CPU:
+			return true;
+		case HIT_UNBIND_RATE_REACH:
+			if (hook_toggle && hnat_priv &&
+			    READ_ONCE(hnat_priv->fe_base) &&
+			    !skb_hnat_alg(skb) &&
+			    skb->mark != HNAT_EXCEPTION_TAG &&
+			    !nf_flow_multitier_ppe_over_watermark()) {
+				*is_promote_candidate = true;
+				return true;
+			}
+			return false;
+		default:
+			break;
+		}
+	}
+
+	if (in_dev && !IS_WHNAT(in_dev) && IS_EXT(in_dev) &&
+	    !is_from_extge(skb) && !skb_is_gso(skb) &&
+	    !skb_shinfo(skb)->frag_list) {
+		if (hook_toggle && hnat_priv && READ_ONCE(hnat_priv->fe_base) &&
+		    skb->mark != HNAT_EXCEPTION_TAG &&
+		    !nf_flow_multitier_ppe_over_watermark()) {
+			*is_promote_candidate = true;
+			return true;
+		}
+		return false;
+	}
+
+	return false;
+}
