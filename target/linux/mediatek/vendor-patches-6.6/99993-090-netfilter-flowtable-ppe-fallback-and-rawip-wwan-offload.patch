+
+void nf_flow_multitier_note_hw_fail(struct flow_offload *flow,
+				    bool count_metric)
+{
+	u8 cnt, shift;
+	unsigned long backoff;
+
+	if (!flow)
+		return;
+
+	cnt = READ_ONCE(flow->hw_fail_cnt);
+	shift = min_t(u8, cnt, 6);
+	backoff = min_t(unsigned long, (unsigned long)HZ << shift, 60UL * HZ);
+
+	if (cnt < U8_MAX)
+		WRITE_ONCE(flow->hw_fail_cnt, cnt + 1);
+	WRITE_ONCE(flow->hw_retry_ts, jiffies + backoff);
+	if (count_metric)
+		nf_flow_multitier_inc_hw_fail_backoff();
+}
+EXPORT_SYMBOL_GPL(nf_flow_multitier_note_hw_fail);
+
+static bool nf_flow_tuple_matches_mac(const struct flow_offload *flow,
+				      enum flow_offload_tuple_dir dir,
+				      const u8 *mac)
+{
+	const struct flow_offload_tuple *tuple = &flow->tuplehash[dir].tuple;
+	const struct flow_offload_tuple *other_tuple = &flow->tuplehash[!dir].tuple;
+	const struct dst_entry *dst;
+	struct neighbour *n;
+	bool matched = false;
+
+	if (tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT) {
+		return ether_addr_equal(tuple->out.h_dest, mac) ||
+		       ether_addr_equal(tuple->out.h_source, mac);
+	}
+
+	if (tuple->xmit_type == FLOW_OFFLOAD_XMIT_NEIGH) {
+		dst = READ_ONCE(tuple->dst_cache);
+		if (dst && dst->ops && dst->ops->neigh_lookup) {
+			const void *daddr = (tuple->l3proto == NFPROTO_IPV4) ?
+				(const void *)&other_tuple->src_v4 :
+				(const void *)&other_tuple->src_v6;
+
+			n = dst_neigh_lookup(dst, daddr);
+			if (n) {
+				read_lock_bh(&n->lock);
+				matched = ether_addr_equal(n->ha, mac);
+				read_unlock_bh(&n->lock);
+				neigh_release(n);
+			}
+		}
+	}
+
+	return matched;
+}
+
+void nf_flow_multitier_roam_flush(const u8 *mac, const struct net_device *dev,
+				  u16 vid)
+{
+	const struct mtk_flow_multitier_ops *ops;
+	struct flow_offload *flow;
+	unsigned int bkt;
+	bool flushed = false;
+
+	if (!mac || is_zero_ether_addr(mac) || is_multicast_ether_addr(mac))
+		return;
+
+	rcu_read_lock();
+	ops = rcu_dereference(mtk_flow_multitier_ops_ptr);
+	if (ops && ops->roam_flush_mac && ops->roam_flush_mac(mac, dev, vid))
+		flushed = true;
+
+	hash_for_each_rcu(nf_flow_ct_ht, bkt, flow, hnat_ct_node) {
+		if (test_bit(NF_FLOW_TEARDOWN, &flow->flags))
+			continue;
+
+		if (nf_flow_tuple_matches_mac(flow, FLOW_OFFLOAD_DIR_ORIGINAL, mac) ||
+		    nf_flow_tuple_matches_mac(flow, FLOW_OFFLOAD_DIR_REPLY, mac)) {
+			flow_offload_teardown(flow);
+			flushed = true;
+		}
+	}
+	rcu_read_unlock();
+
+	if (flushed)
+		atomic64_inc(&mtk_flow_roam_flushes);
+}
+EXPORT_SYMBOL_GPL(nf_flow_multitier_roam_flush);
+
+static int nf_flow_table_switchdev_event(struct notifier_block *this,
+					 unsigned long event, void *ptr)
+{
+	const struct switchdev_notifier_fdb_info *fdb_info;
+
+	if (event != SWITCHDEV_FDB_ADD_TO_DEVICE &&
+	    event != SWITCHDEV_FDB_ADD_TO_BRIDGE)
+		return NOTIFY_DONE;
+
+	fdb_info = ptr;
+	if (!fdb_info || !fdb_info->addr)
+		return NOTIFY_DONE;
+
+	if (fdb_info->is_local)
+		return NOTIFY_DONE;
+
+	nf_flow_multitier_roam_flush(fdb_info->addr,
+				     switchdev_notifier_info_to_dev(&fdb_info->info),
+				     fdb_info->vid);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block flow_offload_switchdev_notifier = {
+	.notifier_call	= nf_flow_table_switchdev_event,
+};
