+static void mtk_free_mac_slot(struct mtk_eth *eth, int id)
+{
+	struct net_device *ndev = eth->netdev[id];
+	struct mtk_mac *mac;
+
+	if (!ndev)
+		return;
+
+	mac = netdev_priv(ndev);
+	if (mac->phylink) {
+		rtnl_lock();
+		phylink_disconnect_phy(mac->phylink);
+		rtnl_unlock();
+		phylink_destroy(mac->phylink);
+		mac->phylink = NULL;
+	}
+
+	if (!IS_ERR_OR_NULL(mac->sgmii_pcs)) {
+		mtk_pcs_lynxi_put(mac->sgmii_pcs);
+		mac->sgmii_pcs = NULL;
+	}
+
+	if (!IS_ERR_OR_NULL(mac->usxgmii_pcs)) {
+		mtk_usxgmii_pcs_put(mac->usxgmii_pcs);
+		mac->usxgmii_pcs = NULL;
+	}
+
+	eth->netdev[id] = NULL;
+	eth->mac[id] = NULL;
+	free_netdev(ndev);
+}
