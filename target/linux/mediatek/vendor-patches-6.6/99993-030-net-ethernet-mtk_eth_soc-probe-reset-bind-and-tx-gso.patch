@@ -2118,6 +2160,9 @@ static netdev_tx_t mtk_start_xmit(struct sk_buff *skb, struct net_device *dev)
 			goto dropped;
 	}
 
+	orig_skb = skb;
+	tx_list = skb;
+
 	/* normally we can rely on the stack not calling this more than once,
 	 * however we have 2 queues running on the same ring so we need to lock
 	 * the ring access
@@ -2125,51 +2170,93 @@ static netdev_tx_t mtk_start_xmit(struct sk_buff *skb, struct net_device *dev)
 	spin_lock(&eth->page_lock);
 
 	if (unlikely(test_bit(MTK_RESETTING, &eth->state)))
-		goto drop;
+		goto drop_prepared;
 
-	tx_num = mtk_cal_txd_req(eth, skb);
-	if (unlikely(atomic_read(&ring->free_count) <= tx_num)) {
-		netif_tx_stop_all_queues(dev);
-		netif_err(eth, tx_queued, dev,
-			  "Tx Ring full when queue awake!\n");
-		atomic_inc(&ring->full_count);
-		spin_unlock(&eth->page_lock);
-		return NETDEV_TX_BUSY;
-	}
-
-	if (mtk_is_netsys_v1(eth) &&
-	    skb_is_gso(skb) && mtk_skb_has_small_frag(skb)) {
-		segs = skb_gso_segment(skb, dev->features & ~NETIF_F_ALL_TSO);
+	if (skb_is_gso(orig_skb) && mtk_skb_has_small_frag(orig_skb)) {
+		segs = skb_gso_segment(orig_skb,
+				       dev->features & ~NETIF_F_ALL_TSO);
 		if (IS_ERR(segs))
-			goto drop;
+			goto drop_prepared;
 
 		if (segs) {
-			consume_skb(skb);
-			skb = segs;
+			if (mtk_skb_headroom_copy)
+				mtk_skb_headroom_copy(segs, orig_skb);
+			tx_list = segs;
 		}
 	}
 
-	/* TSO: fill MSS info in tcp checksum field */
-	if (skb_is_gso(skb)) {
-		if (skb_cow_head(skb, 0)) {
-			netif_warn(eth, tx_err, dev,
-				   "GSO expand head fail.\n");
-			goto drop;
-		}
+	need = 0;
+	skb_list_walk_safe(tx_list, seg, next) {
+		if (mtk_skb_has_small_frag(seg) && skb_linearize(seg))
+			goto drop_prepared;
+
+		if (skb_headlen(seg) > eth->soc->tx.dma_max_len)
+			goto drop_prepared;
+
+		if (MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA))
+			need += mtk_qdma_desc_need(eth, seg);
+		else
+			need += mtk_cal_txd_req(eth, seg);
+	}
 
-		if (skb_shinfo(skb)->gso_type &
-				(SKB_GSO_TCPV4 | SKB_GSO_TCPV6)) {
-			gso = true;
-			tcp_hdr(skb)->check = htons(skb_shinfo(skb)->gso_size);
+	if (unlikely(need >= ring->dma_size - 2))
+		goto drop_prepared;
+
+	if (unlikely(atomic_read(&ring->free_count) <= need)) {
+		netif_tx_stop_all_queues(dev);
+		smp_mb();
+		if (unlikely(atomic_read(&ring->free_count) <= need)) {
+			netif_err(eth, tx_queued, dev,
+				  "Tx Ring full when queue awake!\n");
+			atomic_inc(&ring->full_count);
+			spin_unlock(&eth->page_lock);
+			if (tx_list != orig_skb) {
+				skb_list_walk_safe(tx_list, seg, next) {
+					skb_mark_not_on_list(seg);
+					dev_kfree_skb_any(seg);
+				}
+			}
+			return NETDEV_TX_BUSY;
 		}
+		netif_tx_wake_all_queues(dev);
+	}
+
+	if (tx_list != orig_skb) {
+		consume_skb(orig_skb);
+		orig_skb = NULL;
 	}
 
-	skb_list_walk_safe(skb, skb, next) {
-		if ((mtk_is_netsys_v1(eth) &&
-		     mtk_skb_has_small_frag(skb) && skb_linearize(skb)) ||
-		    mtk_tx_map(skb, dev, tx_num, ring, gso) < 0) {
+	skb_list_walk_safe(tx_list, seg, next) {
+		int seg_tx_num;
+
+		skb_mark_not_on_list(seg);
+		gso = false;
+
+		/* TSO: fill MSS info in tcp checksum field */
+		if (skb_is_gso(seg)) {
+			if (skb_cow_head(seg, 0)) {
+				netif_warn(eth, tx_err, dev,
+					   "GSO expand head fail.\n");
 				stats->tx_dropped++;
-				dev_kfree_skb_any(skb);
+				dev_kfree_skb_any(seg);
+				continue;
+			}
+
+			if (skb_shinfo(seg)->gso_type &
+			    (SKB_GSO_TCPV4 | SKB_GSO_TCPV6)) {
+				gso = true;
+				tcp_hdr(seg)->check =
+					htons(skb_shinfo(seg)->gso_size);
+			}
+		}
+
+		seg_tx_num = MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA) ?
+			     mtk_qdma_desc_need(eth, seg) :
+			     mtk_cal_txd_req(eth, seg);
+
+		if (mtk_tx_map(seg, dev, seg_tx_num, ring, gso) < 0) {
+			stats->tx_dropped++;
+			dev_kfree_skb_any(seg);
 		}
 	}
 
