 	return -ENOMEM;
 }
 
+static unsigned int
+mtk_qdma_desc_need(struct mtk_eth *eth, struct sk_buff *skb)
+{
+	unsigned int need = 1;
+	int i;
+
+	for (i = 0; i < skb_shinfo(skb)->nr_frags; i++)
+		need += DIV_ROUND_UP(
+			skb_frag_size(&skb_shinfo(skb)->frags[i]),
+			eth->soc->tx.dma_max_len);
+
+	return need;
+}
+
 static int mtk_cal_txd_req(struct mtk_eth *eth, struct sk_buff *skb)
 {
 	int i, nfrags = 1;
@@ -2107,9 +2148,10 @@ static netdev_tx_t mtk_start_xmit(struct sk_buff *skb, struct net_device *dev)
 	struct mtk_eth *eth = mac->hw;
 	struct mtk_tx_ring *ring = &eth->tx_ring;
 	struct net_device_stats *stats = &dev->stats;
-	struct sk_buff *segs, *next;
+	struct sk_buff *orig_skb, *tx_list;
+	struct sk_buff *segs, *seg, *next;
+	unsigned int need;
 	bool gso = false;
-	int tx_num;
 
