+++ b/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
@@ -827,6 +827,7 @@ static ssize_t mtketh_debugfs_reset(struct file *file, const char __user *ptr,
 {
 	struct mtk_eth *eth = file->private_data;
 	unsigned long dbg_level = 0;
+	unsigned long flags;
 	char buf[8] = "";
 	int count = len;
 
@@ -843,23 +844,26 @@ static ssize_t mtketh_debugfs_reset(struct file *file, const char __user *ptr,
 		atomic_set(&eth->reset.force, 0);
 		break;
 	case 1:
-		if (atomic_read(&eth->reset.force) && !test_bit(MTK_RESETTING, &eth->state))
-		{
-			eth->reset.event = MTK_FE_START_RESET;
-			schedule_work(&eth->pending_work);
-		}
-		else
+		if (atomic_read(&eth->reset.force)) {
+			if (!mtk_eth_queue_reset(eth, MTK_FE_START_RESET))
+				pr_info(" stat:disable\n");
+		} else {
 			pr_info(" stat:disable\n");
+		}
 		break;
 	case 2:
-		atomic_set(&eth->reset.force, 1);
+		spin_lock_irqsave(&eth->reset.lock, flags);
+		if (!test_bit(MTK_REMOVING, &eth->state))
+			atomic_set(&eth->reset.force, 1);
+		spin_unlock_irqrestore(&eth->reset.lock, flags);
 		break;
 	case 3:
-		if (atomic_read(&eth->reset.force) && !test_bit(MTK_RESETTING, &eth->state)) {
-			eth->reset.event = MTK_FE_STOP_TRAFFIC;
-			schedule_work(&eth->pending_work);
-		} else
+		if (atomic_read(&eth->reset.force)) {
+			if (!mtk_eth_queue_reset(eth, MTK_FE_STOP_TRAFFIC))
+				pr_info(" stat:disable\n");
+		} else {
 			pr_info(" stat:disable\n");
+		}
 		break;
 	default:
 		pr_info("Usage: echo [level] > /sys/kernel/debug/mtketh/reset\n");
