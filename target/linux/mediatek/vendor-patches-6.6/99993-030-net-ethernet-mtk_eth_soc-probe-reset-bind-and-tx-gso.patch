+static void mtk_probe_cleanup(struct mtk_eth *eth, bool napi_added,
+			      bool ppe_initialized, bool mdio_initialized)
+{
+	int i;
+
+	if (napi_added)
+		mtk_napi_del(eth);
+
+	if (eth->dummy_dev) {
+		free_netdev(eth->dummy_dev);
+		eth->dummy_dev = NULL;
+	}
+
+	if (ppe_initialized)
+		mtk_ppe_deinit(eth);
+
+	/* The poll worker holds pointers into each MAC slot. */
+	mtk_release_all_muxes(eth);
+	mtk_unregister_notifier(eth);
+
+	for (i = 0; i < MTK_MAX_DEVS; i++)
+		mtk_free_mac_slot(eth, i);
+
+	/* Keep mtk_free_dev() for DSA metadata after its netdev loop is empty. */
+	mtk_free_dev(eth);
+
+	if (eth->esw_base) {
+		iounmap(eth->esw_base);
+		eth->esw_base = NULL;
+	}
+
+	/* Phylinks/PCS have been released before their MDIO bus. */
+	if (mdio_initialized)
+		mtk_mdio_cleanup(eth);
+}
