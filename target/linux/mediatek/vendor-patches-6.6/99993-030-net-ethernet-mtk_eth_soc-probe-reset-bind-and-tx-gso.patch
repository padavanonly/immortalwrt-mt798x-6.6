+static int mtk_register_netdevs(struct mtk_eth *eth)
+{
+	int err, i;
+
+	err = rtnl_lock_killable();
+	if (err)
+		return err;
+
+	for (i = 0; i < MTK_MAX_DEVS; i++) {
+		if (!eth->netdev[i])
+			continue;
+
+		err = register_netdevice(eth->netdev[i]);
+		if (err) {
+			dev_err(eth->dev, "error bringing up device\n");
+			goto err_unregister;
+		}
+
+		netif_info(eth, probe, eth->netdev[i],
+			   "mediatek frame engine at 0x%08lx, irq %d\n",
+			   eth->netdev[i]->base_addr, eth->irq_fe[0]);
+	}
+
+	rtnl_unlock();
+	return 0;
+
+err_unregister:
+	for (i = 0; i < MTK_MAX_DEVS; i++) {
+		if (!eth->netdev[i] ||
+		    eth->netdev[i]->reg_state != NETREG_REGISTERED)
+			continue;
+
+		unregister_netdevice(eth->netdev[i]);
+	}
+
+	/* This runs netdev_run_todo() before any private state is released. */
+	rtnl_unlock();
+
+	return err;
+}
