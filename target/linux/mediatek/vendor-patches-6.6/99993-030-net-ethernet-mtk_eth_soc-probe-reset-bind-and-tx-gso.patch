 drivers/net/ethernet/mediatek/mtk_eth_reset.c |  16 +-
 drivers/net/ethernet/mediatek/mtk_eth_reset.h |   1 +
 drivers/net/ethernet/mediatek/mtk_eth_soc.c   | 577 +++++++++++++-----
 drivers/net/ethernet/mediatek/mtk_eth_soc.h   |  17 +-
 drivers/net/ethernet/mediatek/mtk_ppe.c       |  48 +-
 .../net/ethernet/mediatek/mtk_ppe_offload.c   |   8 +
 drivers/net/ethernet/mediatek/mtk_wed.c       |   7 +
 drivers/net/ethernet/mediatek/mtk_wed.h       |   1 +
 9 files changed, 527 insertions(+), 174 deletions(-)

diff --git a/drivers/net/ethernet/mediatek/mtk_eth_dbg.c b/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
