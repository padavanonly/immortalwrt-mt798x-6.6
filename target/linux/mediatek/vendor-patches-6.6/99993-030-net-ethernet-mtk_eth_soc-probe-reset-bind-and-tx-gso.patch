+bool mtk_eth_queue_reset(struct mtk_eth *eth, u32 event);
 #endif		/* MTK_ETH_RESET_H */
diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.c b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
index b78991a..16542af 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -54,6 +54,34 @@ MODULE_PARM_DESC(msg_level, "Message level (-1=defaults,0=none,...,16=all)");
 				  offsetof(struct mtk_hw_stats, xdp_stats.x) / \
 				  sizeof(u64) }
 
+bool mtk_eth_queue_reset(struct mtk_eth *eth, u32 event)
+{
+	unsigned long flags;
+
+	if (!eth)
+		return false;
+
+	spin_lock_irqsave(&eth->reset.lock, flags);
+	if (test_bit(MTK_REMOVING, &eth->state) ||
+	    test_bit(MTK_RESETTING, &eth->state)) {
+		spin_unlock_irqrestore(&eth->reset.lock, flags);
+		return false;
+	}
+
+	if (!eth->reset.pending) {
+		eth->reset.pending_event = event;
+		eth->reset.pending = true;
+	} else if (event == MTK_FE_START_RESET) {
+		eth->reset.pending_event = MTK_FE_START_RESET;
+	}
+
+	schedule_work(&eth->pending_work);
+	spin_unlock_irqrestore(&eth->reset.lock, flags);
+
+	return true;
+}
+EXPORT_SYMBOL_GPL(mtk_eth_queue_reset);
+
