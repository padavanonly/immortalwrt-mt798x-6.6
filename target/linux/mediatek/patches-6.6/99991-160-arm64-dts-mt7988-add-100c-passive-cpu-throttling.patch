From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] arm64: dts: mt7988: add 100C passive cpu thermal throttling

Keep vendor cpufreq cooling patch 999-2005 unmodified and add a 100C
passive thermal trip and cpu0 cooling map afterwards on MT7988A.

Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
 arch/arm64/boot/dts/mediatek/mt7988a.dtsi      |   11 +
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt7988a.dtsi b/arch/arm64/boot/dts/mediatek/mt7988a.dtsi
index a96c471..b887051 100644
--- a/arch/arm64/boot/dts/mediatek/mt7988a.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt7988a.dtsi
@@ -1746,6 +1746,12 @@ cpu_trip_active_high: active-high {
 					type = "active";
 				};
 
+				cpu_trip_passive: passive {
+					temperature = <100000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
 				cpu_trip_active_med: active-med {
 					temperature = <85000>;
 					hysteresis = <2000>;
@@ -1769,6 +1775,11 @@ cpu-active-hot {
 					trip = <&cpu_trip_active_hot>;
 				};
 
+				cpu-passive-throttle {
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+					trip = <&cpu_trip_passive>;
+				};
+
 				cpu-active-high {
 				/* active: set fan to cooling level 2 */
 					cooling-device = <&fan 3 3>;
