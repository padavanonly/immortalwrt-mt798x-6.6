From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] usb: net: huawei_cdc_ncm, cdc_ncm: add MT5700/MH5000 support and SuperSpeed/SG optimizations

Add vendor-specific NCM device table matches for Huawei 0x12d1
(0xff/0x06/0x16) and TD Tech 0x3466 (MT5700/MT5700M NCM endpoints
0x02/0x03/0x06 + 0x16), without overlapping option.c serial interfaces,
and tag 0x3466 standard CDC-NCM interfaces with wwan_info (wwan%d for
USB HNAT ext-devices-prefix).

On USB SuperSpeed+ links, scale default NTB RX/TX caps up to 32768
bytes clamped by device NTB parameters and reduce initial coalescing
timer to 150 us. Also advertise NETIF_F_SG on non-MBIM CDC-NCM devices
and gather nonlinear TX SKBs directly via skb_copy_bits() inside
cdc_ncm_fill_tx_frame().

Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
--- a/drivers/net/usb/huawei_cdc_ncm.c	2026-11-23 12:03:45.430359243 +0800
+++ b/drivers/net/usb/huawei_cdc_ncm.c	2026-11-23 12:03:45.658472927 +0800
@@ -203,6 +203,19 @@ static const struct usb_device_id huawei
 	{ USB_VENDOR_AND_INTERFACE_INFO(0x12d1, 0xff, 0x03, 0x16),
 	  .driver_info = (unsigned long)&huawei_cdc_ncm_info,
 	},
+	{ USB_VENDOR_AND_INTERFACE_INFO(0x12d1, 0xff, 0x06, 0x16),
+	  .driver_info = (unsigned long)&huawei_cdc_ncm_info,
+	},
+	/* TD Tech (Huawei Balong-derived) MT5700/MT5700M NCM devices */
+	{ USB_VENDOR_AND_INTERFACE_INFO(0x3466, 0xff, 0x02, 0x16),
+	  .driver_info = (unsigned long)&huawei_cdc_ncm_info,
+	},
+	{ USB_VENDOR_AND_INTERFACE_INFO(0x3466, 0xff, 0x03, 0x16),
+	  .driver_info = (unsigned long)&huawei_cdc_ncm_info,
+	},
+	{ USB_VENDOR_AND_INTERFACE_INFO(0x3466, 0xff, 0x06, 0x16),
+	  .driver_info = (unsigned long)&huawei_cdc_ncm_info,
+	},
 
 	/* Terminating entry */
 	{
--- a/drivers/net/usb/cdc_ncm.c	2026-11-23 12:03:45.641562927 +0800
+++ b/drivers/net/usb/cdc_ncm.c	2026-11-23 12:03:45.659168361 +0800
@@ -600,7 +600,10 @@ static int cdc_ncm_init(struct usbnet *d
 		ctx->max_ndp_size = sizeof(struct usb_cdc_ncm_ndp32) + (ctx->tx_max_datagrams + 1) * sizeof(struct usb_cdc_ncm_dpe32);
 
 	/* initial coalescing timer interval */
-	ctx->timer_interval = CDC_NCM_TIMER_INTERVAL_USEC * NSEC_PER_USEC;
+	if (dev->udev->speed >= USB_SPEED_SUPER)
+		ctx->timer_interval = 150UL * NSEC_PER_USEC;
+	else
+		ctx->timer_interval = CDC_NCM_TIMER_INTERVAL_USEC * NSEC_PER_USEC;
 
 	return 0;
 }
@@ -701,14 +704,22 @@ static void cdc_ncm_fix_modulus(struct u
 static int cdc_ncm_setup(struct usbnet *dev)
 {
 	struct cdc_ncm_ctx *ctx = (struct cdc_ncm_ctx *)dev->data[0];
-	u32 def_rx, def_tx;
+	u32 def_rx, def_tx, cap_rx, cap_tx;
+
+	if (dev->udev->speed >= USB_SPEED_SUPER) {
+		cap_rx = 32768U;
+		cap_tx = 32768U;
+	} else {
+		cap_rx = CDC_NCM_NTB_DEF_SIZE_RX;
+		cap_tx = CDC_NCM_NTB_DEF_SIZE_TX;
+	}
 
 	/* be conservative when selecting initial buffer size to
 	 * increase the number of hosts this will work for
 	 */
-	def_rx = min_t(u32, CDC_NCM_NTB_DEF_SIZE_RX,
+	def_rx = min_t(u32, cap_rx,
 		       le32_to_cpu(ctx->ncm_parm.dwNtbInMaxSize));
-	def_tx = min_t(u32, CDC_NCM_NTB_DEF_SIZE_TX,
+	def_tx = min_t(u32, cap_tx,
 		       le32_to_cpu(ctx->ncm_parm.dwNtbOutMaxSize));
 
 	/* clamp rx_max and tx_max and inform device */
@@ -976,6 +987,10 @@ int cdc_ncm_bind_common(struct usbnet *d
 	dev->net->netdev_ops = &cdc_ncm_netdev_ops;
 	dev->net->max_mtu = cdc_ncm_max_dgram_size(dev) - cdc_ncm_eth_hlen(dev);
 	dev->rx_urb_size = 32*1024;
+	if (!cdc_ncm_comm_intf_is_mbim(ctx->control->cur_altsetting)) {
+		dev->net->features |= NETIF_F_SG;
+		dev->net->hw_features |= NETIF_F_SG;
+	}
 	return 0;
 
 error2:
@@ -1354,7 +1369,11 @@ cdc_ncm_fill_tx_frame(struct usbnet *dev
 			ndp.ndp32->dpe32[index].dwDatagramIndex = cpu_to_le32(skb_out->len);
 			ndp.ndp32->wLength = cpu_to_le16(ndplen + sizeof(struct usb_cdc_ncm_dpe32));
 		}
-		skb_put_data(skb_out, skb->data, skb->len);
+		if (skb_is_nonlinear(skb))
+			skb_copy_bits(skb, 0, skb_put(skb_out, skb->len),
+				      skb->len);
+		else
+			skb_put_data(skb_out, skb->data, skb->len);
 		ctx->tx_curr_frame_payload += skb->len;	/* count real tx payload data */
 		dev_kfree_skb_any(skb);
 		skb = NULL;
@@ -2033,6 +2052,14 @@ static const struct usb_device_id cdc_de
 					USB_CLASS_COMM,
 					USB_CDC_SUBCLASS_NCM,
 					USB_CDC_PROTO_NONE),
+	  .driver_info = (unsigned long)&wwan_info,
+	},
+
+	/* tag TD Tech (MT5700/MT5700M) devices as wwan */
+	{ USB_VENDOR_AND_INTERFACE_INFO(0x3466,
+					USB_CLASS_COMM,
+					USB_CDC_SUBCLASS_NCM,
+					USB_CDC_PROTO_NONE),
 	  .driver_info = (unsigned long)&wwan_info,
 	},
 
