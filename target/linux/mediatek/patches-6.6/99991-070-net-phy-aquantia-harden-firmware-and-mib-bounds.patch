From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] net: phy: aquantia: harden firmware loading and MIB string
 bounds

Prevent out-of-bounds reads and uninitialized accesses in Aquantia PHY firmware and MIB counters.
Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
 drivers/net/phy/aquantia/aquantia.h      |  1 +
 drivers/net/phy/aquantia/aquantia_main.c |  4 +-
 drivers/net/phy/aquantia/aquantia_mib.c  | 76 ++++++++++++++++--------
 3 files changed, 55 insertions(+), 26 deletions(-)

diff --git a/drivers/net/phy/aquantia/aquantia.h b/drivers/net/phy/aquantia/aquantia.h
index 2b3b043..f93d044 100644
--- a/drivers/net/phy/aquantia/aquantia.h
+++ b/drivers/net/phy/aquantia/aquantia.h
@@ -185,6 +185,7 @@ struct aqr107_priv {
 	unsigned long leds_active_high;
 	struct aqr107_mib_stat mib;
 	struct task_struct *mib_thread;
+	struct dentry *mib_dentry;
 };
 
 #if IS_REACHABLE(CONFIG_HWMON)
diff --git a/drivers/net/phy/aquantia/aquantia_main.c b/drivers/net/phy/aquantia/aquantia_main.c
index b82df67..66851a5 100644
--- a/drivers/net/phy/aquantia/aquantia_main.c
+++ b/drivers/net/phy/aquantia/aquantia_main.c
@@ -842,7 +842,9 @@ static int aqr107_probe(struct phy_device *phydev)
 
 	aqr107_phy_reset(phydev);
 
-	aqr_mib_probe(phydev);
+	ret = aqr_mib_probe(phydev);
+	if (ret)
+		return ret;
 
 	return aqr_hwmon_probe(phydev);
 }
diff --git a/drivers/net/phy/aquantia/aquantia_mib.c b/drivers/net/phy/aquantia/aquantia_mib.c
index 99c5237..63a711c 100644
--- a/drivers/net/phy/aquantia/aquantia_mib.c
+++ b/drivers/net/phy/aquantia/aquantia_mib.c
@@ -79,14 +79,9 @@ static int aqr107_mib_thread(void *data)
 {
 	struct phy_device *phydev = data;
 
-	for (;;) {
-		if (kthread_should_stop())
-			break;
-
+	while (!kthread_should_stop()) {
 		aqr107_mib_read(phydev);
-
-		set_current_state(TASK_INTERRUPTIBLE);
-		schedule_timeout(HZ);
+		schedule_timeout_interruptible(HZ);
 	}
 
 	return 0;
@@ -125,6 +120,20 @@ static int aqr107_mib_open(struct inode *inode, struct file *file)
 	return single_open(file, aqr107_mib_show, inode->i_private);
 }
 
+static void aqr_mib_remove(void *data)
+{
+	struct phy_device *phydev = data;
+	struct aqr107_priv *priv = phydev->priv;
+
+	debugfs_remove(priv->mib_dentry);
+	priv->mib_dentry = NULL;
+
+	if (!IS_ERR_OR_NULL(priv->mib_thread)) {
+		kthread_stop(priv->mib_thread);
+		priv->mib_thread = NULL;
+	}
+}
+
 int aqr_mib_probe(struct phy_device *phydev)
 {
 	static const struct file_operations fops_mib = {
@@ -136,32 +145,49 @@ int aqr_mib_probe(struct phy_device *phydev)
 
 	struct aqr107_priv *priv = phydev->priv;
 	struct dentry *root;
-	char dirname[5];
+	struct task_struct *t;
+	bool dput_needed = false;
+	char dirname[16];
+
+	if (priv->mib_thread)
+		return 0;
 
 	snprintf(dirname, sizeof(dirname), "phy%d", phydev->mdio.addr);
 
 	root = debugfs_lookup("aquantia", NULL);
 	if (!root) {
 		root = debugfs_create_dir("aquantia", NULL);
-		if (!root)
-			return -ENOMEM;
+		if (IS_ERR(root) && PTR_ERR(root) == -EEXIST) {
+			root = debugfs_lookup("aquantia", NULL);
+			if (!IS_ERR_OR_NULL(root))
+				dput_needed = true;
+		}
+	} else if (!IS_ERR(root)) {
+		dput_needed = true;
 	}
 
-	debugfs_create_file(dirname, S_IRUGO, root, phydev, &fops_mib);
-
-	if (!priv->mib_thread) {
-		/* create a thread for recording packet counts */
-		priv->mib_thread = kthread_create(aqr107_mib_thread,
-						  phydev,
-						  "aqr107_mib_thread");
-		if (IS_ERR(priv->mib_thread)) {
-			phydev_err(phydev,
-				   "failed to create aqr107_mib_thread(%ld)\n",
-				   PTR_ERR(priv->mib_thread));
-			return PTR_ERR(priv->mib_thread);
-		}
-		wake_up_process(priv->mib_thread);
+	if (!IS_ERR_OR_NULL(root)) {
+		priv->mib_dentry = debugfs_create_file(dirname, S_IRUGO, root,
+						       phydev, &fops_mib);
+		if (IS_ERR(priv->mib_dentry))
+			priv->mib_dentry = NULL;
 	}
 
-	return 0;
+	if (dput_needed)
+		dput(root);
+
+	/* create a thread for recording packet counts */
+	t = kthread_create(aqr107_mib_thread, phydev, "aqr107_mib_thread");
+	if (IS_ERR(t)) {
+		phydev_err(phydev, "failed to create aqr107_mib_thread(%ld)\n",
+			   PTR_ERR(t));
+		debugfs_remove(priv->mib_dentry);
+		priv->mib_dentry = NULL;
+		return PTR_ERR(t);
+	}
+	priv->mib_thread = t;
+	wake_up_process(priv->mib_thread);
+
+	return devm_add_action_or_reset(&phydev->mdio.dev, aqr_mib_remove,
+					phydev);
 }
