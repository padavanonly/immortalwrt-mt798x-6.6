From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] rpcd: file: re-authorize ACL against resolved path and parent
 symlinks

Resolve realpath on file operations and validate symlink parent traversal against ACL permissions.
Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
 file.c | 209 +++++++++++++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 196 insertions(+), 13 deletions(-)

diff --git a/file.c b/file.c
index d690b66..ac12c5a 100644
--- a/file.c
+++ b/file.c
@@ -79,6 +79,7 @@ struct rpc_file_exec_context {
 
 static struct blob_buf buf;
 static char *canonpath;
+static char *resolvedpath;
 static char cmdstr[RPC_CMDLINE_MAX_SIZE];
 
 enum {
@@ -248,10 +249,175 @@ next:
 	return canonpath;
 }
 
+/*
+ * rpc_canonicalize_path() only folds "//", "/./" and "/../" textually; it
+ * never resolves symlink components. Since the ACL check above matches the
+ * textual path, a symlink placed inside an ACL-covered directory would let
+ * a grant on the link authorize whatever file the link points to once the
+ * caller's stat()/open()/opendir() follows it. Re-resolve *path with
+ * realpath() and, if that changes the path, re-run the ACL check against
+ * the resolved target so grants only ever cover the real file. If the
+ * target does not exist yet (e.g. a new file being written), resolve and
+ * re-check the containing directory instead and rebuild *path from that.
+ */
+static bool
+rpc_check_symlink_access(const struct blob_attr *sid, const char *perm, char **path)
+{
+	char resolved[PATH_MAX];
+	char dirbuf[PATH_MAX];
+	const char *base;
+	struct stat lst;
+
+	if (realpath(*path, resolved) != NULL)
+	{
+		if (strcmp(resolved, *path) == 0)
+			return true;
+
+		if (!rpc_file_access(sid, resolved, perm))
+		{
+			errno = EACCES;
+			return false;
+		}
+
+		free(resolvedpath);
+		resolvedpath = strdup(resolved);
+
+		if (resolvedpath == NULL)
+		{
+			errno = ENOMEM;
+			return false;
+		}
+
+		*path = resolvedpath;
+		return true;
+	}
+
+	if (errno == ENOENT)
+	{
+		/* realpath() also fails with ENOENT for a dangling symlink whose
+		 * final target component is missing. Distinguish that case (an
+		 * *existing* symlink we must not silently create-through, e.g.
+		 * via open(O_CREAT) on file.write) from a genuinely nonexistent
+		 * path by lstat()'ing the requested path itself. */
+		errno = (lstat(*path, &lst) == 0 && S_ISLNK(lst.st_mode)) ? EACCES : 0;
+	}
+
+	if (errno != 0)
+		return false;
+
+	base = strrchr(*path, '/');
+
+	if (base == NULL)
+	{
+		errno = ENOENT;
+		return false;
+	}
+
+	if (base == *path)
+	{
+		dirbuf[0] = '/';
+		dirbuf[1] = '\0';
+	}
+	else if ((size_t)(base - *path) >= sizeof(dirbuf))
+	{
+		errno = ENAMETOOLONG;
+		return false;
+	}
+	else
+	{
+		memcpy(dirbuf, *path, base - *path);
+		dirbuf[base - *path] = '\0';
+	}
+
+	base++;
+
+	if (realpath(dirbuf, resolved) == NULL)
+		return false;
+
+	if (strcmp(resolved, dirbuf) == 0)
+	{
+		errno = ENOENT;
+		return true;
+	}
+
+	free(resolvedpath);
+
+	if (asprintf(&resolvedpath, "%s/%s", resolved, base) < 0)
+	{
+		errno = ENOMEM;
+		return false;
+	}
+
+	if (!rpc_file_access(sid, resolvedpath, perm))
+	{
+		errno = EACCES;
+		return false;
+	}
+
+	*path = resolvedpath;
+	errno = ENOENT;
+
+	return true;
+}
+
+/* Resolve ancestors while leaving the final component for lstat()/unlink(). */
+static bool
+rpc_check_parent_access(const struct blob_attr *sid, const char *perm, char **path)
+{
+	char parent[PATH_MAX], resolved[PATH_MAX];
+	const char *base = strrchr(*path, '/');
+	char *candidate;
+	size_t len;
+
+	if (strcmp(*path, "/") == 0)
+		return true;
+
+	if (base == NULL)
+	{
+		strcpy(parent, ".");
+		base = *path;
+	}
+	else
+	{
+		len = base == *path ? 1 : (size_t)(base - *path);
+		if (len >= sizeof(parent))
+		{
+			errno = ENAMETOOLONG;
+			return false;
+		}
+		memcpy(parent, *path, len);
+		parent[len] = '\0';
+		base++;
+	}
+
+	if (realpath(parent, resolved) == NULL)
+		return false;
+
+	if (asprintf(&candidate, "%s%s%s", resolved,
+	             strcmp(resolved, "/") ? "/" : "", base) < 0)
+	{
+		errno = ENOMEM;
+		return false;
+	}
+
+	if (!rpc_file_access(sid, candidate, perm))
+	{
+		free(candidate);
+		errno = EACCES;
+		return false;
+	}
+
+	free(resolvedpath);
+	resolvedpath = candidate;
+	*path = resolvedpath;
+	return true;
+}
+
 static struct blob_attr **
 __rpc_check_path(const struct blobmsg_policy *policy, size_t policy_len,
                  int policy_path_idx, int policy_sid_idx, const char *perm,
-                 struct blob_attr *msg, char **path, struct stat *s, bool use_lstat)
+                 struct blob_attr *msg, char **path, struct stat *s,
+                 bool use_lstat, bool resolve_symlinks)
 {
 	static struct blob_attr *tb[__RPC_F_RW_MAX]; /* largest _MAX constant */
 
@@ -277,6 +443,10 @@ __rpc_check_path(const struct blobmsg_policy *policy, size_t policy_len,
 		return NULL;
 	}
 
+	if (!(resolve_symlinks ? rpc_check_symlink_access(tb[policy_sid_idx], perm, path)
+	                      : rpc_check_parent_access(tb[policy_sid_idx], perm, path)))
+		return NULL;
+
 	if (s != NULL && (use_lstat ? lstat(*path, s) : stat(*path, s)) != 0)
 		return NULL;
 
@@ -289,7 +459,7 @@ __rpc_check_path(const struct blobmsg_policy *policy, size_t policy_len,
 		ARRAY_SIZE(rpc_file_ ## policy_selector ## _policy), \
 		RPC_F_ ## policy_selector ## _PATH, \
 		RPC_F_ ## policy_selector ## _SESSION, \
-		perm, msg, path, s, false)
+		perm, msg, path, s, false, true)
 
 // use_lstat control
 #define rpc_check_path_with_lstat(msg, policy_selector, perm, path, s, use_lstat) \
@@ -297,7 +467,15 @@ __rpc_check_path(const struct blobmsg_policy *policy, size_t policy_len,
 		ARRAY_SIZE(rpc_file_ ## policy_selector ## _policy), \
 		RPC_F_ ## policy_selector ## _PATH, \
 		RPC_F_ ## policy_selector ## _SESSION, \
-		perm, msg, path, s, use_lstat)
+		perm, msg, path, s, use_lstat, !use_lstat)
+
+// Leave symlinks unresolved when inspecting the link itself or removing it.
+#define rpc_check_path_no_resolve(msg, policy_selector, perm, path, s) \
+	__rpc_check_path(rpc_file_ ## policy_selector ## _policy, \
+		ARRAY_SIZE(rpc_file_ ## policy_selector ## _policy), \
+		RPC_F_ ## policy_selector ## _PATH, \
+		RPC_F_ ## policy_selector ## _SESSION, \
+		perm, msg, path, s, false, false)
 
 static int
 rpc_file_read(struct ubus_context *ctx, struct ubus_object *obj,
@@ -387,7 +565,7 @@ rpc_file_write(struct ubus_context *ctx, struct ubus_object *obj,
 {
 	struct blob_attr **tb;
 	int append = O_TRUNC;
-	mode_t prev_mode, mode = 0666;
+	mode_t mode = 0666;
 	int fd, rv = 0;
 	char *path = NULL;
 	void *data = NULL;
@@ -408,11 +586,9 @@ rpc_file_write(struct ubus_context *ctx, struct ubus_object *obj,
 		append = O_APPEND;
 
 	if (tb[RPC_F_RW_MODE])
-		mode = blobmsg_get_u32(tb[RPC_F_RW_MODE]);
+		mode = blobmsg_get_u32(tb[RPC_F_RW_MODE]) & 0777;
 
-	prev_mode = umask(0);
 	fd = open(path, O_CREAT | O_WRONLY | append, mode);
-	umask(prev_mode);
 	if (fd < 0)
 		return rpc_errno_status();
 
@@ -654,10 +830,10 @@ rpc_file_lstat(struct ubus_context *ctx, struct ubus_object *obj,
 }
 
 static int
-rpc_file_remove_recursive(const char *path);
+rpc_file_remove_recursive(const struct blob_attr *sid, const char *path);
 
 static int
-rpc_file_remove_recursive(const char *path)
+rpc_file_remove_recursive(const struct blob_attr *sid, const char *path)
 {
 	DIR *fd;
 	int err = 0;
@@ -675,10 +851,14 @@ rpc_file_remove_recursive(const char *path)
 
 		if (asprintf(&entrypath, "%s/%s", path, e->d_name) >= 0)
 		{
-			if (!lstat(entrypath, &s))
+			if (!rpc_file_access(sid, entrypath, "write"))
+			{
+				err = UBUS_STATUS_PERMISSION_DENIED;
+			}
+			else if (!lstat(entrypath, &s))
 			{
 				if (S_ISDIR(s.st_mode))
-					err = rpc_file_remove_recursive(entrypath);
+					err = rpc_file_remove_recursive(sid, entrypath);
 				else if (unlink(entrypath))
 					err = rpc_errno_status();
 			}
@@ -704,17 +884,20 @@ rpc_file_remove(struct ubus_context *ctx, struct ubus_object *obj,
                 struct ubus_request_data *req, const char *method,
                 struct blob_attr *msg)
 {
+	struct blob_attr **tb;
 	struct stat s;
 	char *path = NULL;
 
-	if (!rpc_check_path(msg, R, "write", &path, NULL))
+	tb = rpc_check_path_no_resolve(msg, R, "write", &path, NULL);
+
+	if (tb == NULL)
 		return rpc_errno_status();
 
 	if (lstat(path, &s))
 		return rpc_errno_status();
 
 	if (S_ISDIR(s.st_mode))
-		return rpc_file_remove_recursive(path);
+		return rpc_file_remove_recursive(tb[RPC_F_R_SESSION], path);
 
 	if (unlink(path))
 		return rpc_errno_status();
