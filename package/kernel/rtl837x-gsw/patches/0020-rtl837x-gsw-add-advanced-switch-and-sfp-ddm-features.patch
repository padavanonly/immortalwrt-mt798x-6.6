+static int rtl837x_sw_set_port_storm_bcast(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_enable_t enable;
+	rtk_api_ret_t ret;
+
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+
+	enable = val->value.i ? ENABLED : DISABLED;
+	ret = rtk_rate_stormControlPortEnable_set(PORT_MAPPED(val->port_vlan), STORM_GROUP_BROADCAST, enable);
+	return (ret == RT_ERR_OK) ? 0 : -EIO;
+}
+
+static int rtl837x_sw_get_port_storm_bcast(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_enable_t enable = DISABLED;
+	rtk_api_ret_t ret;
+
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+
+	ret = rtk_rate_stormControlPortEnable_get(PORT_MAPPED(val->port_vlan), STORM_GROUP_BROADCAST, &enable);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+
+	val->value.i = (enable == ENABLED) ? 1 : 0;
+	return 0;
+}
