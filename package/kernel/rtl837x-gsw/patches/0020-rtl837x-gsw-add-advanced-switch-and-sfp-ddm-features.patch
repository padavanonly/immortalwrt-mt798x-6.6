+static int rtl837x_sw_set_trunk_ports(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val, rtk_trunk_group_t trk_gid)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_portmask_t portmask;
+	char *buf, *p, *token;
+	int port;
+	rtk_api_ret_t ret;
+
+	memset(&portmask, 0, sizeof(portmask));
+	if (!val->value.s)
+		return -EINVAL;
+
+	buf = kstrdup(val->value.s, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	p = buf;
+	while ((token = strsep(&p, " ,")) != NULL) {
+		if (!*token || strcmp(token, "none") == 0 || strcmp(token, "clear") == 0)
+			continue;
+		if (kstrtoint(token, 0, &port) != 0 || port < 0 || port >= gsw->num_ports) {
+			kfree(buf);
+			return -EINVAL;
+		}
+		portmask.bits[0] |= (1U << PORT_MAPPED(port));
+	}
+	kfree(buf);
+
+	ret = rtk_trunk_port_set(trk_gid, &portmask);
+	if (ret != RT_ERR_OK) {
+		dev_err(gsw->dev, "rtk_trunk_port_set group %d failed: %d\n", trk_gid, ret);
+		return -EIO;
+	}
+	return 0;
+}
+
+static int rtl837x_sw_get_trunk_ports(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val, rtk_trunk_group_t trk_gid)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_portmask_t portmask;
+	rtk_api_ret_t ret;
+	int len = 0;
+	int port;
+	char *buf = gsw->buf;
+
+	memset(&portmask, 0, sizeof(portmask));
+	ret = rtk_trunk_port_get(trk_gid, &portmask);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+
+	for (port = 0; port < gsw->num_ports; port++) {
+		rtk_uint32 mapped = PORT_MAPPED(port);
+		if (portmask.bits[0] & (1 << mapped)) {
+			len += snprintf(buf + len, sizeof(gsw->buf) - len, "%d ", port);
+		}
+	}
+	if (len > 0 && buf[len - 1] == ' ')
+		buf[len - 1] = '\0';
+	else
+		buf[len] = '\0';
+
+	val->value.s = buf;
+	val->len = len;
+	return 0;
+}
+
+static int rtl837x_sw_set_trunk0_ports(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	return rtl837x_sw_set_trunk_ports(dev, attr, val, 0);
+}
+
+static int rtl837x_sw_get_trunk0_ports(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	return rtl837x_sw_get_trunk_ports(dev, attr, val, 0);
+}
+
+static int rtl837x_sw_set_trunk1_ports(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	return rtl837x_sw_set_trunk_ports(dev, attr, val, 1);
+}
+
+static int rtl837x_sw_get_trunk1_ports(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	return rtl837x_sw_get_trunk_ports(dev, attr, val, 1);
+}
