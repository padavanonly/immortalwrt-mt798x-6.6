+static void rtl837x_format_cable_len(char *buf, size_t size, u32 raw_len)
+{
+	u32 cm = (raw_len * 25) / 10;
+	u32 m_int = cm / 100;
+	u32 m_dec = cm % 100;
+
+	snprintf(buf, size, "%u.%02u m", m_int, m_dec);
+}
+
+static const char *rtl837x_rtct_status_str(u32 normal, u32 open, u32 mis_open,
+					  u32 s_short, u32 mis_short, u32 inter_short)
+{
+	if (normal)
+		return "Normal";
+	if (open || mis_open)
+		return "Open";
+	if (s_short || mis_short || inter_short)
+		return "Short";
+	return "Unknown";
+}
+
+static int rtl837x_sw_get_port_cable_diag(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_port_status_t port_status;
+	rtk_rtct_result_t result;
+	rtk_uint32 phy_port;
+	rtk_api_ret_t ret;
+	int iter;
+	bool done = false;
+	u32 len_a, len_b, len_c, len_d;
+	char str_a[32], str_b[32], str_c[32], str_d[32];
+
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+
+	phy_port = PORT_MAPPED(val->port_vlan);
+
+	/* RTCT is only supported on copper PHY ports 4-7 */
+	if (phy_port < 4 || phy_port > 7) {
+		snprintf(gsw->buf, sizeof(gsw->buf),
+			 "Port %d (phy %u) does not support cable diagnostics (requires copper PHY ports 4-7)\n",
+			 val->port_vlan, phy_port);
+		val->value.s = gsw->buf;
+		return 0;
+	}
+
+	/* RTCT requires port to be Link Down */
+	ret = rtk_port_macStatus_get(phy_port, &port_status);
+	if (ret != RT_ERR_OK) {
+		snprintf(gsw->buf, sizeof(gsw->buf),
+			 "Failed to get port %d MAC status (%d)\n", val->port_vlan, ret);
+		val->value.s = gsw->buf;
+		return 0;
+	}
+
+	if (port_status.link) {
+		snprintf(gsw->buf, sizeof(gsw->buf),
+			 "Port %d is Link Up (cable diagnostics requires Link Down)\n",
+			 val->port_vlan);
+		val->value.s = gsw->buf;
+		return 0;
+	}
+
+	/* Initialize RTCT engine */
+	ret = rtk_port_rtct_init();
+	if (ret != RT_ERR_OK) {
+		snprintf(gsw->buf, sizeof(gsw->buf),
+			 "Failed to initialize RTCT engine (%d)\n", ret);
+		val->value.s = gsw->buf;
+		return 0;
+	}
+
+	/* Start RTCT test on specified port */
+	ret = rtk_port_rtctEnable_set(1 << phy_port);
+	if (ret != RT_ERR_OK && ret != RT_ERR_BUSYWAIT_TIMEOUT) {
+		snprintf(gsw->buf, sizeof(gsw->buf),
+			 "Failed to start RTCT test on port %d (%d)\n", val->port_vlan, ret);
+		val->value.s = gsw->buf;
+		return 0;
+	}
+
+	/* Poll for RTCT test completion (up to ~2.0s with 50ms intervals) */
+	for (iter = 0; iter < 40; iter++) {
+		msleep(50);
+		memset(&result, 0, sizeof(result));
+		ret = rtk_port_rtctResult_get(phy_port, &result);
+		if (ret == RT_ERR_OK) {
+			if (result.channelADone && result.channelBDone &&
+			    result.channelCDone && result.channelDDone) {
+				done = true;
+				break;
+			}
+		}
+	}
+
+	if (!done) {
+		snprintf(gsw->buf, sizeof(gsw->buf),
+			 "Port %d: Cable test in progress or timeout, please try again...\n",
+			 val->port_vlan);
+		val->value.s = gsw->buf;
+		return 0;
+	}
+
+	/* Read channel lengths from PHY SRAM (raw unit = 2.5cm) */
+	len_a = uc1_sram_read_8b(phy_port, 0x8027) | (uc1_sram_read_8b(phy_port, 0x8028) << 8);
+	len_b = uc1_sram_read_8b(phy_port, 0x802B) | (uc1_sram_read_8b(phy_port, 0x802C) << 8);
+	len_c = uc1_sram_read_8b(phy_port, 0x802F) | (uc1_sram_read_8b(phy_port, 0x8030) << 8);
+	len_d = uc1_sram_read_8b(phy_port, 0x8033) | (uc1_sram_read_8b(phy_port, 0x8034) << 8);
+
+	rtl837x_format_cable_len(str_a, sizeof(str_a), len_a);
+	rtl837x_format_cable_len(str_b, sizeof(str_b), len_b);
+	rtl837x_format_cable_len(str_c, sizeof(str_c), len_c);
+	rtl837x_format_cable_len(str_d, sizeof(str_d), len_d);
+
+	scnprintf(gsw->buf, sizeof(gsw->buf),
+		  "Port %d Cable Diagnostics (RTCT):\n"
+		  "  Channel A: %s (Length: %s)\n"
+		  "  Channel B: %s (Length: %s)\n"
+		  "  Channel C: %s (Length: %s)\n"
+		  "  Channel D: %s (Length: %s)\n",
+		  val->port_vlan,
+		  rtl837x_rtct_status_str(result.channelANormal, result.channelAOpen, result.channelAMisOpen,
+					  result.channelAShort, result.channelAMisShort, result.channelAInterShort),
+		  str_a,
+		  rtl837x_rtct_status_str(result.channelBNormal, result.channelBOpen, result.channelBMisOpen,
+					  result.channelBShort, result.channelBMisShort, result.channelBInterShort),
+		  str_b,
+		  rtl837x_rtct_status_str(result.channelCNormal, result.channelCOpen, result.channelCMisOpen,
+					  result.channelCShort, result.channelCMisShort, result.channelCInterShort),
+		  str_c,
+		  rtl837x_rtct_status_str(result.channelDNormal, result.channelDOpen, result.channelDMisOpen,
+					  result.channelDShort, result.channelDMisShort, result.channelDInterShort),
+		  str_d);
+
+	val->value.s = gsw->buf;
+	return 0;
+}
+
+static int rtl837x_sfp_01uw_to_c_dbm(unsigned int raw_01uw)
+{
+	u64 m, log2_q20;
+	u32 int_log2 = 0, frac_log2 = 0;
+	unsigned int tmp = raw_01uw;
+	int i;
+
+	if (raw_01uw == 0)
+		return -4000;
+
+	while (tmp >>= 1)
+		int_log2++;
+
+	m = ((u64)raw_01uw << 30) >> int_log2;
+	for (i = 0; i < 20; i++) {
+		m = (m * m) >> 30;
+		frac_log2 <<= 1;
+		if (m >= (1ULL << 31)) {
+			m >>= 1;
+			frac_log2 |= 1;
+		}
+	}
+
+	log2_q20 = ((u64)int_log2 << 20) | frac_log2;
+	/* round(1000 * log10(2) * 2^20) = 315652829; -4000 for 0.1 uW = 10^-4 mW */
+	return (int)(((log2_q20 * 315652829ULL) + (1ULL << 39)) >> 40) - 4000;
+}
+
+static int rtl837x_sfp_uw_to_c_dbm(unsigned int uw)
+{
+	if (uw == 0)
+		return -4000;
+	return rtl837x_sfp_01uw_to_c_dbm(uw * 10);
+}
+
+static void rtl837x_format_dbm_01uw(char *buf, size_t size, unsigned int raw_01uw)
+{
+	int c_dbm;
+
+	if (raw_01uw == 0) {
+		scnprintf(buf, size, "<-40.0 dBm (0.0 uW)");
+		return;
+	}
+	c_dbm = rtl837x_sfp_01uw_to_c_dbm(raw_01uw);
+	scnprintf(buf, size, "%s%d.%02d dBm (%u.%u uW)",
+		  (c_dbm < 0 ? "-" : ""), abs(c_dbm) / 100, abs(c_dbm) % 100,
+		  raw_01uw / 10, raw_01uw % 10);
+}
+
+static void rtl837x_format_dbm(char *buf, size_t size, unsigned int uw)
+{
+	int c_dbm;
+
+	if (uw == 0) {
+		scnprintf(buf, size, "<-40.0 dBm (0 uW)");
+		return;
+	}
+	c_dbm = rtl837x_sfp_uw_to_c_dbm(uw);
+	scnprintf(buf, size, "%s%d.%02d dBm (%u uW)",
+		  (c_dbm < 0 ? "-" : ""), abs(c_dbm) / 100, abs(c_dbm) % 100, uw);
+}
+
+static int rtl837x_sw_get_sfp_info_common(struct rtk_gsw *gsw, struct switch_val *val)
+{
+	struct ethtool_eeprom ee;
+	u8 *a0, *a2;
+	char vendor[17], part[17], serial[17];
+	char tx_pwr_str[32], rx_pwr_str[32];
+	int i, len = 0;
+	int ret = 0;
+
+	if (!gsw->sfp_bus || !gsw->sfp_present) {
+		snprintf(gsw->buf, sizeof(gsw->buf), "Module: Not present\n");
+		val->value.s = gsw->buf;
+		return 0;
+	}
+
+	a0 = kzalloc(256, GFP_KERNEL);
+	a2 = kzalloc(256, GFP_KERNEL);
+	if (!a0 || !a2) {
+		kfree(a0);
+		kfree(a2);
+		return -ENOMEM;
+	}
+
+	ee.cmd = 0;
+	ee.offset = 0;
+	ee.len = 256;
+	ret = sfp_get_module_eeprom(gsw->sfp_bus, &ee, a0);
+	if (ret < 0) {
+		snprintf(gsw->buf, sizeof(gsw->buf), "Module: Failed to read A0h EEPROM (%d)\n", ret);
+		val->value.s = gsw->buf;
+		kfree(a0);
+		kfree(a2);
+		return 0;
+	}
+
+	memcpy(vendor, &a0[20], 16);
+	vendor[16] = '\0';
+	for (i = 15; i >= 0 && vendor[i] == ' '; i--)
+		vendor[i] = '\0';
+
+	memcpy(part, &a0[40], 16);
+	part[16] = '\0';
+	for (i = 15; i >= 0 && part[i] == ' '; i--)
+		part[i] = '\0';
+
+	memcpy(serial, &a0[68], 16);
+	serial[16] = '\0';
+	for (i = 15; i >= 0 && serial[i] == ' '; i--)
+		serial[i] = '\0';
+
+	len += scnprintf(gsw->buf + len, sizeof(gsw->buf) - len,
+			 "Vendor: %s\nPart: %s\nSerial: %s\n",
+			 vendor[0] ? vendor : "Unknown",
+			 part[0] ? part : "Unknown",
+			 serial[0] ? serial : "Unknown");
+
+	if (a0[92] & 0x40) {
+		ee.offset = 256;
+		ee.len = 256;
+		ret = sfp_get_module_eeprom(gsw->sfp_bus, &ee, a2);
+		if (ret == 0) {
+			s16 raw_t = (s16)((a2[96] << 8) | a2[97]);
+			u16 raw_v = (u16)((a2[98] << 8) | a2[99]);
+			u16 raw_b = (u16)((a2[100] << 8) | a2[101]);
+			u16 raw_tx = (u16)((a2[102] << 8) | a2[103]);
+			u16 raw_rx = (u16)((a2[104] << 8) | a2[105]);
+
+			int t_int = raw_t / 256;
+			int t_dec = (abs(raw_t % 256) * 100) / 256;
+			int v_int = raw_v / 10000;
+			int v_dec = (raw_v % 10000) / 100;
+			int b_int = (raw_b * 2) / 1000;
+			int b_dec = ((raw_b * 2) % 1000) / 10;
+			rtl837x_format_dbm_01uw(tx_pwr_str, sizeof(tx_pwr_str), raw_tx);
+			rtl837x_format_dbm_01uw(rx_pwr_str, sizeof(rx_pwr_str), raw_rx);
+
+			len += scnprintf(gsw->buf + len, sizeof(gsw->buf) - len,
+					 "DDM: Supported\n"
+					 "Temperature: %s%d.%02d C\n"
+					 "Voltage: %d.%02d V\n"
+					 "TX Bias: %d.%02d mA\n"
+					 "TX Power: %s\n"
+					 "RX Power: %s\n",
+					 (raw_t < 0 ? "-" : ""), abs(t_int), t_dec,
+					 v_int, v_dec,
+					 b_int, b_dec,
+					 tx_pwr_str, rx_pwr_str);
+		} else {
+			len += scnprintf(gsw->buf + len, sizeof(gsw->buf) - len,
+					 "DDM: Read failed (%d)\n", ret);
+		}
+	} else {
+		len += scnprintf(gsw->buf + len, sizeof(gsw->buf) - len,
+				 "DDM: Not supported (Passive DAC or non-DDM module)\n");
+	}
+
+	val->value.s = gsw->buf;
+	kfree(a0);
+	kfree(a2);
+	return 0;
+}
+
+static int rtl837x_sw_get_sfp_info_port(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+	if (PORT_MAPPED(val->port_vlan) != UTP_PORT8) {
+		snprintf(gsw->buf, sizeof(gsw->buf), "Port %d is not an SFP slot\n", val->port_vlan);
+		val->value.s = gsw->buf;
+		return 0;
+	}
+	return rtl837x_sw_get_sfp_info_common(gsw, val);
+}
+
+static int rtl837x_sw_get_sfp_info_global(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	return rtl837x_sw_get_sfp_info_common(gsw, val);
+}
