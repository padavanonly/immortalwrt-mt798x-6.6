@@ -506,7 +506,17 @@ static int rtl837x_sw_reset_hw(struct switch_dev *dev, const struct switch_attr
 
 static int _rtl837x_sw_force_set_serdes_mode(struct rtk_gsw *gsw, uint8_t sds_index, rtk_sds_mode_t mode)
 {
