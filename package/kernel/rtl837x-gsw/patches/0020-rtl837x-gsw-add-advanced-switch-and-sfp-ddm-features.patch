+static int rtl837x_sw_set_trunk_hash(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	rtk_api_ret_t ret;
+	if (val->value.i < 0 || val->value.i > 7)
+		return -EINVAL;
+	ret = dal_rtl8373_trunk_distributionAlgorithm_set(0, (rtk_uint32)val->value.i);
+	return (ret == RT_ERR_OK) ? 0 : -EIO;
+}
+
+static int rtl837x_sw_get_trunk_hash(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	rtk_uint32 algo = 0;
+	rtk_api_ret_t ret = dal_rtl8373_trunk_distributionAlgorithm_get(0, &algo);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+	val->value.i = (int)algo;
+	return 0;
+}
+
+static int rtl837x_sw_set_igmp_snooping(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	rtk_enable_t enable = val->value.i ? ENABLED : DISABLED;
+	rtk_api_ret_t ret = rtk_igmp_state_set(enable);
+	return (ret == RT_ERR_OK) ? 0 : -EIO;
+}
+
+static int rtl837x_sw_get_igmp_snooping(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	rtk_enable_t enable = DISABLED;
+	rtk_api_ret_t ret = rtk_igmp_state_get(&enable);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+	val->value.i = (enable == ENABLED) ? 1 : 0;
+	return 0;
+}
+
+static int rtl837x_sw_set_igmp_fast_leave(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	rtk_enable_t enable = val->value.i ? ENABLED : DISABLED;
+	rtk_api_ret_t ret = rtk_igmp_fastLeave_set(enable);
+	return (ret == RT_ERR_OK) ? 0 : -EIO;
+}
+
+static int rtl837x_sw_get_igmp_fast_leave(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	rtk_enable_t enable = DISABLED;
+	rtk_api_ret_t ret = rtk_igmp_fastLeave_get(&enable);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+	val->value.i = (enable == ENABLED) ? 1 : 0;
+	return 0;
+}
