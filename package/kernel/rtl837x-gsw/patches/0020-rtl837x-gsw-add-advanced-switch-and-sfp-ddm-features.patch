+static int rtl837x_sw_set_port_eee(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_enable_t enable;
+	rtk_api_ret_t ret;
+
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+
+	enable = val->value.i ? ENABLED : DISABLED;
+	ret = rtk_eee_portTxRxEn_set(PORT_MAPPED(val->port_vlan), enable, enable);
+	return (ret == RT_ERR_OK) ? 0 : -EIO;
+}
+
+static int rtl837x_sw_get_port_eee(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_enable_t rxEn = DISABLED, txEn = DISABLED;
+	rtk_api_ret_t ret;
+
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+
+	ret = rtk_eee_portTxRxEn_get(PORT_MAPPED(val->port_vlan), &rxEn, &txEn);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+
+	val->value.i = (rxEn == ENABLED && txEn == ENABLED) ? 1 : 0;
+	return 0;
+}
+
+static int rtl837x_sw_set_port_stp(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_api_ret_t ret;
+
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+	if (val->value.i < 0 || val->value.i > 3)
+		return -EINVAL;
+
+	ret = dal_rtl8373_asicMstpPortStatus_set(0, PORT_MAPPED(val->port_vlan), (rtk_uint32)val->value.i);
+	return (ret == RT_ERR_OK) ? 0 : -EIO;
+}
+
+static int rtl837x_sw_get_port_stp(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_uint32 status = 0;
+	rtk_api_ret_t ret;
+
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+
+	ret = dal_rtl8373_asicMstpPortStatus_get(0, PORT_MAPPED(val->port_vlan), &status);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+
+	val->value.i = (int)status;
+	return 0;
+}
+
+static int rtl837x_sw_set_port_isolation(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_uint32 mask;
+	rtk_api_ret_t ret;
+
+	if (val->port_vlan >= gsw->num_ports || val->value.i < 0 || val->value.i > RTL8373_PORTMASK)
+		return -EINVAL;
+
+	mask = (val->value.i == 0) ? RTL8373_PORTMASK : (rtk_uint32)val->value.i;
+	ret = rtk_port_isolation_set(PORT_MAPPED(val->port_vlan), mask);
+	return (ret == RT_ERR_OK) ? 0 : -EIO;
+}
+
+static int rtl837x_sw_get_port_isolation(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	rtk_uint32 mask = 0;
+	rtk_api_ret_t ret;
+
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+
+	ret = rtk_port_isolation_get(PORT_MAPPED(val->port_vlan), &mask);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+
+	val->value.i = (mask == RTL8373_PORTMASK) ? 0 : (int)mask;
+	return 0;
+}
+
+static int rtl837x_sw_set_port_max_frame_size(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	int port;
+	ret_t ret;
+
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+
+	if (val->value.i < 1518 || val->value.i > 16000)
+		return -EINVAL;
+
+	port = PORT_MAPPED(val->port_vlan);
+	ret = dal_rtl8373_portMaxLen_set(port, 0, (rtk_uint32)val->value.i);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+
+	ret = dal_rtl8373_portMaxLen_set(port, 1, (rtk_uint32)val->value.i);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+
+	dal_rtl8373_portMaxLenIncTag_set(port, 1);
+	return 0;
+}
+
+static int rtl837x_sw_get_port_max_frame_size(struct switch_dev *dev, const struct switch_attr *attr, struct switch_val *val)
+{
+	struct rtk_gsw *gsw = container_of(dev, struct rtk_gsw, sw_dev);
+	int port;
+	rtk_uint32 len = 0;
+	ret_t ret;
+
+	if (val->port_vlan >= gsw->num_ports)
+		return -EINVAL;
+
+	port = PORT_MAPPED(val->port_vlan);
+	ret = dal_rtl8373_portMaxLen_get(port, 1, &len);
+	if (ret != RT_ERR_OK)
+		return -EIO;
+
+	val->value.i = (int)len;
+	return 0;
+}
