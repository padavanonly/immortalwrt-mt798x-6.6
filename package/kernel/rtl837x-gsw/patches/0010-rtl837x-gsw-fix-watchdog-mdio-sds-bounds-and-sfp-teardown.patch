 	// check busy
 	ret = bus->read(bus, priv->mdio_addr, MDC_MDIO_CTRL_REG);
+	if (ret < 0)
+		goto out_unlock;
     if (ret & 0x4) {
 		ret = RT_ERR_BUSYWAIT_TIMEOUT;
 		goto out_unlock;
@@ -108,6 +110,8 @@ static int rtl837x_mdio_write(void *ctx, u32 reg, u32 val)
 
