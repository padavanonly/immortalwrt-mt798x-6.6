+static int mtk_htmodes_for_band_2g(int is_wifi7)
+{
+	return IWINFO_HTMODE_HT20 | IWINFO_HTMODE_HT40 |
+	       IWINFO_HTMODE_HE20 | IWINFO_HTMODE_HE40 |
+	       (is_wifi7 ? (IWINFO_HTMODE_EHT20 | IWINFO_HTMODE_EHT40) : 0);
+}
+
+static int mtk_htmodes_for_band_5g(int is_wifi7)
