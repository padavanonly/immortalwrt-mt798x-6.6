+static int mtk_is_wifi7_chip_name(const char *chip)
+{
+	if (!chip || !*chip)
+		return -1;
+	if (!strncasecmp(chip, "MT799", 5))
+		return 1;
+	if (!strncasecmp(chip, "MT798", 5) || !strncasecmp(chip, "MT791", 5))
+		return 0;
+	return -1;
+}
+
+static int mtk_ifname_token_match(const char *list, const char *ifname, int exact_only)
+{
+	const char *p = list;
+	size_t iflen;
+
+	if (!list || !*list || !ifname || !*ifname)
+		return 0;
+
+	iflen = strlen(ifname);
+	while (*p) {
+		const char *sep = strchr(p, ';');
+		size_t tlen = sep ? (size_t)(sep - p) : strlen(p);
+
+		while (tlen > 0 && (*p == ' ' || *p == '\t')) {
+			p++;
+			tlen--;
+		}
+		while (tlen > 0 && (p[tlen - 1] == ' ' || p[tlen - 1] == '\t'))
+			tlen--;
+
+		if (tlen > 0) {
+			if (exact_only) {
+				if (tlen == iflen && !strncmp(p, ifname, tlen))
+					return 1;
+			} else if (iflen > tlen && !strncmp(p, ifname, tlen) &&
+				   isdigit((unsigned char)ifname[tlen])) {
+				return 1;
+			}
+		}
+
+		if (!sep)
+			break;
+		p = sep + 1;
+	}
+	return 0;
+}
+
+static void mtk_append_semi_list(char *dst, size_t dstsz, const char *src)
+{
+	size_t used;
+
+	if (!dst || !dstsz || !src || !*src)
+		return;
+	used = strlen(dst);
+	if (used > 0 && used + 1 < dstsz && dst[used - 1] != ';') {
+		dst[used++] = ';';
+		dst[used] = '\0';
+	}
+	if (used < dstsz - 1)
+		snprintf(dst + used, dstsz - used, "%s", src);
+}
+
+static void mtk_resolve_ifname_for_l1(const char *dev, char *ifname, size_t ifname_sz)
+{
+	struct uci_section *s;
+	const char *mapped_phy;
+
+	if (!ifname || !ifname_sz)
+		return;
+	ifname[0] = '\0';
+	if (!dev || !*dev)
+		return;
+
+	s = iwinfo_uci_get_radio(dev, "mtwifi");
+	if (s) {
+		mapped_phy = uci_lookup_option_string(uci_ctx, s, "phy");
+		if (mapped_phy && *mapped_phy) {
+			snprintf(ifname, ifname_sz, "%s", mapped_phy);
+			iwinfo_uci_free();
+			return;
+		}
+	}
+	iwinfo_uci_free();
+
+	if (mtk_dev2phy(dev, ifname, ifname_sz) != 0)
+		snprintf(ifname, ifname_sz, "%s", dev);
+}
+
+static int mtk_is_wifi7_dev(const char *dev)
+{
+	char chips[8][32];
+	char main_ifs[8][128];
+	char pfx_ifs[8][256];
+	char line[512];
+	char ifname[IFNAMSIZ];
+	FILE *fp;
+	int i, verdict;
+	int saw_zero = 0, saw_one = 0;
+
+	verdict = mtk_is_wifi7_chip_name(dev);
+	if (verdict >= 0)
+		return verdict;
+
+	memset(chips, 0, sizeof(chips));
+	memset(main_ifs, 0, sizeof(main_ifs));
+	memset(pfx_ifs, 0, sizeof(pfx_ifs));
+
+	mtk_resolve_ifname_for_l1(dev, ifname, sizeof(ifname));
+
+	fp = fopen(MTK_L1_PROFILE_PATH, "r");
+	if (fp) {
+		while (fgets(line, sizeof(line), fp)) {
+			char *eq, *k, *v, *end;
+			unsigned int idx = 0;
+			int consumed = 0;
+
+			line[strcspn(line, "\r\n")] = '\0';
+			eq = strchr(line, '=');
+			if (!eq)
+				continue;
+			*eq = '\0';
+			k = line;
+			v = eq + 1;
+
+			while (*k == ' ' || *k == '\t')
+				k++;
+			if (!*k || *k == '#')
+				continue;
+			end = k + strlen(k);
+			while (end > k && (end[-1] == ' ' || end[-1] == '\t'))
+				*--end = '\0';
+
+			while (*v == ' ' || *v == '\t')
+				v++;
+			end = v + strlen(v);
+			while (end > v && (end[-1] == ' ' || end[-1] == '\t'))
+				*--end = '\0';
+			if (!*v)
+				continue;
+
+			if (sscanf(k, "INDEX%u%n", &idx, &consumed) != 1 || idx >= 8)
+				continue;
+			k += consumed;
+
+			if (*k == '\0') {
+				snprintf(chips[idx], sizeof(chips[idx]), "%s", v);
+			} else if (!strcmp(k, "_main_ifname")) {
+				mtk_append_semi_list(main_ifs[idx], sizeof(main_ifs[idx]), v);
+			} else if (!strcmp(k, "_ext_ifname") || !strcmp(k, "_apcli_ifname") ||
+				   !strcmp(k, "_wds_ifname") || !strcmp(k, "_mesh_ifname")) {
+				mtk_append_semi_list(pfx_ifs[idx], sizeof(pfx_ifs[idx]), v);
+			}
+		}
+		fclose(fp);
+
+		for (i = 0; i < 8; i++) {
+			verdict = mtk_is_wifi7_chip_name(chips[i]);
+			if (verdict < 0)
+				continue;
+			if (verdict == 0)
+				saw_zero = 1;
+			else
+				saw_one = 1;
+			if (ifname[0] &&
+			    (mtk_ifname_token_match(main_ifs[i], ifname, 1) ||
+			     mtk_ifname_token_match(pfx_ifs[i], ifname, 0)))
+				return verdict;
+		}
+
+		if (saw_zero && !saw_one)
+			return 0;
+		if (saw_one && !saw_zero)
+			return 1;
+		verdict = mtk_is_wifi7_chip_name(chips[0]);
+		if (verdict >= 0)
+			return verdict;
+	}
+
+	return (access(MTK_HWIFI_SYSFS_PATH, F_OK) == 0) ? 1 : 0;
+}
+
+static int mtk_hwmodes_for_band_2g(int is_wifi7)
+{
+	return IWINFO_80211_N | IWINFO_80211_AX | (is_wifi7 ? IWINFO_80211_BE : 0);
+}
+
+static int mtk_hwmodes_for_band_5g(int is_wifi7)
+{
