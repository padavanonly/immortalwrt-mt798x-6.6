+static void mtk_scanlist_fill_ht_info(const char *row,
+				      const size_t row_offsets[SCAN_DATA_MAX],
+				      uint8_t channel,
+				      struct iwinfo_scanlist_ht_chan_entry *ht)
+{
+	char wmode[24];
+	size_t wmode_len;
+	const char *extch = row + row_offsets[SCAN_DATA_EXTCH];
+
+	if (!memcmp(extch, "ABOVE", 5)) {
+		ht->primary_chan = channel;
+		ht->secondary_chan_off = 1;
+		ht->chan_width = 1;
+		return;
+	}
+
+	if (!memcmp(extch, "BELOW", 5)) {
+		ht->primary_chan = channel;
+		ht->secondary_chan_off = 3;
+		ht->chan_width = 1;
+		return;
+	}
+
+	wmode_len = row_offsets[SCAN_DATA_EXTCH] - 1 - row_offsets[SCAN_DATA_WMODE];
+	if (wmode_len >= sizeof(wmode))
+		wmode_len = sizeof(wmode) - 1;
+	memcpy(wmode, row + row_offsets[SCAN_DATA_WMODE], wmode_len);
+	wmode[wmode_len] = '\0';
+
+	if (strstr(wmode, "/n") || strstr(wmode, "ac") ||
+	    strstr(wmode, "ax") || strstr(wmode, "be")) {
+		ht->primary_chan = channel;
+		ht->secondary_chan_off = 0;
+		ht->chan_width = 0;
+	}
+}
