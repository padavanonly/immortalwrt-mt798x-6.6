+static void mtk_scanlist_parse_crypto(const char *security,
+				      struct iwinfo_crypto_entry *crypto)
+{
+	if (!strcmp(security, "OPEN/NONE") || !strcmp(security, "UNKNOW/NONE"))
+		return;
+
+	if (strstr(security, "PSK") || strstr(security, "OWE") ||
+	    strstr(security, "SAE") || strstr(security, "WPA") ||
+	    strstr(security, "DPP") || strstr(security, "WEP") ||
+	    strstr(security, "SHARED")) {
+		crypto->enabled = true;
+	} else {
+		return;
+	}
+
+	if (strstr(security, "WPA1") || strstr(security, "WPAPSK") ||
+	    !strncmp(security, "WPA/", 4))
+		crypto->wpa_version |= 1 << 0;
+
+	if (strstr(security, "WPA2"))
+		crypto->wpa_version |= 1 << 1;
+
+	if (strstr(security, "WPA3") || strstr(security, "SAE") ||
+	    strstr(security, "OWE") || strstr(security, "DPP"))
+		crypto->wpa_version |= 1 << 2;
+
+	if (crypto->wpa_version) {
+		if (strstr(security, "PSK"))
+			crypto->auth_suites |= IWINFO_KMGMT_PSK;
+		if (strstr(security, "SAE") || strstr(security, "WPA3PSK"))
+			crypto->auth_suites |= IWINFO_KMGMT_SAE;
+		if (strstr(security, "OWE"))
+			crypto->auth_suites |= IWINFO_KMGMT_OWE;
+		if (!(crypto->auth_suites &
+		      (IWINFO_KMGMT_PSK | IWINFO_KMGMT_SAE | IWINFO_KMGMT_OWE)))
+			crypto->auth_suites |= IWINFO_KMGMT_8021x;
+	} else if (strstr(security, "WEP") || strstr(security, "SHARED")) {
+		crypto->auth_algs |= IWINFO_AUTH_OPEN;
+		if (strstr(security, "SHARED") || strstr(security, "WEPAUTO"))
+			crypto->auth_algs |= IWINFO_AUTH_SHARED;
+		crypto->pair_ciphers |= IWINFO_CIPHER_WEP40 | IWINFO_CIPHER_WEP104;
+	}
+
+	if (strstr(security, "AES"))
+		crypto->pair_ciphers |= IWINFO_CIPHER_CCMP;
+
+	if (strstr(security, "CCMP256"))
+		crypto->pair_ciphers |= IWINFO_CIPHER_CCMP256;
+
+	if (strstr(security, "TKIP"))
+		crypto->pair_ciphers |= IWINFO_CIPHER_TKIP;
+
+	if (strstr(security, "GCMP128"))
+		crypto->pair_ciphers |= IWINFO_CIPHER_GCMP;
+
+	if (strstr(security, "GCMP256"))
+		crypto->pair_ciphers |= IWINFO_CIPHER_GCMP256;
+}
