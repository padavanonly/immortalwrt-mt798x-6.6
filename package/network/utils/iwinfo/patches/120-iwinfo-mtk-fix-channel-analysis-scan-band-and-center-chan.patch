+static enum mtk_config_band mtk_detect_device_band(const char *dev, const char *ifname)
+{
+	char chans[IWINFO_BUFSIZE] = { 0 };
+	struct iwinfo_freqlist_entry *e;
+	enum mtk_config_band band;
+	uint8_t entry_band;
+	int len = 0;
+
+	band = mtk_get_config_band(dev);
+	if (band == MTK_CONFIG_BAND_2G ||
+	    band == MTK_CONFIG_BAND_5G ||
+	    band == MTK_CONFIG_BAND_6G)
+		return band;
+
+	if (ifname && *ifname &&
+	    !mtk_get_freqlist_by_ifname(ifname, chans, &len) &&
+	    len >= (int)sizeof(*e)) {
+		e = (struct iwinfo_freqlist_entry *)chans;
+		entry_band = e->band ? e->band : mtk_freq_band(e->mhz);
+		if (entry_band == iwinfo_ghz2band(2))
+			return MTK_CONFIG_BAND_2G;
+		if (entry_band == iwinfo_ghz2band(5))
+			return MTK_CONFIG_BAND_5G;
+		if (entry_band == iwinfo_ghz2band(6))
+			return MTK_CONFIG_BAND_6G;
+	}
+
+	return MTK_CONFIG_BAND_NONE;
+}
+
+static int mtk_channel_to_mhz_band(enum mtk_config_band cfg_band, int channel,
+				     uint32_t *mhz_out, uint8_t *band_out)
+{
+	uint32_t mhz;
+	uint8_t band;
+
+	if (channel <= 0)
+		return -1;
+
+	if (cfg_band == MTK_CONFIG_BAND_6G) {
+		if (channel == 2)
+			mhz = 5935;
+		else if (channel <= 233)
+			mhz = (uint32_t)(5950 + channel * 5);
+		else
+			return -1;
+		band = iwinfo_ghz2band(6);
+	} else if (cfg_band == MTK_CONFIG_BAND_2G ||
+		   (cfg_band != MTK_CONFIG_BAND_5G && channel <= 14)) {
+		if (channel == 14)
+			mhz = 2484;
+		else if (channel < 14)
+			mhz = (uint32_t)(2407 + channel * 5);
+		else
+			return -1;
+		band = iwinfo_ghz2band(2);
+	} else {
+		if (channel >= 182 && channel <= 196)
+			mhz = (uint32_t)(4000 + channel * 5);
+		else if (channel <= 181)
+			mhz = (uint32_t)(5000 + channel * 5);
+		else
+			return -1;
+		band = iwinfo_ghz2band(5);
+	}
+
+	if (mhz_out)
+		*mhz_out = mhz;
+	if (band_out)
+		*band_out = band;
+	return 0;
+}
