+static int mtk_scanlist_has_duplicate(const char *buf, size_t output_len,
+				      const uint8_t mac[6], uint8_t channel)
+{
+	const struct iwinfo_scanlist_entry *cur;
+	size_t off;
+
+	for (off = 0; off + sizeof(*cur) <= output_len; off += sizeof(*cur)) {
+		cur = (const struct iwinfo_scanlist_entry *)(buf + off);
+		if (cur->channel == channel && memcmp(cur->mac, mac, 6) == 0)
+			return 1;
+	}
+
+	return 0;
+}
