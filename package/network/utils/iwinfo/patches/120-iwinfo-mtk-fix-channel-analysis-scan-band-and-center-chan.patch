+static int mtk_compute_center_chan1(enum mtk_config_band band, int channel,
+				    unsigned char bw, unsigned char ext_cha)
+{
+	if (channel <= 0)
+		return -1;
+
+	if (band != MTK_CONFIG_BAND_2G &&
+	    band != MTK_CONFIG_BAND_5G &&
+	    band != MTK_CONFIG_BAND_6G)
+		band = (channel <= 14) ? MTK_CONFIG_BAND_2G : MTK_CONFIG_BAND_5G;
+
+	switch (bw) {
+	case BW_40:
+		if (ext_cha == EXTCHA_ABOVE)
+			return channel + 2;
+		if (ext_cha == EXTCHA_BELOW && channel > 2)
+			return channel - 2;
+		if (band == MTK_CONFIG_BAND_2G) {
+			if (channel <= 7)
+				return channel + 2;
+			if (channel > 2)
+				return channel - 2;
+			return channel;
+		}
+		if (band == MTK_CONFIG_BAND_5G) {
+			if (channel >= 36 && channel <= 64)
+				return ((channel - 36) / 8) * 8 + 38;
+			if (channel >= 100 && channel <= 144)
+				return ((channel - 100) / 8) * 8 + 102;
+			if (channel >= 149 && channel <= 177)
+				return ((channel - 149) / 8) * 8 + 151;
+			return channel;
+		}
+		if (channel >= 1 && channel <= 229 && channel != 2)
+			return ((channel - 1) / 8) * 8 + 3;
+		return channel;
+	case BW_80:
+	case BW_8080:
+		if (band == MTK_CONFIG_BAND_5G) {
+			if (channel >= 36 && channel <= 48)
+				return 42;
+			if (channel >= 52 && channel <= 64)
+				return 58;
+			if (channel >= 100 && channel <= 112)
+				return 106;
+			if (channel >= 116 && channel <= 128)
+				return 122;
+			if (channel >= 132 && channel <= 144)
+				return 138;
+			if (channel >= 149 && channel <= 161)
+				return 155;
+			if (channel >= 165 && channel <= 177)
+				return 171;
+			return channel;
+		}
+		if (band == MTK_CONFIG_BAND_6G &&
+		    channel >= 1 && channel <= 221 && channel != 2)
+			return ((channel - 1) / 16) * 16 + 7;
+		return channel;
+	case BW_160:
+		if (band == MTK_CONFIG_BAND_5G) {
+			if (channel >= 36 && channel <= 64)
+				return 50;
+			if (channel >= 100 && channel <= 128)
+				return 114;
+			if (channel >= 149 && channel <= 177)
+				return 163;
+			return channel;
+		}
+		if (band == MTK_CONFIG_BAND_6G &&
+		    channel >= 1 && channel <= 221 && channel != 2)
+			return ((channel - 1) / 32) * 32 + 15;
+		return channel;
+	case BW_320:
+		if (band == MTK_CONFIG_BAND_6G) {
+			if (channel >= 1 && channel <= 61 && channel != 2)
+				return 31;
+			if (channel >= 65 && channel <= 125)
+				return 95;
+			if (channel >= 129 && channel <= 189)
+				return 159;
+			if (channel >= 193 && channel <= 221)
+				return 191;
+		}
+		return channel;
+	case BW_20:
+	case BW_10:
+	case BW_5:
+	case BW_20_242TONE:
+	default:
+		return channel;
+	}
+}
