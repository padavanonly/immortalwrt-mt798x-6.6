+	unsigned char bw = BW_20;
+	unsigned char ext_cha = EXTCHA_NONE;
+	enum mtk_config_band band;
+	int channel;
+	int center;
+
+	if (!buf || mtk_dev2phy(dev, ifname, sizeof(ifname)))
+		return -1;
+
+	if (!mtk_is_ifup(ifname))
+		return -1;
+
+	if (mtk_ioctl(ifname, SIOCGIWFREQ, &wrq) < 0)
+		return -1;
