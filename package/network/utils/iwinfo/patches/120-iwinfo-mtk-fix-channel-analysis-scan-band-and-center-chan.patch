+		return -1;
+
+	memset(&wrq, 0, sizeof(wrq));
+	wrq.u.data.length = sizeof(bw);
+	wrq.u.data.pointer = &bw;
+	wrq.u.data.flags = OID_802_11_BW;
+	if (mtk_ioctl(ifname, RT_PRIV_IOCTL, &wrq) < 0 ||
+	    wrq.u.data.length != sizeof(bw))
+		bw = BW_20;
+
+	memset(&wrq, 0, sizeof(wrq));
+	wrq.u.data.length = sizeof(ext_cha);
+	wrq.u.data.pointer = &ext_cha;
+	wrq.u.data.flags = OID_802_11_EXTENSION_CHANNEL;
+	if (mtk_ioctl(ifname, RT_PRIV_IOCTL, &wrq) < 0 ||
+	    wrq.u.data.length != sizeof(ext_cha))
+		ext_cha = EXTCHA_NONE;
+
+	band = mtk_detect_device_band(dev, ifname);
+	center = mtk_compute_center_chan1(band, channel, bw, ext_cha);
+	if (center <= 0)
+		return -1;
+
+	*buf = center;
+	return 0;
 }
 
