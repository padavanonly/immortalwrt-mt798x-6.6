+static int mtk_scanlist_hex_nibble(char value)
+{
+	if (value >= '0' && value <= '9')
+		return value - '0';
+	if (value >= 'a' && value <= 'f')
+		return value - 'a' + 10;
+	if (value >= 'A' && value <= 'F')
+		return value - 'A' + 10;
+	return -1;
+}
+
+static int mtk_scanlist_parse_bssid(const char *field, size_t field_len,
+				    uint8_t mac[6])
+{
+	size_t pos = 0;
+	int i;
+
+	if (field_len != 20)
+		return -1;
+
+	for (i = 0; i < 6; i++) {
+		int high = mtk_scanlist_hex_nibble(field[pos]);
+		int low = mtk_scanlist_hex_nibble(field[pos + 1]);
+
+		if (high < 0 || low < 0)
