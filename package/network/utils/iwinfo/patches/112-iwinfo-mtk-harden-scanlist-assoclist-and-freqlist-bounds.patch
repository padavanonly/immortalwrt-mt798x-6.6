+static enum mtk_config_band mtk_get_config_band(const char *dev)
+{
+	const char *band;
+	struct uci_section *s;
+	enum mtk_config_band result = MTK_CONFIG_BAND_NONE;
+
+	s = iwinfo_uci_get_radio(dev, "mtwifi");
+	if (!s)
+		goto out;
+
+	band = uci_lookup_option_string(uci_ctx, s, "band");
+	if (!band)
+		goto out;
+
+	if (!strcmp(band, "2g"))
+		result = MTK_CONFIG_BAND_2G;
+	else if (!strcmp(band, "5g"))
+		result = MTK_CONFIG_BAND_5G;
+	else
+		result = MTK_CONFIG_BAND_OTHER;
+
+out:
+	iwinfo_uci_free();
+	return result;
+}
