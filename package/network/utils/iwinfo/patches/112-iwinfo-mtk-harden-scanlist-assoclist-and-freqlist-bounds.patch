+static int mtk_scanlist_parse_uint(const char *field, size_t field_len,
+				   unsigned long max_value,
+				   unsigned long *value)
+{
+	size_t i = 0;
+	unsigned long parsed = 0;
+	int digits = 0;
+
+	while (i < field_len && field[i] == ' ')
+		i++;
+
+	while (i < field_len && field[i] >= '0' && field[i] <= '9') {
+		unsigned long digit = (unsigned long)(field[i] - '0');
+
+		if (digit > max_value || parsed > (max_value - digit) / 10)
+			return -1;
+
+		parsed = parsed * 10 + digit;
+		digits++;
+		i++;
+	}
 
