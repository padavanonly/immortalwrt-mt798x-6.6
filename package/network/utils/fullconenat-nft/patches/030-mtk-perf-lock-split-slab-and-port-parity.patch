From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] fullconenat-nft: split dying-list lock, add slab caches, and preserve port parity

Splice dying_tuple_list into a local list before releasing dying_tuple_list_lock
so v4/v6 cleanup acquires only one table lock at a time without blocking
ct_event_cb. Back nat_mapping, nat_mapping6, nat_mapping_original_tuple, and
tuple_list allocations with dedicated kmem_cache slab pools initialized and
torn down cleanly around module expr lifetime. Preserve RFC 4787 port parity
before opposite-parity fallback when scanning from clamped original_port.

Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
diff -uNrp a/src/nf_nat_fullcone.c b/src/nf_nat_fullcone.c
--- a/src/nf_nat_fullcone.c	2026-11-23 11:33:55.197194889 +0800
+++ b/src/nf_nat_fullcone.c	2026-11-23 11:33:55.218278187 +0800
@@ -21,6 +21,7 @@
 #include <linux/atomic.h>
 #include <linux/kernel.h>
 #include <linux/jhash.h>
+#include <linux/slab.h>
 
 #ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
 #include <linux/notifier.h>
@@ -74,6 +75,13 @@ static DEFINE_SPINLOCK(fullconenat6_lock
 static LIST_HEAD(dying_tuple_list);
 static DEFINE_SPINLOCK(dying_tuple_list_lock);
 
+static struct kmem_cache *original_tuple_cachep __read_mostly;
+static struct kmem_cache *dying_tuple_cachep __read_mostly;
+static struct kmem_cache *mapping_cachep __read_mostly;
+#if IS_ENABLED(CONFIG_NF_NAT_IPV6) || (IS_ENABLED(CONFIG_IPV6) && LINUX_VERSION_CODE >= KERNEL_VERSION(5, 1, 0))
+static struct kmem_cache *mapping6_cachep __read_mostly;
+#endif
+
 /* static variables end */
 
 /* forward declaration */
@@ -291,6 +299,74 @@ static char *nf_ct_stringify_tuple(const
 
 /* non-atomic part end */
 
+int nf_nat_fullcone_init(void)
+{
+	original_tuple_cachep = kmem_cache_create("nf_fullcone_tuple",
+						  sizeof(struct nat_mapping_original_tuple),
+						  0, 0, NULL);
+	if (!original_tuple_cachep)
+		return -ENOMEM;
+
+	dying_tuple_cachep = kmem_cache_create("nf_fullcone_dying",
+					       sizeof(struct tuple_list),
+					       0, 0, NULL);
+	if (!dying_tuple_cachep)
+		goto err_original;
+
+	mapping_cachep = kmem_cache_create("nf_fullcone_map",
+					   sizeof(struct nat_mapping),
+					   0, 0, NULL);
+	if (!mapping_cachep)
+		goto err_dying;
+
+#if IS_ENABLED(CONFIG_NF_NAT_IPV6) || (IS_ENABLED(CONFIG_IPV6) && LINUX_VERSION_CODE >= KERNEL_VERSION(5, 1, 0))
+	mapping6_cachep = kmem_cache_create("nf_fullcone_map6",
+					    sizeof(struct nat_mapping6),
+					    0, 0, NULL);
+	if (!mapping6_cachep)
+		goto err_mapping;
+#endif
+
+	return 0;
+
+#if IS_ENABLED(CONFIG_NF_NAT_IPV6) || (IS_ENABLED(CONFIG_IPV6) && LINUX_VERSION_CODE >= KERNEL_VERSION(5, 1, 0))
+err_mapping:
+	kmem_cache_destroy(mapping_cachep);
+	mapping_cachep = NULL;
+#endif
+err_dying:
+	kmem_cache_destroy(dying_tuple_cachep);
+	dying_tuple_cachep = NULL;
+err_original:
+	kmem_cache_destroy(original_tuple_cachep);
+	original_tuple_cachep = NULL;
+	return -ENOMEM;
+}
+
+void nf_nat_fullcone_exit(void)
+{
+#if IS_ENABLED(CONFIG_NF_NAT_IPV6) || (IS_ENABLED(CONFIG_IPV6) && LINUX_VERSION_CODE >= KERNEL_VERSION(5, 1, 0))
+	kmem_cache_destroy(mapping6_cachep);
+	mapping6_cachep = NULL;
+#endif
+	kmem_cache_destroy(mapping_cachep);
+	mapping_cachep = NULL;
+	kmem_cache_destroy(dying_tuple_cachep);
+	dying_tuple_cachep = NULL;
+	kmem_cache_destroy(original_tuple_cachep);
+	original_tuple_cachep = NULL;
+}
+
+struct tuple_list *nf_nat_fullcone_dying_tuple_alloc(void)
+{
+	return kmem_cache_alloc(dying_tuple_cachep, GFP_ATOMIC);
+}
+
+static inline void nf_nat_fullcone_dying_tuple_free(struct tuple_list *item)
+{
+	kmem_cache_free(dying_tuple_cachep, item);
+}
