From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] netifd: add mtwifi compatibility exception for interface reload

Scope disabled-interface exception handling to mtwifi AP devices during netifd state reloads.

Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
--- a/wireless.c
+++ b/wireless.c
@@ -1243,7 +1243,11 @@
 	blobmsg_parse_attr(vif_policy, __VIF_ATTR_MAX, tb, data);
 
 	cur = tb[VIF_ATTR_DISABLED];
-	if (cur && blobmsg_get_bool(cur))
+	if (cur && blobmsg_get_bool(cur) &&
+	    !(wdev->drv && wdev->drv->name &&
+	      !strcmp(wdev->drv->name, "mtwifi") &&
+	      tb[VIF_ATTR_MODE] &&
+	      !strcmp(blobmsg_get_string(tb[VIF_ATTR_MODE]), "ap")))
 		return NULL;
 
 	sprintf(name, "%d", wdev->vif_idx++);
