From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] firewall4: enforce explicit flow-offload gating hooks

Allow platform flow-offload policy controls to disable incompatible flowtable rules cleanly.

Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -22,9 +22,6 @@
 		hook ingress priority 0;
 		devices = {{ fw4.set(flowtable_devices, true) }};
 		counter;
-{% if (fw4.default_option("flow_offloading_hw")): %}
-		flags offload;
-{% endif %}
 	}
 
 
