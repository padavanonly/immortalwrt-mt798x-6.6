+#ifndef FT_KDP_EMPTY
+static FT_KDP_R0KH_INFO *ft_kdp_r0kh_info_del_locked(
+	IN	PRTMP_ADAPTER		pAd,
+	IN	UCHAR				*pR0KHID,
+	IN	UCHAR				*pMAC,
+	IN	UINT32				IP)
+{
+	FT_KDP_R0KH_INFO *pInfo;
+	FT_KDP_R0KH_INFO *pInfoBackup, *pInfoDelPrev = NULL, *pInfoDel = NULL;
+	ULONG TimeOldest = 0xFFFFFFFF;
+
+	pInfo = FT_KDP_CB->R0KH_InfoHead;
+	if (pInfo == NULL)
+		return NULL;
+
+	pInfoBackup = pInfo;
+	while (pInfo != NULL) {
+		if ((pR0KHID == NULL) && (pMAC == NULL) && (IP == 0)) {
+			if (pInfo->TimeUpdate < TimeOldest) {
+				TimeOldest = pInfo->TimeUpdate;
+				pInfoDelPrev = pInfoBackup;
+				pInfoDel = pInfo;
+			}
+		} else {
+			if ((pR0KHID != NULL) &&
+				(NdisEqualMemory(pR0KHID, pInfo->R0KHID, sizeof(pInfo->R0KHID)))) {
+				pInfoDelPrev = pInfoBackup;
+				pInfoDel = pInfo;
+				break;
+			}
+			if ((pMAC != NULL) &&
+				(NdisEqualMemory(pMAC, pInfo->MAC, sizeof(pInfo->MAC)))) {
+				pInfoDelPrev = pInfoBackup;
+				pInfoDel = pInfo;
+				break;
+			}
+			if (pInfo->IP == IP) {
+				pInfoDelPrev = pInfoBackup;
+				pInfoDel = pInfo;
+				break;
+			}
+		}
+		pInfoBackup = pInfo;
+		pInfo = pInfo->pNext;
+	}
+
+	if (pInfoDel != NULL) {
+		FT_KDP_CB->R0KH_Size--;
+		if (FT_KDP_CB->R0KH_Size == 0) {
+			FT_KDP_CB->R0KH_InfoHead = NULL;
+			FT_KDP_CB->R0KH_InfoTail = NULL;
+		} else if (pInfoDelPrev == pInfoDel) {
+			FT_KDP_CB->R0KH_InfoHead = pInfoDel->pNext;
+		} else {
+			pInfoDelPrev->pNext = pInfoDel->pNext;
+			if (FT_KDP_CB->R0KH_InfoTail == pInfoDel)
+				FT_KDP_CB->R0KH_InfoTail = pInfoDelPrev;
+		}
+	}
+	return pInfoDel;
+}
