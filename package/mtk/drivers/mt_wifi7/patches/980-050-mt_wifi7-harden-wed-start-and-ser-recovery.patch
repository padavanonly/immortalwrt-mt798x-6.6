diff --git a/mt_wifi/hw_ctrl/ser_mngr/ser_mngr.c b/mt_wifi/hw_ctrl/ser_mngr/ser_mngr.c
index b8a2d05..cfe0e50 100644
--- a/mt_wifi/hw_ctrl/ser_mngr/ser_mngr.c
+++ b/mt_wifi/hw_ctrl/ser_mngr/ser_mngr.c
@@ -760,6 +760,77 @@ static void ser_free_event_cb(
 #endif
 
 
+VOID ser_latch_terminal_failure(struct ser_cb_t *ser_cb, UINT8 failed_state, INT32 err)
+{
+	struct ser_ctrl_t *_ser_ctrl = ser_get_ser_ctrl();
+	NDIS_SPIN_LOCK *lock = &_ser_ctrl->cb_lsit_lock;
+	unsigned long flags;
+
+	if (!ser_cb)
+		return;
+
+	RTMP_SPIN_LOCK_IRQSAVE(lock, &flags);
+	ser_cb->terminal_failed = TRUE;
+	ser_cb->failed_state = failed_state;
+	ser_cb->last_err = err;
+	RTMP_SPIN_UNLOCK_IRQRESTORE(lock, &flags);
+}
+
+BOOLEAN ser_is_terminal_failed(struct ser_cb_t *ser_cb)
+{
+	struct ser_ctrl_t *_ser_ctrl = ser_get_ser_ctrl();
+	NDIS_SPIN_LOCK *lock = &_ser_ctrl->cb_lsit_lock;
+	unsigned long flags;
+	BOOLEAN failed = FALSE;
+
+	if (!ser_cb)
+		return FALSE;
+
+	RTMP_SPIN_LOCK_IRQSAVE(lock, &flags);
+	failed = ser_cb->terminal_failed;
+	RTMP_SPIN_UNLOCK_IRQRESTORE(lock, &flags);
+
+	return failed;
+}
+
+VOID ser_clear_terminal_failure(struct ser_cb_t *ser_cb)
+{
+	struct ser_ctrl_t *_ser_ctrl = ser_get_ser_ctrl();
+	NDIS_SPIN_LOCK *lock = &_ser_ctrl->cb_lsit_lock;
+	struct ser_cb_t *iter_cb = NULL;
+	unsigned long flags;
+
+	if (!ser_cb)
+		return;
+
+	RTMP_SPIN_LOCK_IRQSAVE(lock, &flags);
+	ser_cb->terminal_failed = FALSE;
+	ser_cb->failed_state = 0;
+	ser_cb->last_err = 0;
+	if (ser_cb->ser_level == SER_LV_1_0) {
+		ser_cb->ser_state = SER_LV_1_0_STATE_STOP_IDLE;
+#ifdef MTK_FE_RESET_RECOVER
+		ser_cb->need_reset = FALSE;
+#endif
+	}
+
+	DlListForEach(iter_cb, &_ser_ctrl->ser_cb_list, struct ser_cb_t, list) {
+		if (iter_cb->chip_id == ser_cb->chip_id &&
+		    iter_cb->hw_id == ser_cb->hw_id) {
+			iter_cb->terminal_failed = FALSE;
+			iter_cb->failed_state = 0;
+			iter_cb->last_err = 0;
+			if (iter_cb->ser_level == SER_LV_1_0) {
+				iter_cb->ser_state = SER_LV_1_0_STATE_STOP_IDLE;
+#ifdef MTK_FE_RESET_RECOVER
+				iter_cb->need_reset = FALSE;
+#endif
+			}
+		}
+	}
+	RTMP_SPIN_UNLOCK_IRQRESTORE(lock, &flags);
+}
+
 static int ser_handler(
 	struct ser_ctrl_t *_ser_ctrl,
 	struct ser_cb_t *ser_cb)
@@ -835,6 +906,21 @@ static int ser_handler(
 		return NDIS_STATUS_FAILURE;
 	}
 
+	if (level == SER_LV_1_0 && ser_is_terminal_failed(ser_cb)) {
+		MTWF_DBG(NULL, DBG_CAT_HW, CATHW_SER, DBG_LVL_ERROR,
+			"SER L1 rejected: chip=0x%x,hw_id=%u,failed_state=%u,last_err=%d\n",
+			chip_id, hw_id, ser_cb->failed_state, ser_cb->last_err);
+		return NDIS_STATUS_FAILURE;
+	}
+
+	if (level == SER_LV_0_5
+#ifdef MTK_FE_RESET_RECOVER
+	    || level == FE_RESET || level == FE_WDMA_RESET
+#endif
+	) {
+		ser_clear_terminal_failure(ser_cb);
+	}
+
 	if (_ser_handler)
 		_ser_handler(ser_cb);
 
