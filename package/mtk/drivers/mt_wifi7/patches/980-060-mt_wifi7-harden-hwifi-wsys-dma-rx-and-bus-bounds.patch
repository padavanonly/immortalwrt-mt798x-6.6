+static void
+pci_dma_rx_init_unwind_queue(struct pci_trans *trans, struct pci_rx_queue *rq)
+{
+	struct pci_queue *q = &rq->q;
+	struct pci_dma_cb *cb;
+	struct pci_dma_buf *buf;
+	unsigned int i;
+
+	if (!rq->rx_init_started)
+		return;
+
+	set_bit(RXQ_STOPPING, &rq->runtime_flags);
+
+#ifdef CONFIG_HWIFI_RX_PROCESS_WORKQUEUE
+	if (rq->rx_process_work_ready)
+		pci_dma_exit_rx_process_work(rq);
+#endif
+
+	if (!test_bit(RQ_FLAG_RX_DATA_TKID, &rq->rq_flags)) {
+		for (i = 0; i < rq->initialized_descs; i++) {
+			cb = &q->cb[i];
+			buf = &cb->dma_buf;
+			if (!cb->pkt)
+				continue;
+			if (rq->q.q_attr == Q_RX_DATA_MSDU_PG)
+				rro_msdu_page_hash_deinit_one(trans,
+							      buf->alloc_pa);
+			dma_unmap_single(to_device(trans), buf->alloc_pa,
+					 buf->alloc_size, DMA_FROM_DEVICE);
+			put_page(virt_to_head_page(cb->pkt));
+			cb->pkt = NULL;
+			buf->alloc_va = NULL;
+			buf->alloc_pa = 0;
+		}
+	} else {
+		for (i = 0; i < rq->initialized_descs; i++)
+			q->cb[i].pkt = NULL;
+	}
+
+	pci_rx_queue_page_drain(rq);
+	rq->initialized_descs = 0;
+	rq->rx_init_started = false;
+}
