+void
+rro_msdu_page_hash_deinit_one(struct pci_trans *trans, dma_addr_t pa)
+{
+	struct hw_rro_cfg *rro_cfg = trans->rro_cfg;
+	struct msdu_page_addr *pg_addr, *tmp;
+	u32 hash_idx;
+
+	if (!rro_cfg)
+		return;
+
+	hash_idx = msdu_page_hash(pa);
+	spin_lock(&rro_cfg->lock);
+	list_for_each_entry_safe(pg_addr, tmp,
+				 &rro_cfg->pg_hash_head[hash_idx], list) {
+		if (pg_addr->pa == pa) {
+			list_del(&pg_addr->list);
+			kfree(pg_addr);
+			break;
+		}
+	}
+	spin_unlock(&rro_cfg->lock);
+}
 
