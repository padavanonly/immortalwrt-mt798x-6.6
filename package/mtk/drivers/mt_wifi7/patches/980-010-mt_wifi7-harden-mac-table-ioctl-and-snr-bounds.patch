From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] mt_wifi7: harden MAC table ioctl state, length checks, and
 SNR bounds

Propagate MAC table ioctl output bounds, reset per-row interface/SNR state, size local SNR callback buffers to 4 bytes, and validate unified SNR event payloads.
Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
 mt_wifi/ap/ap_cfg.c                 |  2 +-
 mt_wifi/chip/mcu/cmm_fw_uni_event.c | 25 ++++++++++++++++++----
 mt_wifi/common/cmm_info.c           | 33 +++++++++++++++++++++++------
 mt_wifi/hw_ctrl/hw_ctrl.c           |  9 +++++---
 mt_wifi/include/ap/ap_cfg.h         |  2 +-
 mt_wifi/os/linux/ap_ioctl.c         |  2 +-
 6 files changed, 57 insertions(+), 16 deletions(-)

diff --git a/mt_wifi/ap/ap_cfg.c b/mt_wifi/ap/ap_cfg.c
index 34c220b..6397356 100644
--- a/mt_wifi/ap/ap_cfg.c
+++ b/mt_wifi/ap/ap_cfg.c
@@ -24795,7 +24795,7 @@ INT RTMP_AP_IoctlHandle(
 		break;
 #endif /* DBG */
         case CMD_RTPRIV_IOCTL_GET_MAC_TABLE_STRUCT:
-                RTMPIoctlGetMacTableStaInfo(pAd, wrq);
+                Status = RTMPIoctlGetMacTableStaInfo(pAd, wrq);
                 break;
 	case CMD_RTPRIV_IOCTL_AP_SIOCGIFHWADDR:
 		ifIndex = pObj->ioctl_if;
diff --git a/mt_wifi/chip/mcu/cmm_fw_uni_event.c b/mt_wifi/chip/mcu/cmm_fw_uni_event.c
index c458941..7abc8a1 100644
--- a/mt_wifi/chip/mcu/cmm_fw_uni_event.c
+++ b/mt_wifi/chip/mcu/cmm_fw_uni_event.c
@@ -7075,11 +7075,28 @@ VOID uni_event_per_sta_per_handler(struct cmd_msg *msg, char *rsp_payload,
 VOID uni_event_per_sta_snr_handler(struct cmd_msg *msg, char *rsp_payload,
 					UINT16 rsp_payload_len)
 {
-	PUINT8 pu1SNR = (PUINT8) msg->attr.rsp.wb_buf_in_calbk;
-	struct UNI_EVENT_PER_STA_INFO_T *event = (struct UNI_EVENT_PER_STA_INFO_T *)rsp_payload;
-	struct UNI_EVENT_PER_STA_INFO_COMMON_T *tlv = (struct UNI_EVENT_PER_STA_INFO_COMMON_T *) &(event->au1TlvBuffer[0]);
-	struct UNI_EVENT_PER_STA_SNR_T *ptr = (struct UNI_EVENT_PER_STA_SNR_T *) &(tlv->au1PerStaContent[0]);
+	PUINT8 pu1SNR;
+	struct UNI_EVENT_PER_STA_INFO_T *event;
+	struct UNI_EVENT_PER_STA_INFO_COMMON_T *tlv;
+	struct UNI_EVENT_PER_STA_SNR_T *ptr;
+
+	if (!msg || !rsp_payload ||
+	    rsp_payload_len < sizeof(struct UNI_EVENT_PER_STA_INFO_T) +
+				 sizeof(struct UNI_EVENT_PER_STA_INFO_COMMON_T) +
+				 sizeof(struct UNI_EVENT_PER_STA_SNR_T) ||
+	    rsp_payload_len > (0xFFFF - sizeof(EVENT_RXD)))
+		return;
+
+	pu1SNR = (PUINT8)msg->attr.rsp.wb_buf_in_calbk;
+	if (!pu1SNR)
+		return;
+
+	event = (struct UNI_EVENT_PER_STA_INFO_T *)rsp_payload;
+	tlv = (struct UNI_EVENT_PER_STA_INFO_COMMON_T *)&event->au1TlvBuffer[0];
+	if (le2cpu16(tlv->u2Tag) != UNI_EVENT_PER_STA_SNR)
+		return;
 
+	ptr = (struct UNI_EVENT_PER_STA_SNR_T *)&tlv->au1PerStaContent[0];
 	pu1SNR[0] = ptr->au1Snr[0];
 	pu1SNR[1] = ptr->au1Snr[1];
 	pu1SNR[2] = ptr->au1Snr[2];
diff --git a/mt_wifi/common/cmm_info.c b/mt_wifi/common/cmm_info.c
index c51ce7d..fa7dae6 100644
--- a/mt_wifi/common/cmm_info.c
+++ b/mt_wifi/common/cmm_info.c
@@ -7628,23 +7628,38 @@ UINT32 RTMPGetLastRxRate(PRTMP_ADAPTER pAd, MAC_TABLE_ENTRY *pEntry)
 	return lastRxRate.word;
 }
 
-VOID RTMPIoctlGetMacTableStaInfo(
+static INT RTMPValidateMacTableStaInfoRequest(RTMP_IOCTL_INPUT_STRUCT *wrq)
+{
+	if (!wrq || !wrq->u.data.pointer)
+		return RTMP_IO_EFAULT;
+	if (wrq->u.data.length < sizeof(RT_802_11_MAC_TABLE_FIX))
+		return RTMP_IO_E2BIG;
+	return NDIS_STATUS_SUCCESS;
+}
+
+INT RTMPIoctlGetMacTableStaInfo(
 	IN PRTMP_ADAPTER pAd,
 	IN RTMP_IOCTL_INPUT_STRUCT *wrq)
 {
-	UINT8 u1Snr = 0;
+	UINT8 u1Snr[4] = {0};
 	INT i, rssi_len;
+	INT status;
 	BOOLEAN need_send = FALSE;
 	RT_802_11_MAC_TABLE_FIX *pMacTab = NULL;
 	PRT_802_11_MAC_ENTRY_FIX pDst;
 	PMAC_TABLE_ENTRY pEntry;
 	CHAR rssi[4] = {-127, -127, -127, -127};
+
+	status = RTMPValidateMacTableStaInfoRequest(wrq);
+	if (status != NDIS_STATUS_SUCCESS)
+		return status;
+
 	/* allocate memory */
 	os_alloc_mem(NULL, (UCHAR **)&pMacTab, sizeof(RT_802_11_MAC_TABLE_FIX)); 
 
 	if (pMacTab == NULL) {
 		MTWF_DBG(pAd, DBG_CAT_CFG, CATCFG_DBGLOG, DBG_LVL_ERROR, "Allocate memory fail!!!\n");
-		return;
+		return RTMP_IO_ENOMEM;
 	}
 
 	NdisZeroMemory(pMacTab, sizeof(RT_802_11_MAC_TABLE_FIX));
@@ -7657,6 +7672,7 @@ VOID RTMPIoctlGetMacTableStaInfo(
 		//pEntry = &(pAd->MacTab->Content[i]);
 		pEntry = entry_get(pAd, i);
 
+		need_send = FALSE;
 		if (pEntry->wdev != NULL && pEntry->wdev->if_dev != NULL) {
 			/* As per new GUI design ifname with index as ra0/ra1/rai0/rai1/... (may not work with older GUI)*/
 			if (!strcmp(wrq->ifr_ifrn.ifrn_name, pEntry->wdev->if_dev->name))
@@ -7683,8 +7699,9 @@ VOID RTMPIoctlGetMacTableStaInfo(
 			pDst->AvgRssi2 = rssi[2];
 			pDst->AvgRssi3 = rssi[3];
 			/* Fill in SNR per entry*/
-			UniCmdPerStaGetSNR(pAd, pEntry->wcid, &u1Snr);
-			pDst->AvgSnr = u1Snr;
+			NdisZeroMemory(u1Snr, sizeof(u1Snr));
+			UniCmdPerStaGetSNR(pAd, pEntry->wcid, u1Snr);
+			pDst->AvgSnr = u1Snr[0];
 			/* the connected time per entry*/
 			pDst->ConnectedTime = pEntry->StaConnectTime;
 			pDst->TxRate.word = RTMPGetLastTxRate_FIX(pAd, pEntry);
@@ -7705,10 +7722,14 @@ VOID RTMPIoctlGetMacTableStaInfo(
 
 	wrq->u.data.length = sizeof(RT_802_11_MAC_TABLE_FIX);
 
-	if (copy_to_user(wrq->u.data.pointer, pMacTab, wrq->u.data.length))
+	if (copy_to_user(wrq->u.data.pointer, pMacTab, wrq->u.data.length)) {
 		MTWF_DBG(pAd, DBG_CAT_CFG, CATCFG_DBGLOG, DBG_LVL_INFO, "copy_to_user() fail\n");
+		os_free_mem(pMacTab);
+		return RTMP_IO_EFAULT;
+	}
 
 	os_free_mem(pMacTab);
+	return NDIS_STATUS_SUCCESS;
 }
 
 INT Set_DynamicAGG_Proc(RTMP_ADAPTER *pAd, RTMP_STRING *arg)
diff --git a/mt_wifi/hw_ctrl/hw_ctrl.c b/mt_wifi/hw_ctrl/hw_ctrl.c
index 344cb9e..123efff 100644
--- a/mt_wifi/hw_ctrl/hw_ctrl.c
+++ b/mt_wifi/hw_ctrl/hw_ctrl.c
@@ -2185,17 +2185,20 @@ static NTSTATUS HwCtrlSetRxFilterCntl(RTMP_ADAPTER *pAd, HwCmdQElmt *CMDQelmt)
 static NTSTATUS HwCtrlGetStaSnr(RTMP_ADAPTER *pAd, HwCmdQElmt *CMDQelmt)
 {
 	UINT8 uwcid = *((UINT8 *)CMDQelmt->buffer);
-	UINT8 snr = 0;
+	UINT8 snr[4] = {0};
 #ifdef WIFI_UNIFIED_COMMAND
 	RTMP_CHIP_CAP * cap = NULL;
 #endif
 
+	if (!CMDQelmt->RspBuffer || CMDQelmt->RspBufferLen != sizeof(snr[0]))
+		return NDIS_STATUS_INVALID_DATA;
+
 #ifdef WIFI_UNIFIED_COMMAND
 	cap = hc_get_chip_cap(pAd->hdev_ctrl);
 	if (cap->uni_cmd_support)
-		UniCmdPerStaGetSNR(pAd, uwcid, &snr);
+		UniCmdPerStaGetSNR(pAd, uwcid, snr);
 #endif /* WIFI_UNIFIED_COMMAND */
-	os_move_mem(CMDQelmt->RspBuffer, &snr, CMDQelmt->RspBufferLen);
+	os_move_mem(CMDQelmt->RspBuffer, &snr[0], sizeof(snr[0]));
 	return NDIS_STATUS_SUCCESS;
 }
 static NTSTATUS HwCtrlUpdateChannelInfo(RTMP_ADAPTER *pAd, HwCmdQElmt *CMDQelmt)
diff --git a/mt_wifi/include/ap/ap_cfg.h b/mt_wifi/include/ap/ap_cfg.h
index a6f4224..0d2b69e 100644
--- a/mt_wifi/include/ap/ap_cfg.h
+++ b/mt_wifi/include/ap/ap_cfg.h
@@ -55,7 +55,7 @@ INT RTMPIoctlRXStatistics(
 	IN RTMP_ADAPTER * pAd,
 	IN RTMP_IOCTL_INPUT_STRUCT * wrq);
 
-VOID RTMPIoctlGetMacTableStaInfo(
+INT RTMPIoctlGetMacTableStaInfo(
         IN PRTMP_ADAPTER pAd,
 	IN RTMP_IOCTL_INPUT_STRUCT * wrq);
 
diff --git a/mt_wifi/os/linux/ap_ioctl.c b/mt_wifi/os/linux/ap_ioctl.c
index a057d6f..84dddc9 100644
--- a/mt_wifi/os/linux/ap_ioctl.c
+++ b/mt_wifi/os/linux/ap_ioctl.c
@@ -1015,7 +1015,7 @@ INT rt28xx_ap_ioctl(void *net_dev_obj, void *data_obj, int cmd) /* snowpin for a
 #endif/*WSC_AP_SUPPORT*/
 	       /* modified by Red@Ralink, 2009/09/30 */
         case RTPRIV_IOCTL_GET_MAC_TABLE_STRUCT:
-               RTMP_AP_IoctlHandle(pAd, wrq, CMD_RTPRIV_IOCTL_GET_MAC_TABLE_STRUCT, 0, NULL, 0);
+               Status = RTMP_AP_IoctlHandle(pAd, wrq, CMD_RTPRIV_IOCTL_GET_MAC_TABLE_STRUCT, 0, NULL, 0);
                break;
                /* end of modification */
 
