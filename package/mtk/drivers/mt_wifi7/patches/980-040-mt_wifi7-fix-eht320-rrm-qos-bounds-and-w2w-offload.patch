 						&& pMbss->WNMCtrl.ProxyARPEnable)
 #endif /* HOSTAPD_HS_R2_SUPPORT */
 				   )
-					to_air = FALSE;
+					to_os = FALSE;
 			} else {
 				/*
 					STAs in different SSID, default send to os and not to air
