Subject: [PATCH] mt_wifi7: mt_hwifi: fix MAP_R3 build error

Restore vendor driver change from 56d373929253.

[sKyissKy: extract mt_wifi7 patch from commit 56d373929253]
Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
 mt_wifi/ap/ap_cfg.c               | 4 ++--
 mt_wifi/common/security/cmm_wpa.c | 9 ++++++---
 2 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/mt_wifi/ap/ap_cfg.c b/mt_wifi/ap/ap_cfg.c
index 08905a3..18ce9e2 100644
--- a/mt_wifi/ap/ap_cfg.c
+++ b/mt_wifi/ap/ap_cfg.c
@@ -28501,9 +28501,9 @@ static BOOLEAN ch_switch_monitor_sanity_check(IN PRTMP_ADAPTER pAd, UCHAR channe
 		&& !WMODE_CAP_6G(wdev->PhyMode)
 #endif /* MAP_R3_6E_SUPPORT */
 		) ||
-		(channel > 14 && WMODE_CAP_2G(wdev->PhyMode)) ||
+		(channel > 14 && WMODE_CAP_2G(wdev->PhyMode))
 #ifdef MAP_R3_6E_SUPPORT
-		(channel > 233 && WMODE_CAP_6G(wdev->PhyMode))
+		|| (channel > 233 && WMODE_CAP_6G(wdev->PhyMode))
 #endif /* MAP_R3_6E_SUPPORT */
 	) {
 		MTWF_DBG(pAd, DBG_CAT_CHN, CATCHN_CHN, DBG_LVL_ERROR,
diff --git a/mt_wifi/common/security/cmm_wpa.c b/mt_wifi/common/security/cmm_wpa.c
index 0298953..83b939c 100644
--- a/mt_wifi/common/security/cmm_wpa.c
+++ b/mt_wifi/common/security/cmm_wpa.c
@@ -3710,6 +3710,9 @@ static void build_eapol_key_data_element(
 #ifdef DOT11_EHT_BE
