 		}
 
-		skb = build_skb(rx_info.pkt,
+		prefetch((u8 *)rx_info.pkt + SKB_HEADROOM_RSV);
+		skb = napi_build_skb(rx_info.pkt,
 						rx_pkt_total_size(rq->rx_buf_size));
 
 		/* TODO: Need to fix if fragment packet. */
@@ -1872,6 +1887,8 @@
 			q->hw_didx_addr, q->hw_didx_mask);
 
