+	/* Expose active NAPI context on current CPU for softirq GRO receive. */
+	mtk_mac_set_active_rx_napi(napi);
 
 	do {
 		cur = rq->q_ops->process(trans, q, budget - done);
@@ -1882,12 +1899,13 @@
 #endif
 	} while (cur && done < budget);
 
+	mtk_mac_set_active_rx_napi(NULL);
 	mt_rcu_read_unlock();
 
 	if (done < budget) {
 #ifdef CONFIG_HWIFI_RX_PROCESS_WORKQUEUE
 		if (test_bit(RXQ_FIFO_PAUSED, &rq->runtime_flags)) {
-			napi_complete(napi);
+			napi_complete_done(napi, done);
 			smp_mb__after_atomic();
 			if (!kfifo_is_full(&rq->bus_rx_process_fifo) &&
 			    !test_bit(RXQ_STOPPING, &rq->runtime_flags) &&
@@ -1905,7 +1923,7 @@
 		if (((q->head + 1) % q->q_size) != q->tail)
 			return budget;
 
-		napi_complete(napi);
+		napi_complete_done(napi, done);
 		pci_dma_irq_enable(vec_data, q->hw_int_mask);
 	}
 	return done;
