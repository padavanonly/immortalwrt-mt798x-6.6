-	int offset, ret;
+	u32 copy_len;
+	int ret;
 
 	pci_dma_rxdmad_parser(trans, desc, rx_info);
 
@@ -1623,12 +1628,11 @@
 	if (new_pkt == NULL)
 		return -ENOMEM;
 
-	offset = SKB_HEADROOM_RSV - (pkt_va - rx_info->pkt);
-
-	if (unlikely(offset < 0)) {
+	copy_len = rx_info->len;
+	if (unlikely(copy_len > dma_buf->alloc_size)) {
 		dev_err_once(to_device(trans),
-			"%s(): idx = %u, tkid = %u, offset = %d should not negative\n",
-			__func__, idx, rx_info->id, offset);
+			"%s(): idx = %u, tkid = %u, len = %u exceeds alloc_size = %zu\n",
+			__func__, idx, rx_info->id, copy_len, dma_buf->alloc_size);
 		goto err;
 	}
 
@@ -1642,17 +1646,23 @@
 		goto err;
 	}
 
-	dma_sync_single_for_cpu(to_device(trans), pkt_pa,
-		dma_buf->alloc_size, DMA_FROM_DEVICE);
+	/*
+	 * Sync and copy only the valid DMA payload [0, copy_len) directly into
+	 * new_dma_buf.alloc_va (new_pkt + SKB_HEADROOM_RSV), avoiding stale WARP
+	 * headroom contamination and redundant tail/shinfo cache ops.
+	 */
+	if (likely(copy_len)) {
+		dma_sync_single_for_cpu(to_device(trans), pkt_pa,
+			copy_len, DMA_FROM_DEVICE);
+		memcpy(new_dma_buf.alloc_va, pkt_va, copy_len);
+		dma_sync_single_for_device(to_device(trans), pkt_pa,
+			copy_len, DMA_FROM_DEVICE);
+	}
 
-	memcpy(new_pkt + offset, rx_info->pkt, rx_pkt_total_size(dma_buf->alloc_size - offset));
 	rx_info->pkt = new_pkt;
 	dma_buf->alloc_va = pkt_va;
 	dma_buf->alloc_pa = pkt_pa;
 
-	dma_sync_single_for_device(to_device(trans), pkt_pa,
-		dma_buf->alloc_size, DMA_FROM_DEVICE);
-
 	clear_ddone(cb->alloc_va);
 	fill_rxd(cb, rx_info->id, rq->magic_cnt);
 
@@ -1731,6 +1741,8 @@
 		skb_add_rx_frag(skb, nr_frags,
 				page, offset, rx_info->len,
 				rx_pkt_total_size(rq->rx_buf_size));
+	} else {
+		put_page(virt_to_head_page(rx_info->pkt));
 	}
 }
 
@@ -1769,6 +1781,8 @@
 			break;
 		}
 
+		prefetch(q->cb[(q->head + 1) % q->q_size].alloc_va);
+
