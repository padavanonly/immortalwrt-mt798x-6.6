-	memset((void *)(u8 *)pkt, 0, SKB_HEADROOM_RSV);
+	/* Zero 64B (covering FOE_INFO_LEN) to clear stale HNAT tags on recycled pages. */
+	BUILD_BUG_ON(SKB_HEADROOM_RSV < 64);
+	memset((void *)(u8 *)pkt, 0, 64);
 
 	buf->alloc_va = (void *)((u8 *)pkt + SKB_HEADROOM_RSV);
 
