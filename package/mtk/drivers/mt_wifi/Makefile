# Validate the package source/build boundary before package.mk's prepared/clean rm -rf.
override VENDOR_WIFI_GUARD := $(TOPDIR)/package/mtk/drivers/vendor-wifi-guard.sh
override VENDOR_WIFI_SOURCE_DIR := $(CURDIR)
.PHONY: vendor-wifi-predelete-guard
vendor-wifi-predelete-guard:
	@$(VENDOR_WIFI_GUARD) "$(TOPDIR)" "$(VENDOR_WIFI_SOURCE_DIR)" "$(KERNEL_BUILD_DIR)" "$(PKG_BUILD_DIR)" "mt_wifi" "$(if $(filter-out undefined,$(origin USE_SOURCE_DIR)),active,)" "$(if $(filter-out undefined,$(origin USE_GIT_TREE)),active,)" "$(if $(filter-out undefined,$(origin USE_GIT_SRC_CHECKOUT)),active,)" "$(BUILD_VARIANT)"
STAMP_PREPARED_DEPENDS += | vendor-wifi-predelete-guard
force-clean-build: vendor-wifi-predelete-guard


TAR_CMD=$(HOST_TAR) -C $(1)/ $(TAR_OPTIONS)

define KernelPackage/mt_wifi
  CATEGORY:=MTK Properties
  TITLE:=MTK wifi AP driver
  DEPENDS:=@TARGET_mediatek_filogic_mtwifi +wifi-dats
  DEPENDS+=+kmod-conninfra
  DEPENDS+=+kmod-mediatek_hnat
  FILES:=$(PKG_BUILD_DIR)/mt_wifi_ap/mt_wifi.ko \
	$(PKG_BUILD_DIR)/mt_wifi/embedded/plug_in/warp_proxy/mtk_warp_proxy.ko
  DEPENDS+=+kmod-warp
  AUTOLOAD:=$(call AutoProbe,mt_wifi mtk_warp_proxy)
  SUBMENU:=Drivers
  MENU:=1
  VARIANT:=custom
  DEFAULT_VARIANT:=1
  CONFLICTS:=kmod-mt_wifi-mt7981 kmod-mt_wifi-mt7986 kmod-mt_wifi-mt7986-ax4200 kmod-mt_wifi7 kmod-mt_wifi7-mt7992-be5040 kmod-mt_wifi7-mt7992-be7200 kmod-mt_wifi7-mt7990-be19000 kmod-mt_hwifi
endef

define KernelPackage/mt_wifi/config
	source "$(SOURCE)/config.in"
endef

