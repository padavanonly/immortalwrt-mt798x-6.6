From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] mt_wifi: align STA info ABI struct and Tx/Rx rate bitfields with iwinfo

Align HTTRANSMIT_SETTING_FIX (4-bit BW), RT_802_11_MAC_ENTRY_FIX (80 bytes),
and RT_802_11_MAC_TABLE_FIX (544 entries) with package/network/utils/iwinfo/src/mtwifi.h.

Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
--- a/mt_wifi/embedded/common/cmm_info.c
+++ b/mt_wifi/embedded/common/cmm_info.c
@@ -7016,30 +7016,36 @@
 typedef union _HTTRANSMIT_SETTING_FIX {
 #ifdef RT_BIG_ENDIAN
 	struct {
-		USHORT MODE:4;	/* Use definition MODE_xxx. */
-		USHORT iTxBF:1;
-		USHORT eTxBF:1;
-		USHORT STBC:1;	/* only support in HT/VHT mode with MCS0~7 */
-		USHORT ShortGI:2;
-		USHORT BW:2;	/* channel bandwidth 20MHz/40/80 MHz */
-		USHORT ldpc:1;
-		USHORT MCS:6;	/* MCS */
+		UINT32 padding:8;
+		UINT32 Nss:4;
+		UINT32 MODE:4;	/* Use definition MODE_xxx. */
+		UINT32 iTxBF:1;
+		UINT32 eTxBF:1;
+		UINT32 STBC:1;	/* only support in HT/VHT mode with MCS0~7 */
+		UINT32 ShortGI:2;
+		UINT32 BW:4;	/* channel bandwidth 20/40/80/160/320 MHz */
+		UINT32 ldpc:1;
+		UINT32 MCS:6;	/* MCS */
 	} field;
 #else
 	struct {
-		USHORT MCS:6;
-		USHORT ldpc:1;
-		USHORT BW:2;
-		USHORT ShortGI:2;
-		USHORT STBC:1;
-		USHORT eTxBF:1;
-		USHORT iTxBF:1;
-		USHORT MODE:4;
+		UINT32 MCS:6;
+		UINT32 ldpc:1;
+		UINT32 BW:4;
+		UINT32 ShortGI:2;
+		UINT32 STBC:1;
+		UINT32 eTxBF:1;
+		UINT32 iTxBF:1;
+		UINT32 MODE:4;
+		UINT32 Nss:4;
+		UINT32 padding:8;
 	} field;
 #endif
 	UINT32 word;
 } HTTRANSMIT_SETTING_FIX, *PHTTRANSMIT_SETTING_FIX;
 
+#define MTK_IOCTL_MAX_NUMBER_OF_MAC 544
+
 typedef struct _RT_802_11_MAC_ENTRY_FIX {
 	UCHAR ApIdx;
 	UCHAR Addr[MAC_ADDR_LEN];
@@ -7050,20 +7056,31 @@
 	CHAR AvgRssi1;
 	CHAR AvgRssi2;
 	CHAR AvgRssi3;
+	UCHAR AvgSnr;
 	UINT32 ConnectedTime;
 	HTTRANSMIT_SETTING_FIX TxRate;
 	HTTRANSMIT_SETTING_FIX LastRxRate;
 	SHORT StreamSnr[3];				/* BF SNR from RXWI. Units=0.25 dB. 22 dB offset removed */
 	SHORT SoundingRespSnr[3];			/* SNR from Sounding Response. Units=0.25 dB. 22 dB offset removed */
+	UINT32					InactiveTime;
 	UINT32					EncryMode;
 	UINT32					AuthMode;
+	UINT32					TxPackets;
+	UINT32					RxPackets;
+	UINT64					TxBytes;
+	UINT64					RxBytes;
 } RT_802_11_MAC_ENTRY_FIX, *PRT_802_11_MAC_ENTRY_FIX;
 
 typedef struct _RT_802_11_MAC_TABLE_FIX {
 	ULONG Num;
-	RT_802_11_MAC_ENTRY_FIX Entry[MAX_LEN_OF_MAC_TABLE];
+	RT_802_11_MAC_ENTRY_FIX Entry[MTK_IOCTL_MAX_NUMBER_OF_MAC];
 } RT_802_11_MAC_TABLE_FIX, *PRT_802_11_MAC_TABLE_FIX;
 
+#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
+_Static_assert(sizeof(HTTRANSMIT_SETTING_FIX) == 4, "HTTRANSMIT_SETTING_FIX ABI size mismatch");
+_Static_assert(sizeof(RT_802_11_MAC_ENTRY_FIX) == 80, "RT_802_11_MAC_ENTRY_FIX ABI size mismatch");
+#endif
+
 UINT32 RTMPGetLastTxRate_fix(PRTMP_ADAPTER pAd, MAC_TABLE_ENTRY *pEntry)
 {
 	HTTRANSMIT_SETTING_FIX lastTxRate;
@@ -7161,7 +7178,7 @@
 			pDst = &pMacTab->Entry[pMacTab->Num];
 			pDst->ApIdx = pEntry->func_tb_idx;
 			COPY_MAC_ADDR(pDst->Addr, &pEntry->Addr);
-			pDst->Aid = (UCHAR)pEntry->Aid;
+			pDst->Aid = (UINT16)pEntry->Aid;
 			pDst->Psm = pEntry->PsMode;
 #ifdef DOT11_N_SUPPORT
 			pDst->MimoPs = pEntry->MmpsMode;
@@ -7172,15 +7189,24 @@
 			pDst->AvgRssi1 = rssi[1];
 			pDst->AvgRssi2 = rssi[2];
 			pDst->AvgRssi3 = rssi[3];
+			pDst->AvgSnr = (pEntry->RssiSample.AvgSnr[0] > 0) ?
+				(UCHAR)pEntry->RssiSample.AvgSnr[0] : 0;
 			/* the connected time per entry*/
 			pDst->ConnectedTime = pEntry->StaConnectTime;
 			pDst->TxRate.word = RTMPGetLastTxRate_fix(pAd, pEntry);
 			pDst->LastRxRate.word = RTMPGetLastRxRate(pAd, pEntry);
+			pDst->InactiveTime = (UINT32)pEntry->NoDataIdleCount;
 			pDst->EncryMode = pEntry->SecConfig.PairwiseCipher;
 			pDst->AuthMode = pEntry->SecConfig.AKMMap;
+#ifdef CONFIG_AP_SUPPORT
+			pDst->TxPackets = (UINT32)pEntry->TxPackets.QuadPart;
+			pDst->RxPackets = (UINT32)pEntry->RxPackets.QuadPart;
+			pDst->TxBytes = pEntry->TxBytes;
+			pDst->RxBytes = pEntry->RxBytes;
+#endif /* CONFIG_AP_SUPPORT */
 			pMacTab->Num += 1;
 			/* Add to avoid Array cross board */
-			if (pMacTab->Num >= MAX_LEN_OF_MAC_TABLE)
+			if (pMacTab->Num >= MTK_IOCTL_MAX_NUMBER_OF_MAC)
 				break;
 
 		}
