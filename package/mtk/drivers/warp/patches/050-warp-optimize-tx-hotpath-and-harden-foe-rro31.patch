-		 __func__,
-		 (0xff & ip_h->saddr),
-		 (0xff00 & ip_h->saddr) >> 8,
-		 (0xff0000 & ip_h->saddr) >> 16,
-		 (0xff000000 & ip_h->saddr) >> 24);
+	nh_off = skb_network_offset(skb);
