 	ret = warp_reset_hw(wed, WARP_RESET_INTERFACE);
 	if (ret) {
 		spin_lock_irqsave(&warp->ring_lock, flags);
@@ -1683,6 +1689,12 @@
 
 		warp_quiesce_and_drain_irq_and_tasks(warp, wed, wdma, wifi, bus);
 
+#ifdef WED_RX_HW_RRO_3_1
+		/* Tear down RRO 3.1 hardware state during SER ring recovery. */
+		if (wifi->hw.hw_cap & BIT(WIFI_HW_CAP_RRO_3_1))
+			warp_rx_rro_3_1_exit_hw(wed, wifi);
+#endif
+
 		ret = warp_reset_hw(wed, WARP_RESET_IDX_ONLY);
 		if (ret) {
 			spin_lock_irqsave(&warp->ring_lock, flags);
