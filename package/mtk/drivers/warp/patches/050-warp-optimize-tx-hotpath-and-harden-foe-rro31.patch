+	if (!ip_h || ip_h->version != 4 || ip_h->ihl < 5)
+		return;
 
-	warp_dbg(WARP_DBG_WAR,
-		 "%s(): dst=%d.%d.%d.%d\n",
-		 __func__,
-		 (0xff & ip_h->daddr),
-		 (0xff00 & ip_h->daddr) >> 8,
-		 (0xff0000 & ip_h->daddr) >> 16,
-		 (0xff000000 & ip_h->daddr) >> 24);
-
-	warp_dbg(WARP_DBG_WAR,
-		 "%s(): src_mac=%pM, dest_mac=%pM\n",
-		 __func__,
-		 eth_h->h_source,
-		 eth_h->h_dest);
+	eth_h = skb_mac_header_was_set(skb) ?
+		skb_header_pointer(skb, skb_mac_offset(skb), sizeof(_eth), &_eth) :
+		NULL;
+
+	warp_dbg(WARP_DBG_WAR, "%s(): src=%pI4 dst=%pI4\n",
+		 __func__, &ip_h->saddr, &ip_h->daddr);
+	if (eth_h)
+		warp_dbg(WARP_DBG_WAR, "%s(): src_mac=%pM, dest_mac=%pM\n",
+			 __func__, eth_h->h_source, eth_h->h_dest);
 
 	if (ip_h->protocol == IPPROTO_TCP) {
-		struct tcphdr *tcph = tcp_hdr(skb);
-
-		warp_dbg(WARP_DBG_WAR,
-			 "%s(): protocol=TCP,src_port=%d,dst_port=%d\n",
-			 __func__,
-			 tcph->source,
-			 tcph->dest);
-	}
-
-	if (ip_h->protocol == IPPROTO_UDP) {
-		struct udphdr *udph = udp_hdr(skb);
+		struct tcphdr _tcph, *tcph;
 
-		warp_dbg(WARP_DBG_WAR,
-			 "%s(): protocol=UDP,src_port=%d,dst_port=%d\n",
-			 __func__,
-			 udph->source,
-			 udph->dest);
+		tcph = skb_header_pointer(skb, nh_off + ip_h->ihl * 4,
+					  sizeof(_tcph), &_tcph);
+		if (tcph)
+			warp_dbg(WARP_DBG_WAR,
+				 "%s(): protocol=TCP,src_port=%u,dst_port=%u\n",
+				 __func__, ntohs(tcph->source),
+				 ntohs(tcph->dest));
+	} else if (ip_h->protocol == IPPROTO_UDP) {
+		struct udphdr _udph, *udph;
+
+		udph = skb_header_pointer(skb, nh_off + ip_h->ihl * 4,
+					  sizeof(_udph), &_udph);
+		if (udph)
+			warp_dbg(WARP_DBG_WAR,
+				 "%s(): protocol=UDP,src_port=%u,dst_port=%u\n",
+				 __func__, ntohs(udph->source),
+				 ntohs(udph->dest));
 	}
 }
 #endif /*CONFIG_WARP_DBG_SUPPORT*/
@@ -148,62 +148,70 @@
 			warp_dbg(WARP_DBG_INF, "%s():skb->head is NULL!!!!\n", __func__);
 			return -EFAULT;
 		}
-		if ((FOE_AI(skb) == HIT_UNBIND_RATE_REACH) ||
