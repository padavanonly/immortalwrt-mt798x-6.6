--- a/warp_main.c
+++ b/warp_main.c
@@ -1455,6 +1455,12 @@
 
 	warp_quiesce_and_drain_irq_and_tasks(warp, wed, wdma, wifi, bus);
 
+#ifdef WED_RX_HW_RRO_3_1
+	/* Tear down RRO 3.1 hardware state before resetting the WED interface. */
