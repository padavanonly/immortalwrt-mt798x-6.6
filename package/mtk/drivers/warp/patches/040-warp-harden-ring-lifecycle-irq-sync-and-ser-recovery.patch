 }
 
 
@@ -496,6 +514,7 @@ warp_remove(struct platform_device *pdev)
 	struct wifi_entry *wifi;
 	struct wifi_hw *hw;
 	struct warp_bus *bus = warp_bus_get();
+	unsigned long flags;
 	u8 enable = 0;
 
