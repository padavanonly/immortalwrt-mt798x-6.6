@@ -514,6 +533,22 @@ warp_remove(struct platform_device *pdev)
 	if (wifi->ops->set_attach)
 		wifi->ops->set_attach(wifi->hw.priv, false);
 
+#ifdef WED_INTER_AGENT_SUPPORT
+	mutex_lock(&warp->state_lock);
+	spin_lock_irqsave(&warp->ring_lock, flags);
+	warp->irq_gated = true;
+	if (warp->ring_state == WARP_RING_READY)
+		warp->ring_state = WARP_RING_STOPPING;
+	warp->ring_ready = false;
+	spin_unlock_irqrestore(&warp->ring_lock, flags);
+	warp_eint_ctrl_hw(wed, false);
+	warp_int_ctrl_hw(wed, wifi, wdma, ALL_INT_AGENT,
+			false, bus->pcie_ints_offset, warp->idx);
+	if (wed->irq > 0)
+		synchronize_irq(wed->irq);
+	mutex_unlock(&warp->state_lock);
+#endif
+
 	/*free irq*/
 	wifi_chip_set_irq(wifi, WIFI_FREE_IRQ, wed->irq);
 	/*restore pcie msi group setting*/
@@ -543,6 +578,11 @@ warp_remove(struct platform_device *pdev)
 #endif
 #endif
 
+	spin_lock_irqsave(&warp->ring_lock, flags);
+	warp->ring_state = WARP_RING_DOWN;
+	warp->ring_ready = false;
+	spin_unlock_irqrestore(&warp->ring_lock, flags);
+
 	/*reomve warp entry from warp_ctrl*/
 	warp_entry_release_pdev(warp);
 #ifdef WED_RX_HW_RRO_2_0
@@ -745,6 +785,12 @@ warp_entry_init(struct warp_entry *warp, u32 idx)
 	warp->idx = idx;
 	warp->pdev = NULL;
 	warp->slot_id = wed_get_slot_map(idx);
+	mutex_init(&warp->state_lock);
+	spin_lock_init(&warp->ring_lock);
+	warp->ring_state = WARP_RING_DOWN;
+	warp->res_mask = 0;
+	warp->ring_ready = false;
+	warp->irq_gated = true;
 	cfg->hw_tx_en = CFG_HW_TX_SUPPORT;
 
 	//sw_conf->txbm.enable = true;
@@ -1147,18 +1193,64 @@ EXPORT_SYMBOL(warp_client_remove);
 /*
 *
 */
+static void
+warp_quiesce_and_drain_irq_and_tasks(struct warp_entry *warp, struct wed_entry *wed,
+				    struct wdma_entry *wdma, struct wifi_entry *wifi,
+				    struct warp_bus *bus)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&warp->ring_lock, flags);
+	warp->irq_gated = true;
+	if (warp->ring_state == WARP_RING_READY)
+		warp->ring_state = WARP_RING_STOPPING;
+	warp->ring_ready = false;
+	spin_unlock_irqrestore(&warp->ring_lock, flags);
+
+#ifdef WED_INTER_AGENT_SUPPORT
+	warp_eint_ctrl_hw(wed, false);
+	warp_int_ctrl_hw(wed, wifi, wdma, ALL_INT_AGENT,
+			false, bus->pcie_ints_offset, warp->idx);
+	if (wed->irq > 0)
+		synchronize_irq(wed->irq);
+#endif
+}
+
 int
-warp_ring_init(void *priv_data)
+warp_ring_init_checked(void *priv_data, bool *cleanup_failed)
 {
 	int ret = 0;
