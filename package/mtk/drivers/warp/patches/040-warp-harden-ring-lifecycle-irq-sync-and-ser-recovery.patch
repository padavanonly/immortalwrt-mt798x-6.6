diff --git a/warp.h b/warp.h
index bba36f2..1a90434 100644
--- a/warp.h
+++ b/warp.h
@@ -17,6 +17,8 @@
 #ifndef _WARP_H
 #define _WARP_H
 
+#include <linux/mutex.h>
+#include <linux/interrupt.h>
 #include "wdma.h"
 #include "wed.h"
 #include "warp_wifi.h"
@@ -51,9 +53,30 @@ struct warp_wifi_cr_map {
 };
 
 #define MAX_MAP_TABLE_SIZE 32
+enum warp_ring_state {
+	WARP_RING_DOWN = 0,
+	WARP_RING_STARTING,
+	WARP_RING_READY,
+	WARP_RING_STOPPING,
+	WARP_RING_FAILED,
+};
+
+#define WARP_RES_TXBM        BIT(0)
+#define WARP_RES_RXBM        BIT(1)
+#define WARP_RES_RX_PAGE_BM  BIT(2)
+#define WARP_RES_DYBM        BIT(3)
+#define WARP_RES_HW_RING     BIT(4)
+#define WARP_RES_HIF_TXD     BIT(5)
+
 struct warp_entry {
 	u8 idx;
 	u8 slot_id;
+	bool ring_ready;
+	bool irq_gated;
+	enum warp_ring_state ring_state;
+	u32 res_mask;
+	spinlock_t ring_lock;
+	struct mutex state_lock;
 	struct wifi_entry wifi;
 	struct platform_driver pdriver;
 	struct wdma_entry wdma;
@@ -200,12 +223,24 @@ warp_register_client(struct wifi_hw *hw, struct wifi_ops *ops);
 void
 warp_client_remove(void *priv_data);
 
+/*
+*
+*/
+int
+warp_ring_init_checked(void *priv_data, bool *cleanup_failed);
+
 /*
 *
 */
 int
 warp_ring_init(void *priv_data);
 
+/*
+*
+*/
+int
+warp_ring_exit_checked(void *priv_data);
+
 /*
 *
 */
