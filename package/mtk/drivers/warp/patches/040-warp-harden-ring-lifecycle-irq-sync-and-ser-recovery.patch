index 05b0ffd..45cef18 100644
--- a/regs/reg_v1/warp_hw_v1.c
+++ b/regs/reg_v1/warp_hw_v1.c
@@ -1177,6 +1177,10 @@ warp_reset_hw(struct wed_entry *wed, u32 reset_type)
 	case WARP_RESET_INTERFACE:
 		reset_all(wed, wdma);
 		break;
+	default:
+		warp_dbg(WARP_DBG_ERR, "%s(): Unknown reset_type = %u\n", __func__, reset_type);
+		ret = -EOPNOTSUPP;
+		break;
 	}
 
 	return ret;
