@@ -26,6 +26,9 @@
 	__TS_CONFIG_MAX,
 };
 
+bool mtk_pce_has_ppe_port(enum pse_port ppe);
+bool mtk_pce_has_ts_port(enum pse_port port);
+
 int mtk_pce_tport_map_ts_config_read(enum ts_config_entry entry,
