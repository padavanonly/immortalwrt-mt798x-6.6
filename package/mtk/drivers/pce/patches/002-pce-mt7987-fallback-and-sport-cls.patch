From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] pce: add MT7987 CDRT fallback and sport classifier support

Guard CDRT hardware register accesses on platforms without CDRT support
(such as MT7987), propagate classifier cleanup failures cleanly, and
extend debugfs/sport classifier handling.

Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
diff -uNr a/cdrt.c b/cdrt.c
--- a/cdrt.c	2026-11-20 09:06:06.542286890 +0800
+++ b/cdrt.c	2026-11-20 09:06:06.549561601 +0800
@@ -36,6 +36,9 @@
 	struct fe_mem_msg msg;
 	int ret;
 
+	if (!mtk_pce_has_cdrt())
+		return -ENODEV;
+
 	if (unlikely(!desc || idx >= FE_MEM_CDRT_MAX_INDEX / 3))
 		return -EINVAL;
 
@@ -74,6 +77,9 @@
 	struct fe_mem_msg msg;
 	int ret;
 
+	if (!mtk_pce_has_cdrt())
+		return -ENODEV;
+
 	if (unlikely(!desc || idx >= FE_MEM_CDRT_MAX_INDEX / 3))
 		return -EINVAL;
 
@@ -230,6 +236,9 @@
 	int ret = 0;
 	u32 i;
 
+	if (!mtk_pce_has_cdrt())
+		return;
+
 	memset(&msg.raw, 0, sizeof(msg.raw));
 
 	spin_lock_irqsave(&cdrt_hw.lock, flag);
@@ -249,6 +258,9 @@
 
 int mtk_pce_cdrt_enable(void)
 {
+	if (!mtk_pce_has_cdrt())
+		return 0;
+
 	mtk_pce_netsys_setbits(GLO_MEM_CFG, CDM_CDRT_EN);
 
 	return 0;
@@ -256,6 +268,9 @@
 
 void mtk_pce_cdrt_disable(void)
 {
+	if (!mtk_pce_has_cdrt())
+		return;
+
 	mtk_pce_netsys_clrbits(GLO_MEM_CFG, CDM_CDRT_EN);
 }
 
diff -uNr a/cls.c b/cls.c
