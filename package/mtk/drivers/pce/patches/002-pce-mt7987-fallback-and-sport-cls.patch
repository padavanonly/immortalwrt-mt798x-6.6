 void mtk_pce_dipfilter_deinit(struct platform_device *pdev)
diff -uNr a/inc/pce/netsys.h b/inc/pce/netsys.h
--- a/inc/pce/netsys.h	2026-09-18 10:18:56.492933773 +0800
+++ b/inc/pce/netsys.h	2026-11-20 09:06:06.547222784 +0800
