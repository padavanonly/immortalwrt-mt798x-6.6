 int mtk_pce_tport_map_ts_config_write(enum ts_config_entry entry,
diff -uNr a/init.c b/init.c
--- a/init.c	2026-09-18 10:18:56.492933773 +0800
+++ b/init.c	2026-11-20 09:06:06.547996193 +0800
@@ -22,6 +22,7 @@
 #include "pce/pce.h"
 
 struct device *pce_dev;
+static struct platform_device *pce_fallback_pdev;
 
 static int mtk_pce_probe(struct platform_device *pdev)
 {
@@ -70,6 +71,8 @@
 netsys_deinit:
 	mtk_pce_netsys_deinit(pdev);
 
+	pce_dev = NULL;
+
 	return ret;
 }
 
@@ -86,6 +89,8 @@
 	mtk_pce_cls_deinit(pdev);
 
 	mtk_pce_netsys_deinit(pdev);
+
+	pce_dev = NULL;
 }
 
 #if KERNEL_VERSION(6, 3, 0) > LINUX_VERSION_CODE
@@ -124,11 +129,42 @@
 
 static int __init mtk_pce_init(void)
 {
-	return platform_driver_register(&mtk_pce_driver);
+	int ret;
+
+	ret = platform_driver_register(&mtk_pce_driver);
+	if (ret)
+		return ret;
+
+	if (!pce_dev) {
+		struct device_node *eth_np;
+
+		eth_np = of_find_compatible_node(NULL, NULL,
+						 "mediatek,mt7988-eth");
+		if (eth_np) {
+			of_node_put(eth_np);
+			pce_fallback_pdev = platform_device_register_simple(
+						"mediatek,pce", -1, NULL, 0);
+			if (IS_ERR(pce_fallback_pdev)) {
+				pr_warn("pce: fallback device register failed: %ld\n",
+					PTR_ERR(pce_fallback_pdev));
+				pce_fallback_pdev = NULL;
+			} else if (!pce_dev) {
+				platform_device_unregister(pce_fallback_pdev);
+				pce_fallback_pdev = NULL;
+			}
+		}
+	}
+
+	return 0;
 }
 
 static void __exit mtk_pce_exit(void)
 {
+	if (pce_fallback_pdev) {
+		platform_device_unregister(pce_fallback_pdev);
+		pce_fallback_pdev = NULL;
+	}
+
 	platform_driver_unregister(&mtk_pce_driver);
 }
 
diff -uNr a/netsys.c b/netsys.c
--- a/netsys.c	2026-11-20 09:06:06.542780596 +0800
+++ b/netsys.c	2026-11-20 09:06:06.548536979 +0800
@@ -105,15 +105,25 @@
 		   FIELD_PREP(GLO_MEM_CTRL_CMD_MASK, cmd));
 }
 
-static inline void mtk_pce_fe_mem_wait_transfer_done(void)
+static int mtk_pce_fe_mem_wait_transfer_done(void)
 {
-	while (FIELD_GET(GLO_MEM_CTRL_CMD_MASK, mtk_pce_netsys_read(GLO_MEM_CTRL)))
+	u32 retry = 1000;
+
+	while (FIELD_GET(GLO_MEM_CTRL_CMD_MASK, mtk_pce_netsys_read(GLO_MEM_CTRL))) {
+		if (!retry--) {
+			mtk_pce_netsys_write(GLO_MEM_CTRL, 0);
+			return -ETIMEDOUT;
+		}
 		udelay(10);
+	}
+
+	return 0;
 }
 
 static int mtk_pce_fe_mem_write(enum fe_mem_type type, u32 *raw_data, u32 idx)
 {
 	unsigned long flag;
+	int ret;
 	u32 i = 0;
 
 	spin_lock_irqsave(&netsys.lock, flag);
@@ -126,16 +136,20 @@
 
 	mtk_pce_fe_mem_start(FE_MEM_CMD_WRITE);
 
-	mtk_pce_fe_mem_wait_transfer_done();
+	ret = mtk_pce_fe_mem_wait_transfer_done();
 
 	spin_unlock_irqrestore(&netsys.lock, flag);
 
-	return 0;
+	if (ret && pce_dev)
+		PCE_ERR("fe_mem write timeout: type=%u idx=%u\n", type, idx);
+
+	return ret;
 }
 
 static int mtk_pce_fe_mem_read(enum fe_mem_type type, u32 *raw_data, u32 idx)
 {
 	unsigned long flag;
+	int ret;
 	u32 i = 0;
 
 	spin_lock_irqsave(&netsys.lock, flag);
@@ -144,15 +158,19 @@
 
 	mtk_pce_fe_mem_start(FE_MEM_CMD_READ);
 
-	mtk_pce_fe_mem_wait_transfer_done();
-
-	/* read data out */
-	for (i = 0; i < FE_MEM_DATA_WLEN; i++)
-		raw_data[i] = mtk_pce_netsys_read(GLO_MEM_DATA_IDX(i));
+	ret = mtk_pce_fe_mem_wait_transfer_done();
+	if (!ret) {
+		/* read data out */
+		for (i = 0; i < FE_MEM_DATA_WLEN; i++)
+			raw_data[i] = mtk_pce_netsys_read(GLO_MEM_DATA_IDX(i));
+	}
 
 	spin_unlock_irqrestore(&netsys.lock, flag);
 
-	return 0;
+	if (ret && pce_dev)
+		PCE_ERR("fe_mem read timeout: type=%u idx=%u\n", type, idx);
+
+	return ret;
 }
 
 int mtk_pce_fe_mem_msg_send(struct fe_mem_msg *msg)
@@ -189,13 +207,41 @@
 }
 EXPORT_SYMBOL(mtk_pce_fe_mem_msg_send);
 
+bool mtk_pce_has_cdrt(void)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+	bool ready;
+
+	np = of_find_compatible_node(NULL, NULL,
+				     "inside-secure,safexcel-eip197b");
+	if (!np)
+		return false;
+
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return false;
+
+	ready = of_device_is_available(pdev->dev.of_node) &&
+		READ_ONCE(pdev->dev.driver) != NULL;
+	put_device(&pdev->dev);
+
+	return ready;
+}
+EXPORT_SYMBOL(mtk_pce_has_cdrt);
+
 int mtk_pce_netsys_init(struct platform_device *pdev)
 {
 	struct device_node *fe_mem = NULL;
 	struct resource res;
 	int ret = 0;
 
-	fe_mem = of_parse_phandle(pdev->dev.of_node, "fe_mem", 0);
+	if (pdev->dev.of_node)
+		fe_mem = of_parse_phandle(pdev->dev.of_node, "fe_mem", 0);
+	if (!fe_mem)
+		fe_mem = of_find_compatible_node(NULL, NULL,
+						 "mediatek,mt7988-eth");
 	if (!fe_mem) {
 		PCE_ERR("can not find fe_mem node\n");
 		return -ENODEV;
@@ -232,7 +278,8 @@
 
 	mtk_pce_dipfilter_enable();
 
-	mtk_pce_cdrt_enable();
+	if (mtk_pce_has_cdrt())
+		mtk_pce_cdrt_enable();
 
 	return 0;
 }
@@ -240,7 +287,8 @@
 
 void mtk_pce_disable(void)
 {
-	mtk_pce_cdrt_disable();
+	if (mtk_pce_has_cdrt())
+		mtk_pce_cdrt_disable();
 
 	mtk_pce_dipfilter_disable();
 
diff -uNr a/tport_map.c b/tport_map.c
--- a/tport_map.c	2026-09-18 10:18:56.492933773 +0800
+++ b/tport_map.c	2026-11-20 09:06:06.550256670 +0800
@@ -13,6 +13,29 @@
 #include "pce/internal.h"
 #include "pce/tport_map.h"
 
+bool mtk_pce_has_ppe_port(enum pse_port ppe)
+{
+	if (ppe == PSE_PORT_PPE2 && of_machine_is_compatible("mediatek,mt7987"))
+		return false;
+
+	return true;
+}
+
+bool mtk_pce_has_ts_port(enum pse_port port)
+{
+	if (!(TS_CONFIG_MASK & BIT(port)))
+		return false;
+
+	if (port == PSE_PORT_EIP197 && !mtk_pce_has_cdrt())
+		return false;
+
+	if ((port == PSE_PORT_TDMA || port == PSE_PORT_WDMA2) &&
+	    of_machine_is_compatible("mediatek,mt7987"))
+		return false;
+
+	return true;
+}
+
 int mtk_pce_tport_map_ts_config_read(enum ts_config_entry entry,
 				    struct tsc_desc *ts_cfg)
 {
@@ -22,7 +45,7 @@
 	if (!ts_cfg)
 		return -EINVAL;
 
-	if (!(TS_CONFIG_MASK & BIT(entry))) {
+	if (!mtk_pce_has_ts_port((enum pse_port)entry)) {
 		PCE_ERR("invalid ts config entry: %u\n", entry);
 		return -EPERM;
 	}
@@ -50,7 +73,7 @@
 	if (!ts_cfg)
 		return -EINVAL;
 
-	if (!(TS_CONFIG_MASK & BIT(entry))) {
+	if (!mtk_pce_has_ts_port((enum pse_port)entry)) {
 		PCE_NOTICE("invalid ts config entry: %u\n", entry);
 		return -EPERM;
 	}
@@ -78,6 +101,9 @@
 		return -EPERM;
 	}
 
+	if (!mtk_pce_has_ppe_port(ppe))
+		return -ENODEV;
+
 	*map = mtk_pce_ppe_read(ppe, PPE_TPORT_TBL_0);
 	*map |= ((u64)mtk_pce_ppe_read(ppe, PPE_TPORT_TBL_1)) << 32;
 
@@ -151,10 +177,11 @@
 		return -EPERM;
 	}
 
-	if (TS_CONFIG_MASK & BIT(pse_port))
+	if (mtk_pce_has_ts_port(pse_port))
 		ret = mtk_pce_tport_map_update_ts_config((enum ts_config_entry)pse_port,
 							 tport_idx, target);
-	else if (PSE_PORT_PPE_MASK & BIT(pse_port))
+	else if ((PSE_PORT_PPE_MASK & BIT(pse_port)) &&
+		 mtk_pce_has_ppe_port(pse_port))
 		ret = mtk_pce_tport_map_update_ppe(pse_port, tport_idx, target);
 	else
 		ret = -EINVAL;
