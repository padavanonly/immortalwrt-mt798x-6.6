		eqos_flows="$(printf '%s\n' "$dpi_raw" | sed -n 's/.*eqos_flows=\([0-9]*\).*/\1/p' | head -n 1)"
	fi
	: "${dpi_on:=0}"; : "${rt_pkts:=0}"; : "${fair_pkts:=0}"; : "${vid_pkts:=0}"; : "${p2p_pkts:=0}"; : "${eqos_flows:=0}"

	if [ -r "$PPE_STATUS" ]; then
		ppe_stats="$(awk '
			$1 == "tier1_ppe_bind" { bind = $2 }
			$1 == "tier1_ppe_total" { total = $2 }
			END {
				if (bind ~ /^[0-9]+$/ && total ~ /^[0-9]+$/)
					printf "%s %s\n", bind, total
				else
					printf "null 0\n"
			}
		' "$PPE_STATUS" 2>/dev/null)"
		ppe_bound="${ppe_stats%% *}"
		ppe_total="${ppe_stats#* }"
		if ! is_uint "$ppe_bound" || ! is_uint "$ppe_total" ||
		   [ "$ppe_total" -eq 0 ] || [ "$ppe_bound" -gt "$ppe_total" ]; then
			ppe_bound=null
			ppe_total=0
		fi
	fi
	soc_supports_pce && pce_supported=1
	[ -e "$PCE_DIR/cls_entry" ] && pce_loaded=1
	if [ -r "$PCE_DIR/cls_entry" ]; then
		pce_active="$(awk '/enabled: 1/ { count++ } END { print count + 0 }' "$PCE_DIR/cls_entry" 2>/dev/null)"
	fi
	{ [ -d "$SYS_MOD/mtk_wed" ] || [ -d "$SYS_MOD/mtk_warp" ] || [ -d "$SYS_NET/ra0" ] || [ -d "$SYS_NET/rai0" ]; } && wed_present=1

	sch2="$(read_sch_summary 2)"; s2_en="$(echo "$sch2" | awk '{print $1}')"; s2_alg="$(echo "$sch2" | awk '{print $2}')"; s2_rate="$(echo "$sch2" | awk '{print $3}')"
	sch3="$(read_sch_summary 3)"; s3_en="$(echo "$sch3" | awk '{print $1}')"; s3_alg="$(echo "$sch3" | awk '{print $2}')"; s3_rate="$(echo "$sch3" | awk '{print $3}')"

	u_eqos="$(sum_queue_range 1 15)"
	u_rt="$(sum_queue_range 16 16)"
	u_fair="$(sum_queue_range 17 29)"
	u_vid="$(sum_queue_range 30 30)"
	u_p2p="$(sum_queue_range 31 31)"

	d_eqos="$(sum_queue_range 33 47)"
	d_rt="$(sum_queue_range 48 48)"
	d_fair="$(sum_queue_range 49 61)"
	d_vid="$(sum_queue_range 62 62)"
	d_p2p="$(sum_queue_range 63 63)"

	if command -v "$TC_BIN" >/dev/null 2>&1 && [ -d "$SYS_NET/$primary_wan" ]; then
		cake_line="$("$TC_BIN" qdisc show dev "$primary_wan" 2>/dev/null | grep 'qdisc cake ' | head -n 1)"
	fi

	if [ -r "$RUN_DIR/eqos_slots.tsv" ]; then
		while IFS='|' read -r slot ul_r dl_r max_c ip mac cmt; do
			is_uint "$slot" || continue
			[ -n "$slots_json" ] && slots_json="${slots_json},"
			slots_json="${slots_json}{\"slot\":${slot},\"ul_kbps\":${ul_r:-0},\"dl_kbps\":${dl_r:-0},\"max_conn\":${max_c:-0},\"ip\":\"$(json_escape "$ip")\",\"mac\":\"$(json_escape "$mac")\",\"comment\":\"$(json_escape "$cmt")\"}"
		done < "$RUN_DIR/eqos_slots.tsv"
	fi

	printf '{"enabled":%d,"active":%d,"conflict":%d,"mode":"%s","last_apply":"%s","wan_kind":"%s","wan_dev":"%s","wan_devs":"%s","download_kbps":%d,"upload_kbps":%d,"hook_toggle":%d,"qos_toggle":%d,"sqm_toggle":%d,"dpi_enabled":%d,"fast_bind_pkt":%d,"ppe_bound":%s,"ppe_total":%d,"pce":{"supported":%d,"loaded":%d,"active_cls":%d},"wed_present":%d,"sch2":{"enabled":%d,"alg":"%s","rate":%d},"sch3":{"enabled":%d,"alg":"%s","rate":%d},"dpi_stats":{"realtime_pkts":%s,"fair_pkts":%s,"video_pkts":%s,"p2p_pkts":%s,"eqos_flows":%s},"queues":{"ul_eqos":[%s],"ul_rt":[%s],"ul_fair":[%s],"ul_video":[%s],"ul_p2p":[%s],"dl_eqos":[%s],"dl_rt":[%s],"dl_fair":[%s],"dl_video":[%s],"dl_p2p":[%s]},"eqos_slots":[%s],"cake":"%s"}\n' \
		"$([ "$CFG_ENABLED" = "1" ] && echo 1 || echo 0)" \
		"$st_active" "$conflict_flag" \
		"$(json_escape "$st_mode")" "$(json_escape "$last_apply")" "$(json_escape "$wan_kind")" \
		"$(json_escape "$primary_wan")" "$(json_escape "$wan_devs")" \
		"$CFG_DL" "$CFG_UL" "$hook_on" "$qos_mode" "$sqm_en" "$dpi_on" "$CFG_FAST_BIND" \
		"$ppe_bound" "$ppe_total" "$pce_supported" "$pce_loaded" "$pce_active" "$wed_present" \
		"${s2_en:-0}" "$(json_escape "$s2_alg")" "${s2_rate:-0}" \
		"${s3_en:-0}" "$(json_escape "$s3_alg")" "${s3_rate:-0}" \
		"$rt_pkts" "$fair_pkts" "$vid_pkts" "$p2p_pkts" "$eqos_flows" \
		"$(echo "$u_eqos" | tr ' ' ',')" "$(echo "$u_rt" | tr ' ' ',')" "$(echo "$u_fair" | tr ' ' ',')" "$(echo "$u_vid" | tr ' ' ',')" "$(echo "$u_p2p" | tr ' ' ',')" \
		"$(echo "$d_eqos" | tr ' ' ',')" "$(echo "$d_rt" | tr ' ' ',')" "$(echo "$d_fair" | tr ' ' ',')" "$(echo "$d_vid" | tr ' ' ',')" "$(echo "$d_p2p" | tr ' ' ',')" \
		"$slots_json" "$(json_escape "$cake_line")"
}

do_status() {
	do_json
	[ -r "$QDMA_DIR/qdma_sch2" ] && printf -- '--- qdma_sch2 ---\n' && cat "$QDMA_DIR/qdma_sch2"
	[ -r "$QDMA_DIR/qdma_sch3" ] && printf -- '--- qdma_sch3 ---\n' && cat "$QDMA_DIR/qdma_sch3"
	[ -r "$HNAT_DIR/sqm_toggle" ] && printf -- '--- sqm_toggle ---\n' && cat "$HNAT_DIR/sqm_toggle"
	[ -r "$HNAT_DIR/qos_dpi" ] && printf -- '--- qos_dpi ---\n' && cat "$HNAT_DIR/qos_dpi"
	[ -r "$PCE_DIR/cls_entry" ] && printf -- '--- pce cls_entry (24..31) ---\n' && grep -A 3 -E '^CLS Entry(2[4-9]|3[01])' "$PCE_DIR/cls_entry"
}

case "${1:-status}" in
	start|apply|reload)
		do_start
		;;
	sync)
		do_sync
		;;
	stop)
		do_stop
		;;
	json)
		do_json
		;;
	status)
		do_status
		;;
	*)
		printf 'Usage: %s {start|stop|reload|apply|sync|status|json}\n' "$0" >&2
		exit 1
		;;
esac
