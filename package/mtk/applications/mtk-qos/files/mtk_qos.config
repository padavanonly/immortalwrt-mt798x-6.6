config global 'global'
	option enabled '0'
	option sqm_enabled '1'
	option eqos_enabled '1'
	option dpi_enabled '1'
	option pce_enabled '1'
	option wan_mode 'auto'
	option interface 'auto'
	option download_kbps '300000'
	option upload_kbps '50000'
	option scheduler 'wrr'
	option overhead '0'
	option realtime_pct '25'
	option video_pct '45'
	option p2p_pct '15'
	option ack_prio '1'
	option cake_diffserv 'diffserv4'
	option cake_ack_filter '1'

