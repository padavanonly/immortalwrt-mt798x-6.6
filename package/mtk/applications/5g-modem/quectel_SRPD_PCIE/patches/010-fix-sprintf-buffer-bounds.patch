diff -Naur a/sipc/sblock.c b/sipc/sblock.c
--- a/sipc/sblock.c
+++ b/sipc/sblock.c
@@ -782,12 +782,12 @@
 
 static void sblock_pms_init(uint8_t dst, uint8_t ch, struct sblock_ring *ring)
 {
-	sprintf(ring->tx_pms_name, "sblock-%d-%d-tx", dst, ch);
+	snprintf(ring->tx_pms_name, sizeof(ring->tx_pms_name), "sblock-%u-%u-tx", (unsigned int)dst & 0xff, (unsigned int)ch & 0xff);
