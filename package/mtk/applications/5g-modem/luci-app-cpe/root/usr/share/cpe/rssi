# Entry point
first()
{
    Debug "Start RSSI service"
    # Initialize data structure
    InitData
    Debug "Data structure initialized"
    sleep 1s
    # Compute modem AT port
    ATPORT
    # Register network interface
    RegisterNetwork
    # Fetch initial modem info
    AUTO_CPE
    # Save structured data
    SETData
    # Run network registration on boot
    modem_reset
    # Check internet connectivity on first boot
    chenk_firstdns
    chenk_Task
}

