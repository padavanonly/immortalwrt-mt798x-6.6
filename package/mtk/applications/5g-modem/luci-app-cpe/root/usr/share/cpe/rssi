ATPORT=1

# Automatically handle modem signals
AUTO_CPE()
{
    Debug "------------------------------Port $ATPORT---------------------------"
	Debug "AUTO_CPE"
	Date=$(date "+%Y-%m-%d %H:%M:%S")


	# Check if device is ready
	rec=$(sendat $ATPORT "AT" 500 |grep OK |wc -l) 
	if [ $rec == "1" ];then
		sleep 1s
	else
		sleep 5s
		return
	fi
    # Read modem information
    # if [ "$conntype" == "" ]; then
    # {
    #     Debug "Compute modem"
    #     ATATI=$( sendat $ATPORT "ATI")
    #     Getconntype=$(echo "$ATATI" | sed -n '2p')
    #     if [ "$Getconntype" == "" ]; then
    #     {
    #         sleep 5s
	# 	    return
    #     }
    #     fi
    #     Model=$(echo "$ATATI" | sed -n '3p')
    #     conntype=$Getconntype
    # }
    # fi

    Debug "Read modem info / compute modem"
    ATATI=$( sendat $ATPORT "ATI")
    Getconntype=$(echo "$ATATI" | sed -n '2p')
    if [ "$Getconntype" == "" ]; then
    {
        sleep 5s
        return
    }
    fi
    Model=$(echo "$ATATI" | sed -n '3p')
    conntype=$Getconntype

    cpin=$( sendat $ATPORT "at+cpin?")
    ERR=$(echo "$cpin" | grep "ERROR")
	if [ ! -z "$ERR" ]; then # No SIM
		Debug "No SIM"
        sleep 5s
		return
	fi
	RDY=$(echo "$cpin" | grep "READY")
	if [ -z "$RDY" ]; then # SIM Locked
		Debug "Correct Pin"
        sleep 5s
		return
	else
		Debug "Not Locked"
	fi
    # Execute corresponding modem handler
	if [ $(echo $conntype |grep "Quectel"| wc -l) -ge 1 ];then
	{
        Quectel_AT 
    }
	elif [ $(echo $conntype |grep "SIMCOM"| wc -l) -ge 1 ];then
    {
        SIMCOM_AT
    }
	elif [ $(echo $conntype |grep "Fibocom"| wc -l) -ge 1 ];then
    {
        Fibocom_AT
    }
    else
    {
        Debug "null "
    }
	fi
}
# Reconnect network
modem_reset()
{
    
    echo "Abnormal network restart"
    lsusb=$( lsusb )
    RDFM650=$(echo "$lsusb" | grep "ID 2cb7:0a05 " | wc -l)
    echo "RDFM650 $RDFM650"
	if [ "$RDFM650" == 1 ]; then
	{
        GTRNDIS=$(sendat $ATPORT "AT+GTRNDIS=1,1" 500 |grep OK |wc -l) 
        sleep 2s
    }
	else
	{
        start="$( /etc/init.d/modem stop )"
        sleep 2s
        start="$( /etc/init.d/modem start )"
        sleep 5s
    }
	fi
}
# Check if SIM card is inserted, restart modem after 10 failures
check_sim()
{
	while [ 1 ]
	do
        enabled=$(uci -q get modem.@ndis[0].enabled)
        if [ $enabled == '1' ] ;then
            echo "Check the sim"
            rec=$( sendat 2 "AT+CPIN?")
            rec1=$(echo $rec | grep "READY" | wc -l )
            if [ $rec1 == 1 ]; then
                x=0
                echo "SIM is READY"
            else
                let x++
                if [ $x == 10 ]; then
                    echo "SIM abnormal restart" 
                    modem_reset	# Restart modem
                    x=0
                fi
            fi
        fi
		sleep 6s
	done
}
# Check network status on first boot
chenk_firstdns()
{
    while [ 1 ]
    do
        enabled=$(uci -q get modem.@ndis[0].enabled)
        en1=$(uci -q get modem.@ndis[0].en)
        if [ $enabled == '1' ] ;then
            if [ $en1 == '1' ] ;then
                echo "------------------------------Start task---------------------------"
                ipadd=$(uci -q get modem.@ndis[0].ipaddress)
                ping -c 1 -w 1  $ipadd > /dev/null 2>&1
                if [ $? -eq 0 ];then  
                    echo "Network connected normally" 
                    xx=0
                    return
                else  
                    echo "Network connection abnormal: $ipadd" 
                    let xx++
                    let pxx++
                fi	
            fi
            if [ $xx == 5 ];then
                xx=0
                modem_reset
            fi
            if [ $pxx == 10 ];then
                xx=0
                pxx=0
                return
            fi
            echo "------------------------------End task---------------------------"
        fi
	    sleep 1s
    done
}
# Check network status
chenk_dns()
{
    en1=$(uci -q get modem.@ndis[0].en)
    if [ $en1 == '1' ] ;then
        echo "------------------------------Start task---------------------------"
        ipadd=$(uci -q get modem.@ndis[0].ipaddress)
        ping -c 1 -w 1  $ipadd > /dev/null 2>&1
        if [ $? -eq 0 ];then  
            echo "Network connected normally" 
            xx=0
        else  
            echo "Network connection abnormal: $ipadd, count: $xx" 
            let xx++
        fi	
    fi
    an=$(uci -q get modem.@ndis[0].an)
    if [ $xx == $an ];then
        xx=0
        modem_reset
    fi
    echo "------------------------------End task---------------------------"

}
# Signal task
chenk_Task()
{
    while [ 1 ]
    do
        enabled=$(uci -q get modem.@ndis[0].enabled)
        if [ $enabled == '1' ] ;then
            ATPORT
            Debug "------------------------------Start task---------------------------"
            AUTO_CPE
            SETData
            chenk_dns
            Debug "------------------------------End task---------------------------"
        fi
        sleep 10s
    done
}


