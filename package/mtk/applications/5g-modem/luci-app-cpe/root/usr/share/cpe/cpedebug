#!/bin/sh

en=1 # Debug switch: 0=off, 1=on, 2=output to file
outfile="/tmp/cpe.log"	# Output file
# Log information
Debug()
{
	tim=$(date "+%Y-%m-%d %H:%M:%S")	# Get system time
	if [ $en == 1 ]; then
		echo $tim $1					# Print output
	elif [ $en == 2 ]; then
		echo $tim $1 >> $outfile		# Output to file
	fi
}
ATPORT()
{
	MODEMNAME="ALL"
	# ATPORT=$(uci -q get modem.@ndis[0].tyyusb)
	lsusb=$( lsusb )
	RDFM650=$(echo "$lsusb" | grep "ID 2cb7:0a05 " | wc -l)
	if [ "$RDFM650" == 1 ]; then
		ATPORT=0
		MODEMNAME="FM650CN"
	else
		ATPORT=2
	fi
}