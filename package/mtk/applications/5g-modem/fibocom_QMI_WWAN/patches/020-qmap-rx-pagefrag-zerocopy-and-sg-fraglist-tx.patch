-static struct sk_buff * add_qhdr(struct sk_buff *skb, u8 mux_id) {
+static int qmap_pad_skb(struct sk_buff *skb, unsigned int pad, bool can_sg_pad)
+{
+    if (!pad)
+        return 0;
+
+    if (!skb_is_nonlinear(skb) && !skb_cloned(skb) &&
+        skb_tailroom(skb) >= pad) {
+        memset(__skb_put(skb, pad), 0, pad);
+        return 0;
+    }
+
+    /* Preserve truesize for sock_wfree and guard skb_zcopy/pp_recycle invariants. */
+    if (can_sg_pad && qmap_zero_pad_page &&
+        skb_is_nonlinear(skb) && !skb_cloned(skb) &&
+        !skb_has_frag_list(skb) && !skb_zcopy(skb) &&
+        !skb->pp_recycle &&
+        skb_shinfo(skb)->nr_frags < MAX_SKB_FRAGS) {
+        get_page(qmap_zero_pad_page);
+        skb_fill_page_desc(skb, skb_shinfo(skb)->nr_frags,
+                           qmap_zero_pad_page, 0, pad);
+        skb->len += pad;
+        skb->data_len += pad;
+        return 0;
+    }
+
+    return __skb_put_padto(skb, skb->len + pad, false);
+}
