#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only

UCODE="${EQOS_UCODE_BIN:-/usr/bin/ucode}"
LIBEXEC_DIR="${EQOS_LIBEXEC_DIR:-/usr/libexec/eqos}"

if [ ! -x "$UCODE" ] && command -v ucode >/dev/null 2>&1; then
	UCODE="$(command -v ucode)"
fi

exec "$UCODE" ${EQOS_UCODE_ARGS} "${LIBEXEC_DIR}/route-reconcile.uc" "$@"
