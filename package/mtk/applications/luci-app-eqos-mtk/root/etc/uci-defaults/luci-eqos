#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

UCI="${EQOS_UCI_BIN:-uci}"
FIREWALL_USER="${EQOS_FIREWALL_USER:-/etc/firewall.user}"
STATE_DIR="${EQOS_STATE_DIR:-/var/run/eqos}"
FW4_STATE="${EQOS_FW4_STATE:-/var/run/fw4.state}"

"$UCI" -q batch <<-EOF >/dev/null
	delete ucitrack.@eqos[-1]
	add ucitrack eqos
	set ucitrack.@eqos[-1].init='eqos'
	commit ucitrack
	set firewall.eqos_include='include'
	set firewall.eqos_include.type='script'
	set firewall.eqos_include.path='/usr/libexec/eqos/fw4-include.sh'
	set firewall.eqos_include.fw4_compatible='1'
	commit firewall
EOF

legacy_detected=0
if [ -f "$FIREWALL_USER" ] && grep -q '/etc/init\.d/eqos start' "$FIREWALL_USER" 2>/dev/null; then
	legacy_detected=1
	grep -v '/etc/init\.d/eqos start' "$FIREWALL_USER" > "${FIREWALL_USER}.eqos.tmp" || true
	mv "${FIREWALL_USER}.eqos.tmp" "$FIREWALL_USER"
fi

if [ "$legacy_detected" -eq 1 ] || [ -f "$FW4_STATE" ]; then
	mkdir -p "$STATE_DIR" 2>/dev/null || true
	echo "1" > "${STATE_DIR}/legacy-reboot-required"
fi

rm -f /tmp/luci-indexcache
exit 0
