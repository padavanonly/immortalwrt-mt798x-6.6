#!/bin/sh /etc/rc.common
# Copyright (C) 2006 OpenWrt.org

START=50
USE_PROCD=1

start_service() {
	${EQOS_UCODE_BIN:-/usr/bin/ucode} ${EQOS_UCODE_ARGS} "${EQOS_LIBEXEC_DIR:-/usr/libexec/eqos}/reconcile.uc" --trigger start
}

stop_service() {
	${EQOS_UCODE_BIN:-/usr/bin/ucode} ${EQOS_UCODE_ARGS} "${EQOS_LIBEXEC_DIR:-/usr/libexec/eqos}/reconcile.uc" --trigger stop
}

reload_service() {
	${EQOS_UCODE_BIN:-/usr/bin/ucode} ${EQOS_UCODE_ARGS} "${EQOS_LIBEXEC_DIR:-/usr/libexec/eqos}/reconcile.uc" --trigger reload
}

service_triggers() {
	procd_add_reload_trigger "eqos"
}
