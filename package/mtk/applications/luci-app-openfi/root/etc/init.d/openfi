#!/bin/sh /etc/rc.common
START=99
STOP=13
USE_PROCD=1

service_triggers()
{
	procd_add_reload_trigger "openfi"
}

start_service()
{
	config_load "openfi"

	procd_open_instance
	procd_set_param command /usr/sbin/op_led.sh
	procd_set_param respawn
	procd_close_instance

	[ -x /usr/sbin/op_reset_modem.sh ] && /usr/sbin/op_reset_modem.sh
	[ -x /usr/sbin/op_switch.sh ] && /usr/sbin/op_switch.sh
}

reload_service()
{
	stop
	start
}
