import * as fs from 'fs';

unshift(REQUIRE_SEARCH_PATH, "/usr/lib/ucode/*.uc");
unshift(REQUIRE_SEARCH_PATH, "/usr/share/ucode/*.uc");
unshift(REQUIRE_SEARCH_PATH, "/usr/share/ucode/mtwifi/*.uc");
let __sp = sourcepath(0, true);
if (__sp) {
	unshift(REQUIRE_SEARCH_PATH, __sp + "/../mtwifi-cfg/*.uc");
	unshift(REQUIRE_SEARCH_PATH, __sp + "/../l1util/*.uc");
	unshift(REQUIRE_SEARCH_PATH, __sp + "/*.uc");
}
let __env_dir = getenv("MTWIFI_UCODE_DIR") || getenv("MTWIFI_LIB_DIR");
if (__env_dir) {
	for (let p in split(__env_dir, ":")) {
		if (length(p) > 0)
			unshift(REQUIRE_SEARCH_PATH, p + "/*.uc");
	}
}

let l1parser = require("l1dat_parser");
let utils = require("mtwifi_utils");
let defs = require("mtwifi_defs");

let l1dat = l1parser.load_l1_profile(l1parser.L1_DAT_PATH);

function lua_truthy(val) {
	return val != null && val !== false;
}

function lua_or(a, b) {
	return lua_truthy(a) ? a : b;
}

function to_lua_str(v) {
	if (v == null)
		return "nil";
	return "" + v;
}

function split_nonempty(s, sep) {
	sep = sep || ":";
	let fields = [];
	if (s == null)
		return fields;
	for (let c in split("" + s, sep)) {
		if (length(c) > 0)
			push(fields, c);
	}
	return fields;
}

function load_profile(path) {
	return utils.load_profile(path);
}

function save_profile(cfgs, path) {
	if (!cfgs)
		return false;
	return utils.save_profile(cfgs, path);
}

function resolve_enc2dat(enc, band, mode) {
	if (enc == null || enc == "")
		enc = "none";
	let pair = defs.enc2dat["" + enc];
	if (type(pair) != "array" || length(pair) < 2)
		return null;
	if (mode == "sta" && (pair[0] == "WPA2PSKWPA3PSK" || pair[0] == "WPAPSKWPA2PSK"))
		return null;
	if (band == "6g" && pair[0] != "WPA3PSK" && pair[0] != "OWE")
		return null;
	return pair;
}

function diff_cfg(cfg1, cfg2) {
	let diff = {};

	for (let k, v in cfg1) {
		if (to_lua_str(cfg2[k]) != to_lua_str(cfg1[k])) {
			diff[k] = [ lua_or(cfg1[k], ""), lua_or(cfg2[k], "") ];
		}
	}

	for (let k, v in cfg2) {
		if (to_lua_str(cfg2[k]) != to_lua_str(cfg1[k])) {
			diff[k] = [ lua_or(cfg1[k], ""), lua_or(cfg2[k], "") ];
		}
	}

	return diff;
}

function vif_status(ifname) {
	let raw = utils.read_sysfs_net(ifname, "flags");
	let flags = (raw && length(raw) > 0) ? int(raw, 0) : 0;
	if (type(flags) != "int")
		flags = 0;
	if (flags % 2 == 1)
		return "up";
	return "down";
}

function is_dbdc_inited(ifname) {
	let mac = utils.read_sysfs_net(ifname, "address");
	if (lua_truthy(mac) && mac != "00:00:00:00:00:00")
		return true;
	return false;
}

function ifup(ifname) {
	if (ifname && length(ifname) > 0) {
		utils.exec(["ip", "link", "set", "dev", "" + ifname, "up"]);
		utils.syslog("info", "mtwifi-cfg: ip link set dev up " + ifname);
	}
}

function ifdown(ifname) {
	if (ifname && length(ifname) > 0) {
		utils.exec(["ip", "link", "set", "dev", "" + ifname, "down"]);
		utils.syslog("info", "mtwifi-cfg: ip link set dev down " + ifname);
	}
}

function cfg2dat(cfg) {
	if (type(cfg) == "bool") {
		return cfg ? 1 : 0;
	} else if (type(cfg) == "int" || type(cfg) == "double" || type(cfg) == "string") {
		return cfg;
	}
	return null;
}

function set_dev_dat(dats, dat, cfg) {
	if (cfg != null) {
		dats[dat] = cfg2dat(cfg);
	}
}

function set_dat(dats, apidx, dat, cfg) {
	if (cfg != null) {
		dats[dat] = utils.token_set(dats[dat], apidx, cfg2dat(cfg));
	}
}

function set_idx_dat(dats, apidx, dat, cfg) {
	if (cfg != null) {
		let key;
		if (apidx == 0)
			key = dat;
		else
			key = dat + ("" + apidx);
		dats[key] = cfg;
	}
}

function __match_vif_prefix(vif, prefix) {
	if (!vif || !prefix)
		return false;
	let re = regexp("^" + utils.esc(prefix) + "[0-9]+$");
	return match("" + vif, re) != null;
}

function is_dbdc_dev(devname, dev) {
	for (let k, v in l1dat.devname_ridx) {
		if (k != devname && v.INDEX == dev.INDEX && v.mainidx == dev.mainidx)
			return true;
	}
	return false;
}

function vif_in_dev(vif, dev) {
	if (vif == dev.main_ifname ||
	    __match_vif_prefix(vif, dev.ext_ifname) ||
	    __match_vif_prefix(vif, dev.apcli_ifname) ||
	    __match_vif_prefix(vif, dev.wds_ifname) ||
	    __match_vif_prefix(vif, dev.mesh_ifname)) {
		return true;
	}
	return false;
}

function vif_is_apcli(vif, dev) {
	return __match_vif_prefix(vif, dev.apcli_ifname);
}

function is_ax_mode(cfg) {
	if (!cfg.config.htmode)
		return false;
	if (substr("" + cfg.config.htmode, 0, 2) == "HE")
		return true;
	return false;
}

function is_be_mode(cfg) {
	if (!cfg.config.htmode)
		return false;
	if (substr("" + cfg.config.htmode, 0, 3) == "EHT")
		return true;
	return false;
}

function is_wifi7_dev(dev) {
	let chip = (dev && dev.INDEX) ? ("" + dev.INDEX) : "";
	if (match(chip, /^MT799/i))
		return true;
	if (match(chip, /^MT798|^MT791/i))
		return false;
	return utils.exists("/sys/module/mtk_hwifi");
}

function vif_count(cfg) {
	let vif_num = 0;
	let ap_num = 0;
	let apcli_num = 0;

	for (let k, v in cfg.interfaces) {
		vif_num++;
		if (lua_truthy(v.config.disabled))
			continue;
		if (v.config.mode == "ap")
			ap_num++;
		else if (v.config.mode == "sta")
			apcli_num++;
	}

	return [ vif_num, ap_num, apcli_num ];
}

function mtwifi_cfg_foreach_vif(cfg, mode, func) {
	if (cfg == null || func == null)
		return;

	let counts = vif_count(cfg);
	let vif_num = counts[0];
	for (let idx = 0; idx <= vif_num - 1; idx++) {
		let v = cfg.interfaces[sprintf("%d", idx)];
		if (v && !lua_truthy(v.config.disabled) && v.config.mode && v.config.mode == mode) {
			func(v);
		}
	}
}

function __exec_iwpriv_cmd(ifname, key, val) {
	let argv = ["iwpriv", "" + ifname, "set", sprintf("%s=%s", key, "" + val)];
	utils.syslog("info", "mtwifi-cfg: iwpriv cmd: " + join(" ", argv));
	utils.exec(argv);
}

function __apcli_auto_connect(ifname) {
	__exec_iwpriv_cmd(ifname, "ApCliEnable", "1");
	__exec_iwpriv_cmd(ifname, "ApCliAutoConnect", "3");
}

function mtwifi_up(devname, cfg, restore_vifs, is_dbdc) {
	utils.syslog("info", "mtwifi-cfg: start " + devname);
	if (!l1dat || !l1dat.devname_ridx)
		return;
	let dev = l1dat.devname_ridx[devname];
	if (!dev)
		return;

	if (is_dbdc) {
		let dbdc_main_dev = dev.INDEX + "_1_1";
		let dbdc_main_ifname = l1dat.devname_ridx[dbdc_main_dev] ? l1dat.devname_ridx[dbdc_main_dev].main_ifname : null;

		if (dbdc_main_ifname && !is_dbdc_inited(dbdc_main_ifname)) {
			utils.syslog("info", "mtwifi-cfg: dbdc card init...");
			ifup(dbdc_main_ifname);
			utils.sleep(1);
			ifdown(dbdc_main_ifname);
		}

		if (restore_vifs && devname != cfg.device) {
			// restart ap vif
			for (let vif in restore_vifs) {
				if (vif_in_dev(vif, dev) && !vif_is_apcli(vif, dev)) {
					utils.syslog("info", "mtwifi-cfg: restore ap vif: " + vif);
					ifup(vif);
				}
			}
			// restart apcli vif
			for (let vif in restore_vifs) {
				if (vif_is_apcli(vif, dev)) {
					utils.syslog("info", "mtwifi-cfg: restore apcli vif: " + vif);
					ifup(vif);
					__apcli_auto_connect(vif);
				}
			}
			return;
		}
	}

	let start_vif = function(v) {
		if (!lua_truthy(v.config.disabled) && v.mtwifi_ifname) {
			let vif = v.mtwifi_ifname;
			utils.syslog("info", "mtwifi-cfg: up vif: " + vif);
			ifup(vif);
		}
	};

	mtwifi_cfg_foreach_vif(cfg, "ap", start_vif);
	mtwifi_cfg_foreach_vif(cfg, "sta", start_vif);
}

function mtwifi_down(devname, cfg) {
	utils.syslog("info", "mtwifi-cfg: stop " + devname);
	if (!l1dat || !l1dat.devname_ridx)
		return [];
	let dev = l1dat.devname_ridx[devname];
	let reset_vifs = [];

	if (!dev)
		return [];

	for (let vif in utils.list_netdevs()) {
		if (vif_status(vif) == "up" && vif_in_dev(vif, dev)) {
			utils.syslog("info", "mtwifi-cfg: down vif: " + vif);
			ifdown(vif);
			if (cfg && devname != cfg.device) {
				push(reset_vifs, vif);
			}
		}
	}
	return reset_vifs;
}

function mtwifi_reinstall() {
	let mod_order = [ "mtk_warp", "mt_wifi", "mtk_hwifi", "connac_if", "mtk_pci", "mtk_wed", "mt799a", "mt7992", "mt7990", "mt7991", "mt7993" ];
	let unloaded = [];

	utils.syslog("info", "mtwifi-cfg: unload mtwifi module...");

	for (let i = length(mod_order) - 1; i >= 0; i--) {
		let m = mod_order[i];
		if (utils.exists("/sys/module/" + m)) {
			utils.exec(["rmmod", "" + m]);
			unshift(unloaded, m);
		}
	}

	utils.sleep(2);

	utils.syslog("info", "mtwifi-cfg: reload mtwifi module...");

	for (let m in unloaded) {
		utils.exec(["modprobe", "" + m]);
	}

	utils.sleep(1);
}

function mtwifi_cfg_iwpriv_hook(cfg) {
	let ap_hook = function(v) {
		if (!lua_truthy(v.config.disabled) && v.mtwifi_ifname) {
			let vif = v.mtwifi_ifname;
			for (let k, j in defs.iwpriv_ap_cfgs) {
				__exec_iwpriv_cmd(vif, j[0], lua_or(v.config[k], j[1]));
			}
			if (lua_truthy(v.config.igmp_snooping) && "" + v.config.igmp_snooping != "0") {
				__exec_iwpriv_cmd(vif, "IgmpSnAllowNonMembEnable", "1");
			}
		}
	};

	let apcli_hook = function(v) {
		if (!lua_truthy(v.config.disabled) && v.mtwifi_ifname) {
			let vif = v.mtwifi_ifname;
			__apcli_auto_connect(vif);
		}
	};

	mtwifi_cfg_foreach_vif(cfg, "ap", ap_hook);
	mtwifi_cfg_foreach_vif(cfg, "sta", apcli_hook);
}

function set_chip_cfg(cfg, dats) {
	if (!lua_truthy(cfg.config.dbdc_main))
		return true;

	// reset chip cfgs to default
	for (let uci, v in defs.chip_cfgs) {
		let dat_key = v[0];

		dats[dat_key] = v[1];

		// setup current dev cfg
		set_dev_dat(dats, dat_key, cfg.config[uci]);
	}

	let cur_dev = l1dat.devname_ridx[cfg.device];
	if (cur_dev && cur_dev.init_path && utils.exists(cur_dev.init_path)) {
		let init_dats = load_profile(cur_dev.init_path);
		if (init_dats) {
			set_dev_dat(init_dats, "WHNAT", dats.WHNAT);
			if (!save_profile(init_dats, cur_dev.init_path)) {
				utils.syslog("err", "mtwifi-cfg: init profile " + cur_dev.init_path + " save failed");
				return false;
			}
		}
	}

	// setup other dev cfg
	for (let k, v in l1dat.devname_ridx) {
		if (k != cfg.device &&
		    v.INDEX == l1dat.devname_ridx[cfg.device].INDEX &&
		    v.mainidx == l1dat.devname_ridx[cfg.device].mainidx) {
			let dev_dats = load_profile(v.profile_path);
			if (dev_dats) {
				for (let _, j in defs.chip_cfgs) {
					let dat_key = j[0];
					set_dev_dat(dev_dats, dat_key, dats[dat_key]);
				}
				if (!save_profile(dev_dats, v.profile_path)) {
					utils.syslog("err", "mtwifi-cfg: peer profile " + v.profile_path + " save failed");
					return false;
				}
			}
		}
	}
	return true;
}

function mtwifi_cfg_setup(argv) {
	let cfg = json(argv);
	if (!cfg)
		return false;

	utils.log2file("input = " + sprintf("%J", cfg));

	if (!l1dat || !l1dat.devname_ridx)
		return false;

	let devname = cfg.device;
	let dev = l1dat.devname_ridx[devname];
	if (!dev)
		return false;

	let counts = vif_count(cfg);
	let vif_num = counts[0];
	let bssid_num = counts[1];
	let apcli_num = counts[2];

	if (vif_num == 0) {
		utils.syslog("err", "mtwifi-cfg: not valid vif found!");
		return false;
	}
	if (bssid_num == 0 && apcli_num == 0) {
		mtwifi_down(devname);
		return true;
	}
	if (bssid_num > defs.max_runtime_ap) {
		utils.syslog("err", sprintf("mtwifi-cfg: too many active AP interfaces (%d > %d) for %s", bssid_num, defs.max_runtime_ap, devname));
		return false;
	}
	if (apcli_num > 1) {
		utils.syslog("err", "mtwifi-cfg: only support one apcli vif!");
		return false;
	}

	let profile = dev.profile_path;

	let dats = load_profile(profile);
	if (!dats) {
		utils.syslog("err", "mtwifi-cfg: profile " + profile + "open failed");
		return false;
	}
	let dats_orig = load_profile(profile);

	// setup wireless mode
	if (type(cfg.config.htmode) != "string") {
		utils.syslog("err", "mtwifi-cfg: invalid htmode!");
		return false;
	}

	let wifi7 = is_wifi7_dev(dev);
	let req_be = is_be_mode(cfg);
	let eff_be = wifi7 && req_be;
	let eff_ax = is_ax_mode(cfg) || (!wifi7 && req_be);
	if (!wifi7 && req_be) {
		utils.syslog("warning", sprintf("mtwifi-cfg: %s (%s) does not support EHT, downgrading %s to HE/AX",
			devname, dev.INDEX ?? "mt_wifi", cfg.config.htmode));
	}

	let WirelessMode = null;

	if (cfg.config.band == "2g") {
		WirelessMode = 9; // PHY_11BGN_MIXED
		if (eff_ax) {
			WirelessMode = 16; // PHY_11AX_24G
		} else if (eff_be) {
			WirelessMode = 22; // PHY_11BE_24G
		}
	} else if (cfg.config.band == "5g") {
		if (substr("" + cfg.config.htmode, 0, 2) == "HT") {
			WirelessMode = 8; // PHY_11AN_MIXED
		} else {
			WirelessMode = 14; // PHY_11VHT_N_ABG_MIXED
		}
		if (eff_ax) {
			WirelessMode = 17; // PHY_11AX_5G
		} else if (eff_be) {
			WirelessMode = 23; // PHY_11BE_5G
		}
	} else if (cfg.config.band == "6g") {
		if (eff_ax) {
			WirelessMode = 18; // PHY_11AX_6G
		} else if (eff_be) {
			WirelessMode = 24; // PHY_11BE_6G
		}
	}

	if (!WirelessMode) {
		utils.syslog("err", "mtwifi-cfg: invalid wireless mode!");
		return false;
	}

	// setup bandwidth
	let bw_m = match(cfg.config.htmode, /[0-9]+/);
	let bw = bw_m ? bw_m[0] : null;
	if (!bw || defs.bwMap[bw] == null) {
		utils.syslog("err", "mtwifi-cfg: invalid bandwidth!");
		return false;
	}

	if (bw == "320" && !(cfg.config.band == "6g" && eff_be)) {
		utils.syslog("err", "mtwifi-cfg: 320MHz bandwidth only supported in 6G BE mode!");
		return false;
	}

	if (cfg.config.band == "2g" && (bw == "80" || bw == "160" || bw == "320")) {
		utils.syslog("err", "mtwifi-cfg: bandwidth " + bw + " not supported on 2.4GHz!");
		return false;
	}

	// pre-validate all ap and sta interfaces before mutating dats or calling set_chip_cfg
	for (let _, v in cfg.interfaces) {
		if (v && v.config && (v.config.mode == "ap" || v.config.mode == "sta")) {
			if (!resolve_enc2dat(v.config.encryption, cfg.config.band, v.config.mode)) {
				utils.syslog("err", "mtwifi-cfg: invalid encryption " + (v.config.encryption ?? "") + " for mode " + v.config.mode);
				return false;
			}
		}
	}

	// pre-validate country if specified
	if (type(cfg.config.country) == "string" && length(cfg.config.country) == 2) {
		if (!defs.countryRegions[cfg.config.country]) {
			utils.syslog("err", "mtwifi-cfg: invalid country " + cfg.config.country);
			return false;
		}
	}

	dats.BssidNum = defs.max_runtime_ap;
	dats.HT_BW = defs.bwMap[bw].HT_BW;
	dats.VHT_BW = defs.bwMap[bw].VHT_BW;
	if (wifi7) {
		dats.EHT_ApBw = defs.bwMap[bw].EHT_ApBw;
		dats.EHT_StaBw = defs.bwMap[bw].EHT_ApBw;
	}

	if (bw == "40" && cfg.config.noscan != null && "" + cfg.config.noscan == "1") {
		dats.HT_BSSCoexistence = 0;
	} else {
		dats.HT_BSSCoexistence = 1;
	}

	// setup apcli
	dats.ApCliEnable = 0;
	dats.ApCliSsid = "";
	dats.ApCliBssid = "";
	dats.MACRepeaterEn = 0;
	dats.ApcliMacAddress = "";
	dats.ApCliAuthMode = "";
	dats.ApCliEncrypType = "";
	dats.ApCliWPAPSK = "";
	dats.ApCliPMFMFPC = 0;
	dats.ApCliPMFMFPR = 0;
	dats.ApCliPMFSHA256 = 0;

	for (let _, v in cfg.interfaces) {
		if (v.config.mode == "sta") {
			if (lua_truthy(v.config.disabled))
				continue;
			let enc_pair = resolve_enc2dat(v.config.encryption, cfg.config.band, v.config.mode);
			if (!enc_pair) {
				utils.syslog("err", "mtwifi-cfg: invalid apcli encryption " + lua_or(v.config.encryption, ""));
				return false;
			}
			dats.ApCliEnable = 1;
			dats.ApCliSsid = lua_or(v.config.ssid, "");
			dats.ApCliBssid = lua_or(v.config.bssid, "");
			dats.MACRepeaterEn = (lua_truthy(v.config.bssid) && v.config.bssid != "") ? 1 : 0;
			dats.ApcliMacAddress = lua_or(v.config.macaddr, lua_or(dats.MacAddress_Default, ""));
			dats.ApCliAuthMode = enc_pair[0];
			dats.ApCliEncrypType = enc_pair[1];
			dats.ApCliWPAPSK = lua_or(v.config.key, "");

			if (dats.ApCliAuthMode == "OWE" || dats.ApCliAuthMode == "WPA3PSK") {
				dats.ApCliPMFMFPC = 1;
				dats.ApCliPMFMFPR = 1;
				dats.ApCliPMFSHA256 = 0;
			} else if (dats.ApCliAuthMode == "WPA2PSKWPA3PSK") {
				dats.ApCliPMFMFPC = 1;
				dats.ApCliPMFMFPR = 0;
				dats.ApCliPMFSHA256 = 0;
			}
			break;
		}
	}

	// setup chip cfgs
	if (!set_chip_cfg(cfg, dats))
		return false;

	// setup other dev cfgs
	if (type(cfg.config.country) == "string" && length(cfg.config.country) == 2) {
		let region = defs.countryRegions[cfg.config.country];
		if (!region) {
			utils.syslog("err", "mtwifi-cfg: invalid country " + cfg.config.country);
			return false;
		}
		dats.CountryCode = cfg.config.country;
		if (cfg.config.band == "2g") {
			dats.CountryRegion = region[0];
		} else if (cfg.config.band == "5g") {
			dats.CountryRegionABand = region[1];
			dats.RDRegion = defs.countryRdRegion[cfg.config.country] ?? "CE";
			dats.DfsEnable = (lua_truthy(cfg.config.dfs) && "" + cfg.config.dfs != "0") ? 1 : 0;
		} else if (cfg.config.band == "6g") {
			dats.CountryRegionABand = defs.countryRegions6G[cfg.config.country] ?? 1;
		}
	}

	if (cfg.config.channel == "auto") {
		dats.AutoChannelSelect = 3;
		dats.Channel = 0;
	} else {
		dats.AutoChannelSelect = 0;
		dats.Channel = cfg.config.channel;
	}

	if (lua_truthy(cfg.config.txpower) && int(cfg.config.txpower) < 100) {
		dats.PERCENTAGEenable = 1;
		dats.TxPower = cfg.config.txpower;
	} else {
		dats.PERCENTAGEenable = 0;
		dats.TxPower = 100;
	}

	if (lua_truthy(cfg.config.mu_beamformer)) {
		dats.ETxBfEnCond = 1;
		if (dats.ApCliEnable == 1) {
			dats.MUTxRxEnable = 3;
		} else {
			dats.MUTxRxEnable = 1;
		}
		dats.ITxBfEn = 1;
	} else {
		dats.ETxBfEnCond = 0;
		dats.MUTxRxEnable = 0;
		dats.ITxBfEn = 0;
	}

	if ((eff_ax || eff_be) && cfg.config.twt != null && "" + cfg.config.twt != "") {
		dats.TWTSupport = defs.twtMap["" + cfg.config.twt] ?? 0;
	} else {
		dats.TWTSupport = 0;
	}

	// reset vif cfgs to default
	for (let k, v in defs.vif_cfgs) {
		if (!wifi7 && (k == "MldGroup" || k == "PpMuMimoDlEnable" || k == "PpMuMimoUlEnable" || k == "PpOfdmaDlEnable" || k == "PpOfdmaUlEnable"))
			continue;
		let defv = (!wifi7 && k == "HT_BAWinSize") ? "256" : v;
		dats[k] = "";
		for (let i = 1; i <= bssid_num; i++) {
			dats[k] = utils.token_set(dats[k], i, defv);
		}
	}

	for (let k, v in defs.vif_cfgs_idx) {
		for (let i = 1; i <= defs.max_mbssid; i++) {
			dats[k + ("" + i)] = "";
		}
		for (let i = 1; i <= bssid_num; i++) {
			dats[k + ("" + i)] = v;
		}
	}

	for (let vif_table in [ defs.vif_mac, defs.vif_acl ]) {
		for (let k, v in vif_table) {
			if (k == "MacAddress") {
				for (let i = 0; i <= bssid_num - 1; i++) {
					set_idx_dat(dats, i, k, v);
				}
				if (bssid_num < defs.max_mbssid) {
					for (let i = bssid_num; i <= defs.max_mbssid - 1; i++) {
						set_idx_dat(dats, i, k, "");
					}
				}
			} else {
				for (let i = 0; i <= bssid_num - 1; i++) {
					dats[k + ("" + i)] = v;
				}
				if (bssid_num < defs.max_mbssid) {
					for (let i = bssid_num; i <= defs.max_mbssid - 1; i++) {
						dats[k + ("" + i)] = "";
					}
				}
			}
		}
	}

	// setup vif cfgs
	let apidx = 1;
	let mlo_assigned = false;
	for (let idx = 0; idx <= vif_num - 1; idx++) {
		let v = cfg.interfaces[sprintf("%d", idx)];
		if (v && v.config.mode == "ap") {
			if (lua_truthy(v.config.disabled))
				continue;

			let enc_pair = resolve_enc2dat(v.config.encryption, cfg.config.band, v.config.mode);
			if (!enc_pair) {
				utils.syslog("err", "mtwifi-cfg: invalid ap encryption " + lua_or(v.config.encryption, ""));
				return false;
			}
			let authmode = enc_pair[0];

			set_idx_dat(dats, apidx, "SSID", v.config.ssid);
			set_idx_dat(dats, apidx, "WPAPSK", lua_or(v.config.key, ""));
			set_dat(dats, apidx, "NoForwarding", v.config.isolate);
			set_dat(dats, apidx, "HideSSID", v.config.hidden);
			let set_mac = true;
			if (wifi7) {
				if (!mlo_assigned && lua_truthy(v.config.mlo) && eff_be &&
				    (authmode == "OWE" || authmode == "WPA3PSK" || authmode == "WPA2PSKWPA3PSK")) {
					set_dat(dats, apidx, "MldGroup", "1");
					mlo_assigned = true;
					set_mac = false;
				} else {
					set_dat(dats, apidx, "MldGroup", "0");
				}
			}
			if (set_mac) {
				set_idx_dat(dats, apidx - 1, "MacAddress",
					lua_or(v.config.macaddr, lua_or(dats.MacAddress_Default, "")));
			}
			set_dat(dats, apidx, "WmmCapable", v.config.wmm);
			set_dat(dats, apidx, "RRMEnable", v.config.ieee80211k);
			set_dat(dats, apidx, "HT_AMSDU", v.config.amsdu);
			set_dat(dats, apidx, "HT_AutoBA", v.config.autoba);
			set_dat(dats, apidx, "APSDCapable", v.config.uapsd);
			set_dat(dats, apidx, "RTSThreshold", v.config.rts);
			set_dat(dats, apidx, "FragThreshold", v.config.frag);
			set_dat(dats, apidx, "DtimPeriod", v.config.dtim_period);
			set_dat(dats, apidx, "WirelessMode", WirelessMode);
			set_dat(dats, apidx, "WNMEnable", v.config.bss_transition);
			if (v.config.igmp_snooping != null) {
				set_dat(dats, apidx, "IgmpSnEnable",
					(lua_truthy(v.config.igmp_snooping) && "" + v.config.igmp_snooping != "0") ? 1 : 0);
			}
			let mcast_rate_key = (v.config.mcast_rate != null) ? ("" + v.config.mcast_rate) : "";
			if (defs.mcastRateMap[mcast_rate_key] != null) {
				set_dat(dats, apidx, "McastPhyMode", 2);
				set_dat(dats, apidx, "McastMcs", defs.mcastRateMap[mcast_rate_key]);
			} else {
				set_dat(dats, apidx, "McastPhyMode", 0);
				set_dat(dats, apidx, "McastMcs", "");
			}

			if (eff_be) {
				set_dat(dats, apidx, "PpMuMimoDlEnable", !lua_truthy(v.config.mumimo_dl) ? 0 : 1);
				set_dat(dats, apidx, "PpMuMimoUlEnable", !lua_truthy(v.config.mumimo_ul) ? 0 : 1);
				set_dat(dats, apidx, "PpOfdmaDlEnable", v.config.ofdma_dl);
				set_dat(dats, apidx, "PpOfdmaUlEnable", v.config.ofdma_ul);
				set_dat(dats, apidx, "MuMimoDlEnable", !lua_truthy(v.config.mumimo_dl) ? 0 : 1);
				set_dat(dats, apidx, "MuMimoUlEnable", !lua_truthy(v.config.mumimo_ul) ? 0 : 1);
				set_dat(dats, apidx, "MuOfdmaDlEnable", v.config.ofdma_dl);
				set_dat(dats, apidx, "MuOfdmaUlEnable", v.config.ofdma_ul);
				set_dat(dats, apidx, "HT_BAWinSize", 1024);
			} else if (eff_ax) {
				set_dat(dats, apidx, "MuMimoDlEnable", !lua_truthy(v.config.mumimo_dl) ? 0 : 1);
				set_dat(dats, apidx, "MuMimoUlEnable", !lua_truthy(v.config.mumimo_ul) ? 0 : 1);
				set_dat(dats, apidx, "MuOfdmaDlEnable", v.config.ofdma_dl);
				set_dat(dats, apidx, "MuOfdmaUlEnable", v.config.ofdma_ul);
				set_dat(dats, apidx, "HT_BAWinSize", 256);
			} else {
				set_dat(dats, apidx, "HT_BAWinSize", 64);
			}

			if (lua_truthy(v.config.macfilter)) {
				if (v.config.macfilter == "allow") {
					set_idx_dat(dats, apidx - 1, "AccessPolicy", 1);
				} else if (v.config.macfilter == "deny") {
					set_idx_dat(dats, apidx - 1, "AccessPolicy", 2);
				}
			}

			if (lua_truthy(v.config.maclist) && type(v.config.maclist) == "array") {
				let maclist = "";
				for (let i = 0; i < length(v.config.maclist); i++) {
					if (i + 1 > defs.max_acl_entry)
						break;
					let mac_entry = v.config.maclist[i];
					if (length(maclist) > 0)
						maclist = maclist + ";" + mac_entry;
					else
						maclist = "" + mac_entry;
				}
				set_idx_dat(dats, apidx - 1, "AccessControlList", maclist);
			}

			set_dat(dats, apidx, "AuthMode", authmode);
			set_dat(dats, apidx, "EncrypType", enc_pair[1]);

			if (authmode == "OWE" || authmode == "WPA3PSK") {
				set_dat(dats, apidx, "PMFMFPC", 1);
				set_dat(dats, apidx, "PMFMFPR", 1);
				set_dat(dats, apidx, "PMFSHA256", 0);
			} else if (authmode == "WPA2PSKWPA3PSK") {
				set_dat(dats, apidx, "PMFMFPC", 1);
				set_dat(dats, apidx, "PMFMFPR", 0);
				set_dat(dats, apidx, "PMFSHA256", 0);
			}

			if (authmode == "OPEN" || authmode == "OWE") {
				set_dat(dats, apidx, "RekeyMethod", "DISABLE");
				set_dat(dats, apidx, "RekeyInterval", 3600);
			} else {
				let rekey_str = (v.config.wpa_group_rekey != null) ? ("" + v.config.wpa_group_rekey) : "";
				let rekey_val = int(rekey_str);
				if (rekey_str == "0") {
					set_dat(dats, apidx, "RekeyMethod", "DISABLE");
					set_dat(dats, apidx, "RekeyInterval", 3600);
				} else if (match(rekey_str, /^[0-9]+$/) && rekey_val >= 10 && rekey_val <= 86400) {
					set_dat(dats, apidx, "RekeyMethod", "TIME");
					set_dat(dats, apidx, "RekeyInterval", rekey_val);
				} else {
					set_dat(dats, apidx, "RekeyMethod", "TIME");
					set_dat(dats, apidx, "RekeyInterval", 3600);
				}
			}

			apidx = apidx + 1;
		}
	}

	let reinstall_wifidrv = false;
	let cfg_diff = diff_cfg(dats_orig, dats);
	utils.log2file("diff = " + sprintf("%J", cfg_diff));

	if (!save_profile(dats, profile)) {
		utils.syslog("err", "mtwifi-cfg: profile " + profile + " save failed");
		return false;
	}

	for (let v in defs.reinstall_cfgs) {
		if (cfg_diff[v] != null) {
			if (v == "BssidNum" && dats_orig.BssidNum != null && int(dats_orig.BssidNum) >= bssid_num)
				continue;
			if (utils.exists("/sys/module/mt_wifi") == false) {
				utils.syslog("err", "mtwifi-cfg: mtwifi module is build-in, please reboot the device!");
				return false;
			}
			reinstall_wifidrv = true;
		}
	}

	if (is_dbdc_dev(devname, dev)) {
		if (reinstall_wifidrv) {
			for (let k, _ in l1dat.devname_ridx) {
				mtwifi_down(k);
			}

			mtwifi_reinstall();

			for (let k, _ in l1dat.devname_ridx) {
				if (k == devname) {
					mtwifi_up(k, cfg, null, true);
				} else {
					utils.exec(["/sbin/wifi", "up", "" + k]);
				}
			}
		} else {
			let restore_vifs = [];
			let restart_other_dbdc_dev = (length(keys(cfg_diff)) > 0);

			if (restart_other_dbdc_dev) {
				for (let k, j in l1dat.devname_ridx) {
					if (j.INDEX == dev.INDEX && j.mainidx == dev.mainidx) {
						let ret = mtwifi_down(k, cfg);
						for (let v in ret) {
							push(restore_vifs, v);
						}
					}
				}
				if (length(restore_vifs) > 0) {
					utils.syslog("info", "mtwifi-cfg: dbdc restore_vifs: " + sprintf("%J", restore_vifs));
				}

				for (let k, j in l1dat.devname_ridx) {
					if (j.INDEX == dev.INDEX && j.mainidx == dev.mainidx) {
						mtwifi_up(k, cfg, restore_vifs, true);
					}
				}
			} else {
				mtwifi_down(devname);
				mtwifi_up(devname, cfg, null, true);
			}
		}
	} else {
		mtwifi_down(devname);

		if (reinstall_wifidrv) {
			mtwifi_reinstall();
		}

		mtwifi_up(devname, cfg);
	}

	mtwifi_cfg_iwpriv_hook(cfg);
	return true;
}

function mtwifi_cfg_down(devname) {
	if (!l1dat || !l1dat.devname_ridx)
		return;
	if (devname) {
		mtwifi_down(devname);
	} else {
		for (let k, _ in l1dat.devname_ridx) {
			mtwifi_down(k);
		}
	}
}

function mtwifi_cfg_reload(devname) {
	if (devname) {
		utils.exec(["/sbin/wifi", "reload", "" + devname]);
	} else {
		utils.exec(["/sbin/wifi", "reload"]);
	}
}

let action = {
	"down": function(devname) {
		mtwifi_cfg_down(devname);
	},

	"reload": function(devname) {
		mtwifi_cfg_reload(devname);
	},

	"setup": function(arg_json) {
		let argv = arg_json;
		if (!argv) {
			argv = fs.stdin.read("line") ?? "";
		}
		argv = trim("" + argv);
		if (length(argv) == 0 || !mtwifi_cfg_setup(argv)) {
			exit(1);
		}
	}
};

let argc = length(ARGV);
if (argc == 0 || !action[ARGV[0]]) {
	exit(1);
}

if (argc == 1) {
	action[ARGV[0]]();
} else if (argc >= 2) {
	action[ARGV[0]](ARGV[1]);
}
