From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] gcc: use __builtin_strchr in AArch64 unwind augmentation

Avoid pulling target <string.h> in headerless libgcc AArch64 unwind compilation.

Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
--- a/libgcc/config/aarch64/aarch64-unwind.h
+++ b/libgcc/config/aarch64/aarch64-unwind.h
@@ -40,8 +40,8 @@
       const struct dwarf_cie *cie = get_cie (fde);
       if (cie != NULL)
 	{
-	  char *aug_str = cie->augmentation;
-	  return strchr (aug_str, 'B') == NULL ? 0 : 1;
+	  const char *aug_str = (const char *) cie->augmentation;
+	  return __builtin_strchr (aug_str, 'B') == NULL ? 0 : 1;
 	}
     }
   return 0;
